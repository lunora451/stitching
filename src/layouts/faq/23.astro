<style lang="scss">
  /*-- -------------------------- -->
<---           Stats            -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #stats-1576 {
      padding: var(--sectionPadding);
      background-color: #1a1a1a;
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        /* Changes to 1280px at small desktop */
        max-width: calc(955 / 16 * 1rem);
        margin: auto;
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        row-gap: calc(60 / 16 * 1rem);
      }

      .cs-item {
        text-align: center;
        list-style: none;
        width: 47%;
        max-width: calc(240 / 16 * 1rem);
        margin: 0;
        padding: 0 calc(12 / 16 * 1rem);
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .cs-icon {
        width: calc(48 / 16 * 1rem);
        height: auto;
        margin: 0 0 calc(24 / 16 * 1rem);
        display: block;
      }

      .cs-number {
        /* 31px - 61px */
        font-size: clamp(1.9375rem, 4.3vw, 2.4375rem);
        line-height: 1.2em;
        text-align: inherit;
        font-weight: 400;
        margin: 0 0 calc(4 / 16 * 1rem) 0;
        color: var(--bodyTextColorWhite);
        display: block;
      }

      .cs-desc {
        /* 16px - 20px */
        font-size: clamp(1rem, 2vw, 1.15rem);
        line-height: 1.5em;
        text-align: inherit;
        width: 100%;
        color: var(--bodyTextColorWhite);
      }

      .cs-background {
        width: 100%;
        height: 100%;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;

        img {
          position: absolute;
          top: 0;
          left: 0;
          height: 100%;
          width: 100%;
          /* Makes img tag act as a background image */
          object-fit: cover;
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #stats-1576 {
      .cs-card-group {
        justify-content: space-between;
      }
    }
  }

  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #stats-1576 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
      }

      .cs-card-group {
        max-width: calc(630 / 16 * 1rem);
        margin-left: auto;
        justify-content: flex-end;
      }

      .cs-item {
        text-align: left;
        max-width: calc(200 / 16 * 1rem);
        align-items: flex-start;
      }
    }
  }

  /*-- -------------------------- -->
<---   Side By Side Reverse     -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #sbsr-1576 {
      padding: var(--sectionPadding);

      .cs-container {
        width: 100%;
        /* changes to 1280px at small desktop */
        max-width: calc(584 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        text-align: center;
        max-width: calc(630 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .cs-title {
        /* 20 characters wide including spaces */
        max-width: 20ch;
        margin: 0 0 calc(32 / 16 * 1rem) 0;
      }

      .cs-faq-group {
        padding: 0;
        margin: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        gap: calc(12 / 16 * 1rem);
      }

      .cs-faq-item {
        text-align: left;
        list-style: none;
        width: 100%;
        background-color: #f7f7f7;
        /* 12px - 16px */
        padding: clamp(0.75rem, 2vw, 1rem) calc(16 / 16 * 1rem);
        box-sizing: border-box;
        transition: border-bottom 0.3s;

        &.active {
          border-color: var(--primaryLight);
          .cs-button {
            color: var(--primary);
            .cs-indicator {
              &:before {
                transform: translate(-50%, -50%) rotate(360deg);
              }

              &:after {
                transform: translate(-50%, -50%) rotate(0deg);
              }
            }
          }
          .cs-item-p {
            height: auto;
            padding-top: calc(16 / 16 * 1rem);
            opacity: 1;
            transform: scaleY(1);
          }
        }
      }

      .cs-button {
        /* 16px - 20px */
        font-size: clamp(1rem, 2vw, 1.25rem);
        line-height: 1.2em;
        text-align: left;
        font-weight: bold;
        padding: 0;
        border: none;
        background: transparent;
        color: var(--headerColor);
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        position: relative;
        transition:
          background-color 0.3s,
          color 0.3s;

        &:hover {
          cursor: pointer;
        }

        .cs-indicator {
          width: calc(24 / 16 * 1rem);
          height: calc(24 / 16 * 1rem);
          position: relative;
          z-index: 1;

          &:before {
            /* left line */
            content: "";
            width: calc(16 / 16 * 1rem);
            height: calc(2 / 16 * 1rem);
            background-color: #767676;
            opacity: 1;
            border-radius: 2px;
            position: absolute;
            display: block;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            transition: transform 0.5s;
          }

          &:after {
            /* right line */
            content: "";
            width: calc(16 / 16 * 1rem);
            height: calc(2 / 16 * 1rem);
            background-color: #767676;
            opacity: 1;
            border-radius: 2px;
            position: absolute;
            display: block;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(90deg);
            transition: transform 0.5s;
          }
        }
      }

      .cs-button-text {
        width: 90%;
        display: block;
      }

      .cs-item-p {
        /* 14px - 16px */
        font-size: clamp(0.875rem, 1.5vw, 1rem);
        line-height: 1.5em;
        width: 90%;
        max-width: calc(541 / 16 * 1rem);
        height: 0;
        margin: 0;
        padding: 0;
        opacity: 0;
        color: var(--bodyTextColor);
        /* clips the text so it doesn't show up */
        overflow: hidden;
        transform: scaleY(0);
        transform-origin: top;
        transition:
          opacity 0.3s,
          transform 0.3s,
          padding-bottom 0.3s;
      }

      .cs-image-group {
        /* everything inside the image group is in ems so the font size will scale them down.  Font size minimum is tied to view width size, and grows until it reaches 75% of the value on em */
        font-size: min(2.3vw, 0.89em);
        width: calc(630 / 16 * 1em);
        min-height: calc(1010 / 16 * 1em);
        display: flex;
        gap: calc(20 / 16 * 1em);
        position: relative;
        z-index: 1;
      }

      .cs-picture {
        overflow: hidden;
        display: block;
        position: relative;
        z-index: 1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      .cs-row {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: calc(20 / 16 * 1em);
      }

      .cs-picture1 {
        width: calc(305 / 16 * 1em);
        height: 40.594059%;
        margin-top: calc(114 / 16 * 1em);
      }

      .cs-picture2 {
        width: calc(305 / 16 * 1em);
        height: 60.891089%;
      }

      .cs-picture3 {
        width: calc(305 / 16 * 1em);
        height: 60%;
      }

      .cs-picture4 {
        width: calc(305 / 16 * 1em);
        height: 27.425743%;
      }
    }
  }

  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #sbsr-1576 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        flex-direction: row;
        justify-content: space-between;
        align-items: stretch;
      }

      .cs-content {
        text-align: left;
        align-items: flex-start;
      }

      .cs-image-group {
        font-size: min(1.2vw, 1em);
        height: auto;
        /* -210px to -384px */
        margin-top: calc(clamp(13.125rem, 20vw, 24rem) * -1);
        flex: none;
      }
    }
  }

  /* Large Desktop - 1300px */
  @media only screen and (min-width: 81.25rem) {
    #sbsr-1576 {
      .cs-image-group {
        margin-top: calc(-382 / 16 * 1rem);
      }
    }
  }
</style><script>
  const faqItems = Array.from(document.querySelectorAll(".cs-faq-item"));
  for (const item of faqItems) {
    const onClick = () => {
      item.classList.toggle("active");
    };
    item.addEventListener("click", onClick);
  }
</script>
