<style lang="scss">
  /*-- -------------------------- -->
<---            FAQ             -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #faq-2352 {
      padding: var(--sectionPadding);
      position: relative;

      .cs-container {
        width: 100%;
        max-width: calc(1800 / 16 * 1rem);
        margin: auto;
        /* 40px - 100px top & bottom */
        /* 16px - 40px left & right */
        padding: clamp(2.5rem, 8vw, 6.25rem) clamp(1rem, 4vw, 2.5rem);
        padding-bottom: 0;
        background-color: #f1eeec;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 32px - 48px */
        gap: clamp(2rem, 6vw, 3rem);
        position: relative;
        z-index: 1;
      }

      .cs-wrapper {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: left;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: flex-start;
      }

      .cs-title {
        margin: 0 0 calc(48 / 16 * 1rem);
      }

      .cs-faq-group {
        width: 100%;
        max-width: calc(739 / 16 * 1rem);
        padding: 0;
        margin: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        gap: calc(32 / 16 * 1rem);
      }

      .cs-faq-item {
        list-style: none;
        width: 100%;
        border-bottom: 1px solid #e3ddd9;
        /* clips all corners of the button that overlap the rounded border */
        overflow: hidden;
        transition: border-bottom 0.3s;

        &.active {
          .cs-button {
            padding-bottom: calc(16 / 16 * 1rem);
            color: var(--primary);
          }

          .cs-icon {
            transform: rotate(90deg);
          }

          .cs-item-p {
            height: auto;
            /* 20px - 24px bottom */
            padding: 0 0 calc(32 / 16 * 1rem);
            opacity: 1;
          }
        }
      }

      .cs-button {
        /* 16px - 20px */
        font-size: clamp(1rem, 2.5vw, 1.25rem);
        line-height: 1.2em;
        text-align: left;
        font-weight: bold;
        /* 20px - 24px */
        padding: 0 0 calc(32 / 16 * 1rem);
        background-color: transparent;
        border: none;
        color: var(--headerColor);
        display: block;
        width: 100%;
        position: relative;
        transition:
          padding 0.3s,
          color 0.3s;

        &:hover {
          cursor: pointer;
        }
      }

      .cs-button-text {
        width: 100%;
        display: flex;
        justify-content: space-between;
        gap: calc(32 / 16 * 1rem);
      }

      .cs-icon {
        width: calc(24 / 16 * 1rem);
        height: auto;
        display: block;
        transition: transform 0.3s;
      }

      .cs-item-p {
        /* 14px - 16px */
        font-size: clamp(0.875rem, 1.5vw, 1rem);
        line-height: 1.5em;
        width: 90%;
        height: 0;
        margin: 0;
        padding: 0;
        opacity: 0;
        color: var(--bodyTextColor);
        /* clips the text so it doesn't show up */
        overflow: hidden;
        transition:
          opacity 0.3s,
          padding-bottom 0.3s;
      }

      .cs-picture {
        width: 90%;
        height: auto;
        margin-right: auto;
        display: block;
        position: relative;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #faq-2352 {
      .cs-container {
        /* 40px - 100px */
        padding-bottom: clamp(2.5rem, 8vw, 6.25rem);
        flex-direction: row;
        justify-content: space-between;
        align-items: stretch;
      }

      .cs-wrapper {
        display: flex;
        justify-content: space-between;
      }

      .cs-content {
        width: 48%;
        text-align: left;
        align-items: flex-start;
        /* prevents flexbox from squishing it */
        flex: none;
      }

      .cs-picture {
        width: 40%;
        max-width: calc(606 / 16 * 1rem);
        max-height: 58%;
        overflow: hidden;
        position: absolute;
        bottom: 0;
        left: 0;
      }
    }
  }
</style><script>
  const faqItems = Array.from(document.querySelectorAll(".cs-faq-item"));
  for (const item of faqItems) {
    const onClick = () => {
      item.classList.toggle("active");
    };
    item.addEventListener("click", onClick);
  }
</script>
