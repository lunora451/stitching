<!-- ============================================ --><!--               Call To Action                 --><!-- ============================================ -->
<section id="cta-2353">
  <div class="cs-container">
    <div class="cs-content">
      <span class="cs-topper">Contact Us</span>
      <h2 class="cs-title">
        Offering an array of services in the fields of architecture and interior
        design.
      </h2>
      <div class="cs-button-box">
        <a href="" class="cs-link">
          <picture class="cs-icon-wrapper">
            <img
              class="cs-icon"
              loading="lazy"
              decoding="async"
              src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/phone-brown.svg"
              alt="icon"
              width="24"
              height="24"
            />
          </picture>
          <div class="cs-info">
            <span class="cs-desc">Call Us Anytime</span>
            <span class="cs-contact">Call us at +1 (888) 456 789</span>
          </div>
        </a>
        <a href="" class="cs-link">
          <picture class="cs-icon-wrapper">
            <img
              class="cs-icon"
              loading="lazy"
              decoding="async"
              src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/mail-brown.svg"
              alt="icon"
              width="24"
              height="24"
            />
          </picture>
          <div class="cs-info">
            <span class="cs-desc">Call Us Anytime</span>
            <span class="cs-contact">Call us at +1 (888) 456 789</span>
          </div>
        </a>
      </div>
      <a href="" class="cs-button-solid">Get A Free Quote</a>
    </div>
    <picture class="cs-picture">
      <!--Mobile Image-->
      <source
        media="(max-width: 600px)"
        srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/MISC/building20.jpg"
      />
      <!--Tablet and above Image-->
      <source
        media="(min-width: 601px)"
        srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/MISC/building20.jpg"
      />
      <img
        loading="lazy"
        decoding="async"
        src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/MISC/building20.jpg"
        alt="interior room"
        width="1280"
        height="568"
      />
    </picture>
  </div>
</section>

<style lang="scss">
  /*-- -------------------------- -->
<---      Call To Action        -->
<--- -------------------------- -*/

  /* Mobile */
  @media only screen and (min-width: 0rem) {
    #cta-2353 {
      width: 100%;
      overflow: hidden;
      box-sizing: border-box;

      .cs-container {
        width: 100%;
        max-width: calc(1800 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        position: relative;
        z-index: 1;
      }

      .cs-content {
        width: 100%;
        max-width: calc(834 / 16 * 1rem);
        padding: var(--sectionPadding);
      }

      .cs-title {
        max-width: 100%;
        margin-bottom: calc(24 / 16 * 1rem);
      }

      .cs-button-box {
        margin-bottom: calc(32 / 16 * 1rem);
        display: flex;
        flex-wrap: wrap;
        column-gap: calc(24 / 16 * 1rem);
        row-gap: calc(16 / 16 * 1rem);
      }

      .cs-link {
        text-decoration: none;
        display: flex;
        align-items: center;
        /* 12px - 24px */
        gap: clamp(0.75rem, 1.5vw, 1.5rem);
      }

      .cs-icon-wrapper {
        /* 48px - 60px */
        width: clamp(3rem, 5vw, 3.75rem);
        height: clamp(3rem, 5vw, 3.75rem);
        border: 1px solid var(--primary);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .cs-icon {
        width: calc(24 / 16 * 1rem);
        height: auto;
        display: block;
      }

      .cs-info {
        display: flex;
        flex-direction: column;
        gap: calc(4 / 16 * 1rem);
      }

      .cs-desc {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.5em;
        color: var(--bodyTextColor);
        display: block;
      }

      .cs-contact {
        font-size: calc(20 / 16 * 1rem);
        line-height: 1.2em;
        font-weight: 700;
        color: var(--bodyTextColor);
        display: block;
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        text-decoration: none;
        /* 46px - 56px */
        line-height: clamp(2.875rem, 3vw, 3.5rem);
        font-weight: 700;
        text-align: center;
        margin: 0;
        padding: 0 calc(48 / 16 * 1rem);
        background-color: var(--primary);
        color: #fff;
        display: inline-block;
        position: relative;
        z-index: 1;

        &:hover {
          &:before {
            width: 100%;
          }
        }

        &:before {
          content: "";
          width: 0%;
          height: 100%;
          background: #1a1a1a;
          opacity: 1;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
        }
      }

      .cs-picture {
        width: 100%;
        height: calc(510 / 16 * 1rem);
        display: block;
        position: relative;
        z-index: 1;
        order: -1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #cta-2353 {
      padding: var(--sectionPadding);
      padding-top: 0;
      padding-bottom: 0;

      .cs-container {
        padding: var(--sectionPadding);
        padding-left: 0;
        padding-right: 0;
        align-items: flex-start;
      }

      .cs-content {
        width: 47.5%;
        padding: 0;
      }

      .cs-picture {
        width: 50vw;
        height: 100%;
        /* 40px - 60px */
        margin-left: clamp(2.5rem, 5vw, 3.75rem);
        position: absolute;
        top: 0;
        left: 50%;
      }
    }
  }
</style>
