<!-- ============================================ --><!--                   Reviews                    --><!-- ============================================ -->
<section id="reviews-2418">
  <div class="cs-container">
    <figure class="cs-card">
      <div class="cs-content">
        <h2 class="cs-topper">Happy Clients Speak</h2>
        <p class="cs-title">What They Say</p>
      </div>
      <blockquote class="cs-blockquote">
        <img
          class="cs-stars"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/stars5.svg"
          decoding="async"
          alt=""
          width="136"
          height="20"
          loading="lazy"
        />
        <p class="cs-review">
          Poop Patrol Stitches has been a game-changer for us! The team is
          always punctual, professional, and leaves our yard spotless. Highly
          recommend their services to every pet owner.
        </p>
      </blockquote>
      <figcaption class="cs-info">
        <img
          class="cs-profile"
          src="https://nyc3.digitaloceanspaces.com/csimages2/Images/People/reviewbg-pet-services-840x840.jpg"
          decoding="async"
          alt=""
          width="52"
          height="52"
          loading="lazy"
        />

        <span class="cs-name">
          Jenny Y.
          <span class="cs-desc">Home Owner</span>
        </span>
        <!--Quote Icon-->
        <svg
          class="cs-profile-graphic"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="125"
          height="100"
          viewBox="0 0 125 100"
          ><path
            fill="var(--primary)"
            d="M68.8 0 28.7 100H0L22.9 0h45.9Zm10.3 0L56.2 100h28.7L125 0H79.1Z"
          ></path></svg
        >
      </figcaption>
    </figure>
  </div>
  <picture class="cs-background">
    <!-- coincides with css Custom mid Mobile/Tablet breakpoint -->
    <!-- update media max and min below if css changes -->
    <source
      media="(max-width: 767px)"
      srcset="https://nyc3.digitaloceanspaces.com/csimages2/Images/People/reviewbg-pet-services-840x840.jpg"
    />
    <source
      media="(min-width: 768px)"
      srcset="https://nyc3.digitaloceanspaces.com/csimages2/Images/People/reviewbg-pet-services-1800x1350.jpg"
    />
    <img
      loading="lazy"
      decoding="async"
      src="https://nyc3.digitaloceanspaces.com/csimages2/Images/People/reviewbg-pet-services-1800x1350.jpg"
      alt=""
      width="630"
      height="877"
    />
  </picture>
</section>

<style lang="scss">
  /*-- -------------------------- -->
<!--          Reviews           -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #reviews-2418 {
      padding: var(--sectionPadding);
      /* padding-top resets at 768px */
      padding-top: calc(400 / 16 * 1rem);
      position: relative;
      overflow: hidden;

      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        margin: 0 auto;
      }

      /* figure */
      .cs-card {
        width: 100%;
        margin: 0;
        margin-left: auto;
        /* 24px - 40px */
        padding: clamp(calc(24 / 16 * 1rem), 6.66vw, calc(40 / 16 * 1rem));
        background-color: #fff;
        border-radius: calc(16 / 16 * 1rem);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: flex-start;
        position: relative;
        z-index: 1;

        &:before {
          /* background color */
          content: "";
          width: 100%;
          height: 100%;
          background: var(--primary);
          opacity: 0.1;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
        }
      }

      .cs-title {
        margin-bottom: calc(48 / 16 * 1rem);
      }

      .cs-blockquote {
        width: 100%;
        margin: 0;
      }

      .cs-stars {
        width: calc(136 / 16 * 1rem);
        height: auto;
        margin-bottom: calc(16 / 16 * 1rem);
        display: block;
      }

      /* blockquote */
      .cs-review {
        /* 16px - 20px */
        font-size: clamp(1rem, 2.5vw, 1.25rem);
        line-height: 1.5em;
        margin: 0 0 calc(16 / 16 * 1rem);
        color: var(--bodyTextColor);
        z-index: 1;

        &:last-of-type {
          margin-bottom: calc(40 / 16 * 1rem);
        }
      }

      /* figcaption */
      .cs-info {
        width: 100%;
        display: flex;
        align-items: flex-start;
        gap: calc(12 / 16 * 1rem);
        position: relative;
      }

      .cs-profile {
        width: calc(52 / 16 * 1rem);
        height: calc(52 / 16 * 1rem);
        border-radius: 50%;
        overflow: hidden;
        object-fit: cover;
        display: block;
        position: relative;
        z-index: 1;
      }

      .cs-name {
        font-size: calc(20 / 16 * 1rem);
        line-height: 1.2em;
        font-weight: 700;
        margin: 0;
      }

      .cs-desc {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 400;
        line-height: 1.5em;
        color: var(--bodyTextColor);
        display: block;
      }

      /* ornamental 'quote' graphic  */
      .cs-profile-graphic {
        width: 27vw;
        max-width: calc(125 / 16 * 1rem);
        height: auto;
        /* controls fill color */
        color: var(--primary);
        opacity: 0.2;
        pointer-events: none;
        position: absolute;
        top: 0;
        right: 0;
        z-index: -1;
      }

      /* background image */
      .cs-background {
        width: 100%;
        height: 100%;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;

        img {
          width: 100%;
          height: 100%;
          /* makes image act as a background image */
          object-fit: cover;
          object-position: center;
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #reviews-2418 {
      /* resetting the padding */
      padding: var(--sectionPadding);

      .cs-card {
        width: 62%;
        max-width: calc(738 / 16 * 1rem);
      }
    }
  }
</style>
