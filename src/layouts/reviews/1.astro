  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #reviews-2429 {
      padding: var(--sectionPadding);
      background-color: #030711;
      overflow: hidden;
      position: relative;

      .cs-container {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-reviews-wrapper {
        max-width: calc(792 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
        position: relative;
        z-index: 1;
      }

      .cs-button-group {
        width: auto;
        display: inline-flex;
        justify-content: center;
        gap: calc(16 / 16 * 1rem);
        position: absolute;
        right: 0;
        bottom: 0;
        z-index: 2;
      }

      .cs-button {
        width: calc(48 / 16 * 1rem);
        height: calc(48 / 16 * 1rem);
        padding: calc(14 / 16 * 1rem);
        background-color: var(--primary);
        border: none;
        transition: background-color 0.3s;

        &:first-of-type {
          background-color: var(--headerColor);
        }

        &:hover {
          cursor: pointer;
          background-color: #f7f7f7;

          .cs-button-arrow {
            filter: invert(1);
          }
        }
      }

      .cs-button-arrow {
        width: calc(20 / 16 * 1rem);
        height: auto;
        display: block;
      }

      .cs-review {
        /* 25px - 39px */
        font-size: clamp(1.5625rem, 4vw, 2.4375rem);
        line-height: 1.2em;
        font-weight: 700;
        /* adjust as needed based on the tallest review, changes on desktop */
        min-height: calc(178 / 16 * 1rem);
        margin: 0;
        color: var(--bodyTextColorWhite);
      }

      .cs-wrapper {
        position: relative;
        z-index: 1;
        transition: opacity 0.3s;
      }

      .cs-active {
        opacity: 1;
      }

      .cs-hidden {
        opacity: 0;
        position: absolute;
      }

      .cs-profile-group {
        /* 32px - 48px */
        margin-top: clamp(2rem, 4vw, 3rem);
        padding-top: clamp(2rem, 3vw, 3rem);
        border-top: 1px solid rgba(255, 255, 255, 0.2);
        display: flex;
