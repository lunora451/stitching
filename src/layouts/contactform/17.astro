  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #contact-1268 {
      .cs-label {
        &:nth-of-type(1),
        &:nth-of-type(2) {
          grid-column: span 6;
        }
      }
    }
  }

  /* Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #contact-1268 {
      /* moved padding back to the section container */
      padding: var(--sectionPadding);

      .cs-container {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
