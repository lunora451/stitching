---

---

<!-- ============================================ --><!--                   Contact                    --><!-- ============================================ -->
<section id="contact-2147">
  <div class="cs-container">
    <div class="cs-content">
      <div class="cs-flex">
        <span class="cs-topper">Contact Us</span>
        <h2 class="cs-title">Our Contact</h2>
      </div>
      <p class="cs-text">
        We have courses on-demand and live instructors for workshops and
        support. We also provide LIVE instructor-led training courses and onsite
        training.
      </p>
    </div>
    <div class="cs-contact-info">
      <ul class="cs-ul">
        <li class="cs-li">
          <span class="cs-header">Location</span>
          <a href="" class="cs-link"
            >5the Avenue, E 28th St, Brooklyn NY, 2300 USA</a
          >
        </li>
        <li class="cs-li">
          <span class="cs-header">Phone No</span>
          <a href="" class="cs-link">+1(0) 987 654 321 </a>
        </li>
        <li class="cs-li">
          <span class="cs-header">Email</span>
          <a href="" class="cs-link">stitchography@gmail.com</a>
        </li>
      </ul>
    </div>
    <!--Form-->
    <div class="cs-form-wrapper">
      <span class="cs-picture-title">Contact Us</span>
      <form
        class="cs-form"
        id="cs-form-2147-2147"
        name="Contact Form"
        method="post"
      >
        <div class="cs-form-content">
          <span class="cs-form-title">Fill out the form below</span>
        </div>
        <label class="cs-label">
          <input
            class="cs-input"
            required
            type="text"
            id="name-2147-2147"
            name="name"
            placeholder="Name"
          />
        </label>
        <label class="cs-label">
          <input
            class="cs-input"
            required
            type="email"
            id="email-2147-2147"
            name="email"
            placeholder="Email"
          />
        </label>
        <label class="cs-label">
          <input
            class="cs-input"
            type="number"
            id="phone-2147-2147"
            name="phone"
            placeholder="Phone"
          />
        </label>
        <label class="cs-label">
          <select
            class="cs-select"
            name="class"
            id="classes-2147-2147"
            placeholder="Services"
          >
            <option value="Service 1">Services</option>
            <option value="Service 2">Services</option>
            <option value="Service 3">Services</option>
            <option value="Service 4">Services</option>
          </select>
        </label>
        <label class="cs-label cs-message">
          <textarea
            class="cs-input cs-textarea"
            required
            name="Message"
            id="message-2147-2147"
            placeholder="Message"></textarea>
        </label>
        <button class="cs-button-solid cs-submit" type="submit"
          >Schedule Consultation</button
        >
      </form>
      <picture class="cs-picture">
        <!--Mobile Image-->
        <source
          media="(max-width: 600px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/MISC/wedding-rings.jpg"
        />
        <!--Tablet and above Image-->
        <source
          media="(min-width: 601px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/MISC/wedding-rings.jpg"
        />
        <img
          loading="lazy"
          decoding="async"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/MISC/wedding-rings.jpg"
          alt="wedding rings"
          width="1280"
          height="576"
          aria-hidden="true"
        />
      </picture>
    </div>
  </div>
  <!--Background-->
  <picture class="cs-background">
    <!--Mobile Image-->
    <source
      media="(max-width: 600px)"
      srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/pattern-bg.png"
    />
    <!--Tablet and above Image-->
    <source
      media="(min-width: 601px)"
      srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/pattern-bg.png"
    />
    <img
      src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/pattern-bg.png"
      alt="background"
      width="1920"
      height="1386"
      loading="lazy"
      decoding="async"
      aria-hidden="true"
    />
  </picture>
</section>

<style lang="scss">
  /*-- -------------------------- -->
<---          Contact           -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #contact-2147 {
      padding: var(--sectionPadding);
      background-color: #fbf5f1;
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
        max-width: calc(704 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: relative;
      }

      .cs-content {
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .cs-contact-info {
        width: 100%;
        /* 48px - 64px bottom */
        margin: calc(32 / 16 * 1rem) 0 clamp(3rem, 6vw, 4rem) 0;
        display: flex;
      }

      .cs-text {
        max-width: calc(630 / 16 * 1rem);
      }

      .cs-ul {
        text-align: left;
        width: 100%;
        margin: 0;
        box-sizing: border-box;
        padding: 0;
        display: grid;
        flex-direction: column;
        align-items: flex-start;
        grid-template-columns: repeat(12, 1fr);
        /* 16px - 20px bottom */
        gap: clamp(1rem, 2vw, 1.25rem);
      }

      .cs-li {
        text-align: center;
        list-style: none;
        /* 24px - 40px bottom */
        padding: clamp(1.5rem, 3vw, 2.5rem);
        background-color: #f6ebe3;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        grid-column: span 12;
        gap: calc(16 / 16 * 1rem);
        align-self: stretch;
      }

      .cs-header {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 2.5vw, 1.5625rem);
        font-weight: 700;
        line-height: 1.2em;
        margin: 0;
        color: var(--headerColor);
        display: block;
      }

      .cs-link {
        /* 14px - 16px */
        font-size: clamp(0.875rem, 1.75vw, 1rem);
        line-height: 1.5em;
        text-decoration: none;
        color: var(--bodyTextColor);
        display: block;
        position: relative;

        &:hover {
          text-decoration: underline;
        }
      }

      .cs-form-wrapper {
        width: 100%;
        display: flex;
        flex-direction: column;
        position: relative;
        z-index: 1;
      }

      .cs-picture-title {
        /* 46px - 56px */
        font-size: clamp(2.4375rem, 5vw, 3.0625rem);
        font-weight: 900;
        line-height: 1.2em;
        /* 24px - 108px */
        margin: 0 auto clamp(1.5rem, 10vw, 6.25rem);
        /* 80px - 200px */
        padding-top: clamp(5rem, 13vw, 12.5rem);
        color: var(--bodyTextColorWhite);
      }

      .cs-picture-wrapper {
        width: 100%;
        /* 380px - 420px */
        height: clamp(23.75rem, 45vw, 26.25rem);
        display: flex;
        justify-content: center;
        position: absolute;
        top: 0;
        left: 0;
      }

      .cs-picture {
        width: 100%;
        height: 100%;
        overflow: hidden;
        display: block;
        position: absolute;
        z-index: -1;

        &::before {
          content: "";
          width: 100%;
          height: 100%;
          background: linear-gradient(
            0deg,
            rgba(0, 0, 0, 0.6) 0%,
            rgba(0, 0, 0, 0.6) 100%
          );
          opacity: 1;
          position: absolute;
          top: 0;
          left: 0;
          z-index: 1;
        }

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      .cs-form {
        /* prevents flexbox from affecting height and width */
        box-sizing: border-box;
        /* 24px - 40px top and bottom */
        /* 24px - 48px left and right */
        padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 3rem);
        background-color: #f6ebe3;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: calc(12 / 16 * 1rem);
        position: relative;
      }

      .cs-form-content {
        text-align: center;
        width: 100%;
        display: flex;
        justify-content: center;
      }

      .cs-form-title {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.5em;
        margin: 0 0 calc(12 / 16 * 1rem) 0;
        color: var(--bodyTextColor);
        display: block;
      }

      .cs-label {
        font-size: calc(16 / 16 * 1rem);
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        grid-column: span 12;
        gap: calc(4 / 16 * 1rem);
      }

      .cs-input,
      .cs-select {
        font-size: calc(16 / 16 * 1rem);
        width: 100%;
        /* 46px - 56px */
        height: clamp(2.875rem, 5.5vw, 3.5rem);
        /* prevents padding from adding to height and width */
        box-sizing: border-box;
        padding: 0 calc(24 / 16 * 1rem);
        background-color: #fff;
        color: #767676;
        border: none;

        &::placeholder {
          color: #767676;
        }
      }

      .cs-textarea {
        font-family: inherit;
        min-height: calc(120 / 16 * 1rem);
        margin: 0 0 calc(20 / 16 * 1rem) 0;
        padding-top: calc(24 / 16 * 1rem);
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        /* 46px - 56px */
        line-height: clamp(2.875em, 5.5vw, 3.5em);
        text-align: center;
        text-decoration: none;
        min-width: calc(150 / 16 * 1rem);
        margin: 0;
        /* prevents padding from adding to the width */
        box-sizing: border-box;
        /* 32px - 48px */
        padding: 0 clamp(2rem, 4vw, 3rem);
        background-color: var(--primary);
        overflow: hidden;
        color: #fff;
        border: none;
        display: inline-block;
        position: relative;
        z-index: 1;
        transition: color 0.3s;

        &:before {
          content: "";
          width: 0%;
          height: 100%;
          background: #000;
          opacity: 1;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
        }

        &:hover {
          &:before {
            width: 100%;
          }
        }
      }

      .cs-submit {
        width: 100%;

        &:hover {
          cursor: pointer;
        }
      }

      .cs-background {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -2;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #contact-2147 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        justify-content: space-between;
      }

      .cs-content {
        text-align: left;
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-end;
      }

      .cs-title {
        margin: 0;
      }

      .cs-text {
        width: 65%;
      }

      .cs-ul {
        flex-direction: row;
      }

      .cs-li {
        grid-column: span 4;
      }

      .cs-form-wrapper {
        align-items: center;
      }

      .cs-picture {
        height: auto;
        top: 0;
        /* 200px - 260px */
        bottom: clamp(12.5rem, 10vw, 16.25rem);
      }

      .cs-form {
        width: 80vw;
        max-width: calc(846 / 16 * 1rem);
        justify-content: space-between;
        column-gap: calc(12 / 16 * 1rem);
      }

      .cs-label {
        width: 48.9%;
      }

      .cs-message {
        width: 100%;
      }

      .cs-submit {
        width: auto;
        margin: auto;
      }
    }
  }
</style>
