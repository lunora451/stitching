<section id="contact-1333">
  <div class="cs-container">
    <!--Form-->
    <form class="cs-form" id="cs-form-1333" name="Contact Form" method="post">
      <div class="cs-content">
        <span class="cs-topper">Contact Us</span>
        <h2 class="cs-title">Make Appointment</h2>
      </div>
      <label class="cs-label">
        Name
        <input
          class="cs-input"
          required
          type="text"
          id="name-1333"
          name="name"
          placeholder="Name"
        />
      </label>
      <label class="cs-label cs-email">
        Email
        <input
          class="cs-input"
          required
          type="email"
          id="email-1333"
          name="email"
          placeholder="Email"
        />
      </label>
      <label class="cs-label cs-phone">
        Phone
        <input
          class="cs-input"
          required
          type="number"
          id="phone-1333"
          name="phone"
          placeholder="Phone"
        />
      </label>
      <label class="cs-label">
        Message
        <textarea
          class="cs-input cs-textarea"
          required
          name="Message"
          id="message-1333"
          placeholder="Write message..."></textarea>
      </label>
      <button class="cs-button-solid cs-submit" type="submit"
        >Schedule Appointment</button
      >
    </form>
    <div class="cs-content">
