---

<!-- ============================================ --><!--                 Contact Form                 --><!-- ============================================ -->
<section id="cs-contact-549">
  <div class="cs-container">
    <div class="cs-content">
      <span class="cs-topper">Contact Us</span>
      <h2 class="cs-title">
        Lorem ipsum dolor sit amet consectetur, adipisicing.
      </h2>
      <p class="cs-text">
        Nulla Lorem mollit cupidatat irure. Laborum magna nulla duis ullamco
        cillum dolor. Voluptate exercitation incididunt aliquip deserunt.
      </p>
    </div>
    <!--Swap the image out for a screenshot of the Google Map location for your client, or you can add the embedded iframe from google and add the cs-background class to it and it should work, remove the animated dots in the CSS if you do that-->
    <picture class="cs-background">
      <!--Mobile Image-->
      <source
        media="(max-width: 600px)"
        srcset="https://csimages2.nyc3.digitaloceanspaces.com/Contact-Page/generic-map.jpg"
      />
      <!--Tablet and above Image-->
      <source
        media="(min-width: 601px)"
        srcset="https://csimages2.nyc3.digitaloceanspaces.com/Contact-Page/generic-map.jpg"
      />
      <img
        loading="lazy"
        decoding="async"
        src="https://csimages2.nyc3.digitaloceanspaces.com/Contact-Page/generic-map.jpg"
        alt="appliance"
        width="1280"
        height="568"
        aria-hidden="true"
      />
    </picture>
    <!--Form-->
    <form class="cs-form" id="cs-form-549" name="Contact Form" method="post">
      <label class="cs-label">
        Name
        <input
          class="cs-input"
          required
          type="text"
          id="name-549"
          name="name"
          placeholder="Name"
        />
        <img
          class="cs-icon"
          loading="lazy"
          decoding="async"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Contact-Page/person-gold.svg"
          alt="person icon"
          width="32"
          height="32"
        />
      </label>
      <label class="cs-label cs-email">
        Email
        <input
          class="cs-input"
          required
          type="text"
          id="email-549"
          name="email"
          placeholder="Email"
        />
        <img
          class="cs-icon"
          loading="lazy"
          decoding="async"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Contact-Page/mail-gold.svg"
          alt="mail icon"
          width="32"
          height="32"
        />
      </label>
      <label class="cs-label cs-phone">
        Phone
        <input
          class="cs-input"
          required
          type="text"
          id="phone-549"
          name="phone"
          placeholder="Phone"
        />
        <img
          class="cs-icon"
          loading="lazy"
          decoding="async"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Contact-Page/phone-golden.svg"
          alt="phone icon"
          width="32"
          height="32"
        />
      </label>
      <label class="cs-label cs-phone">
        How did you hear about us?
        <input
          class="cs-input"
          required
          type="text"
          id="phone-549"
          name="phone"
          placeholder="Google"
        />
        <img
          class="cs-icon"
          loading="lazy"
          decoding="async"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Contact-Page/refer.svg"
          alt="talking icon"
          width="32"
          height="32"
        />
      </label>
      <label class="cs-label cs-textarea-label">
        Message
        <textarea
          class="cs-textarea"
          required
          name="Message"
          id="message-549"
          placeholder="Write message..."></textarea>
      </label>
      <button class="cs-submit" type="submit">Send</button>
    </form>
  </div>
</section>

<style lang="scss">
  /*-- -------------------------- -->
<---       Contact Form         -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    @keyframes scaleFade {
      0% {
        transform: translate(-50%, -50%) scale(0);
      }

      50% {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1.4);
      }

      100% {
        transform: translate(-50%, -50%) scale(1.7);
        opacity: 0;
      }
    }

    #cs-contact-549 {
      padding: var(--sectionPadding);

      .cs-container {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text aling to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-background {
        width: 100%;
        height: calc(312 / 16 * 1rem);
        display: block;
        position: relative;

        &:before {
          /* yellow dot */
          content: "";
          width: calc(18 / 16 * 1rem);
          height: calc(18 / 16 * 1rem);
          background: var(--primary);
          border-radius: 50%;
          opacity: 1;
          position: absolute;
          display: block;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          z-index: 10;
        }

        &:after {
          /* yellow animated ring */
          content: "";
          width: calc(18 / 16 * 1rem);
          height: calc(18 / 16 * 1rem);
          background: transparent;
          border-radius: 50%;
          border: 1px solid var(--primary);
          opacity: 1;
          position: absolute;
          display: block;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%) scale(0);
          z-index: 10;
          transition:
            transform 0.4s,
            opacity 0.4s;
          animation-name: scaleFade;
          animation-duration: 2s;
          animation-timing-function: linear;
          animation-fill-mode: forwards;
          animation-iteration-count: infinite;
        }

        img {
          position: absolute;
          top: 0;
          left: 0;
          height: 100%;
          width: 100%;
          object-fit: cover;
        }
      }

      .cs-form {
        width: 100%;
        max-width: calc(1064 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        gap: calc(20 / 16 * 1rem);
      }

      .cs-label {
        /* 16px - 20px */
        font-size: clamp(1rem, 2vw, 1.25rem);
        line-height: 1.5em;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: calc(12 / 16 * 1rem);
        position: relative;
      }

      .cs-input,
      .cs-textarea,
      select,
      .cs-select {
        /* added options for the select tag in case you add it, that way it will also have the same styles, add the cs-select class for better specificity when targeting it */
        /* 16px - 20px */
        font-size: clamp(1rem, 2vw, 1.25rem);
        font-family: inherit;
        margin: 0;
        /* 24px - 40px */
        padding: 0 clamp(1.5rem, 5vw, 2.5rem) 0;
        width: 100%;
        /* 70px - 90px */
        height: clamp(4.375rem, 7vw, 5.625rem);
        background-color: #f1f1f4;
        /* prevents border and padding from affecting height and width */
        box-sizing: border-box;
        border: 3px solid transparent;
        display: block;
        position: relative;
        transition: border-color 0.3s;

        &:hover,
        &:focus {
          /* focus has a black outline, we override it here */
          outline: none;
          border-color: var(--primaryLight);
        }
      }

      .cs-textarea {
        width: 100%;
        margin: 0;
        padding-top: calc(16 / 16 * 1rem);
        /* changes at tablet */
        min-height: calc(200 / 16 * 1rem);
      }

      .cs-icon {
        width: calc(30 / 16 * 1rem);
        height: auto;
        position: absolute;
        /* 24px - 40px, matches the padding left and right of input */
        right: clamp(1.5rem, 5vw, 2.5rem);
        /* these two center the icon inside the label */
        bottom: 50%;
        transform: translateY(115%);
      }

      .cs-submit {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 2vw, 1.5625rem);
        /* 56px - 84px */
        line-height: clamp(3.5rem, 6.5vw, 5.25rem);
        text-decoration: none;
        font-weight: 700;
        text-align: center;
        /* 28px - 44px, minus the gap value. Should be 48px - 64px, but with a 20px gap on the flexbox, we account for that space when adding our margin top value so its 48px - 64px */
        margin: clamp(1.75rem, 6vw, 2.75rem) auto 0;
        color: #1a1a1a;
        border: none;
        /* 150px - 234px */
        min-width: clamp(9.374rem, 18vw, 14.625rem);
        padding: 0 calc(24 / 16 * 1rem);
        background-color: var(--primaryLight);
        border-radius: calc(4 / 16 * 1rem);
        display: inline-block;
        position: relative;
        z-index: 1;
        /* prevents padding from adding to the width */
        box-sizing: border-box;
        transition: color 0.3s;

        &:before {
          content: "";
          position: absolute;
          height: 100%;
          width: 0%;
          background: #000;
          opacity: 1;
          top: 0;
          left: 0;
          z-index: -1;
          border-radius: calc(4 / 16 * 1rem);
          transition: width 0.3s;
        }

        &:hover {
          color: #fff;
          cursor: pointer;
          &:before {
            width: 100%;
          }
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #cs-contact-549 {
      .cs-background {
        /* 310px - 568px */
        height: clamp(19.375rem, 43vw, 35.5rem);
      }

      .cs-form {
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: space-between;
      }

      .cs-label {
        width: 48%;
      }

      .cs-textarea-label {
        width: 100%;
      }

      .cs-textarea {
        /* 280px - 358px */
        min-height: clamp(17.5rem, 28vw, 22.375rem);
      }
    }
  }
</style>
