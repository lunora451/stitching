        text-align: left;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: flex-start;
      }

      .cs-title {
        /* 48px - 64px */
        margin-bottom: clamp(3rem, 6.3vw, 4rem);
      }

      .cs-form {
        padding: calc(32 / 16 * 1rem) calc(16 / 16 * 1rem);
        background-color: #f6eddf;
        /* 32px - 40px */
        border-radius: clamp(2rem, 4vw, 2.5rem);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        /* 16px - 20px */
        row-gap: clamp(1rem, 2vw, 1.25rem);
      }

      .cs-label {
        /* 14px - 16px */
        font-size: clamp(0.875rem, 1.5vw, 1rem);
        font-weight: 700;
        line-height: calc(19.2 / 16 * 1em);
        width: 100%;
        color: var(--headerColor);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        gap: calc(8 / 16 * 1rem);
      }

      .cs-input {
        font-size: calc(16 / 16 * 1rem);
        width: 100%;
        height: calc(56 / 16 * 1rem);
        /* prevents padding from adding to height and width */
        box-sizing: border-box;
        /* 11px - 16px top & bottom */
        /* 16px - 24px left & right */
        padding: clamp(0.6875rem, 1.5vw, 1rem) clamp(1rem, 2vw, 1.5rem);
        background-color: #faf6f2;
        color: var(--headerColor);
        border: none;
        border-radius: calc(16 / 16 * 1rem);
        transition: border-color 0.3s;

        &:hover {
          border-color: var(--secondary);
        }

        &:focus {
          outline: 1px solid var(--secondary);
        }

        &::placeholder {
          color: #7d799c;
          opacity: 0.6;
        }
      }

      .cs-textarea {
        font-family: inherit;
        /* 120px - 192px */
        min-height: clamp(7.5rem, 28vw, 12rem);
        margin-bottom: calc(16 / 16 * 1rem);
        padding-top: calc(24 / 16 * 1rem);
