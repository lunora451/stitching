<!-- ============================================ --><!--                 Navigation                   --><!-- ============================================ -->
<header id="cs-navigation">
  <!--Nav Logo-->
  <a href="" class="cs-logo cs-desktop" aria-label="back to home">
    <div class="cs-logo-wrapper">
      <!--Default Logo-->
      <img
        class="cs-default"
        src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Logos/construction-logo.svg"
        alt="logo"
        width="210"
        height="29"
        aria-hidden="true"
        decoding="async"
      />
      <!--Dark Mode Logo-->
      <img
        class="cs-dark"
        src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Logos/construction-logo-white2.svg"
        alt="logo"
        width="210"
        height="29"
        aria-hidden="true"
        decoding="async"
      />
    </div>
  </a>
  <div class="cs-middle">
    <!--Top Bar-->
    <div class="cs-top-bar">
      <div class="cs-top-social">
        <a href="" class="cs-social-link">
          <img
            class="cs-social-icon"
            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/facebook-1a.svg"
            alt="logo"
            width="12"
            height="12"
            aria-hidden="true"
            decoding="async"
          />
        </a>
        <a href="" class="cs-social-link">
          <img
            class="cs-social-icon"
            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/twitter-1a.svg"
            alt="logo"
            width="12"
            height="12"
            aria-hidden="true"
            decoding="async"
          />
        </a>
        <a href="" class="cs-social-link">
          <img
            class="cs-social-icon"
            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/instagram1a.svg"
            alt="logo"
            width="12"
            height="12"
            aria-hidden="true"
            decoding="async"
          />
        </a>
        <a href="" class="cs-social-link">
          <img
            class="cs-social-icon"
            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/youtube1a.svg"
            alt="logo"
            width="12"
            height="12"
            aria-hidden="true"
            decoding="async"
          />
        </a>
      </div>
      <ul class="cs-location">
        <li class="cs-item cs-remove">
          <img
            class="cs-icon"
            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/red-pin1.svg"
            alt="icon"
            width="20"
            height="20"
            aria-hidden="true"
            decoding="async"
          />
          555 Fake Avenue - South Milwaukee, WI 53172
        </li>
        <li class="cs-item">
          <img
            class="cs-icon"
            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/red-clock1.svg"
            alt="icon"
            width="20"
            height="20"
            aria-hidden="true"
            decoding="async"
          />
          M-F: 8:00am - 9:00pm
        </li>
      </ul>
    </div>
    <div class="cs-bottom-bar">
      <a href="" class="cs-logo cs-mobile" aria-label="back to home">
        <div class="cs-logo-wrapper">
          <!--Default Logo-->
          <img
            class="cs-default"
            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Logos/construction-logo.svg"
            alt="logo"
            width="210"
            height="29"
            aria-hidden="true"
            decoding="async"
          />
          <!--Dark Mode Logo-->
          <img
            class="cs-dark"
            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Logos/construction-logo-white2.svg"
            alt="logo"
            width="210"
            height="29"
            aria-hidden="true"
            decoding="async"
          />
        </div>
      </a>
      <!--Navigation List-->
      <nav class="cs-nav" role="navigation">
        <!--Mobile Nav Toggle-->
        <button class="cs-toggle" aria-label="mobile menu toggle">
          <div class="cs-box" aria-hidden="true">
            <span class="cs-line cs-line1" aria-hidden="true"></span>
            <span class="cs-line cs-line2" aria-hidden="true"></span>
            <span class="cs-line cs-line3" aria-hidden="true"></span>
          </div>
        </button>
        <!-- We need a wrapper div so we can set a fixed height on the cs-ul in case the nav list gets too long from too many dropdowns being opened and needs to have an overflow scroll. This wrapper acts as the background so it can go the full height of the screen and not cut off any overflowing nav items while the cs-ul stops short of the bottom of the screen, which keeps all nav items in view no matter how mnay there are-->
        <div class="cs-ul-wrapper">
          <ul id="cs-expanded" class="cs-ul" aria-expanded="false">
            <li class="cs-li">
              <a href="" class="cs-li-link cs-active"> Home </a>
            </li>
            <li class="cs-li">
              <a href="" class="cs-li-link"> About </a>
            </li>
            <li class="cs-li">
              <a href="" class="cs-li-link"> Services </a>
            </li>
            <li class="cs-li">
              <a href="" class="cs-li-link"> Asthetics </a>
            </li>
            <li class="cs-li">
              <a href="" class="cs-li-link"> FAQ </a>
            </li>
          </ul>
        </div>
      </nav>
      <a class="cs-nav-button cs-tablet" href="">
        <picture class="cs-wrapper">
          <img
            class="cs-icon"
            loading="lazy"
            decoding="async"
            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/red-phone1.svg"
            alt="icon"
            width="24"
            height="24"
          />
        </picture>
        <div class="cs-info">
          <span class="cs-header">Free Contact 24/7</span>
          <span class="cs-link-content">(604) 555-0234</span>
        </div>
      </a>
      <a href="" class="cs-button-border">
        Get In Touch
        <img
          class="cs-icon"
          loading="lazy"
          decoding="async"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/up-right-arrow.svg"
          alt="icon"
          width="20"
          height="20"
        />
      </a>
      <!--Dark Mode toggle, uncomment button code if you want to enable a dark mode toggle-->
      <button id="dark-mode-toggle" aria-label="dark mode toggle">
        <svg
          class="cs-moon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 480 480"
          style="enable-background:new 0 0 480 480"
          xml:space="preserve"
          ><path
            d="M459.782 347.328c-4.288-5.28-11.488-7.232-17.824-4.96-17.76 6.368-37.024 9.632-57.312 9.632-97.056 0-176-78.976-176-176 0-58.4 28.832-112.768 77.12-145.472 5.472-3.712 8.096-10.4 6.624-16.832S285.638 2.4 279.078 1.44C271.59.352 264.134 0 256.646 0c-132.352 0-240 107.648-240 240s107.648 240 240 240c84 0 160.416-42.688 204.352-114.176 3.552-5.792 3.04-13.184-1.216-18.496z"
          ></path></svg
        >
        <img
          class="cs-sun"
          aria-hidden="true"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Icons%2Fsun.svg"
          decoding="async"
          alt="moon"
          width="15"
          height="15"
        />
      </button>
    </div>
  </div>
  <div class="cs-contact-wrapper">
    <a class="cs-desktop-button" href="">
      <picture class="cs-wrapper">
        <img
          class="cs-button-icon"
          loading="lazy"
          decoding="async"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/red-phone1.svg"
          alt="icon"
          width="24"
          height="24"
        />
      </picture>
      <div class="cs-info">
        <span class="cs-header">Free Contact 24/7</span>
        <span class="cs-link-content">(604) 555-0234</span>
      </div>
    </a>
  </div>
</header>

<style lang="scss">
  /*-- -------------------------- -->
<---      Dark Mode Toggle      -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    body.dark-mode {
      #dark-mode-toggle {
        .cs-sun {
          transform: translate(-50%, -50%);
          opacity: 1;
        }

        .cs-moon {
          transform: translate(-50%, -150%);
          opacity: 0;
          fill: #fff;
        }
      }
    }

    #dark-mode-toggle {
      display: block;
      position: absolute;
      top: calc(0 / 16 * 1rem);
      right: calc(16 / 16 * 1rem);
      width: calc(48 / 16 * 1rem);
      height: calc(48 / 16 * 1rem);
      background: transparent;
      border: none;
      overflow: hidden;
      padding: 0;
      z-index: 1000;
      transition:
        top 0.3s,
        right 0.3s;

      img,
      svg {
        //center image inside button
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: calc(20 / 16 * 1rem);
        height: calc(20 / 16 * 1rem);
        pointer-events: none;
      }

      .cs-moon {
        z-index: 2;
        // Transition properties
        transition:
          transform 0.3s,
          opacity 0.3s;

        // fill: yellow; --> uncomment to change the color of the moon if needed
      }

      .cs-sun {
        z-index: 1;
        // Transition property
        transform: translate(-50%, 100%);
        opacity: 0;
        transition:
          transform 0.3s,
          opacity 0.3s;
      }
    }
  }

  /* Tablet - 650px - 1024px */
  @media only screen and (min-width: 40.625rem) and (max-width: 1299.5px) {
    #dark-mode-toggle {
      top: auto;
      right: auto;
      position: relative;
      order: 3;
    }
  }

  /* Desktop - 1024px */
  @media only screen and (min-width: 1024px) {
    #dark-mode-toggle {
      margin: 0;
      position: relative;
      transform: none;
      bottom: auto;
      right: auto;

      &:hover {
        cursor: pointer;
      }
    }
  }

  /*-- -------------------------- -->
<---     Mobile Navigation      -->
<--- -------------------------- -*/

  /* Mobile - 1023px */
  @media only screen and (max-width: 1299.5px) {
    body {
      &.cs-open {
        overflow: hidden;
      }
    }

    #cs-navigation {
      width: 100%;
      padding: calc(12 / 16 * 1rem) calc(16 / 16 * 1rem) 0 calc(16 / 16 * 1rem);
      /* prevents padding from affecting height and width */
      box-sizing: border-box;
      background-color: #fff;
      box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
      position: fixed;
      z-index: 100;
      transition: transform 0.3s;

      &.cs-active {
        .cs-link {
          color: var(--bodyTextColorWhite);
        }

        .cs-ul-wrapper {
          opacity: 1;
          transform: scaleY(1);
          transition-delay: 0.1s;
        }

        .cs-li {
          transform: translateY(0);
          opacity: 1;
        }
      }

      &.scroll {
        transform: translateY(-3rem);

        #dark-mode-toggle {
          top: calc(68 / 16 * 1rem);
          right: calc(78 / 16 * 1rem);
        }
      }

      .cs-location {
        margin: 0;
        padding: 0;
        position: relative;
        transition:
          height 0.3s,
          padding-bottom 0.3s,
          opacity 0.3s;
        z-index: -3;
      }

      .cs-top-social {
        display: none;
      }

      .cs-top-bar {
        padding-bottom: calc(12 / 16 * 1rem);
        position: relative;
        z-index: 1;

        &:before {
          /* grey line */
          content: "";
          width: 100vw;
          height: 1px;
          background: #eff1f0;
          opacity: 1;
          position: absolute;
          display: block;
          bottom: 0;
          left: 50%;
          z-index: -2;
          transform: translateX(-50%);
          transition: opacity 0.3s;
        }
      }

      .cs-bottom-bar {
        height: auto;
        padding: calc(20 / 16 * 1rem) 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .cs-logo {
        height: calc(40 / 16 * 1rem);
        width: auto;
        display: block;

        img {
          height: 100%;
          width: auto;
        }
      }

      .cs-logo-wrapper {
        width: auto;
        height: 100%;
        position: relative;
        z-index: 1;
        perspective: 700px;
        transform-style: preserve-3d;
      }

      .cs-default {
        -webkit-backface-visibility: hidden; /* Safari */
        backface-visibility: hidden;
        transition:
          opacity 0.3s,
          transform 0.6s;
      }

      .cs-dark {
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;
        opacity: 0;
        -webkit-backface-visibility: hidden; /* Safari */
        backface-visibility: hidden;
        transform: rotateX(180deg);
        transition:
          opacity 0.3s,
          transform 0.6s;
      }

      .cs-desktop {
        display: none;
      }

      .cs-item {
        font-size: calc(16 / 16 * 1rem);
        line-height: calc(24 / 16 * 1rem);
        list-style: none;
        margin: 0;
        color: #585b5d;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: calc(4 / 16 * 1rem);
      }

      .cs-remove {
        display: none;
      }

      .cs-icon {
        width: calc(20 / 16 * 1rem);
        height: auto;
        display: block;
      }

      .cs-header {
        display: none;
      }

      .cs-link {
        font-size: calc(14 / 16 * 1rem);
        line-height: 1.5em;
        text-align: inherit;
        text-decoration: none;
        margin: 0;
        color: var(--bodyTextColor);
        display: block;
        transition: color 0.3s;
      }

      .cs-toggle {
        width: calc(48 / 16 * 1rem);
        height: calc(48 / 16 * 1rem);
        margin: 0;
        background-color: #f3f3f3;
        border: none;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .cs-active {
        .cs-line1 {
          top: 50%;
          transform: translate(-50%, -50%) rotate(225deg);
        }

        .cs-line2 {
          top: 50%;
          transform-origin: center;
          transform: translate(-50%, -50%) translateY(0) rotate(-225deg);
        }

        .cs-line3 {
          bottom: 100%;
          opacity: 0;
        }
      }

      .cs-box {
        width: calc(20 / 16 * 1rem);
        height: calc(12 / 16 * 1rem);
        position: relative;
      }

      .cs-line {
        width: 100%;
        height: 2px;
        border-radius: 2px;
        background-color: #585b5d;
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
      }

      .cs-line1 {
        top: 0;
        transform-origin: center;
        transition:
          transform 0.5s,
          top 0.3s,
          left 0.3s;
        animation-duration: 0.7s;
        animation-timing-function: ease;
        animation-fill-mode: forwards;
        animation-direction: normal;
      }

      .cs-line2 {
        top: 50%;
        transform: translateX(-50%) translateY(-50%);
        transition:
          top 0.3s,
          left 0.3s,
          transform 0.5s;
        animation-duration: 0.7s;
        animation-timing-function: ease;
        animation-fill-mode: forwards;
        animation-direction: normal;
      }

      .cs-line3 {
        width: calc(12 / 16 * 1rem);
        bottom: 0;
        left: 0;
        transform: none;
        transition:
          bottom 0.3s,
          opacity 0.3s;
      }

      .cs-contact-wrapper,
      .cs-tablet,
      .cs-button-border {
        display: none;
      }
    }
  }

  /* Tablet - 650px - 1024px */
  @media only screen and (min-width: 40.625rem) and (max-width: 1299.5px) {
    #cs-navigation {
      .cs-location {
        display: flex;
        justify-content: flex-end;
        flex-direction: row;
      }

      .cs-top-bar {
        padding-bottom: calc(12 / 16 * 1rem);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .cs-logo {
        margin-right: auto;
        order: 1;
      }

      .cs-item {
        position: relative;

        &:nth-of-type(2) {
          &:after {
            display: none;
          }
        }

        &:after {
          /* divider line */
          content: "";
          width: 1px;
          height: 100%;
          margin: 0 calc(16 / 16 * 1rem);
          background: #cfd0d1;
          opacity: 1;
          position: relative;
          display: block;
        }
      }

      .cs-top-social {
        height: calc(32 / 16 * 1rem);
        visibility: visible;
        opacity: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: calc(8 / 16 * 1rem);
        transition:
          opacity 0.3s,
          visibility 0.3s,
          height 0.3s;
      }

      .cs-social-link {
        text-decoration: none;
        width: calc(32 / 16 * 1rem);
        height: calc(32 / 16 * 1rem);
        background-color: #f7f7f7;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .cs-social-icon {
        width: calc(12 / 16 * 1rem);
        height: auto;
        opacity: 0.6;
        display: block;
      }

      .cs-bottom-bar {
        gap: calc(16 / 16 * 1rem);
      }

      .cs-li-link {
        font-size: calc(24 / 16 * 1rem);
      }

      .cs-nav-button {
        text-decoration: none;
        margin-right: calc(32 / 16 * 1rem);
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: calc(16 / 16 * 1rem);
        order: 2;
        position: relative;
        perspective: 200px;
        transform-style: preserve-3d;

        &:hover {
          .cs-wrapper {
            transform: rotateY(180deg);
          }
        }

        .cs-wrapper {
          width: calc(40 / 16 * 1rem);
          height: calc(40 / 16 * 1rem);
          display: flex;
          justify-content: center;
          align-items: center;
          /* prevents flexbox from squishing it */
          flex: none;
          position: relative;
          z-index: 1;
          transition: transform 0.6s;

          &:before {
            /* backgorund color in pseudo so we can use the primary color variable and use opacity */
            content: "";
            width: 100%;
            height: 100%;
            background-color: #f3f3f3;
            position: absolute;
            display: block;
            top: 0;
            left: 0;
            z-index: -1;
          }
        }

        .cs-icon {
          width: calc(24 / 16 * 1rem);
          height: auto;
          display: block;
          transition: transform 0.3s;
        }

        .cs-info {
          display: flex;
          flex-direction: column;
          align-items: flex-start;
        }

        .cs-header {
          font-size: calc(14 / 16 * 1rem);
          line-height: 1.5em;
          margin: 0;
          color: #585b5d;
          display: block;
        }

        .cs-link-content {
          font-size: calc(16 / 16 * 1rem);
          line-height: 1.5em;
          font-weight: 700;
          margin: 0;
          color: var(--headerColor);
          display: block;
        }
      }

      .cs-nav {
        order: 4;
      }
    }
  }

  /* Inbetween - 1024px */
  @media only screen and (min-width: 1024px) {
    #cs-navigation {
      .cs-bottom-bar {
        justify-content: flex-start;
        padding: 0;
      }

      .cs-remove {
        display: flex;
      }

      .cs-toggle {
        display: none;
      }

      .cs-nav {
        order: 2;
      }

      .cs-ul {
        width: 100%;
        margin: 0;
        padding: 0;
        display: flex;
        justify-content: flex-start;
        align-items: center;
        /* 20px - 36px */
        gap: clamp(1.25rem, 2.6vw, 2.25rem);
      }

      .cs-li {
        list-style: none;
        /* 24px - 28px */
        padding: clamp(1.5rem, 2.1vw, 1.75rem) 0;
        /* prevent flexbox from squishing it */
        flex: none;
        &:last-of-type {
          /* pushes the button to the far roght */
          margin-left: auto;
          padding: 0;
        }
      }

      .cs-li-link {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.5em;
        text-transform: uppercase;
        text-decoration: none;
        margin: 0;
        color: var(--headerColor);
        display: block;
        position: relative;
        transition: color 0.3s;

        &.cs-active,
        &:hover {
          color: var(--primary);
        }
      }

      .cs-nav-button {
        display: none;
      }
    }
  }

  /*-- -------------------------- -->
<---   Mobile Navigation Menu   -->
<--- -------------------------- -*/

  /* Small Desktop - 1024px */
  @media only screen and (max-width: 1023.5px) {
    #cs-navigation {
      .cs-ul-wrapper {
        width: 100%;
        opacity: 0;
        background-color: #fff;
        box-shadow: inset rgba(0, 0, 0, 0.2) 0px 8px 24px;
        overflow: hidden;
        position: absolute;
        top: 100%;
        left: 0;
        z-index: -1;
        transform: scaleY(0);
        transform-origin: top;
        transition:
          transform 0.4s,
          opacity 0.3s;
      }

      .cs-ul {
        margin: 0;
        padding: calc(48 / 16 * 1rem) 0 calc(48 / 16 * 1rem) 0;
        width: 100%;
        height: auto;
        max-height: 65vh;
        overflow: scroll;
        display: flex;
        justify-content: flex-start;
        flex-direction: column;
        align-items: center;
        gap: calc(20 / 16 * 1rem);
      }

      .cs-li {
        text-align: center;
        list-style: none;
        width: 100%;
        margin-right: 0;
        /* transition from these values */
        transform: translateY(-4.375rem);
        opacity: 0;
        transition:
          transform 0.6s,
          opacity 0.9s;

        &:nth-of-type(1) {
          transition-delay: 0.05s;
        }
        &:nth-of-type(2) {
          transition-delay: 0.1s;
        }
        &:nth-of-type(3) {
          transition-delay: 0.15s;
        }
        &:nth-of-type(4) {
          transition-delay: 0.2s;
        }
        &:nth-of-type(5) {
          transition-delay: 0.25s;
        }
        &:nth-of-type(6) {
          transition-delay: 0.3s;
        }
        &:nth-of-type(7) {
          transition-delay: 0.35s;
        }
        &:nth-of-type(8) {
          transition-delay: 0.4s;
        }
        &:nth-of-type(9) {
          transition-delay: 0.45s;
        }
      }

      .cs-li-link {
        /* 16px - 24px */
        font-size: clamp(1rem, 2.5vw, 1.5rem);
        text-transform: uppercase;
        line-height: 1.2em;
        text-decoration: none;
        margin: 0;
        color: var(--headerColor);
        display: inline-block;
        position: relative;

        &.cs-active {
          color: var(--primary);
        }
      }
    }
  }

  /*-- -------------------------- -->
<---     Desktop Navigation     -->
<--- -------------------------- -*/

  /* Small Desktop - 1024px */
  @media only screen and (min-width: 1300px) {
    #cs-navigation {
      /* 136px tall */
      --headerHeight: 8.5rem;

      width: 100%;
      padding: 0;
      /* prevents padding from affecting height and width */
      box-sizing: border-box;
      background-color: #fff;
      box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
      display: flex;
      position: fixed;
      z-index: 10000;
      transition:
        height 0.3s,
        background-color 0.3s;

      &.scroll {
        .cs-top-bar {
          height: 0;
          opacity: 0;
          overflow: hidden;
          &:before {
            width: 0;
          }
        }

        .cs-middle {
          height: calc(80 / 16 * 1rem);
        }

        .cs-logo,
        .cs-contact-wrapper {
          height: calc(80 / 16 * 1rem);
        }

        .cs-logo {
          img {
            max-height: calc(80 / 16 * 1rem);
          }
        }

        .cs-toggle {
          margin-top: 0;
        }
      }

      .cs-toggle {
        display: none;
      }

      .cs-logo {
        width: 20%;
        max-width: calc(340 / 16 * 1rem);
        height: var(--headerHeight);
        border-right: 1px solid #e7e7e8;
        padding: calc(16 / 16 * 1rem);
        /* prevents padding from affecting height and width */
        box-sizing: border-box;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 100;
        transition: height 0.3s;

        img {
          width: 80%;
          max-width: calc(260 / 16 * 1rem);
          height: auto;
          max-height: calc(120 / 16 * 1rem);
          box-sizing: border-box;
          /* ensures the image never overflows the container. It stays contained within it's width and height and expands to fill it then stops once it reaches an edge */
          object-fit: contain;
          transition:
            max-height 0.3s,
            opacity 0.3s,
            transform 0.6s;
        }
      }

      .cs-logo-wrapper {
        width: auto;
        height: auto;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        z-index: 1;
        perspective: 700px;
        transform-style: preserve-3d;
      }

      .cs-default {
        -webkit-backface-visibility: hidden; /* Safari */
        backface-visibility: hidden;
      }

      .cs-dark {
        position: absolute;
        top: 0;
        left: 50%;
        z-index: -1;
        opacity: 0;
        -webkit-backface-visibility: hidden; /* Safari */
        backface-visibility: hidden;
        transform: rotateX(180deg) translateX(-50%);
      }

      .cs-mobile {
        display: none;
      }

      .cs-top-bar {
        width: 100%;
        height: calc(56 / 16 * 1rem);
        margin: 0;
        padding: 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        transition:
          height 0.3s,
          opacity 0.3s,
          transform 0.3s;

        &:before {
          /* grey line */
          content: "";
          height: 1px;
          background: #e7e7e8;
          opacity: 1;
          position: absolute;
          display: block;
          bottom: 0;
          left: calc(-40 / 16 * 1rem);
          right: calc(-40 / 16 * 1rem);
          z-index: -2;
          transition: width 0.3s;
        }
      }

      .cs-top-social {
        height: calc(32 / 16 * 1rem);
        visibility: visible;
        opacity: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: calc(8 / 16 * 1rem);
        transition:
          opacity 0.3s,
          visibility 0.3s,
          height 0.3s;
      }

      .cs-social-link {
        text-decoration: none;
        width: calc(32 / 16 * 1rem);
        height: calc(32 / 16 * 1rem);
        background-color: #f7f7f7;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: background-color 0.3s;

        &:hover {
          background-color: var(--primary);
        }
      }

      .cs-social-icon {
        width: calc(12 / 16 * 1rem);
        height: auto;
        opacity: 0.6;
        display: block;
      }

      .cs-location {
        display: flex;
        flex-direction: row;
      }

      .cs-item {
        list-style: none;
        margin: 0;
        display: flex;
        align-items: center;
        flex: none;
        justify-content: flex-start;
        gap: calc(4 / 16 * 1rem);
        position: relative;
        &:last-of-type {
          &:after {
            display: none;
          }
        }

        &:hover {
          .cs-picture {
            transform: scale(1.1);
          }
        }

        &:after {
          /* divider line */
          content: "";
          width: 1px;
          height: 100%;
          /* 24px - 44px */
          margin: 0 calc(24 / 16 * 1rem);
          background: #eff1f0;
          opacity: 1;
          position: relative;
          display: block;
        }
      }

      .cs-link {
        font-size: calc(14 / 16 * 1rem);
        line-height: 1.5em;
        text-align: inherit;
        text-decoration: none;
        margin: 0;
        color: var(--bodyTextColor);
        display: block;
        transition: color 0.3s;
        &:hover {
          text-decoration: underline;
        }
      }

      .cs-middle {
        width: 100%;
        height: var(--headerHeight);
        padding: 0 calc(40 / 16 * 1rem) 0 calc(40 / 16 * 1rem);
        transition: height 0.3s;
      }

      .cs-nav {
        order: -1;
      }

      .cs-bottom-bar {
        width: 100%;
        /* prevents padding from affecting height and width */
        box-sizing: border-box;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: calc(32 / 16 * 1rem);
      }

      .cs-desktop-button {
        text-decoration: none;
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: calc(16 / 16 * 1rem);
        order: 2;
        position: relative;
        perspective: 200px;
        transform-style: preserve-3d;

        &:hover {
          .cs-wrapper {
            transform: rotateY(360deg);
          }
        }
      }

      .cs-wrapper {
        width: calc(56 / 16 * 1rem);
        height: calc(56 / 16 * 1rem);
        display: flex;
        justify-content: center;
        align-items: center;
        /* prevents flexbox from squishing it */
        flex: none;
        position: relative;
        z-index: 1;
        transition: transform 0.6s;

        &:before {
          /* backgorund color in pseudo so we can use the primary color variable and use opacity */
          content: "";
          width: 100%;
          height: 100%;
          background-color: #f3f3f3;
          position: absolute;
          display: block;
          top: 0;
          left: 0;
          z-index: -1;
        }
      }

      .cs-button-icon {
        width: calc(20 / 16 * 1rem);
        height: auto;
        display: block;
        transition: transform 0.3s;
      }

      .cs-info {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }

      .cs-header {
        font-size: calc(14 / 16 * 1rem);
        line-height: 1.5em;
        margin: 0;
        color: #585b5d;
        display: block;
      }

      .cs-link-content {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.5em;
        font-weight: 700;
        margin: 0;
        color: var(--headerColor);
        display: block;
      }

      .cs-nav-button,
      .cs-button-border {
        display: none;
      }

      .cs-contact-wrapper {
        width: 18%;
        max-width: calc(294 / 16 * 1rem);
        height: var(--headerHeight);
        border-left: 1px solid #e7e7e8;
        display: flex;
        justify-content: center;
        align-items: center;
        flex: none;
        transition: height 0.3s;
      }
    }
  }

  /* Small Desktop - 1500px */
  @media only screen and (min-width: 1500px) {
    #cs-navigation {
      .cs-nav {
        margin-right: auto;
      }

      .cs-button-border {
        font-size: calc(16 / 16 * 1rem);
        line-height: calc(46 / 16 * 1rem);
        text-decoration: none;
        text-transform: uppercase;
        padding: 0 calc(28 / 16 * 1rem);
        color: var(--headerColor);
        border: 1px solid var(--headerColor);
        display: flex;
        justify-content: center;
        align-items: center;
        gap: calc(10 / 16 * 1rem);
        transition:
          color 0.3s,
          background-color 0.3s;

        &:hover {
          background-color: var(--headerColor);
          color: #fff;
          .cs-icon {
            filter: grayscale(1) brightness(1000%);
          }
        }

        .cs-icon {
          width: calc(20 / 16 * 1rem);
        }
      }
    }
  }
</style>

<script>
  // add classes for mobile navigation toggling
  var CSbody = document.querySelector("body");
  const CSnavbarMenu = document.querySelector("#cs-navigation");
  const CShamburgerMenu = document.querySelector("#cs-navigation .cs-toggle");

  CShamburgerMenu.addEventListener("click", function () {
    CShamburgerMenu.classList.toggle("cs-active");
    CSnavbarMenu.classList.toggle("cs-active");
    CSbody.classList.toggle("cs-open");
    // run the function to check the aria-expanded value
    ariaExpanded();
  });

  // checks the value of aria expanded on the cs-ul and changes it accordingly whether it is expanded or not
  function ariaExpanded() {
    const csUL = document.querySelector("#cs-expanded");
    const csExpanded = csUL.getAttribute("aria-expanded");

    if (csExpanded === "false") {
      csUL.setAttribute("aria-expanded", "true");
    } else {
      csUL.setAttribute("aria-expanded", "false");
    }
  }

  // mobile nav toggle code
  const dropDowns = Array.from(
    document.querySelectorAll("#cs-navigation .cs-dropdown")
  );
  for (const item of dropDowns) {
    const onClick = () => {
      item.classList.toggle("cs-active");
    };
    item.addEventListener("click", onClick);
  }

  // after scrolling down 100px, add .scroll class to the #cs-navigation
  document.addEventListener("scroll", (e) => {
    const scroll = document.documentElement.scrollTop;
    if (scroll >= 100) {
      document.querySelector("#cs-navigation").classList.add("scroll");
    } else {
      document.querySelector("#cs-navigation").classList.remove("scroll");
    }
  });
</script>
