<style lang="scss">
  /*-- -------------------------- -->
<---           Blog             -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #blog-1702 {
      overflow: hidden;
      position: relative;
      z-index: 1;

      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
      }

      .cs-news {
        /* changes to 740px on tablet */
        max-width: calc(500 / 16 * 1rem);
        margin: auto;
        padding: var(--sectionPadding);
        display: flex;
        flex-direction: column;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to center if content needs to be centrally aligned */
        text-align: left;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* aligns content to the left, set to center to centrally align */
        align-items: flex-start;
      }

      .cs-title {
        margin: 0;
      }

      .cs-card-group {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: calc(40 / 16 * 1rem);
      }

      .cs-item {
        display: flex;
        flex-direction: column;
        /* 20px - 32px */
        gap: clamp(1.25rem, 3vw, 2rem);
      }

      .cs-picture {
        width: auto;
        height: calc(183 / 16 * 1rem);
        display: block;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
      }

      .cs-item-text {
        flex: 1 0 0;
      }

      .cs-h3 {
        font-size: calc(20 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        text-overflow: ellipsis;
        margin: 0;
        margin-bottom: calc(16 / 16 * 1rem);
        color: var(--headerColor);
        display: -webkit-box;
        overflow: hidden;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
      }

      .cs-desc {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.5em;
        text-overflow: ellipsis;
        margin: 0;
        color: var(--bodyTextColor);
        display: -webkit-box;
        overflow: hidden;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
      }

      .cs-link {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        text-align: inherit;
        text-decoration: none;
        margin-top: calc(24 / 16 * 1rem);
        color: var(--primary);
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: calc(10 / 16 * 1rem);
        transition: color 0.3s;

        &:hover {
          .cs-arrow {
            transform: translateX(0.25rem);
          }
        }
      }

      .cs-link-text {
        width: fit-content;
        display: block;
      }

      .cs-arrow {
        width: calc(20 / 16 * 1rem);
        height: auto;
        display: block;
        transition:
          filter 0.3s,
          transform 0.3s;
      }

      .cs-background {
        width: 100%;
        height: calc(360 / 16 * 1rem);
        display: block;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #blog-1702 {
      padding: var(--sectionPadding);

      .cs-container {
        padding: 0;
        justify-content: flex-start;
      }

      .cs-title {
        margin: 0;
      }

      .cs-news {
        width: 60vw;
        max-width: calc(740 / 16 * 1rem);
        margin: 0;
        padding: 0;
      }

      .cs-card-group {
        /* 16px - 32px */
        gap: clamp(1rem, 3vw, 2rem);
      }

      .cs-item {
        flex-direction: row;
      }

      .cs-picture {
        width: calc(180 / 16 * 1rem);
        height: calc(180 / 16 * 1rem);
      }

      .cs-background {
        width: 30%;
        height: 100%;
        position: absolute;
        top: 0;
        bottom: 0;
        right: 0;
      }
    }
  }

  /* Large Desktop - 1300px */
  @media only screen and (min-width: 81.25rem) {
    #blog-1702 {
      .cs-background {
        width: 50vw;
        left: 50%;
        right: auto;
        margin-left: calc(220 / 16 * 1rem);
      }
    }
  }
</style>
