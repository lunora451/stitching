<style lang="scss">
  /*-- -------------------------- -->
<---           Blog             -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #blog-2200 {
      padding: var(--sectionPadding);
      background-color: #fbf5f1;
      overflow: hidden;
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-title {
        max-width: 25ch;
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        row-gap: calc(16 / 16 * 1rem);
      }

      .cs-item {
        text-align: left;
        list-style: none;
        overflow: hidden;
        grid-column: span 12;
        position: relative;
        z-index: 1;
        transition:
          box-shadow 0.3s,
          transform 0.3s;

        &:hover {
          .cs-h3 {
            color: var(--primary);
          }

          .cs-picture {
            img {
              transform: scale(1.1);
            }
          }
        }
      }

      .cs-picture {
        width: 100%;
        /* 220px - 320px */
        height: clamp(13.75rem, 27.5vw, 20rem);
        overflow: hidden;
        display: block;
        position: relative;
        z-index: 1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
          transition: transform 0.3s;
        }
      }

      .cs-large {
        /* 280px - 400px */
        height: clamp(17.5rem, 35vw, 25rem);
      }

      .cs-flex {
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
        padding: calc(16 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: calc(12 / 16 * 1rem);
        position: relative;
        z-index: 2;
      }

      .cs-info-wrapper {
        display: flex;
        flex-direction: column;
        gap: calc(4 / 16 * 1rem);
      }

      .cs-category {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        margin: 0;
        color: var(--headerColor);
        display: flex;
        align-items: center;
        gap: calc(8 / 16 * 1rem);

        &::before {
          content: "";
          /* 16px - 32px */
          width: clamp(1rem, 2vw, 2rem);
          height: 2px;
          background: var(--primary);
          opacity: 1;
          display: block;
          position: relative;
        }
      }

      .cs-date-wrapper {
        display: flex;
        flex-direction: row;
        gap: calc(8 / 16 * 1rem);
      }

      .cs-date,
      .cs-comments {
        /* 14px - 16px */
        font-size: clamp(0.875rem, 1.5vw, 1rem);
        font-weight: 400;
        line-height: 1.5em;
        margin: 0;
        color: var(--bodyTextColor);
        display: flex;
        align-items: center;
        gap: calc(10 / 16 * 1rem);

        &::before {
          content: "";
          width: calc(4 / 16 * 1rem);
          height: calc(4 / 16 * 1rem);
          background: #bababa;
          border-radius: 50%;
        }
      }

      .cs-link {
        text-decoration: none;
        display: flex;
      }

      .cs-h3 {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 2.5vw, 1.5625rem);
        font-weight: 700;
        line-height: 1.2em;
        text-align: inherit;
        margin: 0;
        color: var(--headerColor);
        transition: color 0.3s;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #blog-2200 {
      .cs-card-group {
        /* 16px - 20px */
        column-gap: clamp(1rem, 2vw, 1.25rem);
      }

      .cs-item {
        grid-column: span 4;
      }
    }
  }

  /* Large Desktop - 1300x */
  @media only screen and (min-width: 81.25rem) {
    #blog-2200 {
      .cs-info-wrapper {
        flex-direction: row;
      }
    }
  }
</style>
