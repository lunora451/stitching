<style lang="scss">
  /*-- -------------------------- -->
<---            Blog            -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #blog-2390 {
      padding: var(--sectionPadding);
      position: relative;
      z-index: 1;
      overflow: hidden;

      &:before {
        /* backgorund color */
        content: "";
        width: 100%;
        height: 100%;
        background: var(--primary);
        opacity: 0.05;
        position: absolute;
        display: block;
        top: 0;
        left: 0;
        z-index: -1;
      }

      .cs-container {
        width: 100%;
        /* changes to 1280px at large desktop */
        max-width: calc(640 / 16 * 1rem);
        margin: auto;
        /* 32px - 64px top & bottom */
        /* 16px - 64px left & right */
        padding: clamp(2rem, 4vw, 3.75rem) clamp(1rem, 4vw, 3.75rem);
        box-sizing: border-box;
        background-color: #fff;
        border-radius: calc(16 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
        position: relative;
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-title {
        /* max width of 18 characters, incldues spaces between words */
        max-width: 27ch;
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: grid;
        justify-items: center;
        grid-template-columns: repeat(12, 1fr);
        gap: calc(20 / 16 * 1rem);
      }

      .cs-item {
        text-align: left;
        list-style: none;
        /* 16px - 20px */
        padding: clamp(1rem, 3vw, 1.25rem);
        box-sizing: border-box;
        background-color: #fff;
        border-radius: calc(16 / 16 * 1rem);
        grid-column: span 12;
        position: relative;
        z-index: 1;
        overflow: hidden;
        position: relative;
        z-index: 1;
        transition: border-color 0.3s;

        &:before {
          /* backgorund color */
          content: "";
          width: 100%;
          height: 100%;
          background: var(--primary);
          opacity: 0.05;
          position: absolute;
          display: block;
          top: 0;
          left: 0;
          z-index: -1;
        }

        &:hover {
          .cs-picture {
            img {
              transform: scale(1.3);
              opacity: 0.3;
            }
          }
        }
      }

      .cs-link {
        text-decoration: none;
        font-weight: 400;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: calc(16 / 16 * 1rem);
        position: relative;
        z-index: 1;
      }

      .cs-picture {
        width: 100%;
        height: calc(242 / 16 * 1rem);
        background-color: #000;
        border-radius: calc(16 / 16 * 1rem);
        display: block;
        /* sends it to the top */
        order: -1;
        /* prevents flexbox from squsihing it */
        flex: none;
        position: relative;
        z-index: 1;
        overflow: hidden;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
          transition:
            transform 0.6s,
            opacity 0.3s;
        }
      }

      .cs-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: calc(24 / 16 * 1rem);
      }

      .cs-tag {
        font-size: calc(14 / 16 * 1rem);
        font-weight: 700;
        text-align: center;
        width: fit-content;
        margin-right: 0;
        padding: calc(4 / 16 * 1rem) calc(16 / 16 * 1rem);
        color: var(--bodyTextColor);
        border-radius: calc(100 / 16 * 1rem);
        display: block;
        position: relative;
        overflow: hidden;

        &::before {
          content: "";
          width: 100%;
          height: 100%;
          background: var(--primary);
          opacity: 0.2;
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      .cs-date {
        font-size: calc(14 / 16 * 1rem);
        line-height: 1.5em;
        margin: 0;
        color: var(--bodyTextColor);
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: calc(8 / 16 * 1rem);
      }

      .cs-info {
        display: flex;
        flex-direction: column;
      }

      .cs-item-text {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.5em;
        font-weight: 400;
        margin: 0;
        color: var(--bodyTextColor);
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: calc(8 / 16 * 1rem);
      }

      .cs-h3 {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 2vw, 1.5625rem);
        font-weight: 700;
        line-height: 1.2em;
        text-align: inherit;
        /* 16px - 32px */
        margin: 0 0 clamp(1rem, 5vw, 3rem) 0;
        padding-bottom: calc(24 / 16 * 1rem);
        border-bottom: 1px solid #d2d8df;
        color: var(--headerColor);
        transition: color 0.3s;
      }
    }
  }

  /* Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #blog-2390 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
      }

      .cs-picture {
        order: initial;
      }

      .cs-item {
        grid-column: span 4;
      }

      .cs-info,
      .cs-link {
        height: 100%;
      }

      .cs-item-text {
        margin-top: auto;
      }
    }
  }
</style>
