<style lang="scss">
  /*-- -------------------------- -->
<---           Blog             -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #blog-2351 {
      padding: var(--sectionPadding);
      overflow: hidden;
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        /* changes to 1800px at tablet */
        max-width: calc(584 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-title {
        max-width: 25ch;
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        row-gap: calc(24 / 16 * 1rem);
      }

      .cs-item {
        text-align: left;
        list-style: none;
        overflow: hidden;
        grid-column: span 12;
        position: relative;
        z-index: 1;
        transition:
          box-shadow 0.3s,
          transform 0.3s;

        &:hover {
          .cs-h3 {
            color: var(--primary);
          }

          .cs-picture {
            img {
              opacity: 0.3;
              transform: scale(1.1);
            }
          }
        }
      }

      .cs-link {
        text-decoration: none;
      }

      .cs-picture {
        width: 100%;
        height: 90vw;
        max-height: calc(400 / 16 * 1rem);
        margin-bottom: calc(16 / 16 * 1rem);
        background-color: #000;
        overflow: hidden;
        display: block;
        position: relative;
        z-index: 1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
          transition:
            transform 0.3s,
            opacity 0.3s;
        }
      }

      .cs-flex {
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: calc(12 / 16 * 1rem);
        position: relative;
        z-index: 2;
      }

      .cs-info-wrapper {
        display: flex;
        gap: calc(8 / 16 * 1rem);
      }

      .cs-date,
      .cs-category {
        /* 14px - 16px */
        font-size: clamp(0.875rem, 1.5vw, 1rem);
        font-weight: 400;
        line-height: 1.5em;
        margin: 0;
        color: var(--bodyTextColor);
        display: flex;
        align-items: center;
        gap: calc(8 / 16 * 1rem);
      }

      .cs-category {
        &:after {
          content: "";
          width: 1px;
          height: 100%;
          background: #a3a3a3;
          opacity: 1;
          display: block;
        }
      }

      .cs-h3 {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 2.5vw, 1.5625rem);
        font-weight: 700;
        line-height: 1.2em;
        text-align: inherit;
        margin: 0;
        color: var(--headerColor);
        transition: color 0.3s;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #blog-2351 {
      .cs-container {
        max-width: calc(1800 / 16 * 1rem);
      }

      .cs-content {
        width: 100%;
        text-align: left;
        flex-direction: row;
        align-items: flex-end;
        justify-content: space-between;
        gap: calc(64 / 16 * 1rem);
      }

      .cs-title {
        margin-bottom: 0;
      }

      .cs-text {
        width: 50%;
        max-width: calc(700 / 16 * 1rem);
      }

      .cs-card-group {
        /* 16px - 20px */
        column-gap: clamp(1rem, 2vw, 1.25rem);
        row-gap: calc(20 / 16 * 1rem);
      }

      .cs-item {
        grid-column: span 6;
      }

      .cs-picture {
        height: 34vw;
      }
    }
  }

  /* Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #blog-2351 {
      .cs-item {
        grid-column: span 3;

        &:nth-of-type(even) {
          .cs-picture {
            /* 380px - 520px */
            height: clamp(23.75rem, 45vw, 32.5rem);
          }
        }
      }

      .cs-picture {
        /* 280px - 400px */
        height: clamp(17.5rem, 27vw, 25rem);
        max-height: none;
      }
    }
  }
</style>
