  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #blog-2084 {
      padding: var(--sectionPadding);
      overflow: hidden;
      position: relative;
      z-index: 1;

      &:before {
        content: "";
        width: 100%;
        height: 100%;
        background-color: var(--primary);
        opacity: 0.05;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;
      }

      .cs-container {
        width: 100%;
        /* changes to 1280px at tablet */
        max-width: calc(704 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        /* 16px - 20px */
        gap: clamp(1rem, 2vw, 1.25rem);
      }

      .cs-item {
        text-align: left;
        list-style: none;
        /* 16px - 24px left & right */
        padding: calc(24 / 16 * 1rem) clamp(1rem, 2vw, 1.5rem);
        background-color: #fff;
        overflow: hidden;
        border-radius: calc(16 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        align-items: center;
        grid-column: span 12;
        gap: calc(24 / 16 * 1rem);
        position: relative;
        z-index: 1;

        &:hover {
          .cs-h3 {
            color: var(--primary);
          }

          .cs-picture {
            img {
              transform: scale(1.1);
            }
          }
        }
      }

      .cs-flex {
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        position: relative;
      }

      .cs-info-wrapper {
        padding-bottom: calc(12 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        gap: calc(4 / 16 * 1rem);
      }

      .cs-comments,
      .cs-date {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 400;
        line-height: 1.5em;
        margin: 0;
        color: var(--bodyTextColor);
        display: flex;
        align-items: center;
        gap: calc(4 / 16 * 1rem);
      }

      .cs-icon {
        width: calc(20 / 16 * 1rem);
        height: auto;
      }

      .cs-link {
        text-decoration: none;
        padding-bottom: calc(24 / 16 * 1rem);
      }

      .cs-h3 {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 2.5vw, 1.5625rem);
        font-weight: 700;
        line-height: 1.2em;
        text-align: inherit;
        margin: 0;
        color: var(--headerColor);
        transition: color 0.3s;
      }

      .cs-picture {
        width: 100%;
        /* 240px - 320px */
        min-height: clamp(15rem, 30vw, 20rem);
        overflow: hidden;
        border-radius: calc(16 / 16 * 1rem);
        display: block;
        position: relative;
        z-index: 1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
          transition: transform 0.3s;
        }
      }

      .cs-category {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 400;
        line-height: 1.5em;
        text-align: center;
        margin: 0;
        box-sizing: border-box;
        padding: calc(8 / 16 * 1rem) calc(16 / 16 * 1rem);
        background-color: var(--primary);
        color: #fff;
        border-radius: calc(8 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        position: absolute;
        bottom: calc(-16 / 16 * 1rem);
        left: calc(24 / 16 * 1rem);
        z-index: 2;
      }

      .cs-flex-bottom {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        gap: calc(24 / 16 * 1rem);
        position: relative;
      }

      .cs-item-text {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 400;
        line-height: 1.5em;
        margin: 0;
        color: var(--bodyTextColor);
