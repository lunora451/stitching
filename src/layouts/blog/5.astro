<style lang="scss">
  /*-- -------------------------- -->
<---           Events           -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #blog-1743 {
      padding: var(--sectionPadding);
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        /* changes to 1280px at tablet */
        max-width: calc(784 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-title {
        /* max width of 18 characters, includes spaces between words */
        max-width: 23ch;
        margin: 0;
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: grid;
        justify-items: center;
        grid-template-columns: repeat(12, 1fr);
        /* 16px - 20px */
        gap: clamp(1rem, 1.5vw, 1.25rem);
      }

      .cs-item {
        text-align: left;
        list-style: none;
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        grid-column: span 12;
        position: relative;
        z-index: 1;
        transition:
          box-shadow 0.3s,
          border-color 0.3s;

        &:hover {
          .cs-picture {
            img {
              opacity: 0.3;
              transform: scale(1.1);
            }
          }

          .cs-h3 {
            color: var(--primary);
          }
        }
      }

      .cs-picture {
        width: 100%;
        /* changes to 100% at desktop */
        height: calc(260 / 16 * 1rem);
        background-color: #1a1a1a;
        overflow: hidden;
        display: block;
        position: relative;
        z-index: 1;
        /* prevents flexbox from squishing it */
        flex: none;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
          transition:
            transform 0.6s,
            opacity 0.3s;
        }
      }

      .cs-info {
        width: 100%;
        height: 100%;
        /* 24px - 40px top */
        /* 16px - 24px sides */
        padding: clamp(1.5rem, 6vw, 2.5rem) clamp(1rem, 4vw, 1.5rem) 0;
        background-color: #f7f7f7;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        position: relative;
        z-index: 2;
      }

      .cs-date {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 2vw, 1.5625rem);
        font-weight: 700;
        line-height: 1.2em;
        text-align: center;
        margin: 0;
        padding: calc(12 / 16 * 1rem) calc(16 / 16 * 1rem);
        background-color: var(--primary);
        color: #fff;
        position: absolute;
        top: 0;
        left: calc(24 / 16 * 1rem);
        z-index: 2;
      }

      .cs-time {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        text-transform: uppercase;
        letter-spacing: 1.6px;
        margin-bottom: calc(4 / 16 * 1rem);
        color: var(--bodyTextColor);
      }

      .cs-h3 {
        /* 25px - 31px */
        font-size: clamp(1.5625rem, 2vw, 1.9375rem);
        font-weight: 700;
        line-height: 1.2em;
        margin: 0 0 calc(24 / 16 * 1rem) 0;
        color: var(--headerColor);
        transition: color 0.3s;
      }

      .cs-link {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        text-decoration: none;
        margin: 0 0 auto;
        color: var(--headerColor);
        display: flex;
        justify-content: center;
        align-items: center;

        &:hover {
          .cs-arrow {
            transform: translateX(0.25rem);
          }
        }
      }

      .cs-arrow {
        width: calc(20 / 16 * 1rem);
        height: auto;
        filter: brightness(0);
        transition: transform 0.3s;
      }

      .cs-comments {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        text-align: center;
        width: 100%;
        margin: calc(24 / 16 * 1rem) 0 0;
        padding: calc(16 / 16 * 1rem) 0;
        color: var(--bodyTextColor);
        border-top: 1px solid #dadada;
        display: flex;
        align-items: center;
        gap: calc(4 / 16 * 1rem);
      }
    }
  }

  /* Tablet - 600px */
  @media only screen and (min-width: 37.5rem) {
    #blog-1743 {
      .cs-item {
        min-height: calc(320 / 16 * 1rem);
        flex-direction: row;
      }

      .cs-picture {
        max-width: calc(303 / 16 * 1rem);
        height: 100%;
      }
    }
  }

  /* Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #blog-1743 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
      }

      .cs-item {
        grid-column: span 6;
      }

      .cs-picture {
        width: 45%;
      }
    }
  }
</style>
