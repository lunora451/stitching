        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        position: absolute;
        bottom: 0;
        right: 0;
        z-index: 10;

        &:before {
          /* background-color */
          content: "";
          width: 100%;
          height: 100%;
          background: #1a1a1a;
          opacity: 0.8;
          position: absolute;
          display: block;
          top: 0;
          left: 0;
          z-index: -1;
