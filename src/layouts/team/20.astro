<style lang="scss">
  /*-- -------------------------- -->
<---       Meet The Team        -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    @keyframes floatAnimation {
      0% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-2rem);
      }
      100% {
        transform: translateY(0);
      }
    }

    @keyframes floatAnimation2 {
      0% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-3rem);
      }
      100% {
        transform: translateY(0);
      }
    }

    #meet-team-1367 {
      padding: var(--sectionPadding);
      position: relative;
      z-index: 1;
      overflow: hidden;

      .cs-container {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: grid;
        justify-items: center;
        align-items: stretch;
        grid-template-columns: repeat(12, 1fr);
        /* 16px - 20px */
        gap: clamp(1rem, 2vw, 1.25rem);
      }

      .cs-item {
        list-style: none;
        width: 100%;
        max-width: calc(413 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        grid-column: span 12;

        &:hover {
          .cs-link {
            opacity: 1;
            transform: translateY(0);
          }

          .cs-info {
            color: #fff;
            background-color: var(--secondary);
          }
        }
      }

      .cs-picture-wrapper {
        /* 12px - 20px */
        margin-bottom: clamp(0.75rem, 4vw, 1.25rem);
        position: relative;
      }

      .cs-picture {
        margin: 0 auto;
        border-radius: 50%;
        display: block;
        position: relative;
        z-index: 1;
        overflow: hidden;
        aspect-ratio: 1/1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      .cs-info {
        text-align: center;
        /* 16px - 24px */
        padding: clamp(1rem, 1.7vw, 1.5rem);
        background-color: #f7f7f7;
        border-radius: calc(24 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        justify-content: center;
        /* makes the info boxes grow when the items aren't matching heights */
        flex-grow: 1;
        transition: background-color 0.3s;
      }

      .cs-name {
        font-size: calc(20 / 16 * 1rem);
        font-weight: bold;
        margin: 0;
        margin: 0 0 calc(4 / 16 * 1rem);
        gap: calc(16 / 16 * 1rem);
        transition: color 0.3s;
      }

      .cs-job {
        transition: color 0.3s;
      }

      .cs-social {
        display: flex;
        gap: calc(8 / 16 * 1rem);
        position: absolute;
        right: 50%;
        bottom: calc(24 / 16 * 1rem);
        z-index: 1;
        transform: translateX(50%);
      }

      .cs-link {
        width: calc(40 / 16 * 1rem);
        height: calc(40 / 16 * 1rem);
        background-color: #fff;
        opacity: 0;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        transform: translateY(1rem);
        transition:
          transform 0.3s,
          opacity 0.3s;

        &:hover {
          .cs-icon {
            /* use this pen to generate a filter from black to a color of your choosing */
            /* https://codepen.io/sosuke/pen/Pjoqqp */
            filter: invert(55%) sepia(42%) saturate(4845%) hue-rotate(337deg)
              brightness(101%) contrast(98%);
          }
        }

        &:first-of-type,
        &:last-of-type {
          margin-top: calc(-20 / 16 * 1rem);
        }

        &:nth-of-type(1) {
          transition-delay: 0.05s;
        }

        &:nth-of-type(2) {
          transition-delay: 0.1s;
        }

        &:nth-of-type(3) {
          transition-delay: 0.15s;
        }

        &:nth-of-type(4) {
          transition-delay: 0.2s;
        }
      }

      .cs-icon {
        width: calc(22 / 16 * 1rem);
        height: auto;
        display: block;
      }

      .cs-bubbles {
        width: calc(357 / 16 * 1rem);
        height: calc(470 / 16 * 1rem);
        display: none;
        position: absolute;
        top: calc(51 / 16 * 1rem);
        left: calc(-215 / 16 * 1rem);
        z-index: -1;

        &:before {
          /* white border bubble */
          content: "";
          width: calc(294 / 16 * 1rem);
          height: calc(294 / 16 * 1rem);
          background: transparent;
          opacity: 1;
          border: 1px solid #1a1a1a;
          border-radius: 50%;
          display: block;
          position: absolute;
          top: 0;
          right: 0;
          animation-name: floatAnimation;
          animation-duration: 5s;
          animation-timing-function: ease-in-out;
          animation-iteration-count: infinite;
          animation-fill-mode: forwards;
        }

        &:after {
          /* orange bubble */
          content: "";
          width: calc(294 / 16 * 1rem);
          height: calc(294 / 16 * 1rem);
          background: var(--secondary);
          opacity: 0.1;
          border-radius: 50%;
          display: block;
          position: absolute;
          bottom: 0;
          left: 0;
          z-index: -1;
          animation-name: floatAnimation2;
          animation-duration: 14s;
          animation-timing-function: ease-in-out;
          animation-iteration-count: infinite;
          animation-fill-mode: forwards;
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #meet-team-1367 {
      .cs-item {
        grid-column: span 4;
      }

      .cs-bubbles {
        display: block;
      }
    }
  }

  /* Large Desktop - 1300px */
  @media only screen and (min-width: 81.25rem) {
    #meet-team-1367 {
      .cs-bubbles {
        margin-left: calc(-1062 / 16 * 1rem);
        left: 50%;
      }
    }
  }
</style>
