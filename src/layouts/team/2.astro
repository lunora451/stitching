  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #meet-496 {
      text-align: center;
      padding: var(--sectionPadding);

      .cs-container {
        width: 100%;
        /* changes to 1280px at tablet */
        max-width: calc(550 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        /* 16px - 20px */
        gap: clamp(1rem, 1.8vw, 1.25rem);
      }

      .cs-item {
        list-style: none;
        width: 100%;
        max-width: calc(412 / 16 * 1em);
        height: auto;
        aspect-ratio: 328 / 272;
        position: relative;
        z-index: 1;
        &:hover {
          .cs-background {
            &:before {
              opacity: 0.7;
            }

            img {
              transform: scale(1.1);
            }
          }

          .cs-name,
          .cs-details {
            pointer-events: visible;
            opacity: 1;
            transform: translateY(0);
          }
        }
      }

      .cs-link {
        text-decoration: none;
        width: 100%;
        height: 100%;
        /* 24px - 48px top & bottom */
        /* 24px - 32px left & right */
        padding: clamp(1.5rem, 4vw, 3rem) clamp(1.5rem, 4vw, 2rem);
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-end;
        position: absolute;
        top: 0;
        left: 0;
      }

      .cs-name {
        font-size: calc(24 / 16 * 1em);
        text-align: left;
        line-height: 1.2em;
        font-weight: 700;
        /* 16px - 24px */
        margin: 0 0 clamp(1rem, 2vw, 1.5rem);
        color: var(--bodyTextColorWhite);
        opacity: 0;
        transform: translateY(calc(10 / 16 * 1rem));
        transition:
          opacity 0.3s,
          transform 0.3s;
      }

      .cs-details {
        font-size: calc(16 / 16 * 1em);
        line-height: 1.2em;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 700;
        opacity: 0;
        color: var(--secondary);
        display: flex;
        justify-content: center;
        align-items: center;
        justify-content: center;
        gap: calc(8 / 16 * 1em);
        position: relative;
        transform: translateY(calc(10 / 16 * 1rem));
        transition:
          opacity 0.3s,
          transform 0.6s;
        transition-delay: 0.1s;

        &:hover {
          &:before {
            width: 100%;
          }
        }

        &:before {
          content: "";
          width: 0%;
          height: 3px;
          background: var(--secondary);
          opacity: 1;
          position: absolute;
          display: block;
          bottom: calc(-3 / 16 * 1em);
          left: 0;
          transition: width 0.3s;
        }
      }

      .cs-background {
        width: 100%;
        height: 100%;
        overflow: hidden;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;

        &:before {
          content: "";
          width: 100%;
          height: 100%;
          background: var(--primary);
          opacity: 0;
          position: absolute;
          display: block;
          top: 0;
          left: 0;
          z-index: 10;
          transition: opacity 0.3s;
        }

        img {
          position: absolute;
          top: 0;
          left: 0;
          height: 100%;
          width: 100%;
          /* makes it act like a background image */
          object-fit: cover;
          /* pushes the top of the image to the top of the parent */
          object-position: top;
          transition: transform 0.6s;
        }
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1em);
        /* 46px - 56px */
        line-height: clamp(2.875em, 5.5vw, 3.5em);
        text-decoration: none;
        font-weight: 700;
        text-align: center;
        margin: 0;
        color: #fff;
        min-width: calc(150 / 16 * 1em);
        padding: 0 calc(24 / 16 * 1em);
        background-color: var(--primary);
        border-radius: calc(4 / 16 * 1em);
        display: inline-block;
        position: relative;
        z-index: 1;
        /* prevents padding from adding to the width */
        box-sizing: border-box;

        &:before {
          content: "";
          position: absolute;
          height: 100%;
          width: 0%;
          background: #000;
          opacity: 1;
          top: 0;
          left: 0;
          z-index: -1;
          border-radius: calc(4 / 16 * 1em);
          transition: width 0.3s;
        }

        &:hover {
          &:before {
            width: 100%;
          }
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #meet-496 {
      .cs-container {
        max-width: calc(1280 / 16 * 1em);
      }

      .cs-card-group {
        flex-wrap: wrap;
        flex-direction: row;
      }

      .cs-item {
        width: clamp(31.5%, 30vw, 38.3%);
        aspect-ratio: initial;
        /* 272px - 469px */
        height: clamp(17rem, 37vw, 29.3125rem);
      }
    }
  }
</style>
