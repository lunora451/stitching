<style lang="scss">
  /*-- -------------------------- -->
<---       Meet The Team        -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #meet-2337 {
      padding: var(--sectionPadding);
      overflow: hidden;
      position: relative;

      .cs-container {
        width: 100%;
        /* changes to 1280px at tablet */
        max-width: calc(584 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-title {
        max-width: 18ch;
        margin-bottom: 0;
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: calc(24 / 16 * 1rem);
      }

      .cs-item {
        text-align: center;
        list-style: none;
        width: 100%;
        margin: 0;
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
        padding-bottom: calc(24 / 16 * 1rem);
        border-bottom: 1px solid #e7e7e8;
        display: flex;
        gap: calc(24 / 16 * 1rem);
        grid-column: span 12;
        grid-row: span 1;
        position: relative;
        z-index: 1;
        transition: background-color 0.3s;

        &:before {
          content: "";
          width: 0%;
          height: 4px;
          background: var(--primary);
          opacity: 0;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          transition:
            width 0.3s,
            opacity 0.3s;
        }

        &:after {
          content: "";
          width: 0%;
          height: 4px;
          background: var(--primary);
          opacity: 0;
          display: block;
          position: absolute;
          bottom: 0;
          right: 0;
          transition:
            width 0.3s,
            opacity 0.3s;
        }

        &:hover {
          &:before,
          &:after {
            width: 100%;
            opacity: 1;
          }
        }
      }

      .cs-picture {
        width: 42%;
        max-width: calc(200 / 16 * 1rem);
        height: auto;
        /* 170px - 240px */
        min-height: clamp(10.625rem, 45vw, 15rem);
        display: block;
        flex: none;
        position: relative;
        z-index: 1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          /* makes sure the image is always cropped with the top of the image at the top of the picture element so no ones heads are cut off */
          object-position: top;
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      .cs-flex {
        text-align: left;
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: flex-start;
        /* 40px - 100px */
        gap: clamp(2.5rem, 6vw, 6.25rem);
      }

      .cs-icon {
        width: calc(20 / 16 * 1rem);
        height: auto;
      }

      .cs-header {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 2.5vw, 1.5625rem);
        font-weight: bold;
        line-height: 1.2em;
        text-align: inherit;
        margin: 0 0 calc(4 / 16 * 1rem) 0;
        color: var(--headerColor);
      }

      .cs-job {
        /* 14px - 16px */
        font-size: clamp(0.875rem, 1.5vw, 1rem);
        line-height: 1.5em;
        max-width: calc(450 / 16 * 1rem);
        margin: 0 0 calc(48 / 16 * 1rem);
        padding: 0;
        color: var(--bodyTextColor);
        display: block;
      }

      .cs-social-group {
        display: flex;
        flex-direction: column;
        gap: calc(4 / 16 * 1rem);
      }

      .cs-social {
        font-size: calc(16 / 16 * 1rem);
        text-decoration: none;
        color: #585b5d;
        padding-right: calc(16 / 16 * 1rem);
        display: flex;
        align-items: center;
        position: relative;
        z-index: 1;

        &:before {
          /* background color */
          content: "";
          width: 100%;
          height: 100%;
          background: var(--primary);
          opacity: 0.05;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition:
            opacity 0.3s,
            background-color 0.3s;
        }
      }

      .cs-wrapper {
        width: calc(36 / 16 * 1rem);
        height: calc(36 / 16 * 1rem);
        margin-right: calc(16 / 16 * 1rem);
        border-right: 1px solid #fcebe9;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
      }

      .cs-icon {
        width: calc(20 / 16 * 1rem);
        height: auto;
        display: block;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #meet-2337 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
      }

      .cs-content {
        text-align: left;
        align-items: flex-start;
      }

      .cs-card-group {
        overflow: hidden;
        gap: calc(20 / 16 * 1rem);
        position: relative;
        z-index: 1;
      }

      .cs-item {
        padding-top: calc(24 / 16 * 1rem);
        grid-column: span 6;
        position: relative;
        z-index: 1;

        &:hover {
          .cs-link {
            transform: translateY(0);
          }

          .cs-item-text {
            opacity: 1;
            visibility: visible;
          }

          .cs-icon-wrapper {
            transform: scale(0);
          }
        }
      }

      .cs-social {
        &:hover {
          color: #fff;
          &:before {
            opacity: 1;
            background-color: #1a1a1a;
          }

          .cs-icon {
            filter: invert(1) brightness(1000%);
          }
        }
      }
    }
  }

  /* Desktop - 1300px */
  @media only screen and (min-width: 64rem) {
    #meet-2337 {
      .cs-item {
        grid-column: span 4;
      }
    }
  }
</style>
