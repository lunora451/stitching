<style lang="scss">
  /*-- -------------------------- -->
<---       Meet The Team        -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #meet-team-1284 {
      padding: var(--sectionPadding);

      .cs-container {
        /* changes to 1280px at tablet */
        max-width: calc(550 / 16 * 1rem);
        width: 100%;
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: flex-start;
        /* set text align to left if content needs to be left aligned */
        text-align: left;
      }

      .cs-flex-group {
        display: flex;
        flex-direction: column;
      }

      .cs-text {
        max-width: calc(522 / 16 * 1rem);
      }

      .cs-picture {
        width: calc(80 / 16 * 1rem);
        height: calc(80 / 16 * 1rem);
        margin-bottom: calc(16 / 16 * 1rem);
        border-radius: 50%;
        display: block;
        position: relative;
        /* clips the corners off the image tag */
        overflow: hidden;

        img {
          width: 100%;
          height: 100%;
          /* Makes image behave like a background image */
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
          transition: transform 0.7s;
        }
      }

      .cs-card-group {
        margin: 0;
        padding: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: calc(20 / 16 * 1rem);
      }

      .cs-item {
        list-style: none;
        /* Changes on tablet */
        width: 100%;
        /* prevents padding from adding to height and width */
        box-sizing: border-box;
        /* 16px - 20px */
        padding: clamp(1rem, 2vw, 1.25rem) 0;
        background: #f1f1f4;
        border-radius: calc(8 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;

        &:hover {
          .cs-picture {
            img {
              transform: scale(1.1);
            }
          }
        }
      }

      .cs-name {
        font-size: calc(20 / 16 * 1rem);
        line-height: 1.2em;
        font-weight: 700;
        margin-bottom: calc(8 / 16 * 1rem);
        color: var(--headerColor);
        display: block;
      }

      .cs-job-title {
        font-size: calc(16 / 16 * 1rem);
        margin-bottom: calc(12 / 16 * 1rem);
        color: var(--bodyTextColor);
        display: block;
      }

      .cs-social {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: calc(20 / 16 * 1rem);
      }

      .cs-link {
        width: calc(32 / 16 * 1rem);
        height: calc(32 / 16 * 1rem);
        /* After making the a tag into a box, we center the image inside of it */
        border-radius: calc(4 / 16 * 1rem);
        display: flex;
        justify-content: center;
        align-items: center;
        /* creates the 3D space for the 3D effect when spinning */
        transform-style: preserve-3d;
        perspective: 700px;

        &:hover {
          .cs-icon {
            transform: translateY(calc(-5 / 16 * 1rem)) rotateY(360deg);
          }
        }
      }

      .cs-icon {
        width: calc(14 / 16 * 1rem);
        height: auto;
        transition: transform 0.7s;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #meet-team-1284 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
      }

      .cs-topper {
        width: 100%;
      }

      .cs-content {
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-start;
        column-gap: calc(20 / 16 * 1rem);
      }

      .cs-title {
        margin-bottom: 0;
      }

      .cs-text {
        width: 50%;
      }

      .cs-card-group {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        justify-items: stretch;
      }
    }
  }

  /* Large Desktop - 1300px */
  @media only screen and (min-width: 81.25rem) {
    #meet-team-1284 {
      .cs-card-group {
        grid-template-columns: repeat(4, 1fr);
      }
    }
  }
</style>
