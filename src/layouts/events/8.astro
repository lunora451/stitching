<style lang="scss">
  /*-- -------------------------- -->
<---           Events           -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #events-2423 {
      padding: var(--sectionPadding);
      overflow: hidden;
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
        max-width: calc(784 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
        z-index: 1;
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-title {
        max-width: 23ch;
      }

      .cs-text {
        max-width: calc(900 / 16 * 1rem);
      }

      .cs-button-solid {
        //responsive gradient button color adapts to unique branding color changes
        --gradientmix: color-mix(in lab, var(--primary), black 49%);

        font-size: calc(16 / 16 * 1rem);
        line-height: clamp(calc(46 / 16 * 1rem), 5.5vw, calc(56 / 16 * 1rem));
        text-decoration: none;
        font-weight: 700;
        text-align: center;
        color: #fff;
        white-space: nowrap;
        margin: 0;
        min-width: calc(150 / 16 * 1rem);
        padding: 0 calc(28 / 16 * 1rem);
        background-color: var(--primary);
        background-image: -moz-linear-gradient(
          top,
          rgba(0, 0, 0, 0) 0%,
          var(--gradientmix) 99%
        );
        background-image: -webkit-linear-gradient(
          top,
          rgba(0, 0, 0, 0) 0%,
          var(--gradientmix) 99%
        );
        background-image: linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0) 0%,
          var(--gradientmix) 99%
        );
        border-radius: calc(100 / 16 * 1rem);
        overflow: hidden;
        display: inline-block;
        position: relative;
        z-index: 1;

        &:before {
          content: "";
          width: 0%;
          height: 100%;
          border-radius: calc(4 / 16 * 1rem);
          background: var(--secondary);
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
          opacity: 1;
        }

        &:hover {
          &:before {
            width: 100%;
          }
        }
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: grid;
        justify-items: center;
        grid-template-columns: repeat(12, 1fr);
        /* 16px - 20px */
        gap: clamp(1rem, 1.5vw, 1.25rem);
      }

      .cs-item {
        text-align: left;
        list-style: none;
        width: 100%;
        border-radius: calc(24 / 16 * 1rem);
        background-color: #000;
        overflow: hidden;
        grid-column: span 12;
        position: relative;
        z-index: 1;
        transition:
          box-shadow 0.3s,
          border-color 0.3s;

        &:hover {
          .cs-picture {
            &:before {
              opacity: 0;
            }

            &:after {
              opacity: 1;
            }

            img {
              opacity: 0.4;
              transform: scale(1.2);
            }
          }

          .cs-month {
            background-color: var(--secondary);
          }
        }
      }

      .cs-link {
        text-decoration: none;
        height: 100%;
        padding: calc(24 / 16 * 1rem);
        padding-top: clamp(calc(246 / 16 * 1rem), 23vw, calc(328 / 16 * 1rem));
        /* prevents padding from affecting height and width */
        box-sizing: border-box;
        color: var(--bodyTextColorWhite);
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: flex-start;
        gap: calc(24 / 16 * 1rem);
        z-index: 2;
      }

      .cs-picture {
        width: 100%;
        height: 100%;
        overflow: hidden;
        object-fit: cover;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;
        /* prevents flexbox from squishing it */
        flex: none;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -2;
          transition:
            transform 0.6s,
            opacity 0.3s;
        }

        &::before {
          content: "";
          width: 100%;
          height: 100%;
          background:
            linear-gradient(
              180deg,
              rgba(0, 0, 0, 0) 44.07%,
              rgba(0, 0, 0, 0) 44.07%,
              #000 80.27%
            ),
            rgba(0, 0, 0, 0) 50% / cover no-repeat;
          position: absolute;
          bottom: 0;
          left: 0;
          z-index: -1;
          transition: opacity 0.3s;
        }

        &::after {
          content: "";
          width: 100%;
          height: 100%;
          background:
            linear-gradient(
              180deg,
              rgba(207, 128, 39, 0) 44.07%,
              rgba(207, 128, 39, 0) 44.07%,
              #cf8027 80.27%
            ),
            rgba(207, 128, 39, 0) 50% / cover no-repeat;
          opacity: 0;
          position: absolute;
          bottom: 0;
          left: 0;
          z-index: 2;
          transition: opacity 0.3s;
        }
      }

      .cs-flex {
        width: 100%;
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: flex-start;
        gap: calc(16 / 16 * 1rem);
      }

      .cs-h3 {
        font-size: calc(31 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        /* 3. any additional text beyond the 3 lines will be truncated and replaced with "..." */
        text-overflow: ellipsis;
        margin: 0;
        overflow: hidden;
      }

      .cs-calender {
        display: flex;
        flex-direction: column;
        background-color: #fff;
        font-weight: 400;
        font-size: calc(14 / 16 * 1rem);
        text-transform: uppercase;
        color: var(--bodyTextColor);
        justify-content: center;
        align-items: center;
        border-radius: calc(8 / 16 * 1rem);
      }

      .cs-month {
        background-color: var(--primary);
        color: #fff;
        padding: calc(2 / 16 * 1rem) calc(12 / 16 * 1rem);
        margin-bottom: calc(4 / 16 * 1rem);
        border-radius: calc(8 / 16 * 1rem) calc(8 / 16 * 1rem) 0 0;
        transition: background-color 0.3s;
      }

      .cs-date {
        font-size: calc(20 / 16 * 1rem);
        font-weight: 700;
      }

      .cs-day {
        padding-bottom: calc(4 / 16 * 1rem);
      }

      .cs-text-group {
        padding: calc(8 / 16 * 1rem) 0;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: calc(8 / 16 * 1rem);
      }

      .cs-time {
        font-size: calc(14 / 16 * 1rem);
        line-height: 1.5em;
        font-weight: 400;
        white-space: nowrap;
        display: flex;
        flex-direction: row;
        gap: calc(16 / 16 * 1rem);
      }

      .cs-time-text {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
      }

      .cs-info {
        display: flex;
        flex-direction: column;
      }

      .cs-text-large {
        font-size: calc(20 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        margin: 0 0 calc(4 / 16 * 1rem);
      }

      .cs-text-item {
        color: var(--bodyTextColorWhite);
        font-size: calc(14 / 16 * 1rem);
        font-weight: 400;
        line-height: 1.5em;
        margin: 0;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #events-2423 {
      .cs-info {
        width: 100%;
      }

      .cs-text-group {
        flex-direction: row;
        justify-content: space-between;
      }

      .cs-time {
        order: 3;
        flex-direction: column;
        justify-content: flex-start;
        align-items: flex-end;
        gap: 0;
      }

      .cs-picture {
        &::before {
          height: 70%;
          background:
            linear-gradient(
              180deg,
              rgba(0, 0, 0, 0) 20%,
              rgba(0, 0, 0, 0.6) 30%,
              #000 85%
            ),
            rgba(0, 0, 0, 0) 50% / cover no-repeat;
        }
      }
    }
  }

  /* Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #events-2423 {
      .cs-flex-group {
        flex-direction: row;
      }

      .cs-item {
        width: 100%;
        height: auto;
        grid-column: span 6;

        &:last-child {
          grid-column: span 12;
        }
      }
    }
  }

  /* Large Desktop - 1300px */
  @media only screen and (min-width: 81.25rem) {
    #events-2423 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
      }

      .cs-item {
        grid-column: span 4;

        &:last-child {
          grid-column: span 4;
        }
      }
    }
  }
</style>
