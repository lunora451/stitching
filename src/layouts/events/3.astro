<style lang="scss">
  /*-- -------------------------- -->
<---           Events           -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #events-1512 {
      padding: var(--sectionPadding);
      position: relative;
      z-index: 1;
      overflow: hidden;

      .cs-container {
        width: 100%;
        /* changes to 1280px at large desktop */
        max-width: calc(944 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
        position: relative;
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-title {
        /* max width of 18 characters, incldues spaces between words */
        max-width: 23ch;
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: grid;
        justify-items: center;
        grid-template-columns: repeat(12, 1fr);
        gap: calc(20 / 16 * 1rem);
      }

      .cs-item {
        text-align: left;
        list-style: none;
        /* 16px - 24px */
        padding: clamp(1rem, 3vw, 1.5rem);
        box-sizing: border-box;
        background-color: #fff;
        border: 1px solid #e8e8e8;
        border-radius: calc(40 / 16 * 1rem);
        grid-column: span 12;
        position: relative;
        z-index: 1;
        overflow: hidden;
        transition: border-color 0.3s;

        &:hover {
          border-color: var(--primary);
        }
      }

      .cs-link {
        text-decoration: none;
        font-weight: 400;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        z-index: 1;
      }

      .cs-picture-group {
        width: 100%;
        margin-bottom: calc(24 / 16 * 1rem);
        position: relative;
      }

      .cs-picture {
        width: 100%;
        min-height: calc(195 / 16 * 1rem);
        background-color: #1a1a1a;
        display: block;
        position: relative;
        z-index: 1;
        overflow: hidden;
        /* prevents flexbox from squsihing it */
        flex: none;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
          transition:
            transform 0.6s,
            opacity 0.3s;
        }
      }

      .cs-mask {
        --maskBG: #fff;
        --maskBorder: #e8e8e8;

        width: 101%;
        height: 101%;
        position: absolute;
        top: -1px;
        right: -1px;
        bottom: -1px;
        left: -1px;
        z-index: 1;
      }

      .cs-date {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.2em;
        text-align: inherit;
        margin: 0;
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
        padding: calc(4 / 16 * 1rem) calc(8 / 16 * 1rem);
        color: #1a1a1a;
        background-color: var(--primaryLight);
        border: 1px solid var(--primary);
        border-radius: calc(82 / 16 * 1rem);
        display: inline-block;
        position: absolute;
        /* 20px - 24px */
        bottom: clamp(1.25rem, 2vw, 1.5rem);
        /* 30px - 36px */
        left: clamp(1.875rem, 3vw, 2.25rem);
        z-index: 2;
      }

      .cs-tag {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        text-align: center;
        width: fit-content;
        margin-bottom: calc(12 / 16 * 1rem);
        padding: calc(8 / 16 * 1rem) calc(16 / 16 * 1rem);
        color: var(--secondary);
        border-radius: calc(100 / 16 * 1rem);
        display: block;
        position: relative;
        overflow: hidden;

        &::before {
          content: "";
          width: 100%;
          height: 100%;
          background: var(--secondary);
          opacity: 0.1;
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      .cs-details {
        /* 16px - 24px */
        margin: 0 0 clamp(1rem, 2vw, 1.5rem);
        display: flex;
        flex-direction: column;
        gap: calc(8 / 16 * 1rem);
      }

      .cs-time,
      .cs-location {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.5em;
        font-weight: 400;
        margin: 0;
        color: var(--bodyTextColor);
        display: flex;
        justify-content: flex-start;
        align-items: flex-start;
        gap: calc(8 / 16 * 1rem);
      }

      .cs-item-text {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.5em;
        font-weight: 400;
        margin: 0;
        color: var(--bodyTextColor);
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: calc(8 / 16 * 1rem);
      }

      .cs-icon {
        width: calc(24 / 16 * 1rem);
        height: auto;
      }

      .cs-h3 {
        font-size: calc(20 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        text-align: inherit;
        margin: 0 0 calc(8 / 16 * 1rem) 0;
        color: var(--headerColor);
        transition: color 0.3s;
      }

      .cs-link {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        text-decoration: none;
        margin-top: auto;
        color: var(--primary);
        display: flex;
        justify-content: center;
        align-items: center;

        &:hover {
          .cs-arrow {
            transform: translateX(0.25rem);
          }
        }
      }

      .cs-arrow {
        width: calc(20 / 16 * 1rem);
        height: auto;
        transition: transform 0.3s;
      }

      .cs-graphic {
        position: absolute;
        z-index: -1;
        transform: rotate(-150deg);
      }

      .cs-graphic-one {
        width: calc(507 / 16 * 1rem);
        height: auto;
        top: calc(-353 / 16 * 1rem);
        right: calc(-291 / 16 * 1rem);
      }

      .cs-graphic-two {
        width: calc(710 / 16 * 1rem);
        height: auto;
        bottom: calc(5 / 16 * 1rem);
        left: calc(-375 / 16 * 1rem);
      }
    }
  }

  /* Tablet - 600px */
  @media only screen and (min-width: 37.5rem) {
    #events-1512 {
      .cs-item {
        width: 100%;
      }

      .cs-link {
        flex-direction: row;
        align-items: flex-start;
        gap: calc(24 / 16 * 1rem);
      }

      .cs-picture-group {
        max-width: calc(360 / 16 * 1rem);
        max-height: calc(250 / 16 * 1rem);
        margin: 0;
        flex: 1 0 0;
      }

      .cs-picture {
        height: 100%;
      }

      .cs-info {
        flex: 1 0 0;
      }

      .cs-graphic-one {
        top: calc(-149 / 16 * 1rem);
      }
    }
  }

  /* Desktop - 1200px */
  @media only screen and (min-width: 75rem) {
    #events-1512 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
      }

      .cs-item {
        &:nth-of-type(1) {
          grid-column: 9 / span 4;
          grid-row: 1 / span 2;

          .cs-link {
            flex-direction: column;
          }
        }

        &:nth-of-type(2) {
          grid-column: 1 / span 8;
        }

        &:nth-of-type(3) {
          grid-column: 1 / span 8;
        }
      }

      .cs-graphic-one {
        width: calc(710 / 16 * 1rem);
        height: calc(690 / 16 * 1rem);
        right: calc(-563 / 16 * 1rem);
      }

      .cs-graphic-two {
        left: calc(-521 / 16 * 1rem);
      }
    }
  }
</style>
