<style lang="scss">
  /*-- -------------------------- -->
<---          Gallery           -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #gallery-2442 {
      padding: var(--sectionPadding);
      background-color: #040710;
      position: relative;

      .cs-container {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-title {
        max-width: 28ch;
        margin: 0;
        color: var(--bodyTextColorWhite);
      }

      .cs-image-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: flex-start;
        /* 8px - 20px */
        gap: clamp(0.5rem, 2vw, 1.25rem);
      }

      .cs-picture-wrapper {
        width: 100%;
        height: auto;

        &:hover {
          .cs-info {
            opacity: 1;
            bottom: calc(24 / 16 * 1rem);
          }
        }
      }

      .cs-picture {
        width: 100%;
        height: auto;
        display: block;
        position: relative;

        img {
          width: 100%;
          height: auto;
          object-fit: cover;
          display: block;
        }
      }

      .cs-info {
        /* padding is done in ems so the content doesn't get squished on smaller devices */
        padding: calc(24 / 16 * 1em) calc(32 / 16 * 1em);
        background-color: rgba(3, 7, 17, 0.3);
        opacity: 0;
        border: 1px solid #010104;
        position: absolute;
        /* by using right and left, the content stretches to fill the card, 24px short of the edges */
        right: calc(24 / 16 * 1rem);
        bottom: calc(-50 / 16 * 1rem);
        left: calc(24 / 16 * 1rem);
        transition:
          opacity 0.3s,
          bottom 0.3s;
        backdrop-filter: blur(11px);
      }

      .cs-border {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;

        &:before {
          content: "";
          opacity: 1;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
        }

        &:after {
          content: "";
          opacity: 1;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
        }
      }

      .cs-border1 {
        /* top left border */
        &:before {
          width: 100%;
          height: 1px;
          background: linear-gradient(
            to right,
            rgba(213, 50, 50, 1) 0%,
            rgba(0, 0, 0, 0) 78%
          );
        }

        &:after {
          width: 1px;
          height: 100%;
          background: linear-gradient(
            to bottom,
            rgba(213, 50, 50, 1) 0%,
            rgba(0, 0, 0, 0) 78%
          );
        }
      }

      .cs-border2 {
        &:before {
          width: 100%;
          height: 1px;
          background: linear-gradient(
            to right,
            rgba(0, 0, 0, 0) 22%,
            rgba(213, 50, 50, 1) 100%
          );
          top: auto;
          bottom: 0;
        }

        &:after {
          width: 1px;
          height: 100%;
          background: linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0) 22%,
            rgba(213, 50, 50, 1) 100%
          );
          right: 0;
          left: auto;
        }
      }

      .cs-h3 {
        font-size: calc(20 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        text-align: center;
        margin: 0;
        color: var(--bodyTextColorWhite);
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        /* 46px - 56px */
        line-height: clamp(2.875rem, 5.5vw, 3.5rem);
        text-align: center;
        text-decoration: none;
        min-width: calc(150 / 16 * 1rem);
        margin: 0;
        /* prevents padding from adding to the width */
        box-sizing: border-box;
        padding: 0 calc(24 / 16 * 1rem);
        background-color: var(--primary);
        color: #fff;
        border-radius: calc(4 / 16 * 1rem);
        display: inline-block;
        position: relative;
        z-index: 1;

        &:before {
          content: "";
          width: 0%;
          height: 100%;
          background: #000;
          opacity: 1;
          border-radius: calc(4 / 16 * 1rem);
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
        }

        &:hover {
          &:before {
            width: 100%;
          }
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #gallery-2442 {
      .cs-image-group {
        font-size: min(1.2vw, 1rem);
        width: calc(1280 / 16 * 1em);
        height: calc(2144 / 16 * 1em);
        position: relative;
      }

      /* we create the mosaic pattern by using position: absolute; on all picture-wrappers, and use font-size scaling to keep everything in arrangement */
      .cs-picture-wrapper {
        position: absolute;
      }

      .cs-picture-wrapper-1 {
        width: calc(413 / 16 * 1em);
        height: calc(770 / 16 * 1em);
        top: 0;
        left: 0;
      }

      .cs-picture-wrapper-2 {
        width: calc(434 / 16 * 1em);
        height: calc(478 / 16 * 1em);
        top: calc(100 / 16 * 1em);
        left: calc(477 / 16 * 1em);
      }

      .cs-picture-wrapper-3 {
        width: calc(305 / 16 * 1em);
        height: calc(478 / 16 * 1em);
        top: 0;
        right: 0;
      }

      .cs-picture-wrapper-4 {
        width: calc(630 / 16 * 1em);
        height: calc(668 / 16 * 1em);
        top: calc(834 / 16 * 1em);
        left: 0;
      }

      .cs-picture-wrapper-5 {
        width: calc(586 / 16 * 1em);
        height: calc(770 / 16 * 1em);
        top: calc(642 / 16 * 1em);
        right: 0;
      }

      .cs-picture-wrapper-6 {
        width: calc(305 / 16 * 1em);
        height: calc(578 / 16 * 1em);
        bottom: 0;
        left: 0;
      }

      .cs-picture-wrapper-7 {
        width: calc(434 / 16 * 1em);
        height: calc(318 / 16 * 1em);
        bottom: calc(192 / 16 * 1em);
        left: calc(369 / 16 * 1em);
      }

      .cs-picture-wrapper-8 {
        width: calc(413 / 16 * 1em);
        height: calc(668 / 16 * 1em);
        right: 0;
        bottom: 0;
      }

      .cs-picture {
        width: 100%;
        height: 100%;

        img {
          width: 100%;
          height: 100%;
        }
      }
    }
  }
</style>
