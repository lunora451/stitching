<style lang="scss">
  /*-- -------------------------- -->
<---          Gallery           -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #gallery-2297 {
      padding: var(--sectionPadding);
      background-color: #fef5f4;
      overflow: hidden;
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        position: relative;
        z-index: 1;
      }

      .cs-content {
        width: 100%;
        /* causes the items of cs-content to become children of the cs-container, allowing us to put the buttons below the gallery */
        display: contents;
      }

      .cs-title {
        margin: 0 0 calc(48 / 16 * 1rem);
      }

      .cs-button-group {
        margin: calc(32 / 16 * 1rem) auto 0;
        display: flex;
        order: 2;
        /* 20px - 40px */
        column-gap: clamp(1.25rem, 3.4vw, 2.5rem);
        row-gap: calc(16 / 16 * 1rem);
      }

      .cs-button {
        padding: calc(16 / 16 * 1rem);
        background-color: #f3f3f3;
        border: none;
        transition: background-color 0.3s;

        &:hover {
          background-color: var(--primary);
          cursor: pointer;

          .cs-arrow {
            filter: invert(1) brightness(1000%);
          }
        }
      }

      .cs-arrow {
        width: calc(20 / 16 * 1rem);
        height: calc(20 / 16 * 1rem);
        display: block;
      }

      .cs-gallery-wrapper {
        width: 100%;
        position: relative;
        z-index: 1;
      }

      .cs-gallery {
        width: 100%;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        /* 16px - 20px */
        gap: clamp(1rem, 1.5vw, 1.25rem);
        position: relative;
        transform-style: preserve-3d;
        perspective: 700px;
        transition:
          transform 0.7s,
          opacity 0.3s,
          visibility 0.5s,
          top 0.3s,
          left 0.3s;
        /* makes the transform scaling origin the top left corner, dictates the direction by which the scale transforms animate towards */
        transform-origin: left top;

        &.cs-hidden {
          /* prevents the mouse from interacting with it */
          pointer-events: none;
          /* hidden galleries have a 0 opacity, and we animate the opacity to 1 when they become active */
          opacity: 0;
          /* by using visibility:hidden instead of display:none, we can see the animations from the opacity and transforms, display:none won't render animations. */
          visibility: hidden;
          position: absolute;
          /* this top and left value help control the animation, by setting it to position absolute and left 0, the gallery won't fly off screen to the left, it will stop its position to be at the left edge of the .cs-container (left: 0). Same for the top:0 value, the gallery won't go past that posiiton when it animates */
          top: 0;
          left: 0;
          /* prevents the hidden galleries from overflowing the section, and makes a nice animations to transition to and from */
          transform: scaleY(0) scaleX(0);

          .cs-image {
            opacity: 0;
            /* when gallery is hidden, add these styles to the cs-image to animate from when cs-hidden is removed from the .cs-gallery */
            transform: translateY(2.1875rem) rotateX(90deg);
          }
        }
      }

      .cs-image {
        /* 320px - 524px */
        min-height: clamp(20rem, 35vw, 32.75rem);
        /* clips the image corners */
        overflow: hidden;
        opacity: 1;
        display: block;
        grid-column: span 12;
        position: relative;
        /* when .cs-hidden is removed from the .cs-gallery, reset these values and animate between their hidden styles */
        transform: translateY(0rem) rotateX(0);
        transition:
          opacity 0.6s,
          transform 0.6s;

        &:nth-of-type(1) {
          /* the transition delays change at desktop */
          /* these delays stagger the reveal of each image so they all go one after the other and not all at once */
          transition-delay: 0.1s;
        }

        &:nth-of-type(2) {
          transition-delay: 0.2s;
        }

        &:nth-of-type(3) {
          transition-delay: 0.3s;
        }
      }

      .cs-picture {
        width: 100%;
        height: 100%;
        background-color: #000;
        /* makes it act like a background image */
        object-fit: cover;
        position: absolute;
        top: 0;
        left: 0;

        img {
          width: 100%;
          height: 100%;
          /* makes it act like a background image */
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
          transition:
            transform 0.65s,
            opacity 0.3s;
        }
      }

      .cs-info {
        width: 90%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: calc(8 / 16 * 1rem);
        position: absolute;
        bottom: 0;
        left: 0;
        z-index: 10;
      }

      .cs-tag {
        /* 13px - 16px */
        font-size: clamp(0.8125rem, 2vw, 1rem);
        font-weight: 700;
        text-transform: uppercase;
        padding: calc(8 / 16 * 1rem) calc(20 / 16 * 1rem);
        background-color: var(--primary);
        color: var(--bodyTextColorWhite);
      }

      .cs-project {
        font-size: calc(20 / 16 * 1rem);
        font-weight: 700;
        text-transform: uppercase;
        padding: calc(12 / 16 * 1rem) calc(16 / 16 * 1rem);
        background-color: #fff;
        color: var(--headerColor);
      }

      .cs-stats {
        max-width: calc(1280 / 16 * 1rem);
        /* 48px - 120px */
        margin: clamp(3rem, 9vw, 7.5rem) auto 0;
        display: flex;
        flex-direction: column;
        /* 16px - 24px */
        column-gap: clamp(1rem, 3vw, 1.5rem);
        row-gap: calc(32 / 16 * 1rem);
      }

      .cs-stat {
        display: flex;
        flex-direction: column;
        column-gap: calc(20 / 16 * 1rem);
        row-gap: calc(8 / 16 * 1rem);
      }

      .cs-number {
        font-size: var(--headerFontSize);
        font-weight: 700;
        line-height: 1.2em;
        color: var(--primary);
      }

      .cs-desc {
        font-size: calc(20 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        color: var(--headerColor);
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #gallery-2297 {
      .cs-container {
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        text-align: left;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        gap: calc(24 / 16 * 1rem);
      }

      .cs-title {
        margin: 0;
      }

      .cs-button-group {
        margin: 0;
      }

      .cs-image {
        grid-column: span 4;
      }

      .cs-stats {
        flex-direction: row;
      }
      .cs-stat {
        flex: 1;
      }
    }
  }

  /* Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #gallery-2297 {
      .cs-content {
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-end;
        gap: calc(64 / 16 * 1rem);
      }

      .cs-image {
        &:hover {
          .cs-tag,
          .cs-project {
            opacity: 1;
            transform: translateX(0);
          }

          .cs-picture {
            img {
              opacity: 0.2;
              transform: scale(1.3);
            }
          }
        }
      }

      .cs-tag {
        opacity: 0;
        transform: translateX(-100%);
        transition:
          transform 0.3s ease-in-out,
          opacity 0.3s;
      }

      .cs-project {
        opacity: 0;
        transform: translateX(-100%);
        transition:
          transform 0.4s ease-out,
          opacity 0.3s;
        transition-delay: 0.1s;
      }
    }
  }

  /* Large Desktop - 1300px */
  @media only screen and (min-width: 81.25rem) {
    #gallery-2297 {
      .cs-stat {
        flex-direction: row;
        align-items: center;
      }
    }
  }
</style>
