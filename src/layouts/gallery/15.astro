<style lang="scss">
  /*-- -------------------------- -->
<---          Gallery           -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #gallery-570 {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      .cs-picture {
        width: 50%;
        height: auto;
        /* makes it square */
        aspect-ratio: 1;
        display: block;
        position: relative;

        img {
          position: absolute;
          top: 0;
          left: 0;
          height: 100%;
          width: 100%;
          object-fit: cover;
        }
      }
    }
  }

  /* Tablet - 650px */
  @media only screen and (min-width: 40.625rem) {
    #gallery-570 {
      flex-direction: row;

      .cs-picture {
        width: 20%;
      }
    }
  }
</style>
