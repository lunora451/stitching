<style lang="scss">
  /*-- -------------------------- -->
<---          Services          -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #gallery-2250 {
      padding: var(--sectionPadding);
      background-color: #fdfaf8;
      /* clips the svg wave from overflowing */
      overflow: hidden;
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        /* changes to 1840px at tablet */
        max-width: calc(704 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-title {
        max-width: 40ch;
      }

      .cs-card-group {
        width: 100%;
        /* changes to 100% at tablet */
        max-width: calc(500 / 16 * 1rem);
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        /* 16px - 20px */
        gap: clamp(1rem, 1.5vw, 1.25rem);
      }

      .cs-item {
        text-align: left;
        list-style: none;
        width: 100%;
        height: calc(280 / 16 * 1rem);
        margin: 0;
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
        padding: 0;
        /* clips the image corners */
        overflow: hidden;
        grid-column: span 12;
        grid-row: span 1;
        gap: calc(8 / 16 * 1rem);
        position: relative;

        &:hover,
        &:focus-within {
          .cs-h3 {
            transform: translateY(0);
          }

          .cs-fake-link {
            height: auto;
            opacity: 1;
            transform: translateY(0);
          }

          .cs-background {
            &:before {
              height: 180%;
            }
            img {
              opacity: 0.5;
              transform: scale(1.1);
            }
          }
        }
      }

      .cs-link {
        text-decoration: none;
        height: 100%;
        padding: calc(16 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: flex-start;
      }

      .cs-wrapper {
        width: 100%;
        overflow: hidden;
        color: var(--primary);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: calc(4 / 16 * 1rem);
      }

      .cs-header {
        /* 16px - 20px */
        font-size: clamp(1rem, 2vw, 1.25rem);
        font-weight: 700;
        line-height: 1.2em;
        text-align: inherit;
        margin: 0;
        color: var(--primary);
      }

      .cs-h3 {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 2vw, 2.4375rem);
        font-weight: 700;
        line-height: 1.2em;
        text-align: inherit;
        text-decoration: none;
        width: 100%;
        margin: 0;
        padding-right: calc(60 / 16 * 1rem);
        color: var(--bodyTextColorWhite);
        display: flex;
        justify-content: space-between;
        position: relative;
      }

      .cs-icon {
        /* 40px - 64px */
        width: clamp(2.5rem, 4vw, 4rem);
        height: auto;
        display: block;
        position: absolute;
        bottom: calc(0 / 16 * 1rem);
        right: calc(0 / 16 * 1rem);
        transition: transform 0.3s;
      }

      .cs-background {
        width: 100%;
        height: 100%;
        object-fit: cover;
        background-color: #000;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;

        &:before {
          /* gradient overlay */
          content: "";
          width: 100%;
          height: 100%;
          background: linear-gradient(
            0deg,
            rgba(0, 0, 0, 0.72) 14.59%,
            rgba(0, 0, 0, 0) 43.18%
          );
          opacity: 1;
          display: block;
          position: absolute;
          bottom: 0;
          left: 0;
          z-index: 10;
          transition: height 0.3s;
        }

        img {
          width: 100%;
          height: 100%;
          /* Makes img tag act as a background image */
          object-fit: cover;
          position: absolute;
          z-index: -1;
          transition:
            transform 0.6s,
            opacity 0.3s;
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #gallery-2250 {
      .cs-container {
        max-width: calc(1840 / 16 * 1rem);
      }

      .cs-card-group {
        max-width: 100%;
        /* 60px - 100px, same amount as the top value to offset it */
        margin-bottom: clamp(3.75rem, 6vw, 6.25rem);
        grid-template-rows: 1fr;
      }

      .cs-item {
        /* 280px - 440px */
        min-height: clamp(17.5rem, 35vw, 27.5rem);
        grid-column: span 4;

        &.cs-shift {
          position: relative;
          /* 60px - 100px */
          top: clamp(3.75rem, 6vw, 6.25rem);
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #gallery-2250 {
      .cs-item {
        &:hover,
        &:focus-within {
          .cs-wrapper {
            opacity: 1;
            transform: translateY(0);
          }

          .cs-background {
            &:before {
              height: 180%;
            }
            img {
              opacity: 0.5;
              transform: scale(1.1);
            }
          }
        }
      }
      .cs-wrapper {
        opacity: 0;
        transform: translateY(5rem);
        transition:
          transform 0.3s,
          opacity 0.3s;
      }
    }
  }
</style>
