<style lang="scss">
  /*-- -------------------------- -->
<---        Side By Side        -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #sbs-1982 {
      padding: var(--sectionPadding);
      overflow: hidden;
      position: relative;
      z-index: 1;

      &:before {
        content: "";
        width: 100%;
        height: 100%;
        background-color: var(--primary);
        opacity: 0.05;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;
      }

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
        max-width: calc(584 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: left;
        width: 100%;
        max-width: calc(570 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: flex-start;
      }

      .cs-text-large {
        font-size: calc(20 / 16 * 1rem);
        line-height: 1.5em;
        margin: 0 0 calc(12 / 16 * 1rem) 0;
        color: var(--headerColor);
      }

      .cs-text {
        margin-bottom: calc(32 / 16 * 1rem);
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        line-height: calc(56 / 16 * 1rem);
        text-decoration: none;
        margin: 0;
        /* 32px - 48px */
        padding: 0 clamp(2rem, 4vw, 3rem);
        background-color: var(--primary);
        overflow: hidden;
        color: #fff;
        border-radius: calc(8 / 16 * 1rem);
        display: inline-block;
        position: relative;
        z-index: 1;
        transition: color 0.3s;

        &:before {
          content: "";
          width: 0%;
          height: 100%;
          background: #1a1a1a;
          opacity: 1;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
        }

        &:hover {
          color: #fff;

          &:before {
            width: 100%;
          }
        }
      }

      .cs-ratings {
        width: 100%;
        margin: 0;
        margin-top: calc(64 / 16 * 1rem);
        padding: calc(32 / 16 * 1rem);
        border-radius: calc(16 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        gap: calc(24 / 16 * 1rem);
        position: relative;
        align-self: stretch;

        &:before {
          content: "";
          width: 100%;
          height: 100%;
          background-color: var(--primary);
          opacity: 0.1;
          border-radius: calc(16 / 16 * 1rem);
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
        }
      }

      .cs-stars {
        display: flex;
        flex-direction: row;
      }

      .cs-rating {
        display: flex;
        flex-direction: column;
        gap: calc(4 / 16 * 1rem);
      }

      .cs-h3 {
        font-size: calc(20 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        margin: 0;
        color: var(--headerColor);
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: calc(8 / 16 * 1rem);
      }

      .cs-rating-text {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.5em;
        text-align: inherit;
        width: 100%;
        margin: 0;
        color: var(--bodyTextColor);
      }

      .cs-icon {
        width: calc(82 / 16 * 1rem);
        height: calc(95 / 16 * 1rem);
        position: absolute;
        top: calc(-30 / 16 * 1rem);
        right: calc(20 / 16 * 1rem);
      }

      .cs-image-group {
        width: 100%;
        max-width: calc(630 / 16 * 1rem);
        /* Changes to auto at desktop */
        height: calc(480 / 16 * 1rem);
        /* clips the corners of the children around the border radius */
        overflow: hidden;
        border-radius: calc(16 / 16 * 1rem);
        order: -1;
        position: relative;
      }

      .cs-background {
        width: 100%;
        height: 100%;
        /* makes it cover the parent dimensions */
        object-fit: cover;
        display: block;

        img {
          width: 100%;
          height: 100%;
          /* makes it cover the parent like a backgorund image */
          object-fit: cover;
          display: block;
        }
      }

      .cs-box {
        text-align: left;
        width: 100%;
        max-width: calc(304 / 16 * 1rem);
        /* prevents padding from affecting height and width */
        box-sizing: border-box;
        padding: calc(32 / 16 * 1rem);
        background-color: #1a1a1a;
        /* 48px - 80px */
        border-radius: calc(8 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        position: absolute;
        /* 12px - 24px */
        right: clamp(0.75rem, 2.5vw, 1.5rem);
        /* 12px - 24px */
        bottom: clamp(0.75rem, 2.5vw, 1.5rem);
      }

      .cs-box-icon {
        width: calc(60 / 16 * 1rem);
        height: auto;
        display: block;
      }

      .cs-desc {
        /* 25px - 31px */
        font-size: clamp(1.5625rem, 3.125vw, 1.9375rem);
        font-weight: 700;
        line-height: 1.2em;
        text-align: inherit;
        width: 100%;
        margin: calc(16 / 16 * 1rem) 0 0 0;
        color: #fff;
      }

      .cs-box-text {
        font-size: calc(14 / 16 * 1rem);
        line-height: 1.5em;
        text-align: inherit;
        width: 100%;
        margin: calc(12 / 16 * 1rem) 0 0 0;
        color: #f7f7f7;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #sbs-1982 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        flex-direction: row;
        justify-content: space-between;
        align-items: stretch;
      }

      .cs-content {
        align-self: center;
      }

      .cs-image-group {
        height: auto;
        min-height: calc(680 / 16 * 1rem);
      }
    }
  }
</style>
