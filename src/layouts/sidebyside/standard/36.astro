<style lang="scss">
  /*-- -------------------------- -->
<---       Side By Side         -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #sbs-1470 {
      padding: var(--sectionPadding);

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
        max-width: calc(584 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: left;
        width: 100%;
        /* changes to 433px at desktop */
        max-width: calc(542 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: flex-start;
      }

      .cs-title {
        max-width: 20ch;
      }

      .cs-text {
        margin-bottom: calc(16 / 16 * 1rem);
        &:last-of-type {
          margin-bottom: calc(32 / 16 * 1rem);
        }
      }

      .cs-ul {
        width: 100%;
        margin: 0 0 calc(24 / 16 * 1rem) 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        column-gap: calc(40 / 16 * 1rem);
        row-gap: calc(16 / 16 * 1rem);
      }

      .cs-li {
        font-size: var(--bodyFontSize);
        font-weight: 700;
        line-height: 1.5em;
        list-style: none;
        width: 100%;
        color: var(--bodyTextColor);
        display: flex;
        justify-content: flex-start;
        /* push icon top the top so if the list item goes to two lines the icon stays at the top */
        align-items: flex-start;
        gap: calc(8 / 16 * 1rem);
      }

      .cs-icon {
        width: calc(24 / 16 * 1rem);
        height: auto;
        /* adds extra space between the icon and top of parent so it's more centered */
        margin-top: 1px;
        display: block;
      }

      .button-box {
        width: 100%;
        max-width: calc(630 / 16 * 1rem);
        margin-bottom: calc(32 / 16 * 1rem);
        display: flex;
        justify-content: flex-start;
        align-items: center;
        flex-wrap: wrap;
        gap: calc(24 / 16 * 1rem);
      }

      .cs-link {
        text-decoration: none;
        padding-right: calc(40 / 16 * 1rem);
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: calc(16 / 16 * 1rem);
        position: relative;

        &:hover {
          .cs-wrapper {
            transform: scale(1.2);
          }
        }
      }

      .cs-wrapper {
        width: calc(52 / 16 * 1rem);
        height: calc(52 / 16 * 1rem);
        border: 1px solid #e8e8e8;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: transform 0.3s;
        /* prevents flexbox from squishing it */
        flex: none;
      }

      .cs-img {
        width: calc(52 / 16 * 1rem);
        height: auto;
        /* prevents border from affecting height and width */
        box-sizing: border-box;
        border: 2px solid #bababa;
        border-radius: 50%;
      }

      .cs-icon {
        width: calc(24 / 16 * 1rem);
        height: auto;
        display: block;
      }

      .cs-info {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: calc(4 / 16 * 1rem);
      }

      .cs-header {
        font-size: calc(25 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        margin: 0;
        color: var(--headerColor);
        display: block;
      }

      .cs-phone {
        font-size: calc(20 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        margin: 0;
        color: var(--headerColor);
        display: block;
      }

      .cs-job {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        margin: 0;
        color: var(--secondary);
        display: block;
      }

      .cs-link-content {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 400;
        line-height: 1.2em;
        margin: 0;
        color: var(--bodyTextColor);
        display: block;
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        /* 46px - 56px */
        line-height: clamp(2.875rem, 5.5vw, 3.5rem);
        text-decoration: none;
        margin: 0;
        padding: 0 calc(48 / 16 * 1rem);
        background-color: var(--primary);
        overflow: hidden;
        color: #fff;
        border-radius: calc(30 / 16 * 1rem);
        display: inline-block;
        position: relative;
        z-index: 1;
        transition: color 0.3s;

        &:before {
          content: "";
          width: 0%;
          height: 100%;
          background: var(--secondary);
          opacity: 1;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
        }

        &:hover {
          &:before {
            width: 100%;
          }
        }
      }

      .cs-image-group {
        /* scales the whole group based on the view width size and stop when that vales equals .745em, resets at desktop */
        font-size: min(2.15vw, 0.8em);
        width: calc(660 / 16 * 1em);
        height: calc(757 / 16 * 1em);
        display: block;
        position: relative;
        z-index: 1;
      }

      .cs-picture {
        box-sizing: border-box;
        overflow: hidden;
        position: absolute;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      .cs-picture1 {
        width: calc(413 / 16 * 1em);
        height: calc(388 / 16 * 1em);
        border: calc(8 / 16 * 1em) solid var(--secondary);
        border-radius: calc(194 / 16 * 1em);
        top: 0;
        left: calc(-8 / 16 * 1em);
        z-index: -1;
      }

      .cs-picture2 {
        width: calc(290 / 16 * 1em);
        height: calc(290 / 16 * 1em);
        border: calc(8 / 16 * 1em) solid #ffd3c6;
        border-radius: 50%;
        right: calc(-8 / 16 * 1em);
        bottom: calc(212 / 16 * 1em);
        z-index: 10;
      }

      .cs-picture3 {
        width: calc(382 / 16 * 1em);
        height: calc(349 / 16 * 1em);
        border: calc(8 / 16 * 1em) solid var(--primary);
        border-radius: calc(136 / 16 * 1em);
        bottom: 0;
        left: calc(-8 / 16 * 1em);
        z-index: -1;
      }

      .cs-floater1 {
        width: calc(163 / 16 * 1em);
        height: auto;
        position: absolute;
        top: calc(130 / 16 * 1em);
        right: calc(70 / 16 * 1em);
        transform: rotate(-38deg);
      }

      .cs-floater2 {
        width: calc(81 / 16 * 1em);
        height: auto;
        position: absolute;
        top: calc(352 / 16 * 1em);
        left: 0;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #sbs-1470 {
      .cs-link {
        &:nth-of-type(1) {
          border-right: 1px solid #e8e8e8;
        }
      }
    }
  }

  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #sbs-1470 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }

      .cs-image-group {
        font-size: min(0.9vw, 1em);
        flex: none;
      }
    }
  }

  /* Large Desktop - 1200px */
  @media only screen and (min-width: 75rem) {
    #sbs-1470 {
      .cs-image-group {
        font-size: min(1.13vw, 1em);
        flex: none;
      }
    }
  }
</style>
