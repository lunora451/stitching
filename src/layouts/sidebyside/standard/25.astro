<style lang="scss">
  /*-- -------------------------- -->
<---        Side by Side        -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #sbs-1883 {
      width: 100%;
      padding: var(--sectionPadding);
      background-color: #faf6f2;
      display: flex;
      flex-direction: column;
      /* aligns content to the left, set to center to centrally align */
      align-items: flex-start;
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
        max-width: calc(584 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        /* 48px - 80px */
        gap: clamp(3rem, 6vw, 5rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: left;
        width: 100%;
        max-width: calc(570 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: flex-start;
        position: relative;
        z-index: 3;
      }

      .cs-image-group {
        font-size: min(2.29vw, 0.9rem);
        width: calc(630 / 16 * 1em);
        height: calc(730 / 16 * 1em);
        display: block;
        position: relative;
        z-index: 1;
      }

      .cs-picture {
        width: calc(522 / 16 * 1em);
        height: calc(680 / 16 * 1em);
        box-sizing: border-box;
        background-color: #dab692;
        overflow: hidden;
        border: 8px solid #dab692;
        border-radius: calc(260 / 16 * 1rem);
        position: absolute;
        z-index: -1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
          transition: transform 0.7s;
        }
      }

      .cs-graphic {
        height: auto;
        position: absolute;
      }

      .cs-brown {
        width: calc(242 / 16 * 1em);
        height: auto;
        top: calc(26 / 16 * 1em);
        right: calc(13 / 16 * 1em);
        z-index: -2;
      }

      .cs-peach {
        width: calc(58 / 16 * 1em);
        height: auto;
        top: calc(6 / 16 * 1em);
        right: calc(109 / 16 * 1em);
      }

      .cs-beige {
        width: calc(352 / 16 * 1em);
        height: auto;
        top: calc(71 / 16 * 1em);
        right: calc(16 / 16 * 1em);
        z-index: -3;
      }

      .cs-leaf {
        width: calc(225 / 16 * 1em);
        height: auto;
        bottom: 0;
        left: calc(16 / 16 * 1em);
        z-index: 1;
      }

      .cs-lines {
        width: calc(176 / 16 * 1em);
        height: auto;
        bottom: 0;
      }

      .cs-info {
        width: 50%;
        max-width: calc(305 / 16 * 1rem);
        padding: calc(100 / 16 * 1em) calc(40 / 16 * 1em);
        background-color: var(--primary);
        border-radius: calc(224 / 16 * 1rem);
        display: flex;
        justify-content: center;
        align-items: center;
        position: absolute;
        right: 0;
        bottom: 0;
      }

      .cs-info-text {
        /* 14px - 20px */
        font-size: clamp(0.875rem, 3.5vw, 1.25rem);
        font-weight: 600;
        line-height: 1.6em;
        text-align: center;
        max-width: calc(223 / 16 * 1em);
        margin: 0;
        color: var(--bodyTextColorWhite);
      }

      .cs-bold {
        /* 16px - 24x */
        font-size: clamp(1rem, 3.5vw, 1.5rem);
        font-weight: 600;
        line-height: 1.2em;
        margin: 0 0 calc(4 / 16 * 1rem);
        color: var(--headerColor);
        display: block;
      }

      .cs-text-large {
        font-size: calc(20 / 16 * 1rem);
        line-height: 1.5em;
        margin: 0 0 calc(12 / 16 * 1rem);
        color: var(--headerColor);
      }

      .cs-text {
        margin-bottom: calc(12 / 16 * 1rem);

        &:last-of-type {
          margin-bottom: calc(32 / 16 * 1rem);
        }
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        /* 46px - 56px */
        line-height: clamp(2.875em, 5.5vw, 3.5em);
        text-align: center;
        text-decoration: none;
        min-width: calc(150 / 16 * 1rem);
        margin: 0;
        /* prevents padding from adding to the width */
        box-sizing: border-box;
        padding: 0 calc(24 / 16 * 1rem);
        background-color: var(--secondary);
        overflow: hidden;
        color: #fff;
        border: none;
        border-radius: calc(4 / 16 * 1rem);
        display: inline-block;
        position: relative;
        z-index: 1;
        transition: color 0.3s;

        &:before {
          content: "";
          width: 0;
          height: 100%;
          background: #000;
          opacity: 1;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
        }

        &:hover {
          color: #fff;

          &:before {
            width: 100%;
          }
        }
      }
    }
  }

  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #sbs-1883 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        flex-direction: row;
        justify-content: space-between;
        align-items: stretch;
      }

      .cs-content {
        /* 48px - 64px */
        padding: clamp(3rem, 5vw, 4rem) 0;
      }

      .cs-image-group {
        font-size: min(1.27vw, 1rem);
        min-height: calc(730 / 16 * 1em);
        height: auto;
        flex: none;
      }

      .cs-picture {
        height: 93.150685%;
      }
    }
  }

  /* Dark Mode */
  @media only screen and (min-width: 0rem) {
    body.dark-mode {
      #sbs-1883 {
        background-color: rgba(0, 0, 0, 0.2);

        .cs-bold,
        .cs-text-large,
        .cs-title {
          color: var(--bodyTextColorWhite);
        }

        .cs-text,
        .cs-info-text {
          opacity: 0.8;
        }

        .cs-picture {
          border-color: var(--accent);
        }

        .cs-info {
          background-color: var(--medium);
        }

        .cs-graphic {
          opacity: 0.6;
        }
      }
    }
  }
</style>
