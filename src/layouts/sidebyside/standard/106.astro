<section id="sbs-75">
  <div class="cs-container">
    <div class="cs-wrapper">
      <picture class="cs-picture">
        <source
          media="(max-width: 600px)"
          srcset="https://csimg.nyc3.digitaloceanspaces.com/SideBySide/body-builder-m.jpg"
        />
        <source
          media="(min-width: 601px)"
          srcset="https://csimg.nyc3.digitaloceanspaces.com/SideBySide/body-builder.jpg"
        />
        <img
          loading="lazy"
          decoding="async"
          src="https://csimg.nyc3.digitaloceanspaces.com/SideBySide/body-builder.jpg"
          alt="body builder"
          width="500"
          height="552"
          aria-hidden="true"
