<style lang="scss">
  /*-- -------------------------- -->
<---   Side by Side Reverse     -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #sbs-2008 {
      width: 100%;
      padding: var(--sectionPadding);
      background-color: #faf6f2;
      overflow: clip;
      display: flex;
      flex-direction: column;
      /* aligns content to the left, set to center to centrally align */
      align-items: flex-start;
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
        max-width: calc(584 / 16 * 1rem);
        margin: auto;
        display: grid;
        justify-items: center;
        grid-auto-flow: row;
        /* 48px - 80px */
        gap: clamp(3rem, 6vw, 5rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: left;
        width: 100%;
        max-width: calc(650 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: flex-start;
        position: relative;
        z-index: 3;
      }

      .cs-text {
        margin-bottom: calc(16 / 16 * 1rem);

        &:last-of-type {
          margin-bottom: calc(32 / 16 * 1rem);
        }
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        /* 46px - 56px */
        line-height: clamp(2.875em, 5.5vw, 3.5em);
        text-align: center;
        text-decoration: none;
        min-width: calc(150 / 16 * 1rem);
        margin: 0;
        /* prevents padding from adding to the width */
        box-sizing: border-box;
        padding: 0 calc(24 / 16 * 1rem);
        background-color: var(--secondary);
        overflow: hidden;
        color: #fff;
        border: none;
        border-radius: calc(4 / 16 * 1rem);
        display: inline-block;
        position: relative;
        z-index: 1;
        transition: color 0.3s;

        &:before {
          content: "";
          width: 0;
          height: 100%;
          background: #000;
          opacity: 1;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
        }

        &:hover {
          color: #fff;

          &:before {
            width: 100%;
          }
        }
      }

      .cs-image-group {
        font-size: min(2.97vw, 1rem);
        width: calc(462 / 16 * 1em);
        height: calc(707 / 16 * 1em);
        display: block;
        position: relative;
        z-index: 1;
      }

      .cs-picture {
        box-sizing: border-box;
        background-color: #dab692;
        overflow: hidden;
        border: calc(8 / 16 * 1em) solid #dab692;
        border-radius: calc(260 / 16 * 1rem);
        position: absolute;
        z-index: -1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      .cs-picture-large {
        width: calc(381 / 16 * 1em);
        height: calc(551 / 16 * 1em);
        top: 0;
        left: calc(51 / 16 * 1em);
      }

      .cs-picture-small {
        width: calc(245 / 16 * 1em);
        height: calc(388 / 16 * 1em);
        right: 0;
        bottom: calc(0 / 16 * 1em);
      }

      .cs-graphic {
        height: auto;
        position: absolute;
      }

      .cs-brown {
        width: calc(132 / 16 * 1em);
        height: auto;
        top: 0;
        right: 0;
        z-index: -2;
      }

      .cs-dots {
        width: calc(137 / 16 * 1em);
        height: auto;
        top: calc(36 / 16 * 1em);
        left: 0;
      }

      .cs-glitter {
        width: calc(508 / 16 * 1em);
        height: auto;
        bottom: calc(-60 / 16 * 1em);
        /* -48px to -100px */
        left: calc(clamp(3em, 8vw, 6.25em) * -1);
        z-index: -2;
        transform: rotateY(180deg);
      }

      .cs-logos {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        /* 40px - 80px */
        column-gap: clamp(2.5rem, 6vw, 5rem);
        /* 32px - 46px */
        row-gap: clamp(2rem, 5vw, 2.875rem);
      }

      .cs-logo {
        width: auto;
        height: calc(40 / 16 * 1rem);
        object-fit: contain;
      }
    }
  }

  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #sbs-2008 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        justify-items: initial;
        align-items: stretch;
        grid-template-columns: repeat(2, auto);
      }

      .cs-content {
        /* 48px - 64px */
        padding: clamp(3rem, 5vw, 4rem) 0;
        grid-column: span 1;
        align-self: center;
      }

      .cs-image-group {
        height: auto;
        min-height: calc(707 / 16 * 1rem);
        grid-column: span 1;
      }

      .cs-picture-large {
        height: 77.934939%;
      }

      .cs-picture-small {
        height: 54.879774%;
      }

      .cs-brown {
        top: 0;
        right: 0;
      }

      .cs-glitter {
        width: calc(508 / 16 * 1em);
        height: calc(491 / 16 * 1em);
        /* 34px - 214px */
        left: calc(clamp(2.125em, 10vw, 13.375em) * -1);
      }

      .cs-logos {
        grid-column: span 2;
        order: 3;
      }
    }
  }

  /* Large Desktop - 1400px */
  @media only screen and (min-width: 87.5rem) {
    #sbs-2008 {
      .cs-logos {
        justify-content: space-between;
        gap: 0;
      }
    }
  }
</style>
