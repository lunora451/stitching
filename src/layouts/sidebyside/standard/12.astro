<!-- ============================================ --><!--                Side By Side                  --><!-- ============================================ -->
<section id="sbs-2233">
  <div class="cs-container">
    <div class="cs-content">
      <span class="cs-topper">Why Choose Us</span>
      <h2 class="cs-title">Your Wedding Memory will be More Memorable</h2>
      <p class="cs-text">
        Our expert instructors give you the skills and knowledge to manage
        process risks and show you how to continuously make your facilities and
        operations more safe and reliable. PSRG training courses are available
        online.
      </p>
      <ul class="cs-options">
        <li class="cs-option">
          <span class="cs-option-number">01</span>
          <span class="cs-option-text">Formal Style</span>
        </li>
        <li class="cs-option">
          <span class="cs-option-number">02</span>
          <span class="cs-option-text">Semi - Formal Style</span>
        </li>
      </ul>
      <a href="" class="cs-button-solid">Learn More</a>
    </div>
    <div class="cs-image-group">
      <!--Main Image-->
      <picture class="cs-picture cs-picture1">
        <!--Mobile Image-->
        <source
          media="(max-width: 600px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/wedding4.jpeg"
        />
        <!--Tablet and above Image-->
        <source
          media="(min-width: 601px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/wedding4.jpeg"
        />
        <img
          loading="lazy"
          decoding="async"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/wedding4.jpeg"
          alt="wedding"
          width="272"
          height="337"
        />
      </picture>
      <!--Small Image-->
      <picture class="cs-picture cs-picture2">
        <!--Mobile Image-->
        <source
          media="(max-width: 600px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/wedding18.jpg"
        />
        <!--Tablet and above Image-->
        <source
          media="(min-width: 601px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/wedding18.jpg"
        />
        <img
          loading="lazy"
          decoding="async"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/wedding18.jpg"
          alt="wedding"
          width="243"
          height="367"
        />
      </picture>
      <p class="cs-caption">Our Summer Wedding in a Classic Style</p>
    </div>
  </div>
  <ul class="cs-stats">
    <div class="cs-stat">
      <p class="cs-stat-number">25</p>
      <p class="cs-stat-text">Years</p>
    </div>
    <div class="cs-stat">
      <p class="cs-stat-number">98</p>
      <p class="cs-stat-text">Guests</p>
    </div>
    <div class="cs-stat">
      <p class="cs-stat-number">10</p>
      <p class="cs-stat-text">Bridesmaids</p>
    </div>
    <div class="cs-stat">
      <p class="cs-stat-number">15</p>
      <p class="cs-stat-text">Groomsmen</p>
    </div>
  </ul>
  <!--Floating Flower-->
  <img
    class="cs-flower"
    loading="lazy"
    decoding="async"
    src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/flower-tilted.png"
    alt="flower"
    width="244"
    height="186"
    aria-hidden="true"
  />
</section>

<style lang="scss">
  /*-- -------------------------- -->
<---      Side By Side          -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #sbs-2233 {
      padding: var(--sectionPadding);
      background-color: #fbf5f1;
      overflow: hidden;
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        /* changes to 1280px at tablet */
        max-width: calc(704 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to center if content needs to be centrally aligned */
        text-align: left;
        width: 100%;
        max-width: calc(586 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        /* aligns content to the left, set to center to centrally align */
        align-items: flex-start;
      }

      .cs-text {
        /* 24px - 32px */
        margin-bottom: clamp(1.5rem, 3vw, 2rem);
      }

      .cs-options {
        width: 100%;
        margin: 0 0 calc(32 / 16 * 1rem);
        padding: 0;
        display: flex;
        flex-direction: column;
      }

      .cs-option {
        list-style: none;
        padding: calc(16 / 16 * 1rem) 0;
        border-bottom: 1px solid #e8e8e8;
        display: flex;
        justify-content: flex-start;
        align-items: flex-start;
        gap: calc(24 / 16 * 1rem);
        position: relative;
        z-index: 1;

        &:first-of-type {
          padding-top: 0;
        }

        &:last-of-type {
          padding-bottom: 0;
          border: none;
        }
      }

      .cs-option-number {
        font-size: calc(20 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        color: var(--headerColor);
      }

      .cs-option-text {
        font-size: calc(20 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        color: var(--bodyTextColor);
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        /* 46px - 56px */
        line-height: clamp(2.875rem, 5.5vw, 3.5rem);
        text-align: center;
        text-decoration: none;
        min-width: calc(150 / 16 * 1rem);
        margin: 0;
        /* prevents padding from adding to the width */
        box-sizing: border-box;
        padding: 0 calc(24 / 16 * 1rem);
        background-color: var(--primary);
        color: #fff;
        display: inline-block;
        position: relative;
        z-index: 1;

        &:before {
          content: "";
          width: 0%;
          height: 100%;
          background: #000;
          opacity: 1;
          border-radius: calc(4 / 16 * 1rem);
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
        }

        &:hover {
          &:before {
            width: 100%;
          }
        }
      }

      .cs-image-group {
        /* scales the whole section down and ties the font size to the vw and stops at 75% of the vale of 1em, changes at desktop */
        font-size: min(2.3vw, 0.916rem);
        /* everything inside this box is in ems so we can scale it all down proportionally with a font size */
        width: calc(640 / 16 * 1em);
        height: calc(646 / 16 * 1em);
        order: -1;
        position: relative;
        /* prevents flexbox from squishing it */
        flex: none;
      }

      .cs-picture {
        width: calc(320 / 16 * 1em);
        height: calc(569 / 16 * 1em);
        overflow: hidden;
        border: calc(4 / 16 * 1em) solid #fff;
        display: block;
        position: absolute;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      .cs-picture1 {
        top: 0;
        left: 0;
      }

      .cs-picture2 {
        top: 0;
        right: 0;
      }

      .cs-caption {
        /* 20px - 31px */
        font-size: clamp(1.25rem, 2vw, 1.9375rem);
        font-weight: 700;
        line-height: 1.2em;
        text-align: center;
        width: 83%;
        max-width: calc(391 / 16 * 1rem);
        margin: 0;
        /* 24px - 40px */
        padding: clamp(1.5rem, 3vw, 2.5rem);
        background-color: var(--secondary);
        color: #fff;
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
      }

      .cs-stats {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        /* 48px - 100px */
        margin: clamp(3rem, 7vw, 6.25rem) auto 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(12, 1fr);

        row-gap: calc(8 / 16 * 1rem);
        position: relative;
      }

      .cs-stat {
        /* as the child .cs-number is absolutely positioned, it won't contribute to the size of the box */
        /* we can set the height equal to the font-size which works around this */
        /* 100px - 120px */
        height: clamp(6.25rem, 11vw, 10rem);
        display: flex;
        justify-content: center;
        align-items: center;
        grid-column: span 6;
        position: relative;
      }

      .cs-stat-number {
        /* 100px - 120px */
        font-size: clamp(6.25rem, 11vw, 10rem);
        font-weight: 900;
        line-height: 1.2em;
        margin: 0;
        color: var(--primary);
        opacity: 0.2;
        display: block;
      }

      .cs-stat-text {
        font-size: calc(20 / 16 * 1rem);
        font-weight: bold;
        line-height: 1.2em;
        margin: 0;
        color: var(--bodyTextColor);
        display: block;
        position: absolute;
        z-index: 2;
      }

      .cs-flower {
        width: calc(309 / 16 * 1rem);
        height: auto;
        margin-right: calc(-962 / 16 * 1rem);
        display: none;
        position: absolute;
        right: 50%;
        bottom: 0;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #sbs-2233 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        flex-direction: row;
        align-items: stretch;
      }

      .cs-content {
        /* 48px - 100px */
        padding: clamp(3rem, 7vw, 6.25rem) 0;
      }

      .cs-image-group {
        font-size: min(1vw, 1rem);
        height: auto;
        min-height: calc(645 / 16 * 1em);
      }

      .cs-picture {
        height: auto;
        top: 0;
        bottom: calc(77 / 16 * 1em);
      }

      .cs-stats {
        /* 24px - 64px */
        column-gap: clamp(1.5rem, 9vw, 4rem);
      }

      .cs-stat {
        grid-column: span 3;
      }
    }
  }

  /* Large Desktop - 1400px */
  @media only screen and (min-width: 87.5rem) {
    #sbs-2233 {
      .cs-flower {
        display: block;
      }
    }
  }
</style>
