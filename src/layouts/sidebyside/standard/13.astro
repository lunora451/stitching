<style lang="scss">
  /*-- -------------------------- -->
<---       Side By Side         -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #sbs-2218 {
      padding: var(--sectionPadding);
      background-color: #fdfaf8;
      overflow: hidden;
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
        max-width: calc(584 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: left;
        width: 100%;
        max-width: calc(586 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: flex-start;
      }

      .cs-text {
        margin-bottom: calc(24 / 16 * 1rem);
      }

      .cs-list {
        margin: 0 0 calc(32 / 16 * 1rem) 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        /* 24px - 32px */
        gap: clamp(1.5rem, 3vw, 2rem);
      }

      .cs-li {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        justify-content: flex-start;
        align-items: flex-start;
        gap: calc(24 / 16 * 1rem);
      }

      .cs-icon-wrapper {
        /* 60px - 80px */
        width: clamp(3.75rem, 7vw, 5rem);
        height: clamp(3.75rem, 7vw, 5rem);
        border: 1px solid #bababa;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: none;
      }

      .cs-icon {
        width: calc(32 / 16 * 1rem);
        height: auto;
        display: block;
      }

      .cs-h3 {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 2.5vw, 1.5625rem);
        font-weight: 700;
        line-height: 1.2em;
        text-align: left;
        margin: 0 0 calc(12 / 16 * 1rem) 0;
        color: var(--headerColor);
      }

      .cs-li-text {
        /* 14px - 16px */
        font-size: clamp(0.875rem, 1.8vw, 1rem);
        line-height: 1.5em;
        text-align: left;
        margin: 0;
        color: var(--bodyTextColor);
      }

      .cs-image-group {
        /* scales the whole group based on the view width size and stop when that vales equals .74em, resets at desktop */
        font-size: min(2.32vw, 0.74em);
        width: calc(630 / 16 * 1em);
        height: calc(655 / 16 * 1em);
        display: block;
        position: relative;
        z-index: 1;

        &::before {
          content: "";
          width: calc(358 / 16 * 1em);
          height: auto;
          background: var(--secondary);
          opacity: 0.2;
          display: block;
          position: absolute;
          top: calc(144 / 16 * 1em);
          bottom: calc(178 / 16 * 1em);
          left: calc(88 / 16 * 1em);
        }
      }

      .cs-picture {
        position: absolute;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      .cs-picture1 {
        width: calc(305 / 16 * 1em);
        height: auto;
        border: 4px solid #ffffff;
        top: 0;
        bottom: calc(281 / 16 * 1em);
        left: 0;
      }

      .cs-picture2 {
        width: calc(413 / 16 * 1em);
        height: auto;
        border: 4px solid #ffffff;
        top: calc(271 / 16 * 1em);
        right: 0;
        bottom: 0;
      }

      .cs-picture3 {
        width: calc(218 / 16 * 1em);
        height: calc(155 / 16 * 1em);
        top: calc(84 / 16 * 1em);
        right: calc(75 / 16 * 1em);
      }

      .cs-graphic {
        /* 131px - 255px */
        width: clamp(5.8175rem, 15vw, 15.9375rem);
        height: auto;
        display: block;
        position: absolute;
        top: 0;
        right: 0;
        z-index: -1;
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        /* 46px - 56px */
        line-height: clamp(2.875rem, 5.5vw, 3.5rem);
        text-align: center;
        text-decoration: none;
        min-width: calc(150 / 16 * 1rem);
        margin: 0;
        /* prevents padding from adding to the width */
        box-sizing: border-box;
        padding: 0 calc(24 / 16 * 1rem);
        background-color: var(--primary);
        color: #fff;
        display: inline-block;
        position: relative;
        z-index: 1;

        &:before {
          content: "";
          width: 0%;
          height: 100%;
          background: #000;
          opacity: 1;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
        }

        &:hover {
          &:before {
            width: 100%;
          }
        }
      }
    }
  }

  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #sbs-2218 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        flex-direction: row;
        justify-content: center;
        align-items: stretch;
      }

      .cs-content {
        width: 47%;
        align-self: center;
      }

      .cs-li {
        align-items: center;
      }

      .cs-image-group {
        font-size: min(1.2vw, 1em);
        height: auto;
        flex: none;
      }
    }
  }
</style>
