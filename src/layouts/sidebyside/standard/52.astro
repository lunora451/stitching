<style lang="scss">
  /*-- -------------------------- -->
<---       Side By Side         -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #sbs-1123 {
      padding: var(--sectionPadding);
      background-color: #f7f7f7;
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
        max-width: calc(550 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: calc(48 / 16 * 1rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: left;
        width: 100%;
        max-width: calc(522 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: flex-start;
      }

      .cs-topper {
        color: #767676;
      }

      .cs-text {
        margin-bottom: calc(16 / 16 * 1rem);
        &:last-of-type {
          margin-bottom: calc(32 / 16 * 1rem);
        }
      }

      .cs-ul {
        width: 100%;
        margin: 0 0 calc(32 / 16 * 1rem) 0;
        padding-left: calc(20 / 16 * 1rem);
        /* prevents padding from affecting width and height */
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: calc(8 / 16 * 1rem);
      }

      .cs-li {
        font-size: var(--bodyFontSize);
        line-height: 1.5em;
        list-style: none;
        text-align: left;
        width: 100%;
        max-width: calc(400 / 16 * 1rem);
        margin: 0;
        color: var(--bodyTextColor);
        position: relative;

        &:before {
          /* bullet */
          content: "";
          width: 4px;
          height: 4px;
          border-radius: 50%;
          background: currentColor;
          opacity: 1;
          position: absolute;
          display: block;
          top: calc(10 / 16 * 1rem);
          left: calc(-15 / 16 * 1rem);
        }
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        /* 46px - 56px */
        line-height: clamp(2.875rem, 5.5vw, 3.5rem);
        text-decoration: none;
        font-weight: 700;
        text-align: center;
        margin: 0;
        color: #fff;
        min-width: calc(200 / 16 * 1rem);
        padding: 0 calc(24 / 16 * 1rem);
        background-color: var(--primary);
        border-radius: calc(8 / 16 * 1rem);
        display: inline-block;
        position: relative;
        z-index: 1;
        /* prevents padding from adding to the width */
        box-sizing: border-box;

        &:before {
          content: "";
          position: absolute;
          height: 100%;
          width: 0%;
          background: #000;
          opacity: 1;
          top: 0;
          left: 0;
          z-index: -1;
          border-radius: calc(8 / 16 * 1rem);
          transition: width 0.3s;
        }

        &:hover {
          &:before {
            width: 100%;
          }
        }
      }

      .cs-image-group {
        /* scaling entire section down. font-size starts at a min in vw, and stops when that value reaches 1em (16px). Since we want the picture elements to base their font size on the parent and not the root, we use ems for this entire section  */
        font-size: min(2.18vw, 0.791em);
        width: calc(662 / 16 * 1em);
        height: calc(756 / 16 * 1em);
        position: relative;
        z-index: 1;
      }

      .cs-picture {
        /* width 100% so we can match the border radius with the circle graphic easier */
        width: 100%;
        height: calc(782 / 16 * 1em);
        display: flex;
        justify-content: center;
        align-items: flex-end;
        /* clips images to the shape of the parent */
        overflow: hidden;
        position: absolute;
        bottom: 0;
        left: 50%;
        z-index: 10;
        transform: translateX(-50%);

        img {
          width: auto;
          height: calc(782 / 16 * 1em);
          position: relative;
          bottom: calc(-18 / 16 * 1em);
          left: 0;
        }
      }

      .cs-picture1 {
        /* this is set to match the curve of the circle graphic behind it */
        border-radius: 0 0 47.8% 47.4%;
      }

      .cs-picture2 {
        /* this is the picture mask, we make the picture element a specific height and width thats smaller than the actual image, and where the actual image overflows the new dimensions it gets cut off by the overflow:hidden.  This crop is the image that overlaps the circle shapes we created.  */
        width: calc(413 / 16 * 1em);
        height: calc(743 / 16 * 1em);
        border-radius: 0 0 calc(19 / 16 * 1em) 0;
        /* place the cropped image exactly over the cs-picture1 to finish the masking effect */
        left: calc(277 / 16 * 1em);
        bottom: calc(21 / 16 * 1em);

        img {
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      .cs-graphic {
        width: 100%;
        height: auto;
        position: absolute;
        bottom: 0;
        left: 0;
        z-index: -1;
      }

      .cs-stat {
        text-align: center;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        gap: calc(4 / 16 * 1rem);
        position: absolute;
        top: calc(74 / 16 * 1em);
        left: calc(28 / 16 * 1em);
        z-index: 1;
      }

      .cs-number {
        /* 20px - 39px */
        font-size: clamp(1.25rem, 3vw, 2.4375rem);
        line-height: 1.2em;
        font-weight: 700;
        text-align: inherit;
        margin: 0;
        color: var(--bodyTextColorWhite);
      }

      .cs-desc {
        /* 10px - 14px */
        font-size: clamp(0.625rem, 1vw, 0.875rem);
        line-height: 1.5em;
        text-align: inherit;
        width: 100%;
        /* 80px - 148px */
        max-width: clamp(5rem, 11vw, 9.25rem);
        margin: 0;
        color: var(--bodyTextColorWhite);
      }

      .cs-blob {
        width: 142%;
        max-width: calc(200 / 16 * 1rem);
        height: auto;
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: -1;
        transform: translate(-50%, -50%);
      }

      .cs-arrow {
        width: calc(130 / 16 * 1em);
        height: auto;
        position: absolute;
        top: clamp(150%, 14vw, 180%);
        left: calc(5 / 16 * 1em);
        transform: rotate(-52deg);
      }

      .cs-floater {
        /* 270px - 522px */
        width: clamp(16.875rem, 40vw, 32.625rem);
        height: auto;
        position: absolute;
        right: 0;
        bottom: 0;
        z-index: -1;
      }
    }
  }

  /* Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #sbs-1123 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
      }

      .cs-image-group {
        /* reset the scale */
        font-size: min(1.2vw, 1em);
        /* prevent flexbox from squishing it */
        flex: none;
      }

      .cs-content {
        width: 50%;
      }
    }
  }
</style>
