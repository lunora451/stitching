<section id="sbs-1813">
  <div class="cs-container">
    <div class="cs-image-group">
      <!--Main Image-->
      <picture class="cs-picture">
        <!--Mobile Image-->
        <source
          media="(max-width: 600px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/gym4.jpg"
        />
        <!--Tablet and above Image-->
        <source
          media="(min-width: 601px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/gym4.jpg"
        />
        <img
          loading="lazy"
          decoding="async"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/gym4.jpg"
          alt="body builder"
          width="700"
          height="666"
        />
      </picture>
      <!--White SVG Mask. Download the image and change the fill color to match the color of the section background below it-->
      <img
        class="cs-mask cs-light"
        loading="lazy"
        decoding="async"
        src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/white-paint-stroke.svg"
        alt="white splatter"
        width="700"
        height="666"
      />
      <!--This is a dark version. Download the image and change the fill color to match the color of the section background below it-->
      <img
        class="cs-mask cs-dark"
        loading="lazy"
        decoding="async"
        src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/dark-paint-stroke.svg"
        alt="white splatter"
        width="700"
        height="666"
      />
    </div>
    <div class="cs-content">
      <span class="cs-topper">About Us</span>
      <h2 class="cs-title">Boxing & Martial Arts Club For Kids & Adults</h2>
      <p class="cs-text">
        We understand that your lifestyle changes, that’s why we’ve made fitness
        straightforward and stress free. Join today on a no lock-in contract
        membership and start achieving your fitness goals. We value flexibility
        at Jetts, with unlimited 24/7 access.
      </p>
      <ul class="cs-ul">
        <li class="cs-li">
          <picture class="cs-li-picture">
            <img
              class="cs-li-icon"
              aria-hidden="true"
              src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/gym-check.svg"
              decoding="async"
              alt="icon"
              width="20"
              height="20"
              loading="lazy"
            />
          </picture>
          <div class="cs-flex">
            <h3 class="cs-h3">Kids</h3>
            <span class="cs-li-text"> Age: 5-8 </span>
          </div>
        </li>
        <li class="cs-li">
          <picture class="cs-li-picture">
            <img
              class="cs-li-icon"
              aria-hidden="true"
              src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/gym-check.svg"
              decoding="async"
              alt="icon"
              width="20"
              height="20"
              loading="lazy"
            />
          </picture>
          <div class="cs-flex">
            <h3 class="cs-h3">Juniors</h3>
            <span class="cs-li-text"> Age: 9-11 </span>
          </div>
        </li>
        <li class="cs-li">
          <picture class="cs-li-picture">
            <img
              class="cs-li-icon"
              aria-hidden="true"
              src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/gym-check.svg"
              decoding="async"
              alt="icon"
              width="20"
              height="20"
              loading="lazy"
            />
          </picture>
          <div class="cs-flex">
            <h3 class="cs-h3">Youths</h3>
            <span class="cs-li-text"> Age: 12-15 </span>
          </div>
        </li>
      </ul>
      <a href="" class="cs-button-solid">Learn More</a>
    </div>
  </div>

  <!--White Splash Graphic-->
  <img
    class="cs-graphic cs-light"
    src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/f7-splatter.svg"
    alt="graphic"
    height="161"
    width="1920"
    loading="lazy"
    decoding="async"
  />
  <!--This is a dark version. Download the image and change the fill color to match the color of the section background below it-->
  <img
    class="cs-graphic cs-dark"
    src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/dark-mode-splatter2.svg"
    alt="graphic"
    height="161"
    width="1920"
    loading="lazy"
    decoding="async"
  />
</section>

<style lang="scss">
  /*-- -------------------------- -->
<---       Side By Side         -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #sbs-1813 {
      padding: var(--sectionPadding);
      /* 100px - 200px */
      padding-bottom: clamp(6.25rem, 8vw, 12.5rem);
      /* clips anything overflowing */
      overflow: hidden;
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
        max-width: calc(550 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: left;
        width: 100%;
        max-width: calc(542 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: flex-start;
        position: relative;
        z-index: 3;
      }

      .cs-text {
        margin-bottom: calc(16 / 16 * 1rem);
        &:last-of-type {
          margin-bottom: calc(32 / 16 * 1rem);
        }
      }

      .cs-ul {
        width: 100%;
        max-width: calc(630 / 16 * 1rem);
        margin: 0 0 calc(32 / 16 * 1rem);
        padding: 0;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        row-gap: calc(16 / 16 * 1rem);
        column-gap: calc(12 / 16 * 1rem);
      }

      .cs-li {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        align-items: flex-start;
        justify-content: flex-start;
        flex-direction: column;
        grid-column: span 4;
        /* 16px - 20px */
        gap: clamp(1rem, 2.5vw, 1.25rem);
      }

      .cs-li-picture {
        /* 60px - 80px */
        width: calc(48 / 16 * 1rem);
        height: calc(48 / 16 * 1rem);
        margin: 0;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        /* prevents flexbox from squishing it */
        flex: none;
        position: relative;
        z-index: 1;

        &:before {
          /* background color */
          content: "";
          width: 100%;
          height: 100%;
          background: var(--primary);
          opacity: 0.1;
          position: absolute;
          display: block;
          top: 0;
          left: 0;
          z-index: -1;
        }
      }

      .cs-li-icon {
        width: calc(24 / 16 * 1rem);
        height: auto;
        display: block;
      }

      .cs-h3 {
        /* 13px - 16px */
        font-size: clamp(0.8125rem, 2vw, 1rem);
        line-height: 1.2em;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        text-align: left;
        margin: 0 0 calc(12 / 16 * 1rem) 0;
        color: var(--bodyTextColor);
      }

      .cs-li-text {
        font-size: calc(20 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        text-align: left;
        margin: 0;
        color: var(--headerColor);
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        /* 46px - 56px */
        line-height: clamp(2.875rem, 5.5vw, 3.5rem);
        text-decoration: none;
        font-weight: 700;
        text-align: center;
        margin: 0;
        color: #fff;
        min-width: calc(150 / 16 * 1rem);
        padding: 0 calc(24 / 16 * 1rem);
        background-color: var(--primary);
        border-radius: calc(4 / 16 * 1rem);
        display: inline-block;
        position: relative;
        z-index: 1;
        /* prevents padding from adding to the width */
        box-sizing: border-box;

        &:before {
          content: "";
          position: absolute;
          height: 100%;
          width: 0%;
          background: #000;
          opacity: 1;
          top: 0;
          left: 0;
          z-index: -1;
          border-radius: calc(4 / 16 * 1rem);
          transition: width 0.3s;
        }

        &:hover {
          &:before {
            width: 100%;
          }
        }
      }

      .cs-image-group {
        /* scales the whole section down and ties the font size to the vw and stops at 75% of the vale of 1em, changes at desktop */
        font-size: min(2.2vw, 0.7rem);
        /* everything inside this box is in ems so we can scale it all down proportionally with a font size */
        width: calc(643 / 16 * 1em);
        height: calc(608 / 16 * 1em);
        position: relative;
        z-index: 1;
      }

      .cs-picture {
        width: 100%;
        height: 100%;
        display: block;
        position: absolute;
        object-fit: cover;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
      }

      .cs-mask {
        width: 101%;
        height: 101%;
        object-fit: cover;
        position: absolute;
        left: 50%;
        top: 50%;
        z-index: 1;
        transform: translate(-50%, -50%);
      }

      .cs-graphic {
        width: 100%;
        min-width: calc(1200 / 16 * 1rem);
        height: auto;
        object-fit: cover;
        position: absolute;
        bottom: 0;
        left: 50%;
        z-index: 1;
        transform: translateX(-50%);
      }

      .cs-dark {
        display: none;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #sbs-1813 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }

      .cs-image-group {
        /* set to inherit at Large Desktop */
        font-size: min(1.1vw, 1rem);
        flex: none;

        &:before {
          display: block;
        }
      }

      .cs-content {
        width: 51%;
      }
    }
  }

  /* Desktop - 1300px */
  @media only screen and (min-width: 81.25rem) {
    #sbs-1813 {
      .cs-image-group {
        font-size: inherit;
      }

      .cs-li {
        flex-direction: row;
      }
    }
  }

  /* Large Desktop - 2000px */
  @media only screen and (min-width: 125rem) {
    #sbs-1813 {
      /* pushes down when the screen size gets too big and the graphic starts getting too tall and creeps up on the content above it */
      padding-bottom: 9vw;
    }
  }
</style>
