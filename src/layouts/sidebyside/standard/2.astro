<section id="sbs-2415">
  <div class="cs-container">
    <div class="cs-image-group">
      <!--Main Image-->
      <picture class="cs-picture cs-picture1">
        <!--Mobile Image-->
        <source
          media="(max-width: 600px)"
          srcset="https://nyc3.digitaloceanspaces.com/csimages2/Images/Misc/pet-sbs1.jpg"
        />
        <!--Tablet and above Image-->
        <source
          media="(min-width: 601px)"
          srcset="https://nyc3.digitaloceanspaces.com/csimages2/Images/Misc/pet-sbs1.jpg"
        />
        <img
          loading="lazy"
          decoding="async"
          src="https://nyc3.digitaloceanspaces.com/csimages2/Images/Misc/pet-sbs1.jpg"
          alt="wedding"
          width="272"
          height="337"
        />
      </picture>
      <!--Small Image-->
      <picture class="cs-picture cs-picture2">
        <!--Mobile Image-->
        <source
          media="(max-width: 600px)"
          srcset="https://nyc3.digitaloceanspaces.com/csimages2/Images/Misc/pet-sbs2.png"
        />
        <!--Tablet and above Image-->
        <source
          media="(min-width: 601px)"
          srcset="https://nyc3.digitaloceanspaces.com/csimages2/Images/Misc/pet-sbs2.png"
        />
        <img
          loading="lazy"
          decoding="async"
          src="https://nyc3.digitaloceanspaces.com/csimages2/Images/Misc/pet-sbs2.png"
          alt="wedding"
          width="243"
          height="367"
        />
      </picture>
    </div>
    <div class="cs-content">
      <span class="cs-topper">Featured Service</span>
      <h2 class="cs-title">Sanitizing Yard Spray Service</h2>
      <p class="cs-text">
        Eliminate bacteria and odors with our eco-friendly disinfectant spray,
        available as a standalone service or add-on to regular waste removal.
      </p>
      <h3 class="cs-h3">What's Included:</h3>
      <ul class="cs-ul">
        <li class="cs-li">
          <img
            class="cs-icon"
            loading="lazy"
            decoding="async"
            src="https://nyc3.digitaloceanspaces.com/csimages2/Images/Icons/diamond.svg"
            alt="icon"
            width="16"
            height="16"
          />
          Pet-Safe Formula no harmful chemicals.
        </li>
        <li class="cs-li">
          <img
            class="cs-icon"
            loading="lazy"
            decoding="async"
            src="https://nyc3.digitaloceanspaces.com/csimages2/Images/Icons/diamond.svg"
            alt="icon"
            width="16"
            height="16"
          />
          Odor Elimination leaves your yard fresh.
        </li>
        <li class="cs-li">
          <img
            class="cs-icon"
            loading="lazy"
            decoding="async"
            src="https://nyc3.digitaloceanspaces.com/csimages2/Images/Icons/diamond.svg"
            alt="icon"
            width="16"
            height="16"
          />
          Bacteria Control healthier space for pets and people.
        </li>
        <li class="cs-li">
          <img
            class="cs-icon"
            loading="lazy"
            decoding="async"
            src="https://nyc3.digitaloceanspaces.com/csimages2/Images/Icons/diamond.svg"
            alt="icon"
            width="16"
            height="16"
          />
          You have now a flexible scheduling and easy billing
        </li>
      </ul>
      <a href="" class="cs-button-solid">Request Sanitizing Service</a>
    </div>
    <!--Floating Graphic-->
    <img
      class="cs-floater"
      loading="lazy"
      decoding="async"
      src="https://nyc3.digitaloceanspaces.com/csimages2/Images/Icons/poo.svg"
      alt="flower"
      width="244"
      height="186"
      aria-hidden="true"
    />
  </div>
</section>

<style lang="scss">
  /*-- -------------------------- -->
<---       Side By Side         -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #sbs-2415 {
      padding: var(--sectionPadding);
      overflow: hidden;
      z-index: 1;

      &:before {
        /* background color */
        content: "";
        width: 100%;
        height: 100%;
        background: var(--primary);
        opacity: 0.05;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;
      }

      .cs-container {
        width: 100%;
        position: relative;
        /* changes to 1280px at tablet */
        max-width: calc(564 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to center if content needs to be centrally aligned */
        text-align: left;
        width: 100%;
        max-width: calc(586 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        /* aligns content to the left, set to center to centrally align */
        align-items: flex-start;
      }

      .cs-title {
        max-width: 15ch;
      }

      .cs-text {
        margin-bottom: calc(16 / 16 * 1rem);
      }

      .cs-h3 {
        color: var(--bodyTextColor);
        margin: 0 0 calc(8 / 16 * 1rem);
        font-size: calc(16 / 16 * 1rem);
        font-weight: bold;
        line-height: 1.5em;
      }

      .cs-ul {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        margin: 0 0 calc(32 / 16 * 1rem);
        max-width: calc(500 / 16 * 1rem);
        width: 100%;
        padding: 0;
        gap: calc(12 / 16 * 1rem);
      }

      .cs-li {
        display: flex;
        justify-content: flex-start;
        /* Push icon top the top so if the list item goes to two lines the icon stays at the top */
        align-items: flex-start;
        width: 100%;
        list-style: none;
        font-size: var(--bodyFontSize);
        line-height: 1.5em;
        color: var(--headerColor);
        font-weight: bold;
        gap: calc(12 / 16 * 1rem);
      }

      .cs-icon {
        width: calc(16 / 16 * 1rem);
        height: auto;
        margin-top: calc(3 / 16 * 1rem);
        display: block;
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        /* 46px - 56px */
        line-height: clamp(2.875rem, 5.5vw, 3.5rem);
        text-align: center;
        text-decoration: none;
        min-width: calc(150 / 16 * 1rem);
        margin: 0;
        padding: 0 calc(24 / 16 * 1rem);
        background-color: var(--primary);
        color: var(--headerColor);
        display: inline-block;
        position: relative;
        z-index: 1;

        &:before {
          content: "";
          width: 0%;
          height: 100%;
          background: #000;
          opacity: 1;
          border-radius: calc(4 / 16 * 1rem);
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
        }

        &:hover {
          color: #fff;
          &:before {
            width: 100%;
          }
        }
      }

      .cs-image-group {
        /* scales the whole section down and ties the font size to the vw, changes at desktop */
        font-size: min(3.49vw, 1rem);
        /* everything inside this box is in ems so we can scale it all down proportionally with a font size */
        width: calc(418 / 16 * 1em);
        height: calc(497 / 16 * 1em);
        position: relative;
        z-index: 1;
        /* prevents flexbox from squishing it */
        flex: none;
      }

      .cs-picture {
        display: block;
        position: absolute;
        z-index: 1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      .cs-picture1 {
        width: calc(418 / 16 * 1em);
        height: calc(418 / 16 * 1em);
        top: 0;
        left: 0;
        overflow: hidden;
        border-radius: calc(350 / 16 * 1rem);
      }

      .cs-picture2 {
        width: calc(418 / 16 * 1em);
        height: calc(270 / 16 * 1em);
        bottom: 0;
        left: 0;

        /* using object-fit: contain, as cs-picture2 is a PNG and we don't want the image to get cut off at higher resolutions */
        img {
          object-fit: contain;
        }
      }

      .cs-floater {
        display: none;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #sbs-2415 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
      }

      .cs-floater {
        /* 119px - 247px */
        width: clamp(7.4375rem, 16vw, 15.4375rem);
        height: auto;
        position: absolute;
        right: calc(19 / 16 * 1rem);
        /* 10px - 98px */
        bottom: calc(clamp(0.625rem, 7vw, 6.125rem) * -1);
        display: block;
      }
    }
  }

  /* Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #sbs-2415 {
      .cs-container {
        flex-direction: row;
        align-items: stretch;
      }

      .cs-content {
        text-align: left;
        align-items: flex-start;
        align-self: center;
      }

      .cs-image-group {
        width: calc(630 / 16 * 1em);
        height: auto;
        min-height: calc(749 / 16 * 1em);
        font-size: min(1.03vw, 1rem);
      }

      .cs-picture1 {
        width: calc(630 / 16 * 1em);
        height: auto;
        min-height: calc(630 / 16 * 1rem);
        top: 0;
        bottom: calc(120 / 16 * 1rem);
      }

      .cs-picture2 {
        height: calc(408 / 16 * 1em);
        width: calc(519 / 16 * 1em);
      }

      .cs-floater {
        /* 20px - 39px */
        right: calc(clamp(1.25rem, 3vw, 2.4375rem) * -1);
      }
    }
  }

  /* Large Desktop - 1600px */
  @media only screen and (min-width: 100rem) {
    #sbs-2415 {
      .cs-content {
        padding: calc(144 / 16 * 1rem) 0;
      }

      .cs-floater {
        right: 50%;
        margin-right: calc(-925 / 16 * 1rem);
        bottom: calc(16 / 16 * 1rem);
      }
    }
  }
</style>
