<section id="sbs-2362">
  <div class="cs-container">
    <div class="cs-wrapper">
      <div class="cs-content">
        <span class="cs-topper">About Us</span>
        <h2 class="cs-title">
          The Best Place for Your Dream Vacation is Here, Where Luxury Meets
          Tranquility
        </h2>
        <p class="cs-text">
          At ArchiStitch, we seamlessly blend innovative design with
          functionality, creating spaces that inspire, elevate, and endure. From
          visionary concepts to flawless execution, we craft architectural
          masterpieces. Urban design draws together the many strands of
          place-making, environmental stewardship. We craft premium digital work
          for web, mobile and experiential with creative agencies and global
          brands.
        </p>
        <a href="" class="cs-button-solid">More About Us</a>
      </div>
      <ul class="cs-stat-group">
        <li class="cs-stat">
          <span class="cs-number"><span class="cs-color">+</span>500K</span>
          <span class="cs-desc">Happy Users</span>
        </li>
        <li class="cs-stat">
          <span class="cs-number"><span class="cs-color">+</span>1.4K</span>
          <span class="cs-desc">Completed Projects</span>
        </li>
      </ul>
    </div>
    <div class="cs-image-group">
      <picture class="cs-picture">
        <!--Mobile Image-->
        <source
          media="(max-width: 600px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/MISC/building15.jpg"
        />
        <!--Tablet and above Image-->
        <source
          media="(min-width: 601px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/MISC/building15.jpg"
        />
        <img
          loading="lazy"
          decoding="async"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/MISC/building15.jpg"
          alt="fancy staircase around a pointed triangular structure"
          width="1280"
          height="568"
        />
