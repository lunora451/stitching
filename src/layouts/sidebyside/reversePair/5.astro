<style lang="scss">
  /*-- -------------------------- -->
<---     Side By SIde Pair      -->
<--- -------------------------- -*/

  /* Mobile */
  @media only screen and (min-width: 0rem) {
    #sbs-2375 {
      padding: var(--sectionPadding);
      background-color: #fbf9f5;
      box-sizing: border-box;

      .cs-container {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
        /* 32px - 100px top & bottom */
        /* 16px - 32px left & right */
        padding: clamp(2rem, 8vw, 6.25rem) clamp(1rem, 3vw, 4rem);
        background-color: #fff;
        border-radius: calc(16 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        /* 40px - 48px */
        gap: clamp(2.5rem, 5vw, 3rem);
      }

      .cs-wrapper {
        display: flex;
        flex-direction: column;
        /* 16px - 20px */
        gap: clamp(1rem, 2.3vw, 1.25rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-text {
        max-width: calc(992 / 16 * 1rem);
      }

      .cs-content2 {
        .cs-text {
          margin-bottom: calc(16 / 16 * 1rem);

          &:last-of-type {
            margin-bottom: calc(32 / 16 * 1rem);
          }
        }
      }

      .cs-flex {
        width: 100%;
        /* 24px - 32px top & bottom */
        /* 16px - 32px left & right */
        padding: clamp(1.5rem, 4vw, 2rem) clamp(1rem, 3vw, 2rem);
        box-sizing: border-box;
        background-color: #fbf9f5;
        border-radius: calc(16 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 16px - 32px */
        gap: clamp(1rem, 4vw, 2rem);
      }

      .cs-h3 {
        font-size: calc(25 / 16 * 1rem);
        line-height: 1.2em;
        font-weight: 700;
        /* 16px - 32px */
        margin: 0 0 clamp(1rem, 3vw, 2rem);
        padding-bottom: calc(32 / 16 * 1rem);
        border-bottom: 1px solid #d2d8df;
        color: var(--headerColor);
      }

      .cs-ul {
        width: 100%;
        margin: 0 0 calc(32 / 16 * 1rem);
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: calc(12 / 16 * 1rem);
      }

      .cs-li {
        font-size: var(--bodyFontSize);
        list-style: none;
        line-height: 1.5em;
        width: 100%;
        color: var(--bodyTextColor);
        display: flex;
        justify-content: flex-start;
        /* push icon top the top so if the list item goes to two lines the icon stays at the top */
        align-items: flex-start;
        gap: calc(8 / 16 * 1rem);
      }

      .cs-icon {
        width: calc(19 / 16 * 1rem);
        height: auto;
        /* adds extra space between the icon and top of parent so it's more centered */
        margin-top: 3px;
        display: block;
        flex: none;
      }

      .cs-link {
        font-size: var(--bodyFontSize);
        text-decoration: none;
        line-height: 1.5em;
        font-weight: 700;
        margin: 0;
        color: var(--secondary);
        position: relative;
        z-index: 1;

        &:before {
          content: "";
          width: 100%;
          height: 1px;
          background: currentColor;
          opacity: 1;
          display: block;
          position: absolute;
          bottom: 0;
          left: 0;
        }
      }

      .cs-picture {
        width: 100%;
        height: 75vw;
        max-height: calc(350 / 16 * 1rem);
        border-radius: calc(16 / 16 * 1rem);
        /* clips the border radius of the image */
        overflow: hidden;
        display: block;
        order: -1;
        position: relative;
        z-index: 1;

        img {
          width: 100%;
          height: 100%;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          object-fit: cover;
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #sbs-2375 {
      .cs-flex {
        flex-direction: row;
        align-items: stretch;

        &:nth-child(even) {
          .cs-picture {
            order: -1;
          }
        }
      }

      .cs-h3 {
        /* 108px - 142px */
        min-height: clamp(6.75rem, 12vw, 8.875rem);
      }

      .cs-picture {
        width: 70vw;
        max-width: calc(528 / 16 * 1rem);
        height: auto;
        max-height: 100%;
        order: 2;
      }
    }
  }
</style>
