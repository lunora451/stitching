<style lang="scss">
  /*-- -------------------------- -->
<---       Side By Side         -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #sbs-364,
    #sbsr-364 {
      padding: var(--sectionPadding);
      overflow: hidden;

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
        max-width: calc(550 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
        position: relative;
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: left;
        width: 100%;
        max-width: calc(522 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: flex-start;
      }

      .cs-text {
        margin-bottom: calc(16 / 16 * 1rem);
        &:last-of-type {
          margin-bottom: calc(32 / 16 * 1rem);
        }
      }

      .cs-ul {
        width: 100%;
        margin: 0 0 calc(32 / 16 * 1rem) 0;
        padding: 0 0 0 calc(20 / 16 * 1rem);
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: calc(8 / 16 * 1rem);
      }

      .cs-li {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.5em;
        list-style: none;
        margin-right: 0;
        color: var(--bodyTextColor);
        position: relative;

        &:before {
          /* bullets */
          content: "";
          width: calc(4 / 16 * 1rem);
          height: calc(4 / 16 * 1rem);
          border-radius: 50%;
          background: currentColor;
          opacity: 1;
          position: absolute;
          display: block;
          top: calc(9 / 16 * 1rem);
          left: calc(-15 / 16 * 1rem);
        }
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        /* 46px - 56px */
        line-height: clamp(2.875rem, 5.5vw, 3.5rem);
        text-decoration: none;
        font-weight: 700;
        text-align: center;
        margin: 0;
        color: #fff;
        min-width: calc(150 / 16 * 1rem);
        padding: 0 calc(24 / 16 * 1rem);
        background-color: var(--primary);
        border-radius: calc(4 / 16 * 1rem);
        display: inline-block;
        position: relative;
        z-index: 1;
        /* prevents padding from adding to the width */
        box-sizing: border-box;

        &:before {
          content: "";
          position: absolute;
          height: 100%;
          width: 0%;
          background: #000;
          opacity: 1;
          top: 0;
          left: 0;
          z-index: -1;
          border-radius: calc(4 / 16 * 1rem);
          transition: width 0.3s;
        }

        &:hover {
          &:before {
            width: 100%;
          }
        }
      }

      .cs-image-group {
        /* scale down the whole section */
        font-size: min(1.6vw, 0.6em);
        /* aligns the .cs-image-group to the right */
        text-align: right;
        /* using ems so we can scale this container with a font size */
        width: auto;
        min-width: calc(600 / 16 * 1em);
        /* changes auto at desktop */
        height: calc(759 / 16 * 1em);
        position: relative;
      }

      .cs-splash {
        position: absolute;
        width: 120%;
        height: auto;
        display: block;
        top: calc(20 / 16 * 1em);
        left: 50%;
        transform: translateX(-54%);
      }

      .cs-person {
        height: 100%;
        width: auto;
        /* allows text align to move it left or right */
        display: inline-flex;
        align-items: flex-end;
        justify-content: center;
        position: relative;

        img {
          width: auto;
          height: 100%;
          margin: 0;
          display: block;
        }
      }
    }
  }

  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #sbs-364,
    #sbsr-364 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        flex-direction: row;
        justify-content: space-between;
        position: relative;
      }

      .cs-content {
        width: 50%;
      }

      .cs-image-group {
        font-size: min(1vw, 1em);
        flex: none;
      }
    }
  }

  /* Large Desktop 1300px */
  @media only screen and (min-width: 81.25rem) {
    #sbs-364,
    #sbsr-364 {
      .cs-image-group {
        font-size: min(1.2vw, 1em);
        height: auto;
        margin-right: calc(0 / 16 * 1em);
        display: flex;
        /* pushes person image to the right of the container */
        justify-content: flex-end;
        /* pushed person image to the bottom of the container */
        align-items: flex-end;
        position: absolute;
        right: 50%;
        top: 0;
        /* same amount as the padding bottom on the #sbs, #sbsr*/
        bottom: calc(-100 / 16 * 1rem);
      }

      .cs-content {
        /* pushes it to the right side of the container */
        margin-left: auto;
      }
    }
  }

  /*-- -------------------------- -->
<---    Side By Side Reverse    -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #sbsr-364 {
      background-color: #f7f7f7;
      .cs-image-group {
        /* center the person image */
        text-align: center;
      }
    }
  }

  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #sbsr-364 {
      .cs-image-group {
        order: 2;
      }
    }
  }

  /* Large Desktop 1300px */
  @media only screen and (min-width: 81.25rem) {
    #sbsr-364 {
      .cs-image-group {
        margin-left: calc(100 / 16 * 1em);
        left: 50%;
        right: auto;
        justify-content: center;
      }
      .cs-content {
        margin-left: 0;
        /* push content to the left */
        margin-right: auto;
      }
    }
  }
</style>
