<style lang="scss">
  /*-- -------------------------- -->
<---       Side By Side         -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #RPsbs-1097,
    #RPsbsr-1097 {
      padding: var(--sectionPadding);

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
        max-width: calc(550 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: left;
        width: 100%;
        max-width: calc(522 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: flex-start;
      }

      .cs-text {
        margin-bottom: calc(16 / 16 * 1rem);
        &:last-of-type {
          margin-bottom: calc(32 / 16 * 1rem);
        }
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        /* 46px - 56px */
        line-height: clamp(2.875rem, 5.5vw, 3.5rem);
        text-decoration: none;
        font-weight: 700;
        text-align: center;
        margin: 0;
        color: #fff;
        min-width: calc(150 / 16 * 1rem);
        padding: 0 calc(24 / 16 * 1rem);
        background-color: var(--primary);
        display: inline-block;
        position: relative;
        z-index: 1;
        /* prevents padding from adding to the width */
        box-sizing: border-box;

        &:before {
          content: "";
          position: absolute;
          height: 100%;
          width: 0%;
          background: #000;
          opacity: 1;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
        }

        &:hover {
          &:before {
            width: 100%;
          }
        }
      }

      .cs-list {
        max-width: calc(630 / 16 * 1rem);
        margin: 0 0 calc(32 / 16 * 1rem) 0;
        padding: 0;
        /* clips the bullets to create the half circle */
        overflow: hidden;
      }

      .cs-li {
        list-style: none;
        margin: 0 0 calc(8 / 16 * 1rem) 0;
        color: var(--bodyTextColor);
        display: flex;
        justify-content: flex-start;
        align-items: flex-start;
        gap: calc(12 / 16 * 1rem);
        position: relative;

        &:before {
          /* bullet */
          content: "";
          width: calc(16 / 16 * 1rem);
          height: calc(16 / 16 * 1rem);
          margin-top: calc(3 / 16 * 1rem);
          /* make it overflow the parent by half it's width to make an eclipse */
          margin-left: calc(-8 / 16 * 1rem);
          background: var(--secondary);
          border-radius: 50%;
          display: block;
          /* prevents flexbox from squishing it */
          flex: none;
        }
      }

      .cs-info {
        width: 100%;
        padding-top: calc(32 / 16 * 1rem);
        border-top: 1px solid #e8e8e8;
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: calc(12 / 16 * 1rem);
        position: relative;
      }

      .cs-icon {
        width: calc(52 / 16 * 1rem);
        height: auto;
        display: block;
        transition: transform 0.3s;
      }

      .cs-flex {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: calc(4 / 16 * 1rem);
      }

      .cs-name {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 4vw, 1.5625rem);
        line-height: 1.2em;
        font-weight: 700;
        margin: 0;
        color: var(--headerColor);
        display: block;
      }

      .cs-desc {
        font-size: calc(14 / 16 * 1rem);
        line-height: 1.5em;
        margin: 0;
        color: var(--bodyTextColor);
        display: block;
      }

      .cs-image-group {
        /* scales the whole group based on the view width size and stop when that vales equals .789em, resets at desktop */
        font-size: min(2.09vw, 0.789em);
        width: calc(694 / 16 * 1em);
        height: calc(688 / 16 * 1em);
        display: block;
        position: relative;
        z-index: 1;
      }

      .cs-picture {
        width: calc(542 / 16 * 1em);
        height: calc(608 / 16 * 1em);
        position: absolute;
        bottom: 0;
        left: calc(88 / 16 * 1em);
        z-index: -1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
        }
      }

      .cs-stripes {
        width: calc(522 / 16 * 1em);
        height: auto;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -2;
      }

      .cs-graphic {
        width: calc(184 / 16 * 1em);
        height: auto;
        display: block;
        position: absolute;
        bottom: calc(80 / 16 * 1em);
        right: 0;
      }
    }
  }

  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #RPsbs-1097,
    #RPsbsr-1097 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }

      .cs-image-group {
        font-size: min(1.2vw, 1em);
        flex: none;
      }
    }
  }

  /*-- -------------------------- -->
<---   Side By Side Reverse     -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #RPsbsr-1097 {
      background-color: #f7f7f7;

      .cs-picture {
        right: calc(88 / 16 * 1em);
        left: auto;
      }

      .cs-stripes {
        right: 0;
        left: auto;
      }

      .cs-graphic {
        left: 0;
        right: auto;
      }
    }
  }

  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #RPsbsr-1097 {
      .cs-image-group {
        /* sends it to the right in the 2nd position */
        order: 2;
      }
    }
  }
</style>
