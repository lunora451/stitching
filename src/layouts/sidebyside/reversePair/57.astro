<style lang="scss">
  /*-- -------------------------- -->
<---       Side By Side         -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #RPsbs-414,
    #RPsbsr-414 {
      padding: var(--sectionPadding);
      /* clips svg as the screen grows so it doesn't overflow */
      overflow: hidden;
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        /* changes to 1280 at tablet */
        max-width: calc(550 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 108px */
        gap: clamp(3rem, 6vw + 1.1em, 6.75rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: left;
        width: 100%;
        max-width: calc(542 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: flex-start;
      }

      .cs-text {
        margin-bottom: calc(16 / 16 * 1rem);
        &:last-of-type {
          margin-bottom: calc(32 / 16 * 1rem);
        }
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        /* 46px - 56px */
        line-height: clamp(2.875rem, 5.5vw, 3.5rem);
        text-decoration: none;
        font-weight: 700;
        text-align: center;
        margin: 0;
        color: #fff;
        min-width: calc(150 / 16 * 1rem);
        padding: 0 calc(24 / 16 * 1rem);
        background-color: var(--primary);
        border-radius: calc(4 / 16 * 1rem);
        display: inline-block;
        position: relative;
        z-index: 1;
        /* prevents padding from adding to the width */
        box-sizing: border-box;

        &:before {
          content: "";
          position: absolute;
          height: 100%;
          width: 0%;
          background: #000;
          opacity: 1;
          top: 0;
          left: 0;
          z-index: -1;
          border-radius: calc(4 / 16 * 1rem);
          transition: width 0.3s;
        }

        &:hover {
          &:before {
            width: 100%;
          }
        }
      }

      .cs-image-group {
        font-size: min(2.5vw, 1em);
        width: calc(579 / 16 * 1em);
        height: calc(542 / 16 * 1em);
        /* sends it to the top of the flexbox */
        order: -1;
        position: relative;
      }

      .cs-picture {
        border-radius: calc(20 / 16 * 1em);
        /* clips the img tag corners */
        overflow: hidden;
        position: absolute;
        display: block;

        &:hover {
          &:before {
            opacity: 0.6;
          }

          img {
            transform: scale(1.1);
          }
        }

        &:before {
          /* Hover Box */
          content: "";
          width: 100%;
          height: 100%;
          background: var(--primary);
          opacity: 0;
          position: absolute;
          display: block;
          top: 0;
          left: 0;
          z-index: 10;
          transition: opacity 0.3s;
        }

        img {
          position: absolute;
          top: 0;
          left: 0;
          height: 100%;
          width: 100%;
          object-fit: cover;
          transition: transform 0.6s;
        }
      }

      .cs-picture1 {
        width: calc(204 / 16 * 1em);
        height: calc(314 / 16 * 1em);
        top: 0;
        left: 0;
      }

      .cs-picture2 {
        width: calc(348 / 16 * 1em);
        height: calc(314 / 16 * 1em);
        top: 0;
        right: 0;
      }

      .cs-picture3 {
        width: calc(579 / 16 * 1em);
        height: calc(202 / 16 * 1em);
        bottom: 0;
        left: 0;
      }
    }
  }

  /* Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #RPsbs-414,
    #RPsbsr-414 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        flex-direction: row;
        align-items: center;
        justify-content: flex-start;
      }

      .cs-content {
        width: 48%;
      }

      .cs-image-group {
        font-size: min(1.15vw, 1em);
        flex: none;
      }
    }
  }

  /*-- -------------------------- -->
<---    Side By Side Reverse    -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #RPsbsr-414 {
      background-color: #f7f7f7;
    }
  }

  /* Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #RPsbsr-414 {
      .cs-container {
        justify-content: flex-end;
      }
      .cs-content {
        /* sends it to the left */
        order: -1;
      }
    }
  }
</style>
