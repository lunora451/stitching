<style lang="scss">
  /*-- -------------------------- -->
<---       Side By Side         -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #RPsbs-1287,
    #RPsbsr-1287 {
      padding: var(--sectionPadding);
      background-color: #f7f7f7;
      overflow: hidden;

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
        max-width: calc(550 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: left;
        width: 100%;
        max-width: calc(630 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: flex-start;
      }

      .cs-text {
        margin-bottom: calc(16 / 16 * 1rem);
        &:last-of-type {
          margin-bottom: calc(32 / 16 * 1rem);
        }
      }

      .cs-ul {
        max-width: calc(630 / 16 * 1rem);
        margin: 0 0 calc(32 / 16 * 1rem) 0;
        padding: 0;
        /* clips the bullets to create the half circle */
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: calc(12 / 16 * 1rem);
      }

      .cs-li {
        list-style: none;
        margin: 0;
        color: var(--bodyTextColor);
        display: flex;
        justify-content: flex-start;
        align-items: flex-start;
        gap: calc(12 / 16 * 1rem);
        position: relative;
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        /* 46px - 56px */
        line-height: clamp(2.875rem, 5.5vw, 3.5rem);
        text-decoration: none;
        font-weight: 700;
        text-align: center;
        margin: 0;
        color: #fff;
        min-width: calc(150 / 16 * 1rem);
        padding: 0 calc(24 / 16 * 1rem);
        background-color: var(--primary);
        border-radius: calc(4 / 16 * 1rem);
        display: inline-block;
        position: relative;
        z-index: 1;
        /* prevents padding from adding to the width */
        box-sizing: border-box;

        &:before {
          content: "";
          position: absolute;
          height: 100%;
          width: 0%;
          background: #000;
          opacity: 1;
          top: 0;
          left: 0;
          z-index: -1;
          border-radius: calc(4 / 16 * 1rem);
          transition: width 0.3s;
        }

        &:hover {
          &:before {
            width: 100%;
          }
        }
      }

      .cs-image-group {
        /* scales the whole group based on the view width size and stop when that vales equals .845em, resets at desktop */
        font-size: min(2.207vw, 1em);
        width: calc(545 / 16 * 1em);
        height: calc(793 / 16 * 1em);
        display: block;
        position: relative;
        z-index: 1;
      }

      .cs-picture {
        border-radius: calc(8 / 16 * 1em);
        overflow: hidden;
        position: absolute;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      .cs-picture1 {
        width: calc(244 / 16 * 1em);
        height: calc(200 / 16 * 1em);
        top: 0;
        left: 0;
      }

      .cs-picture2 {
        width: calc(244 / 16 * 1em);
        height: calc(270 / 16 * 1em);
        top: calc(40 / 16 * 1em);
        right: calc(33 / 16 * 1em);
      }

      .cs-picture3 {
        width: calc(244 / 16 * 1em);
        height: calc(270 / 16 * 1em);
        top: calc(220 / 16 * 1em);
        left: 0;
      }

      .cs-picture4 {
        width: calc(310 / 16 * 1em);
        height: calc(343 / 16 * 1em);
        box-shadow: 0px 24px 52px 0px rgba(0, 0, 0, 0.38);
        top: calc(294 / 16 * 1em);
        right: 0;
        z-index: 10;
      }

      .cs-picture5 {
        width: calc(244 / 16 * 1em);
        height: calc(270 / 16 * 1em);
        top: calc(510 / 16 * 1em);
        left: 0;
      }

      .cs-picture6 {
        width: calc(244 / 16 * 1em);
        height: calc(190 / 16 * 1em);
        bottom: 0;
        right: calc(33 / 16 * 1em);
      }

      .cs-waves-wrapper {
        /* changes to 100% at desktop */
        width: 100vw;
        height: 150%;
        position: absolute;
        bottom: 0;
        left: 50%;
        z-index: -1;
        /* changes at desktop */
        transform: translateX(-50%);

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
        }
      }
    }
  }

  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #RPsbs-1287,
    #RPsbsr-1287 {
      padding-top: 0;
      padding-bottom: 0;

      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }

      .cs-content {
        padding: calc(100 / 16 * 1rem) 0;
        align-self: center;
      }

      .cs-image-group {
        font-size: min(1.2vw, 1em);
        flex: none;
      }

      .cs-picture1 {
        border-radius: 0 0 calc(16 / 16 * 1rem) calc(16 / 16 * 1rem);
      }

      .cs-picture6 {
        border-radius: 0;
      }

      .cs-waves-wrapper {
        width: 110%;
        height: 100%;
        display: none;
        left: 50%;
        bottom: 50%;
        transform: translate(-50%, 50%);
      }
    }
  }

  /*-- -------------------------- -->
<---   Side By Side Reverse     -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #RPsbsr-1287 {
      background-color: #1a1a1a;

      .cs-content {
        max-width: calc(522 / 16 * 1rem);
      }

      .cs-title,
      .cs-text {
        color: var(--bodyTextColorWhite);
      }

      .cs-text {
        opacity: 0.8;
      }
    }
  }

  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #RPsbsr-1287 {
      .cs-content {
        /* sends it to the left */
        order: -1;
      }

      .cs-waves-wrapper {
        display: block;
      }
    }
  }

  /* Large Desktop - 1200px */
  @media only screen and (min-width: 75rem) {
    #RPsbsr-1287 {
      .cs-container {
        padding-right: calc(88 / 16 * 1rem);
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
      }

      .cs-waves-wrapper {
        width: calc(692 / 16 * 1rem);
        height: initial;
        right: calc(-88 / 16 * 1rem);
        left: auto;
        top: 0;
        bottom: 0;
        transform: none;
      }
    }
  }
</style>
