  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #pricing-2062 {
      padding: var(--sectionPadding);
      /* clips svg graphic from overflowing the section */
      overflow: hidden;
      position: relative;
      z-index: 1;
      transform-style: preserve-3d;

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
        max-width: calc(550 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
        position: relative;
        perspective: 1100px;
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        margin-right: auto;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-toggle-group {
        max-width: calc(241 / 16 * 1rem);
        margin: 0;
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
        background-color: #484848;
        overflow: hidden;
        border-radius: calc(16 / 16 * 1rem);
        display: flex;
        justify-content: center;
        align-items: center;
        /* causes the toggle group to grow to it's "auto" size before the rest of the space of the flex parent is allocated to .cs-content */
        flex: 1 0 auto;

        &.active {
          .cs-plan:nth-of-type(1) {
            background-color: #484848;
          }

          .cs-plan:nth-of-type(2) {
            background-color: var(--primary);
          }
        }
      }

      .cs-plan {
        /* 13px - 16px */
        font-size: clamp(0.8125rem, 2vw, 1rem);
        font-weight: 700;
        line-height: 1.2em;
        text-transform: uppercase;
        letter-spacing: 1.3px;
        margin: 0;
        padding: calc(16 / 16 * 1rem) calc(28 / 16 * 1rem);
        background-color: #484848;
        color: var(--bodyTextColorWhite);

        &:hover {
          cursor: pointer;
        }

        &:nth-of-type(1) {
          background-color: var(--primary);
        }
      }

      .cs-ul-wrapper {
        position: relative;
        z-index: 10;
        perspective: 1200px;

        &.cs-active .cs-option1 {
          transform: rotateY(180deg);
        }

        &.cs-active .cs-option2 {
          transform: rotateY(360deg);
        }
      }

      .cs-option2 {
        width: 100%;
        position: absolute;
        top: 0;
        left: 0;
        transform: rotateY(180deg);
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        border-radius: calc(24 / 16 * 1rem);
        display: flex;
        -webkit-backface-visibility: hidden; /* Safari */
        backface-visibility: hidden;
        align-items: center;
        flex-wrap: wrap;
        gap: calc(16 / 16 * 1rem);
        transition: transform 0.8s;
        /* prevents flexbox from squishing it */
        flex: none;
      }

      .cs-item {
        text-align: left;
        list-style: none;
        width: 100%;
        margin: 0;
        padding: calc(32 / 16 * 1rem) calc(24 / 16 * 1rem);
        background-color: #fff;
        border-radius: calc(16 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        align-items: stretch;
        position: relative;
        z-index: 1;
      }

      .cs-package {
        margin: 0 0 calc(24 / 16 * 1rem);
        display: flex;
        justify-content: space-between;
        gap: calc(24 / 16 * 1rem);
      }

      .cs-name {
        /* 25px - 31px */
        font-size: clamp(1.5625rem, 4vw, 1.9375rem);
        font-weight: 700;
        line-height: 1.2em;
        color: var(--headerColor);
        display: block;
      }

      .cs-tag {
        font-size: calc(13 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        text-transform: uppercase;
        letter-spacing: 1.3px;
        padding: calc(12 / 16 * 1rem) calc(20 / 16 * 1rem);
        color: var(--headerColor);
        border: 1px solid var(--headerColor);
        border-radius: calc(8 / 16 * 1rem);
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .cs-price {
        font-size: calc(49 / 16 * 1rem);
        font-weight: 900;
        line-height: 1.2em;
        margin: 0 0 calc(16 / 16 * 1rem);
        color: var(--secondary);
        display: flex;
        justify-content: flex-start;
        align-items: flex-end;
        gap: calc(4 / 16 * 1rem);
      }

      .cs-duration {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.3em;
        margin: 0;
        color: var(--headerColor);
        transform: translateY(-9px);
      }

      .cs-item-text {
        /* 14px - 16px */
        font-size: clamp(0.875rem, 1.5vw, 1rem);
        line-height: 1.5em;
        text-align: inherit;
        margin: 0 0 calc(24 / 16 * 1rem);
        padding: 0 0 calc(24 / 16 * 1rem);
        color: var(--bodyTextColor);
        border-bottom: 1px solid #e8f8f7;
      }

      .cs-ul {
        width: 100%;
        margin: 0 0 calc(24 / 16 * 1rem) 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: calc(12 / 16 * 1rem);
      }

      .cs-li {
        font-size: var(--bodyFontSize);
        line-height: 1.5em;
        list-style: none;
        width: 100%;
        color: var(--bodyTextColor);
        display: flex;
        justify-content: flex-start;
        /* push icon top the top so if the list item goes to two lines the icon stays at the top */
        align-items: flex-start;
        gap: calc(8 / 16 * 1rem);
      }

      .cs-disabled {
        filter: grayscale(1);
        opacity: 0.5;

        .cs-icon {
          filter: grayscale(1);
        }
      }

      .cs-icon {
        width: calc(24 / 16 * 1rem);
        height: auto;
        /* adds extra space between the icon and top of parent so it's more centered */
        margin-top: 1px;
        display: block;
      }

      .button-solid {
        width: 100%;
      }

      .cs-button-transparent {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        /* 46px - 56px */
        line-height: clamp(2.875rem, 5.5vw, 3.5rem);
        text-align: center;
        text-decoration: none;
        min-width: calc(150 / 16 * 1rem);
        margin: auto 0 0;
        /* prevents padding from adding to the width */
        box-sizing: border-box;
        padding: 0 calc(24 / 16 * 1rem);
        background-color: transparent;
        color: var(--primary);
        border: 1px solid var(--primary);
        border-radius: calc(8 / 16 * 1rem);
        display: inline-block;
        position: relative;
        z-index: 1;
        transition:
          color 0.3s,
          border-color 0.3s,
          background-color 0.3s;

        &:before {
          content: "";
          width: 0%;
          height: 100%;
          background: var(--primary);
          opacity: 1;
          border-radius: calc(4 / 16 * 1rem);
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
        }

        &:hover {
          background-color: var(--primary);
          color: #fff;
          border-color: var(--primary);
          &:before {
            width: 100%;
          }
        }
      }

      .cs-background {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }

        &::before {
          content: "";
          width: 100%;
          height: 100%;
          background:
            linear-gradient(
              0deg,
              rgba(243, 252, 251, 0.84) 0%,
              rgba(243, 252, 251, 0.84) 100%
            ),
            rgba(0, 0, 0, 0) 50% / cover no-repeat;
          position: absolute;
          top: 0;
          left: 0;
        }
      }
    }
  }

