<style lang="scss">
  /*-- -------------------------- -->
<---          Pricing           -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #pricing-1233 {
      padding: var(--sectionPadding);

      .cs-container {
        width: 100%;
        /* changes to 1280px at tablet */
        max-width: calc(550 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
        position: relative;
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-text {
        margin: 0 0 calc(32 / 16 * 1rem);
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        /* 46px - 56px */
        line-height: clamp(2.875em, 5.5vw, 3.5em);
        text-decoration: none;
        font-weight: 700;
        text-align: center;
        margin: 0;
        color: #1a1a1a;
        min-width: calc(241 / 16 * 1rem);
        padding: 0 calc(32 / 16 * 1rem);
        background-color: var(--primary);
        display: inline-block;
        position: relative;
        z-index: 1;
        /* prevents padding from adding to the width */
        box-sizing: border-box;
        transition: color 0.3s;

        &:before {
          content: "";
          position: absolute;
          height: 100%;
          width: 0%;
          background: #000;
          opacity: 1;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
        }

        &:hover {
          color: #fff;
          &:before {
            width: 100%;
          }
        }
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        /* 16px - 20px */
        gap: clamp(1rem, 1.8vw, 1.25rem);
        /* prevents flexbox from squishing it */
        flex: none;
      }

      .cs-item {
        text-align: left;
        list-style: none;
        width: 100%;
        margin: 0;
        /* 24px - 40px top & Bottom */
        /* 20px - 40px left & right */
        padding: clamp(1.5rem, 4.2vw, 2.5rem) clamp(1.25rem, 4.2vw, 2.5rem);
        background-color: #f7f7f7;
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: stretch;
      }

      .cs-popular {
        background-color: #1a1a1a;

        .cs-package {
          color: var(--primary);
        }

        .cs-desc,
        .cs-time {
          color: var(--bodyTextColorWhite);
          opacity: 0.8;
        }

        .cs-price {
          color: var(--primary);
        }

        .cs-includes {
          color: var(--bodyTextColorWhite);
        }

        .cs-includes {
          border-color: #484848;
        }

        .cs-li {
          color: #bababa;

          &.cs-disabled {
            color: #767676;

            .cs-icon {
              filter: grayscale(1) brightness(50%);
            }
          }
        }
      }

      .cs-package {
        /* 13px - 16px */
        font-size: clamp(0.8125rem, 1.4vw, 1rem);
        line-height: 1.2em;
        letter-spacing: 0.1em;
        text-align: inherit;
        text-transform: uppercase;
        font-weight: 700;
        /* 4px - 8px */
        margin: 0 0 clamp(0.25rem, 1vw, 0.5rem) 0;
        color: var(--headerColor);
        display: block;
      }

      .cs-desc {
        /* 13px - 16px */
        font-size: clamp(0.8125rem, 1.4vw, 1rem);
        line-height: 1.5em;
        text-align: left;
        /* 12px - 24px */
        margin: 0 0 clamp(0.75rem, 2.5vw, 1.5rem);
        color: var(--bodyTextColor);
        display: block;
      }

      .cs-price {
        /* 39px - 49px */
        font-size: clamp(2.4375rem, 4vw, 3.0625rem);
        white-space: nowrap;
        line-height: 1.2em;
        text-align: inherit;
        font-weight: 900;
        margin: 0;
        color: var(--headerColor);
      }

      .cs-time {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 400;
        display: inline-block;
        margin: 0 0 0 calc(-8 / 16 * 1rem);
        color: var(--bodyTextColor);
      }

      .cs-includes {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.2em;
        text-align: inherit;
        font-weight: 700;
        width: 100%;
        margin: 0;
        /* 16px - 24px */
        padding: clamp(1rem, 3vw, 1.5rem) 0 0 0;
        border-top: 1px solid #e8e8e8;
        display: block;
      }

      .cs-ul {
        /* 16px - 24px */
        margin: clamp(1rem, 3vw, 1.5rem) 0 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        /* 4px - 12px */
        gap: clamp(0.25rem, 1.3vw, 0.75rem);
        position: relative;
      }

      .cs-li {
        /* 14px - 16px */
        font-size: clamp(0.875rem, 1.5vw, 1rem);
        list-style: none;
        line-height: 1.5em;
        width: 100%;
        margin: 0;
        padding: 0;
        color: var(--bodyTextColor);
        display: flex;
        justify-content: flex-start;
        /* push everything to the top so if the li goes to two lines the icon stays at the top */
        align-items: flex-start;
        gap: calc(8 / 16 * 1rem);

        &.cs-disabled {
          color: #bababa;

          .cs-icon {
            filter: grayscale(1) brightness(125%);
          }
        }
      }

      .cs-icon {
        width: calc(24 / 16 * 1rem);
        height: auto;
        display: block;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #pricing-1233 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
      }

      .cs-item {
        flex-direction: row;
      }

      .cs-item-content {
        width: 30%;
        max-width: calc(228 / 16 * 1rem);
        /* 28px - 40px */
        margin-right: clamp(1.75rem, 4vw, 2.5rem);
        padding-right: clamp(1.75rem, 4vw, 2.5rem);
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
        border-right: 1px solid #e8e8e8;
      }

      .cs-popular {
        .cs-item-content {
          border-color: #484848;
        }
      }

      .cs-includes {
        padding: 0;
        border: none;
      }

      .cs-ul {
        display: grid;
        /* removed at desktop, added again at large desktop */
        grid-template-columns: repeat(2, minmax(9rem, 1fr));
      }

      .cs-li {
        grid-column: span 1;
      }
    }
  }

  /* Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #pricing-1233 {
      .cs-container {
        flex-direction: row;
        align-items: flex-start;
      }

      .cs-content {
        text-align: left;
        max-width: calc(400 / 16 * 1rem);
        align-items: flex-start;
      }

      .cs-card-group {
        /* changes to 813px at large desktop */
        width: 55vw;
        max-width: calc(813 / 16 * 1rem);
      }

      .cs-item-content {
        width: 100%;
        flex: none;
      }

      .cs-ul {
        grid-template-columns: 1fr;
      }

      .cs-li {
        grid-column: span 2;
      }
    }
  }

  /* Large Desktop - 1300px */
  @media only screen and (min-width: 81.25rem) {
    #pricing-1233 {
      .cs-card-group {
        width: calc(813 / 16 * 1rem);
      }
      .cs-ul {
        grid-template-columns: repeat(2, minmax(9rem, 1fr));
      }

      .cs-li {
        grid-column: span 1;
      }
    }
  }
</style>
