<style lang="scss">
  /*-- -------------------------- -->
<---          Pricing           -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #pricing-2184 {
      padding: var(--sectionPadding);
      background-color: #fbf5f1;
      overflow: hidden;
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        /* changes to 1280px at tablet */
        max-width: calc(584 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to center if content needs to be centered */
        text-align: center;
        width: 100%;
        max-width: calc(700 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        /* left aligns content, set to center to align content horizontally */
        align-items: center;
      }

      .cs-card-group {
        width: 100%;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
      }

      .cs-item {
        text-align: center;
        list-style: none;
        /* 32px - 48px top & Bottom */
        /* 16px - 48px left & right */
        padding: clamp(2rem, 6vw, 3rem) clamp(1rem, 3vw, 2.5rem);
        border-bottom: 1px solid #e8e8e8;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 24px - 48px */
        gap: clamp(1.5rem, 5vw, 3rem);
      }

      .cs-flex {
        max-width: calc(700 / 16 * 1rem);
      }

      .cs-h3 {
        /* 31px - 39px */
        font-size: clamp(1.9375rem, 5vw, 2.4375rem);
        line-height: 1.2em;
        font-weight: 700;
        margin: 0 0 calc(16 / 16 * 1rem);
        color: var(--headerColor);
      }

      .cs-item-text {
        /* 14px - 16px */
        font-size: clamp(0.875rem, 1.6vw, 1rem);
        line-height: 1.5em;
        width: 100%;
        margin: 0;
        color: var(--bodyTextColor);
      }

      .cs-price {
        /* 39px - 49px */
        font-size: clamp(2.4375rem, 6vw, 3.0625rem);
        line-height: 1.2em;
        font-weight: 700;
        color: var(--headerColor);
      }

      .cs-link {
        font-size: calc(16 / 16 * 1rem);
        text-decoration: none;
        line-height: calc(56 / 16 * 1rem);
        font-weight: 700;
        margin: 0;
        color: var(--headerColor);
        display: flex;
        justify-content: center;
        align-items: center;
        gap: calc(10 / 16 * 1rem);
      }

      .cs-icon {
        width: calc(20 / 16 * 1rem);
        height: auto;
        display: block;
        transition: transform 0.3s;
      }

      .cs-floater {
        width: clamp(6.25rem, 15vw, 23.625rem);
        height: auto;
        display: block;
        position: absolute;
        top: calc(10 / 16 * 1rem);
        left: 0;
        z-index: -1;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #pricing-2184 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
      }

      .cs-item {
        text-align: left;
        /* 24px - 40px */
        padding-left: clamp(1.5rem, 3vw, 2.5rem);
        padding-right: clamp(1.5rem, 3vw, 2.5rem);
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        /* 64px - 140px */
        gap: clamp(4rem, 11vw, 8.75rem);
        position: relative;
        z-index: 1;

        &:nth-of-type(2) {
          &:before {
            content: "";
            width: 100%;
            height: 100%;
            background: var(--primary);
            opacity: 0.1;
            position: absolute;
            display: block;
            top: 0;
            left: 0;
            z-index: -1;
          }

          .cs-h3,
          .cs-price,
          .cs-link {
            color: var(--primary);
          }

          .cs-icon {
            path {
              fill: var(--primary);
            }
          }
        }
      }

      .cs-h3 {
        width: 30%;
        max-width: calc(325 / 16 * 1rem);
        flex: none;
      }

      .cs-link {
        flex: none;

        &:hover {
          .cs-icon {
            transform: translateX(0.5rem);
          }
        }
      }
    }
  }
</style>
