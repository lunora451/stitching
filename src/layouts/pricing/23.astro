<style lang="scss">
  /*-- -------------------------- -->
<---          Pricing           -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #pricing-1030,
    #pricingr-1030 {
      padding: var(--sectionPadding);

      .cs-container {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: left;
        width: 100%;
        max-width: calc(738 / 16 * 1rem);
        /* 24px - 48px */
        padding: calc(48 / 16 * 1rem) clamp(1.5rem, 3.5vw, 3rem);
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
        border: 1px solid #c7c7c7;
        border-top: none;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: flex-start;
      }

      .cs-title {
        margin: 0;
        /* frees the :after element from the cs-title parent. It's now relative to the cs-content parent */
        display: contents;
        &:after {
          /* underline */
          content: "";
          width: 100%;
          height: 1px;
          /* 20px - 32px */
          margin: clamp(1.25rem, 3vw, 2rem) 0;
          background: #c7c7c7;
          opacity: 1;
          position: relative;
          display: block;
        }
      }

      .cs-menu {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        column-gap: calc(20 / 16 * 1rem);
        /* 28px - 40px */
        row-gap: clamp(1.75rem, 3vw, 2.5rem);
      }

      .cs-menu-group {
        width: 100%;
        max-width: calc(630 / 16 * 1rem);
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        /* 28px - 40px */
        gap: clamp(1.75rem, 3vw, 2.5rem);
      }

      .cs-menu-item {
        list-style: none;
        width: 100%;
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        gap: calc(8 / 16 * 1rem);
      }

      .cs-h3 {
        width: 100%;
        margin: 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: calc(8 / 16 * 1rem);
        position: relative;
        z-index: 1;

        &:before {
          /* grey line */
          content: "";
          width: 60%;
          height: 1px;
          background-image: linear-gradient(
            90deg,
            #c7c7c7,
            #c7c7c7 75%,
            transparent 75%,
            transparent 100%
          );
          background-size: 6px 6px;
          border: none;
          opacity: 1;
          display: block;
          order: 2;
          z-index: -1;
        }
      }

      .cs-header {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 2vw, 1.5625rem);
        line-height: 1.2em;
        text-align: inherit;
        font-weight: 700;
        width: auto;
        max-width: 70%;
        color: var(--headerColor);
        display: block;
        flex: none;
      }

      .cs-price {
        /* 25px - 31px */
        font-size: clamp(1.6525rem, 2.5vw, 1.9375rem);
        line-height: 1.2em;
        font-weight: bold;
        color: var(--primary);
        order: 3;
      }

      .cs-menu-text {
        /* 16px - 20px */
        font-size: clamp(1rem, 2vw, 1.25rem);
        line-height: 1.5em;
        text-align: inherit;
        margin: 0;
        color: var(--bodyTextColor);
      }

      .cs-picture {
        width: 100%;
        height: 72vw;
        display: block;
        /* sends it to the top */
        order: -1;
        position: relative;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #pricing-1030,
    #pricingr-1030 {
      .cs-container {
        flex-direction: row;
        justify-content: space-between;
        align-items: stretch;
      }

      .cs-content {
        width: 66%;
        border: 1px solid #c7c7c7;
        border-left: none;
        /* prevents flexbox from squishing it */
        flex: none;
      }

      .cs-menu-group {
        width: 100%;
      }

      .cs-picture {
        width: 100%;
        height: auto;
        max-width: calc(542 / 16 * 1rem);
        max-height: 1000%;
      }
    }
  }

  /*-- -------------------------- -->
<---          Pricing           -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #pricingr-1030 {
      background-color: #f7f7f7;
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #pricingr-1030 {
      .cs-content {
        border: 1px solid #c7c7c7;
        border-right: none;
      }

      .cs-picture {
        /* sends it to the right in the 2nd position */
        order: 2;
      }
    }
  }
</style>
