<style lang="scss">
  .c-collection {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .c-sidebyside {
    display: none;
  }
  .active {
    width: 100%;
    display: block;
  }
</style>

<script>
  function changeCollection(selectedValue) {
    const collections = document.querySelectorAll(".c-sidebyside");

    // Retirer active de toutes les collections
    collections.forEach((collection) => {
      collection.classList.remove("active");
    });

    // Si "none" est sélectionné, ne rien afficher
    if (selectedValue === "none") {
      return;
    }

    // Afficher la collection sélectionnée
    const targetCollection = document.querySelector(
      `[data-value-sidebyside="${selectedValue}"]`
    );
    if (targetCollection) {
      targetCollection.classList.add("active");
    }
  }

  // Fonction pour le hover des options
  function previewOnHover(selectedValue) {
    const collections = document.querySelectorAll(".c-sidebyside");

    // Retirer active de toutes les collections
    collections.forEach((collection) => {
      collection.classList.remove("active");
    });

    // Si "none", ne rien afficher
    if (selectedValue === "none") {
      return;
    }

    // Afficher la collection en preview
    const targetCollection = document.querySelector(
      `[data-value-sidebyside="${selectedValue}"]`
    );
    if (targetCollection) {
      targetCollection.classList.add("active");
    }
  }

  document.addEventListener("DOMContentLoaded", function () {
    const select = document.getElementById("template-select-sidebyside");
    const collections = document.querySelectorAll(".c-hero");

    if (!select) return;

    select.addEventListener("change", function () {
      const selectedValue = this.value;
      changeCollection(selectedValue);
    });

    // Alternative pour navigateur qui ne supportent pas mouseover sur option
    let isSelectOpen = false;

    select.addEventListener("focus", function () {
      isSelectOpen = true;
    });

    select.addEventListener("blur", function () {
      isSelectOpen = false;
      // Revenir à la valeur sélectionnée quand on ferme
      changeCollection(this.value);
    });

    // Navigation avec les flèches
    select.addEventListener("keydown", function (e) {
      if (isSelectOpen && (e.key === "ArrowUp" || e.key === "ArrowDown")) {
        setTimeout(() => {
          // Simuler le hover sur l'option "focusée"
          const currentValue = this.value;
          previewOnHover(currentValue);
        }, 10);
      }
    });
  });
</script>
