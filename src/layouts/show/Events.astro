---
import Events1 from "../events/1.astro";
import Events2 from "../events/2.astro";
import Events3 from "../events/3.astro";
import Events4 from "../events/4.astro";
import Events5 from "../events/5.astro";
import Events6 from "../events/6.astro";
import Events7 from "../events/7.astro";
import Events8 from "../events/8.astro";
import Events9 from "../events/9.astro";
import Events10 from "../events/10.astro";
---

<div class="c-collection">
  <div class="c-events" data-value-events="1"><Events1 /></div>
  <div class="c-events" data-value-events="2"><Events2 /></div>
  <div class="c-events" data-value-events="3"><Events3 /></div>
  <div class="c-events" data-value-events="4"><Events4 /></div>
  <div class="c-events" data-value-events="5"><Events5 /></div>
  <div class="c-events" data-value-events="6"><Events6 /></div>
  <div class="c-events" data-value-events="7"><Events7 /></div>
  <div class="c-events" data-value-events="8"><Events8 /></div>
  <div class="c-events" data-value-events="9"><Events9 /></div>
  <div class="c-events" data-value-events="10"><Events10 /></div>
</div>

<style lang="scss">
  .c-collection {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .c-events {
    display: none;
  }
  .active {
    width: 100%;
    display: block;
  }
</style>

<script>
  function changeCollection(selectedValue) {
    const collections = document.querySelectorAll(".c-events");

    // Retirer active de toutes les collections
    collections.forEach((collection) => {
      collection.classList.remove("active");
    });

    // Si "none" est sélectionné, ne rien afficher
    if (selectedValue === "none") {
      return;
    }

    // Afficher la collection sélectionnée
    const targetCollection = document.querySelector(
      `[data-value-events="${selectedValue}"]`
    );
    if (targetCollection) {
      targetCollection.classList.add("active");
    }
  }

  // Fonction pour le hover des options
  function previewOnHover(selectedValue) {
    const collections = document.querySelectorAll(".c-events");

    // Retirer active de toutes les collections
    collections.forEach((collection) => {
      collection.classList.remove("active");
    });

    // Si "none", ne rien afficher
    if (selectedValue === "none") {
      return;
    }

    // Afficher la collection en preview
    const targetCollection = document.querySelector(
      `[data-value-events="${selectedValue}"]`
    );
    if (targetCollection) {
      targetCollection.classList.add("active");
    }
  }

  document.addEventListener("DOMContentLoaded", function () {
    const select = document.getElementById("template-select-events");
    const collections = document.querySelectorAll(".c-team");

    if (!select) return;

    select.addEventListener("change", function () {
      const selectedValue = this.value;
      changeCollection(selectedValue);
    });

    // Alternative pour navigateur qui ne supportent pas mouseover sur option
    let isSelectOpen = false;

    select.addEventListener("focus", function () {
      isSelectOpen = true;
    });

    select.addEventListener("blur", function () {
      isSelectOpen = false;
      // Revenir à la valeur sélectionnée quand on ferme
      changeCollection(this.value);
    });

    // Navigation avec les flèches
    select.addEventListener("keydown", function (e) {
      if (isSelectOpen && (e.key === "ArrowUp" || e.key === "ArrowDown")) {
        setTimeout(() => {
          // Simuler le hover sur l'option "focusée"
          const currentValue = this.value;
          previewOnHover(currentValue);
        }, 10);
      }
    });
  });
</script>
