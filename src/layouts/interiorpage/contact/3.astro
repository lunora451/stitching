              background-color: var(--secondaryLight);
              transform: rotate(-315deg);
            }
          }
          .cs-item-p {
            height: auto;
            /* 20px - 24px top & bottom */
            /* 16px - 24px left & right */
            padding: clamp(1.25rem, 1.3vw, 1.5rem) clamp(1rem, 2vw, 1.5rem);
            opacity: 1;
          }
        }
