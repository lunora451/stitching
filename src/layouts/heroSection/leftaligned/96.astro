      <div class="cs-spotlight">
        <img
          class="cs-image"
          aria-hidden="true"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/chef-small.jpg"
          decoding="async"
          alt="graphic"
          width="154"
          height="154"
        />
        <div class="cs-flex">
          <span class="cs-name">Renaldi Tan</span>
          <span class="cs-job">Head Chef</span>
