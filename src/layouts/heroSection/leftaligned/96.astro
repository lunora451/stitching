      </div>
    </div>
    <div class="cs-image-group">
      <img
        class="cs-icon"
        aria-hidden="true"
        src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Icons/top-rated.svg"
        decoding="async"
        alt="icon"
        width="116"
        height="124"
      />
      <span class="cs-tagline">Today's Special</span>
      <h2 class="cs-h2">Seared Steak Special</h2>
      <p class="cs-desc">Lorem ipsum dolor sit amet, consectetur</p>
      <picture class="cs-picture">
        <!--Mobile Image-->
        <source
          media="(max-width: 600px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Food-Menu/steak.jpg"
        />
        <!--Tablet and above Image-->
        <source
          media="(min-width: 601px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Food-Menu/steak.jpg"
        />
