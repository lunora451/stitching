      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        line-height: calc(56 / 16 * 1rem);
        text-decoration: none;
        margin: 0;
        padding: 0 calc(48 / 16 * 1rem);
        background-color: var(--secondary);
        overflow: hidden;
        color: #fff;
        border-radius: calc(16 / 16 * 1rem);
        display: inline-block;
        position: relative;
        z-index: 1;
        transition: color 0.3s;

        &:before {
          content: "";
          width: 0%;
          height: 100%;
          background: #1a1a1a;
