          color: #fff;
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #hero-1969 {
      .cs-wrapper {
        padding: calc(80 / 16 * 1rem) calc(28 / 16 * 1rem);
        align-items: flex-end;
      }

      .cs-form-wrapper {
        max-width: calc(374 / 16 * 1rem);
      }
    }
  }

  /* Large Desktop - 1300px */
  @media only screen and (min-width: 81.25rem) {
    #hero-1969 {
      .cs-title {
        margin: 0;
      }

      .cs-container {
        max-width: calc(1880 / 16 * 1rem);
      }

      .cs-content {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        gap: calc(64 / 16 * 1rem);
      }

      .cs-flex {
        width: 50%;
        max-width: calc(455 / 16 * 1rem);
      }

      .cs-wrapper {
        padding: calc(80 / 16 * 1rem);
      }
    }
  }
</style>
