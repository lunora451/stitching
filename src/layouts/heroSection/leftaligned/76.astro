        background-color: #dab692;
        /* clips img tag from overflowing it on hover */
        overflow: hidden;
        /* 100px - 220px */
        border-radius: calc(16 / 16 * 1rem);
        display: block;
        position: relative;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
          transition: transform 0.7s;
        }
      }

      .cs-label {
