<!-- ============================================ --><!--                     Hero                     --><!-- ============================================ -->
<section id="hero-1969">
  <div class="cs-container">
    <div class="cs-content">
      <h2 class="cs-title">
        Innovative Technology And Professional Dental Services
      </h2>
      <div class="cs-flex">
        <p class="cs-text">
          At our dental clinic, we are committed to providing the highest
          quality dental care to our patients. Our experienced team of dental
          professionals utilizes the latest technology and techniques to ensure
          that each patient receives personalized and effective treatment.
        </p>
      </div>
    </div>
    <div class="cs-wrapper">
      <picture class="cs-picture">
        <source
          media="(min-width: 601px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/dentist.jpeg"
        />
        <source
          media="(max-width: 600px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/dentist.jpeg"
        />
        <img
          decoding="async"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/dentist.jpeg"
          alt="dentist"
          width="1880"
          height="683"
        />
      </picture>
      <div class="cs-form-wrapper">
        <form class="cs-form" name="Contact Form" method="post">
          <picture class="cs-form-picture">
            <source
              media="(min-width: 601px)"
              srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/dentist-model.png"
            />
            <source
              media="(max-width: 600px)"
              srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/dentist-model.png"
            />
            <img
              decoding="async"
              src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/dentist-model.png"
              alt="woman smiling"
              width="350"
              height="235"
            />
          </picture>
          <label class="cs-label">
            <input
              class="cs-input"
              required
              type="text"
              id="name-1969"
              name="name"
              placeholder="Name"
            />
          </label>
          <label class="cs-label">
            <input
              class="cs-input"
              required
              type="email"
              id="email-1969"
              name="email"
              placeholder="Email"
            />
          </label>
          <label class="cs-label">
            <input
              class="cs-input"
              required
              type="date"
              id="date-1969"
              name="date"
              placeholder="Select Date"
            />
          </label>
          <button class="cs-button-solid cs-submit" type="submit"
            >Book Appointment</button
          >
        </form>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  /*-- -------------------------- -->
<---            Hero            -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #hero-1969 {
      padding: var(--sectionPadding);
      /* 160px - 200px */
      padding-top: clamp(10rem, 20vw, 12.5rem);
      overflow: hidden;
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
        position: relative;
        z-index: 1;
      }

      .cs-content {
        text-align: left;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        position: relative;
        z-index: 1;
      }

      .cs-title {
        /* 39px - 80px */
        font-size: clamp(2.438rem, 4.876vw, 5rem);
        max-width: 25ch;
      }

      .cs-flex {
        /* changes to 455px at large desktop */
        max-width: calc(960 / 16 * 1rem);
      }

      .cs-text {
        max-width: 100%;
      }

      .cs-wrapper {
        width: 100%;
        box-sizing: border-box;
        padding: calc(16 / 16 * 1rem);
        padding-top: calc(402 / 16 * 1rem);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        z-index: 1;
      }

      .cs-picture {
        width: 100%;
