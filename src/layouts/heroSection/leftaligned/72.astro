        z-index: -1;
        transform: translateY(-10rem);
      }

      .cs-picture2 {
        width: auto;
        margin-left: calc(216 / 16 * 1rem);
      }
    }
  }

  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #hero-2173 {
      padding-right: calc(300 / 16 * 1rem);

      .cs-content {
        width: 54%;
