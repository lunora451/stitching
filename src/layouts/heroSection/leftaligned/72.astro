<!-- ============================================ --><!--                     Hero                     --><!-- ============================================ --><!--NOTE: There is a spacing note on Tablet about adjusting the marign top of the section to match the height of whatever navbar you add on top of it-->
<section id="hero-2173">
  <div class="cs-container">
    <div class="cs-content">
      <picture class="cs-picture cs-picture1">
        <!--Mobile Image-->
        <source
          media="(max-width: 600px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/wedding10.jpg"
        />
        <!--Tablet and above Image-->
        <source
          media="(min-width: 601px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/wedding10.jpg"
        />
        <img
          loading="lazy"
          decoding="async"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/wedding10.jpg"
          alt="people at a wedding"
          width="1058"
          height="936"
        />
      </picture>
      <div class="cs-wrapper">
        <h2 class="cs-title">Make Your Wedding Dream Come True</h2>
        <div class="cs-flex">
          <p class="cs-text">
            Authentic wedding photography emphasizes candid shots that capture
            real emotions, reactions, and interactions among the couple, their
            families, and guests. These moments are often spontaneous and
            heartfelt.
          </p>
          <a href="" class="cs-button-solid">Book An Appointment</a>
        </div>
      </div>
      <picture class="cs-picture cs-picture2">
        <!--Mobile Image-->
        <source
          media="(max-width: 1023px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/wedding11-m.jpg"
        />
        <!--Tablet and above Image-->
        <source
          media="(min-width: 1024px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/wedding11.jpg"
        />
        <img
          loading="lazy"
          decoding="async"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/wedding11.jpg"
          alt="bride"
          width="350"
          height="936"
        />
      </picture>
    </div>
  </div>
</section>

<style lang="scss">
  /*-- -------------------------- -->
<---           Hero             -->
<--- -------------------------- -*/

  /* Mobile */
  @media only screen and (min-width: 0rem) {
    #hero-2173 {
