      position: relative;
      z-index: 1;

      .cs-content {
        position: relative;
        z-index: 1;
      }

      .cs-wrapper {
        /* 60px - 80px top */
        /* 60px - 100px Bottom */
        padding: clamp(3.75rem, 5vw, 5rem) calc(16 / 16 * 1rem)
          clamp(3.75rem, 9.6vw, 6.25rem);
      }

      .cs-flex {
        /* changes to clamp at tablet */
        padding-left: calc(60 / 16 * 1rem);
      }

      .cs-title {
        /* 39px - 82px */
        font-size: clamp(2.4375rem, 6.5vw, 5.125rem);
        text-transform: uppercase;
        line-height: 1.1em;
        max-width: 18ch;
        /* 16px - 78px */
        margin-bottom: clamp(1rem, 6vw, 4.875rem);
      }

      .cs-text {
        /* 16px - 20px */
        font-size: clamp(1rem, 2vw, 1.25rem);
        margin-bottom: calc(16 / 16 * 1rem);
        &:last-of-type {
          margin-bottom: calc(32 / 16 * 1rem);
        }
      }

      .cs-button-solid {
