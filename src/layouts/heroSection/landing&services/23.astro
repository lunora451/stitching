<!-- ============================================ --><!--                    Hero                      --><!-- ============================================ -->
<section id="hero-2152">
  <div class="cs-container">
    <div class="cs-content">
      <span class="cs-topper">Perfect Photography at Your Doorstep</span>
      <h2 class="cs-title">
        Your Wedding Memory will be More Memorable with Our Photography
      </h2>
      <p class="cs-text">
        Choose from our range of photobooth options, including open-air and
        enclosed booths, to suit your wedding theme and style.
      </p>
      <a href="" class="cs-button-solid">Book An Appointment</a>
      <img
        class="cs-graphic"
        decoding="async"
        src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/MISC/leaf5.png"
        alt="graphic"
        width="280"
        height="350"
        aria-hidden="true"
      />
    </div>
    <picture class="cs-background">
      <!--Mobile Image-->
      <source
        media="(max-width: 600px)"
        srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/MISC/wedding-pose.jpeg"
      />
      <!--Tablet and above Image-->
      <source
        media="(min-width: 601px)"
        srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/MISC/wedding-pose.jpeg"
      />
      <img
        loading="lazy"
        decoding="async"
        src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/MISC/wedding-pose.jpeg"
        alt="icon"
        width="960"
        height="857"
      />
    </picture>
  </div>
</section>

