<style lang="scss">
  /*-- -------------------------- -->
<---           Hero             -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #hero-2270 {
      background-color: #1a1a1a;

      .cs-container {
        width: 100%;
        max-width: calc(1920 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        justify-content: center;
        /* 48px - 64px */
        gap: clamp(3rem, 7vw, 4rem);
        position: relative;
      }

      .cs-content {
        box-sizing: border-box;
        /* top changes to 100px on tablet */
        /* bottom 60px - 180px */
        padding: calc(360 / 16 * 1rem) calc(16 / 16 * 1rem)
          clamp(3.75rem, 12vw, 11.25rem);
        display: flex;
        flex-direction: column;
        z-index: 2;
      }

      .cs-author {
        display: flex;
        flex-direction: column;
        gap: calc(4 / 16 * 1rem);
      }

      .cs-name {
        font-size: calc(25 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        color: var(--bodyTextColorWhite);
        display: block;
      }

      .cs-job {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.5em;
        margin: 0 0 calc(16 / 16 * 1rem);
        color: var(--bodyTextColorWhite);
        display: block;
      }

      .cs-title {
        /* 49px - 61px */
        font-size: clamp(3.0625rem, 6vw, 3.8125rem);
        max-width: calc(554 / 16 * 1rem);
        color: var(--bodyTextColorWhite);
      }

      .cs-text {
        /* 16px - 20px */
        font-size: clamp(1rem, 2vw, 1.25rem);
        max-width: calc(514 / 16 * 1rem);
        color: var(--bodyTextColorWhite);
      }

      .cs-video-group {
        width: 100%;
        /* 180px - 320px */
        height: clamp(11.25rem, 40vw, 20rem);
        /* 48px - 80px */
        margin-top: clamp(3rem, 11vw, 5rem);
        display: flex;
        justify-content: flex-end;
        position: relative;

        &:hover {
          cursor: pointer;
          .cs-play {
            transform: translateY(-50%) scale(1.1);
          }
        }

        video,
        .cs-picture {
          width: 100%;
          height: 100%;
          display: block;

          img {
            width: 100%;
            height: 100%;
            object-fit: cover;
          }
        }
      }

      .cs-wrapper {
        width: 88%;
        position: relative;
        z-index: 1;
      }

      .cs-play {
        /* 80px - 120px */
        width: clamp(5rem, 10vw, 7.5rem);
        height: auto;
        padding: 0;
        background-color: transparent;
        pointer-events: none;
        border: none;
        position: absolute;
        top: 50%;
        left: calc(clamp(5rem, 10vw, 7.5rem) * -0.5);
        transform: translateY(-50%);
        transition:
          transform 0.3s,
          opacity 0.3s;
        transform-origin: center;

        &:hover {
          cursor: pointer;
        }

        &.cs-hide {
          opacity: 0;
          transform: translateY(-50%) scale(0);
        }

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
      }

      .cs-background {
        width: 100%;
        height: calc(625 / 16 * 1rem);
        position: absolute;
        top: 0;
        left: 0;
        z-index: 1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }

        &::before {
          content: "";
          width: 100%;
          height: 100%;
          background: linear-gradient(
            0deg,
            #1a1a1a 0%,
            rgba(26, 26, 26, 0.83) 38.94%,
            rgba(26, 26, 26, 0) 76.68%
          );
          position: absolute;
          top: 0;
          left: 0;
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #hero-2270 {
      background: linear-gradient(
          90deg,
          #1a1a1a 66.48%,
          rgba(26, 26, 26, 0) 66.82%
        ),
        #262525;
      .cs-container {
        align-items: flex-end;
      }

      .cs-content {
        text-align: left;
        width: 47%;
        max-width: calc(646 / 16 * 1rem);
        padding-top: calc(100 / 16 * 1rem);
        align-items: flex-start;
      }

      .cs-text {
        max-width: calc(514 / 16 * 1rem);
      }

      .cs-author {
        position: absolute;
        /* 60px - 120px */
        bottom: clamp(3.75rem, 12vw, 7.5rem);
        left: calc(120 / 16 * 1rem);
      }

      .cs-job {
        margin: 0;
      }

      .cs-background {
        width: 73%;
        height: 100%;

        &::before {
          background:
            linear-gradient(
              0deg,
              #1a1a1a 0%,
              rgba(26, 26, 26, 0.83) 17.39%,
              rgba(26, 26, 26, 0) 34.24%
            ),
            linear-gradient(
              270deg,
              #1a1a1a 5.72%,
              rgba(26, 26, 26, 0.83) 32.01%,
              rgba(26, 26, 26, 0) 57.49%
            ),
            -556.663px -57.033px / 285.317% 115.906% no-repeat;
        }
      }
    }
  }

  /* Large Desktop - 1300px */
  @media only screen and (min-width: 81.25rem) {
    #hero-2270 {
      .cs-content {
        width: 100%;
        box-sizing: content-box;
        /* 16px - 170px */
        padding-right: clamp(1rem, 11vw, 10.625rem);
      }
    }
  }

  /*-- -------------------------- -->
<---          Services          -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #services-2270 {
      max-width: calc(1920 / 16 * 1rem);
      margin: auto;
      position: relative;
      z-index: 10;

      &:before {
        /* background color */
        content: "";
        width: 100vw;
        height: 100%;
        background: #1a1a1a;
        opacity: 1;
        display: block;
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
      }

      .cs-container {
        width: 100%;
        margin: auto;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        /* prevents padding from affecting height and width */
        box-sizing: border-box;
        /* 60px - 100px top & bottom */
        /* 16px - 100px left and right */
        padding: clamp(3.75rem, 7vw, 6.25rem) clamp(1rem, 4vw, 6.25rem);
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        row-gap: calc(32 / 16 * 1rem);
        position: relative;
        z-index: 15;
      }

      .cs-item {
        text-align: left;
        list-style: none;
        width: 100%;
        box-sizing: border-box;
        grid-column: span 12;
        transition: background-color 0.3s;
      }

      .cs-link {
        text-decoration: none;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        gap: calc(16 / 16 * 1rem);
      }

      .cs-icon {
        width: calc(32 / 16 * 1rem);
        height: auto;
      }

      .cs-h3 {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 2vw, 1.5625rem);
        font-weight: 700;
        line-height: 1.2em;
        text-align: inherit;
        margin: 0;
        color: var(--bodyTextColorWhite);
        display: flex;
        align-items: center;
        gap: calc(8 / 16 * 1rem);
        transition: color 0.3s;
      }

      .cs-item-text {
        /* 14px - 16px */
        font-size: clamp(0.875rem, 1.5vw, 1rem);
        line-height: 1.5em;
        text-align: inherit;
        margin: 0;
        color: var(--bodyTextColorWhite);
        opacity: 0.8;
        transition:
          color 0.3s,
          opacity 0.3s;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #services-2270 {
      .cs-content {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        gap: calc(48 / 16 * 1rem);
      }

      .cs-title {
        margin: 0;
      }

      .cs-card-group {
        /* 32px - 60px */
        column-gap: clamp(2rem, 6vw, 3.75rem);
      }

      .cs-flex-group {
        width: 50%;
        /* prevents flexbox from squishing it */
        flex: none;
      }

      .cs-item {
        grid-column: span 4;
      }
    }
  }
</style>

<script>
  function togglePlayButton() {
    // Select all elements with the .cs-picture class
    const pictures = document.querySelectorAll("#hero .cs-video-group");

    // Add a click event listener to each .cs-picture element
    pictures.forEach((picture) => {
      picture.addEventListener("click", () => {
        // Select all elements with the .cs-play class
        const playButtons = document.querySelectorAll("#hero .cs-play");

        // Toggle the .cs-hide class on each .cs-play element
        playButtons.forEach((button) => {
          button.classList.toggle("cs-hide");
        });
      });
    });
  }

  // Call the function to activate the event listeners
  togglePlayButton();

  function toggleVideoPlayback() {
    // Select the video element
    const video = document.querySelector("#hero video");

    // Add a click event listener to the video
    video.addEventListener("click", () => {
      // Check if the video is paused
      if (video.paused) {
        video.play(); // Play the video if it is paused
      } else {
        video.pause(); // Pause the video if it is playing
      }
    });
  }

  // Call the function to activate the event listener
  toggleVideoPlayback();
</script>
