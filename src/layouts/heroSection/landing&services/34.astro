            media="(min-width: 601px)"
            srcset="https://csimages2.nyc3.digitaloceanspaces.com/Images/People/gym-service-2.jpg"
          />
          <img
            loading="lazy"
            decoding="async"
            src="https://csimages2.nyc3.digitaloceanspaces.com/Images/People/gym-service-2.jpg"
