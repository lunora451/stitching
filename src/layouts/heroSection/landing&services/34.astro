  <!-- Background Image -->
  <picture class="cs-background">
    <source
      media="(max-width: 600px)"
      srcset="https://csimages2.nyc3.digitaloceanspaces.com/Images/People/gym-hero.jpg"
    />
    <source
      media="(min-width: 601px)"
      srcset="https://csimages2.nyc3.digitaloceanspaces.com/Images/People/gym-hero.jpg"
    />
    <img
      loading="lazy"
      decoding="async"
      src="https://csimages2.nyc3.digitaloceanspaces.com/Images/People/gym-hero.jpg"
