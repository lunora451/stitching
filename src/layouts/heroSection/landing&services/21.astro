<style lang="scss">
  /*-- -------------------------- -->
<---           Hero             -->
<--- -------------------------- -*/

  /* Mobile */
  @media only screen and (min-width: 0rem) {
    #hero-2174 {
      overflow: hidden;
      background-color: #f7f7f7;
      position: relative;
      z-index: 1;

      .cs-content {
        position: relative;
        z-index: 1;
      }

      .cs-wrapper {
        /* 60px - 80px top */
        /* 60px - 100px Bottom */
        padding: clamp(3.75rem, 5vw, 5rem) calc(16 / 16 * 1rem)
          clamp(3.75rem, 9.6vw, 6.25rem);
      }

      .cs-flex {
        /* changes to clamp at tablet */
        padding-left: calc(60 / 16 * 1rem);
      }

      .cs-title {
        /* 39px - 82px */
        font-size: clamp(2.4375rem, 6.5vw, 5.125rem);
        text-transform: uppercase;
        line-height: 1.1em;
        max-width: 18ch;
        /* 16px - 78px */
        margin-bottom: clamp(1rem, 6vw, 4.875rem);
      }

      .cs-text {
        /* 16px - 20px */
        font-size: clamp(1rem, 2vw, 1.25rem);
        margin-bottom: calc(16 / 16 * 1rem);
        &:last-of-type {
          margin-bottom: calc(32 / 16 * 1rem);
        }
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        /* 46px - 56px */
        line-height: clamp(2.875rem, 5.5vw, 3.5rem);
        text-decoration: none;
        font-weight: 700;
        text-align: center;
        margin: 0;
        color: #fff;
        min-width: calc(150 / 16 * 1rem);
        padding: 0 calc(24 / 16 * 1rem);
        background-color: var(--primary);
        display: inline-block;
        position: relative;
        z-index: 1;
        /* prevents padding from adding to the width */
        box-sizing: border-box;

        &:before {
          content: "";
          position: absolute;
          height: 100%;
          width: 0%;
          background: #000;
          opacity: 1;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
        }

        &:hover {
          &:before {
            width: 100%;
          }
        }
      }

      .cs-picture {
        width: 100%;
        height: auto;
        display: block;
        position: relative;
        z-index: 1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          object-position: top;
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      .cs-picture1 {
        width: 100%;
        height: 110vw;
      }

      .cs-picture2 {
        width: 100%;
        height: 68vw;
        /* removed at desktop */
        max-height: calc(341 / 16 * 1rem);
        margin-left: calc(76 / 16 * 1rem);
      }
    }
  }

  /* Tablet - 700px */
  @media only screen and (min-width: 43.75rem) {
    #hero-2174 {
      /* make this value the same height as your navigation for best results, and only use a navigation with a background color, not transparent. wont look right */
      margin-top: calc(120 / 16 * 1rem);

      .cs-container {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
      }

      .cs-content {
        width: 57vw;
      }

      .cs-flex {
        padding-left: calc(140 / 16 * 1rem);
      }

      .cs-picture1 {
        width: 56vw;
        height: 100vh;
        position: absolute;
        top: 0%;
        right: 82%;
        z-index: -1;
        transform: translateY(-10rem);
      }

      .cs-picture2 {
        width: auto;
        margin-left: calc(216 / 16 * 1rem);
      }
    }
  }

  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #hero-2174 {
      padding-right: calc(300 / 16 * 1rem);

      .cs-content {
        width: 54%;
        max-width: calc(544 / 16 * 1rem);
        position: relative;
        z-index: 1;
      }

      .cs-wrapper {
        padding-left: 0;
        padding-right: 0;
      }

      .cs-title {
        max-width: 12ch;
      }

      .cs-picture1 {
        width: 60vw;
        right: calc(100% - 5rem);
      }

      .cs-picture2 {
        width: 30vw;
        max-width: calc(350 / 16 * 1rem);
        height: 100vh;
        max-height: 100vh;
        margin: 0;
        position: absolute;
        top: 50%;
        left: calc(100% + 2.5rem);
        transform: translateY(-50%);
      }
    }
  }

  /* Large Desktop - 1920px */
  @media only screen and (min-width: 120rem) {
    #hero-2174 {
      padding-right: 0;
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
        padding-right: calc(80 / 16 * 1rem);
        box-sizing: border-box;
        position: initial;
      }

      .cs-content {
        position: initial;
      }

      .cs-picture1 {
        height: auto;
        margin-right: calc(-94 / 16 * 1rem);
        right: 50%;
        top: 0;
        bottom: 0;
        transform: none;
      }

      .cs-picture2 {
        height: auto;
        width: 20vw;
        max-height: none;
        max-width: none;
        margin-left: calc(606 / 16 * 1rem);
        left: 50%;
        top: 0;
        bottom: 0;
        transform: none;
      }
    }
  }

  /*-- -------------------------- -->
<---          Services          -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #services-2174 {
      max-width: calc(1920 / 16 * 1rem);
      margin: auto;
      position: relative;
      z-index: 10;

      &:before {
        /* background color */
        content: "";
        width: 100vw;
        height: 100%;
        background: #1a1a1a;
        opacity: 1;
        position: absolute;
        display: block;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
      }

      .cs-container {
        width: 100%;
        margin: auto;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        /* 60px - 100px top & bottom */
        /* 16px - 100px left and right */
        padding: clamp(3.75rem, 7vw, 6.25rem) clamp(1rem, 4vw, 6.25rem);
        /* prevents padding from affecting height and width */
        box-sizing: border-box;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        row-gap: calc(32 / 16 * 1rem);
        position: relative;
        z-index: 15;
      }

      .cs-item {
        text-align: left;
        list-style: none;
        width: 100%;
        box-sizing: border-box;
        grid-column: span 12;
        transition: background-color 0.3s;
      }

      .cs-link {
        text-decoration: none;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        flex-direction: column;
        gap: calc(16 / 16 * 1rem);
      }

      .cs-icon {
        width: calc(32 / 16 * 1rem);
        height: auto;
      }

      .cs-h3 {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 2vw, 1.5625rem);
        font-weight: 700;
        text-align: inherit;
        line-height: 1.2em;
        margin: 0;
        color: var(--bodyTextColorWhite);
        display: flex;
        align-items: center;
        gap: calc(8 / 16 * 1rem);
        transition: color 0.3s;
      }

      .cs-item-text {
        /* 14px - 16px */
        font-size: clamp(0.875rem, 1.5vw, 1rem);
        text-align: inherit;
        line-height: 1.5em;
        margin: 0;
        color: var(--bodyTextColorWhite);
        opacity: 0.8;
        transition:
          color 0.3s,
          opacity 0.3s;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #services-2174 {
      .cs-content {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        gap: calc(48 / 16 * 1rem);
      }

      .cs-title {
        margin: 0;
      }

      .cs-card-group {
        /* 32px - 60px */
        column-gap: clamp(2rem, 6vw, 3.75rem);
      }

      .cs-flex-group {
        width: 50%;
        /* prevents flexbox from squishing it */
        flex: none;
      }

      .cs-item {
        grid-column: span 4;
      }
    }
  }
</style>
