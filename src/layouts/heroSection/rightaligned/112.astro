---

<!-- ============================================ --><!--                    Hero                      --><!-- ============================================ -->
<section id="hero-1932">
  <div class="cs-container">
    <div class="cs-content">
      <div class="cs-flex">
        <span class="cs-topper">Get the care you deserve</span>
        <h2 class="cs-title">Stitch Skin Dermatology & Aesthetics</h2>
      </div>
      <p class="cs-text">
        Our comprehensive dermatological care spans medical, pediatric,
        surgical, laser, and cosmetic disciplines.
      </p>
      <a href="" class="cs-button-solid">Book an Appointment</a>
      <div class="cs-info">
        <img
          class="cs-info-pic"
          loading="lazy"
          decoding="async"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/MISC/derma-sbs-1.png"
          alt="graphic"
          width="179"
          height="225"
          aria-hidden="true"
        />
        <div class="cs-wrapper">
          <img
            class="cs-icon"
            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/brown-pin-derm.svg"
            loading="lazy"
            decoding="async"
            alt="icon"
            width="33"
            height="38"
            aria-hidden="true"
          />
          <div class="cs-flex">
            <span class="cs-address"
              >4321 Birch St, 140, Newport Beach, California 92660, US</span
            >
            <span class="cs-slogan">Backed by science, perfected to an art</span
            >
          </div>
        </div>
      </div>
    </div>
    <div class="cs-image-group">
      <picture class="cs-picture">
        <!--Mobile Image-->
        <source
          media="(max-width: 600px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/MISC/faq-left.jpg"
        />
        <!--Tablet and above Image-->
        <source
          media="(min-width: 601px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/MISC/faq-left.jpg"
        />
        <img
          loading="lazy"
          decoding="async"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/MISC/faq-left.jpg"
          alt="dermatologist"
          width="324"
          height="467"
        />
      </picture>
      <img
        class="cs-graphic cs-peach"
        loading="lazy"
        decoding="async"
        src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/peach-blob-35-reverse.svg"
        alt="graphic"
        width="208"
        height="203"
        aria-hidden="true"
      />
      <img
        class="cs-graphic cs-swirl"
        loading="lazy"
        decoding="async"
        src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/beige-swirl-35-reverse.svg"
        alt="graphic"
        width="56"
        height="42"
        aria-hidden="true"
      />
      <img
        class="cs-graphic cs-dots"
        loading="lazy"
        decoding="async"
        src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/beige-dots-35.svg"
        alt="graphic"
        width="379"
        height="394"
        aria-hidden="true"
      />
      <img
        class="cs-graphic cs-leaf"
        loading="lazy"
        decoding="async"
        src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/leaf-35-reverse.svg"
        alt="graphic"
        width="179"
        height="225"
        aria-hidden="true"
      />
      <img
        class="cs-graphic cs-button"
        loading="lazy"
        decoding="async"
        src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/spinning-button.svg"
        alt="graphic"
        width="179"
        height="225"
        aria-hidden="true"
      />
      <img
        class="cs-graphic cs-brown-lines"
        loading="lazy"
        decoding="async"
        src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/brown-lines35.svg"
        alt="graphic"
        width="746"
        height="524"
        aria-hidden="true"
      />
    </div>
  </div>
  <picture class="cs-background">
    <source
      media="(max-width: 600px)"
      srcset="https://csimages2.nyc3.digitaloceanspaces.com/Images/MISC/dermatology-banner.jpg"
    />
    <source
      media="(min-width: 601px)"
      srcset="https://csimages2.nyc3.digitaloceanspaces.com/Images/MISC/dermatology-banner.jpg"
    />
    <img
      decoding="async"
      src="https://csimages2.nyc3.digitaloceanspaces.com/Images/MISC/dermatology-banner.jpg"
      alt="cream background with ripple"
      width="1920"
      height="970"
      aria-hidden="true"
    />
  </picture>
</section>

<style lang="scss">
  /*-- -------------------------- -->
<---          Hero              -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #hero-1932 {
      width: 100%;
      padding: var(--sectionPadding);
      background-color: #faf6f2;
      overflow: hidden;
      position: relative;
      z-index: 1;

      &:before {
        content: "";
        width: 100%;
        height: 100%;
        background: #f6eddf;
        opacity: 0.84;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        z-index: 1;
      }

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
        max-width: calc(584 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        /* 48px - 80px */
        gap: clamp(3rem, 6vw, 5rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: left;
        width: 100%;
        max-width: calc(570 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: flex-start;
        position: relative;
        z-index: 3;
      }

      .cs-topper {
        color: var(--secondary);
      }

      .cs-text {
        margin-bottom: calc(12 / 16 * 1rem);

        &:last-of-type {
          margin-bottom: calc(32 / 16 * 1rem);
        }
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        /* 46px - 56px */
        line-height: clamp(2.875em, 5.5vw, 3.5em);
        text-align: center;
        text-decoration: none;
        min-width: calc(150 / 16 * 1rem);
        margin: 0;
        /* prevents padding from adding to the width */
        box-sizing: border-box;
        padding: 0 calc(24 / 16 * 1rem);
        background-color: var(--primary);
        overflow: hidden;
        color: #fff;
        border: none;
        border-radius: calc(100 / 16 * 1rem);
        display: inline-block;
        position: relative;
        z-index: 1;
        transition: color 0.3s;

        &:before {
          content: "";
          width: 0;
          height: 100%;
          background: #000;
          opacity: 1;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
        }

        &:hover {
          color: #fff;

          &:before {
            width: 100%;
          }
        }
      }

      .cs-info {
        width: 100%;
        margin-top: clamp(3rem, 6vw, 5rem);
        display: flex;
        flex-direction: row;
        justify-content: flex-start;
        align-items: center;
        gap: calc(16 / 16 * 1rem);
      }

      .cs-info-pic {
        width: calc(111 / 16 * 1em);
        height: calc(77 / 16 * 1em);
        border-radius: calc(16 / 16 * 1rem);
        position: relative;
      }

      .cs-wrapper {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
      }

      .cs-address {
        font-size: calc(20 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        color: var(--headerColor);
        display: block;
      }

      .cs-icon {
        width: calc(24 / 16 * 1rem);
        height: auto;
        margin-right: calc(4 / 16 * 1rem);
      }

      .cs-slogan {
        font-size: calc(14 / 16 * 1rem);
        font-weight: 400;
        line-height: 1.5em;
        color: var(--bodyTextColor);
        display: block;
      }

      .cs-image-group {
        font-size: min(2.29vw, 0.9rem);
        width: calc(559 / 16 * 1em);
        height: calc(680 / 16 * 1em);
        display: block;
        position: relative;
        z-index: 2;
      }

      .cs-picture {
        width: calc(522 / 16 * 1em);
        height: calc(680 / 16 * 1em);
        box-sizing: border-box;
        background-color: #dab692;
        overflow: hidden;
        border: 8px solid #dab692;
        border-radius: calc(260 / 16 * 1rem);
        position: absolute;
        left: 0;
        z-index: -1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
          transition: transform 0.7s;
        }
      }

      .cs-graphic {
        height: auto;
        position: absolute;
      }

      .cs-peach {
        width: calc(86 / 16 * 1em);
        height: auto;
        top: calc(6 / 16 * 1em);
        left: calc(91 / 16 * 1em);
      }

      .cs-swirl {
        width: calc(157 / 16 * 1em);
        height: auto;
        top: calc(25 / 16 * 1em);
        left: 0;
        z-index: -0;
      }

      .cs-dots {
        width: calc(246 / 16 * 1em);
        height: auto;
        bottom: 0;
        right: 0;
        z-index: -10;
      }

      .cs-leaf {
        width: calc(215 / 16 * 1em);
        height: auto;
        left: 0;
        bottom: 0;
      }

      .cs-button {
        width: calc(160 / 16 * 1em);
        height: auto;
        top: calc(408 / 16 * 1em);
        right: 0;
      }

      .cs-info-text {
        /* 14px - 20px */
        font-size: clamp(0.875rem, 3.5vw, 1.25rem);
        font-weight: 600;
        line-height: 1.6em;
        text-align: center;
        max-width: calc(223 / 16 * 1em);
        margin: 0;
        color: var(--bodyTextColorWhite);
      }

      .cs-brown-lines {
        width: calc(746 / 16 * 1em);
        height: auto;
        right: calc(331 / 16 * 1em);
        top: calc(395 / 16 * 1em);
        z-index: -10;
        transform: rotate(-36deg);
      }

      .cs-background {
        width: 100%;
        height: 100%;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
        }
      }
    }
  }

  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #hero-1932 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        flex-direction: row;
        justify-content: space-between;
        align-items: stretch;
      }

      .cs-content {
        /* 48px - 64px */
        padding: clamp(3rem, 5vw, 4rem) 0;
        order: 2;
      }

      .cs-image-group {
        font-size: min(1.27vw, 1rem);
        height: auto;
        min-height: calc(680 / 16 * 1em);
        flex: none;
      }

      .cs-picture {
        height: 100%;
      }
    }
  }

  /* Large Desktop - 1600px */
  @media only screen and (min-width: 100rem) {
    #hero-1932 {
      .cs-background {
        background: url("https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/MISC/dermatology-banner.png");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
        img {
          display: none;
        }
      }
    }
  }
</style>
