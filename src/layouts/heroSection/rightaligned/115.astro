        margin: 0;
        color: #f7f7f7;
      }

      .cs-reviews-img {
        width: calc(48 / 16 * 1rem);
        height: auto;
        margin: 0 calc(-16 / 16 * 1rem) 0 0;
        border-radius: 50%;
