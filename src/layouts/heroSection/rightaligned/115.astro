<style lang="scss">
  /*-- -------------------------- -->
<---           Hero             -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #hero-1468 {
      /* 200px - 350px top - leaving extra space for the navigation */
      /* 100px - 200px bottom */
      padding: clamp(12.5rem, 25.95vw, 21.875em) calc(16 / 16 * 1rem)
        clamp(6.25rem, 7vw, 12.5rem);
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
