        align-items: center;
      }

      .cs-flex {
        text-align: center;
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
        flex-direction: column;
        align-items: center;
      }

      .cs-title {
        /* 39px - 49px */
        font-size: clamp(2.4375rem, 6.4vw, 3.0625rem);
        font-weight: 700;
        line-height: 1.2em;
        text-align: inherit;
        max-width: calc(829 / 16 * 1rem);
        color: #fff;
        position: relative;
        z-index: 1;

        &:before {
          content: "";
