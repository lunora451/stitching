---

<!-- ============================================ --><!--                Why Choose Us                 --><!-- ============================================ -->
<section id="why-choose-1882">
  <div class="cs-container">
    <div class="cs-content">
      <span class="cs-topper">Why Choose Us</span>
      <h2 class="cs-title">Why Choose Us</h2>
      <p class="cs-text">
        Aside from seeing patients, Dr. Paul is dedicated to patient advocacy
        and education on evidence-based medicine in dermatology, especially for
        skin of color.
      </p>
    </div>
    <ul class="cs-card-group">
      <li class="cs-item">
        <div class="cs-item-group">
          <img
            class="cs-icon"
            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/derma-icon-heart.svg"
            loading="lazy"
            decoding="async"
            alt="icon"
            width="33"
            height="38"
            aria-hidden="true"
          />
          <h3 class="cs-h3">Under Dr Paul's Care</h3>
        </div>
        <p class="cs-item-text">
          Trained at top medical institutes, Dr Paul provides exceptional
          patient care and is very approachable to her growing loyal
          patient-base (as indicated in patient feedback and online reviews).
        </p>
      </li>
      <li class="cs-item">
        <div class="cs-item-group">
          <img
            class="cs-icon"
            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/derma-icon-palette.svg"
            loading="lazy"
            decoding="async"
            alt="icon"
            width="33"
            height="38"
            aria-hidden="true"
          />
          <h3 class="cs-h3">Skin of Color Expertise</h3>
        </div>
        <p class="cs-item-text">
          Dr Paul has built a strong brand and following in the Skin of Color
          space, serving on the Media Committee for the Skin of Color Society
          and as an advisor on boards of skincare products that focus on darker
          skin tones.
        </p>
      </li>
      <li class="cs-item">
        <div class="cs-item-group">
          <img
            class="cs-icon"
            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/derma-icon-people.svg"
            loading="lazy"
            decoding="async"
            alt="icon"
            width="33"
            height="38"
            aria-hidden="true"
          />
          <h3 class="cs-h3">Unparalleled Patient Experience</h3>
        </div>
        <p class="cs-item-text">
          Every detail of the physical space, workflow processes and selected
          tools & technology is planned and built to deliver the best end to end
          patient experience to our patients who would expect no less.
        </p>
      </li>
      <li class="cs-item">
        <div class="cs-item-group">
          <img
            class="cs-icon"
            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/derma-icon-plan.svg"
            loading="lazy"
            decoding="async"
            alt="icon"
            width="33"
            height="38"
            aria-hidden="true"
          />
          <h3 class="cs-h3">Multipurpose Space</h3>
        </div>
        <p class="cs-item-text">
          The open and modular layout of the space is designed to offer a
          seamless dermatology visit for patients, but also a multipurpose
          aesthetically elegant space for product launches, showcase events,
          training etc.
        </p>
      </li>
    </ul>
    <!--Portrait-->
    <div class="cs-image-group">
      <picture class="cs-image">
        <!--Mobile Image-->
        <source
          media="(max-width: 600px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/derma-clinician.png"
        />
        <!--Tablet and above Image-->
        <source
          media="(min-width: 601px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/derma-clinician.png"
        />
        <img
          loading="lazy"
          decoding="async"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/derma-clinician.png"
          alt="clinician"
          width="510"
          height="193"
          aria-hidden="true"
        />
      </picture>
      <img
        class="cs-graphic"
        src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/derma-graphic.svg"
        alt="graphic"
        height="599"
        width="414"
        loading="lazy"
        decoding="async"
        aria-hidden="true"
      />
    </div>
  </div>
  <!--Background-->
  <picture class="cs-background">
    <!--Mobile Image-->
    <source
      media="(max-width: 600px)"
      srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/derma-bg.png"
    />
    <!--Tablet and above Image-->
    <source
      media="(min-width: 601px)"
      srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/derma-bg.png"
    />
    <img
      src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/derma-bg.png"
      alt="background"
      height="932"
      width="1920"
      loading="lazy"
      decoding="async"
    />
  </picture>
  <!--Top Floating Graphic--->
  <img
    class="cs-floater cs-floater-top"
    src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/derma-bg-top.png"
    alt="graphic"
    loading="lazy"
    decoding="async"
    height="477"
    width="548"
    aria-hidden="true"
  />
  <!--Bottom Floating Graphic--->
  <img
    class="cs-floater cs-floater-bottom"
    src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/derma-bg-bottom.png"
    alt="graphic"
    loading="lazy"
    decoding="async"
    height="477"
    width="548"
    aria-hidden="true"
  />
</section>

<style lang="scss">
  /*-- -------------------------- -->
<---       Why Choose Us        -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #why-choose-1882 {
      /* prevents padding from affecting height and  */
      box-sizing: border-box;
      padding: var(--sectionPadding);
      padding-bottom: 0;
      background-color: #f4e7d8;
      overflow: hidden;
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
        max-width: calc(940 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
        z-index: 1;
      }

      .cs-title {
        max-width: 20ch;
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: grid;
        justify-content: center;
        /* 8px - 20px */
        gap: clamp(0.5rem, 3vw, 1.25rem);
        z-index: 1;
      }

      .cs-item {
        list-style: none;
        width: 100%;
        margin: 0;
        box-sizing: border-box;
        /* 24px - 32px */
        padding: clamp(1.5rem, 1vw, 2rem);
        background-color: #fff;
        border-radius: calc(24 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        gap: calc(16 / 16 * 1rem);
      }

      .cs-item-group {
        display: flex;
        align-items: center;
        gap: calc(16 / 16 * 1rem);
      }

      .cs-icon {
        width: auto;
        height: calc(32 / 16 * 1rem);
        display: block;
      }

      .cs-h3 {
        font-size: calc(20 / 16 * 1rem);
        line-height: 1.2em;
        margin: 0;
        color: var(--headerColor);
      }

      .cs-item-text {
        /* 14px - 16px */
        font-size: clamp(0.875rem, 1.5vw, 1rem);
        line-height: 1.5em;
        text-align: inherit;
        margin: 0;
        color: var(--bodyTextColor);
      }

      .cs-image-group {
        width: 100%;
        max-width: calc(393 / 16 * 1rem);
        height: auto;
        display: block;
        position: relative;
        z-index: 1;
      }

      .cs-image {
        width: 100%;
        height: auto;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        z-index: 1;

        img {
          width: 100%;
          height: auto;
        }
      }

      .cs-graphic {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 50%;
        z-index: 0;
        transform: translateX(-50%);
      }

      .cs-background {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -2;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }

        &::before {
          content: "";
          width: 100%;
          height: 100%;
          background-color: #f6eddf;
          opacity: 0.6;
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      .cs-floater {
        font-size: 1rem;
        width: calc(548 / 16 * 1em);
        height: calc(477 / 16 * 1em);
        display: none;
        position: absolute;
        z-index: 0;
      }

      .cs-floater-top {
        top: 0;
        left: 0;
      }

      .cs-floater-bottom {
        right: 0;
        bottom: 0;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #why-choose-1882 {
      .cs-card-group {
        grid-template-columns: repeat(2, 1fr);
      }

      .cs-floater-bottom {
        display: block;
      }
    }
  }

  /* Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #why-choose-1882 {
      padding: var(--sectionPadding);
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
      }

      .cs-card-group {
        /* makes sure the card group always has a minimum height to keep the section tall enough so the absolutely positioned image group never overlaps the content at the top. */
        min-height: calc(400 / 16 * 1rem);
      }

      .cs-image-group {
        height: 78%;
        display: flex;
        justify-content: center;
        align-items: center;
        position: absolute;
        /* 60px - 100px, same as the section padding clamp values */
        bottom: calc(clamp(3.75rem, 7.82vw, 6.25rem) * -1);
        left: 50%;
        z-index: -1;
        transform: translateX(-50%);

        .cs-image {
          height: 100%;
          width: auto;

          img {
            height: 100%;
            width: auto;
          }
        }
      }

      .cs-card-group {
        justify-content: center;
        align-items: stretch;
      }

      .cs-item {
        width: 31vw;
        max-width: calc(413 / 16 * 1rem);
        position: relative;

        &:nth-of-type(even) {
          justify-self: flex-end;
        }
      }

      .cs-floater-top {
        display: block;
      }
    }
  }

  /* Large Desktop - 1600px */
  @media only screen and (min-width: 100rem) {
    #why-choose-1882 {
      .cs-floater-top {
        margin-right: calc(416 / 16 * 1rem);
        right: 50%;
        left: initial;
      }

      .cs-floater-bottom {
        margin-left: calc(416 / 16 * 1rem);
        right: initial;
        left: 50%;
      }
    }
  }
</style>
