<style lang="scss">
  /*-- -------------------------- -->
<---         Why Choose         -->
<--- -------------------------- -*/

  /* Mobile */
  @media only screen and (min-width: 0rem) {
    #why-2359 {
      padding: var(--sectionPadding);
      padding-top: 0;
      overflow: hidden;

      .cs-container {
        width: 100%;
        max-width: calc(1800 / 16 * 1rem);
        margin: auto;
      }

      .cs-content-wrapper {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        /* 48px - 64px */
        gap: clamp(3rem, 7vw, 4rem);
        position: relative;
        z-index: 1;
      }

      .cs-content {
        width: 100%;
        /* changes to 1280 at tablet */
        max-width: calc(584 / 16 * 1rem);
        margin: auto;
      }

      .cs-card-group {
        width: 100%;
        /* changes to 1280px at tablet */
        max-width: calc(584 / 16 * 1rem);
        margin: auto;
      }

      .cs-title {
        max-width: calc(944 / 16 * 1rem);
      }

      .cs-text {
        max-width: calc(944 / 16 * 1rem);
        margin-bottom: calc(16 / 16 * 1rem);

        &:last-of-type {
          margin-bottom: calc(32 / 16 * 1rem);
        }
      }

      .cs-card-group {
        margin: 0 auto;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        /* 16px - 20px */
        column-gap: clamp(1rem, 2.5vw, 1.25rem);
        /* 32px - 40px */
        row-gap: clamp(2rem, 2.5vw, 2.5rem);
      }

      .cs-item {
        text-align: left;
        list-style: none;
        display: flex;
        grid-column: span 12;
        flex-direction: column;
        align-items: flex-start;
      }

      .cs-icon {
        width: calc(24 / 16 * 1rem);
        height: auto;
        margin-bottom: calc(24 / 16 * 1rem);
        display: block;
      }

      .cs-h3 {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 2.4vw, 1.5625rem);
        line-height: 1.2em;
        font-weight: 700;
        margin: 0 0 calc(16 / 16 * 1rem);
        padding-bottom: calc(16 / 16 * 1rem);
        color: var(--headerColor);
        border-bottom: 1px solid #e3ddd9;
        transition:
          border-color 0.3s,
          color 0.3s;
      }

      .cs-item-text {
        font-size: var(--bodyFontSize);
        line-height: 1.5em;
        margin: 0;
        color: var(--bodyTextColor);
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        /* 46px - 56px */
        line-height: clamp(2.875rem, 5vw, 3.5rem);
        font-weight: 700;
        text-decoration: none;
        text-align: center;
        margin: 0;
        padding: 0 calc(48 / 16 * 1rem);
        background-color: var(--primary);
        color: var(--bodyTextColorWhite);
        display: inline-block;
        position: relative;
        z-index: 1;

        &:hover {
          &:before {
            width: 100%;
          }
        }

        &:before {
          content: "";
          width: 0%;
          height: 100%;
          background: #000;
          opacity: 1;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
        }
      }

      .cs-picture {
        width: 100vw;
        height: 100vw;
        max-height: calc(600 / 16 * 1rem);
        display: block;
        position: relative;
        left: calc(-16 / 16 * 1rem);
        z-index: 1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #why-2359 {
      .cs-content {
        /* changes to 369px at large desktop */
        max-width: calc(1280 / 16 * 1rem);
      }

      .cs-card-group {
        max-width: calc(1280 / 16 * 1rem);
      }

      .cs-item {
        grid-column: span 4;

        &:hover {
          .cs-h3 {
            color: var(--primary);
            border-color: var(--primary);
          }
        }
      }

      .cs-h3 {
        min-height: calc(77 / 16 * 1rem);
      }
    }
  }

  /* Large Desktop - 1800px */
  @media only screen and (min-width: 112.5rem) {
    #why-2359 {
      padding: var(--sectionPadding);
      padding-top: 0;

      .cs-container {
        display: flex;
        justify-content: flex-end;
      }

      .cs-content-wrapper {
        max-width: calc(1280 / 16 * 1rem);
        padding: var(--sectionPadding);
        padding-left: 0;
        padding-right: 0;
        flex-direction: row;
        align-items: flex-start;
      }

      .cs-content {
        max-width: calc(369 / 16 * 1rem);
        margin-top: 0;
      }

      .cs-picture {
        height: 100%;
        width: 35vw;
        max-width: calc(1100 / 16 * 1rem);
        max-height: 100%;
        position: absolute;
        top: 0;
        left: auto;
        right: calc(100% + 4rem);
      }
    }
  }
</style>
