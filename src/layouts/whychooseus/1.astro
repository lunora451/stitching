<style lang="scss">
  /*-- -------------------------- -->
<---         Services           -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #why-2425 {
      padding: var(--sectionPadding);
      padding-bottom: 0;
      padding-top: 0;
      background-color: #030711;
      overflow: hidden;
      position: relative;

      .cs-container {
        width: 100%;
        /* changes to 1280px at tablet */
        max-width: calc(584 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: clamp(calc(32 / 16 * 1rem), 9vw, calc(64 / 16 * 1rem));
        position: relative;
      }

      .cs-content {
        /* cs-content defines common rules of .cs-title-group and .cs-cta */
        text-align: left;
        width: 100%;
        padding: var(--sectionPadding);
        padding-left: 0;
        padding-right: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        position: relative;
        z-index: 1;
      }

      .cs-cta {
        /* these rules override .cs-content where needed */
        text-align: center;
        align-items: center;
        padding: var(--sectionPadding);
        padding-left: 0;
        padding-right: 0;
        order: 9;
      }

      .cs-topper {
        color: var(--secondary);
      }

      .cs-title {
        color: var(--bodyTextColorWhite);
        width: 100%;
        max-width: calc(410 / 16 * 1rem);
        margin: 0;
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        line-height: clamp(calc(46 / 16 * 1rem), 5.5vw, calc(56 / 16 * 1rem));
        text-decoration: none;
        font-weight: 700;
        text-align: center;
        color: #fff;
        white-space: nowrap;
        margin: 0;
        min-width: calc(190 / 16 * 1rem);
        padding: 0 calc(27 / 16 * 1rem);
        background-color: var(--primary);
        overflow: hidden;
        position: relative;
        z-index: 1;

        &:before {
          content: "";
          width: 100%;
          height: 100%;
          background: var(--secondary);
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transform: scaleX(0);
          transform-origin: 0 0;
          transition: transform 0.3s ease;
          opacity: 1;
        }

        &:hover {
          &:before {
            transform: scaleX(1);
          }
        }
      }

      .cs-text-group {
        display: flex;
        flex-direction: column;
        gap: clamp(calc(16 / 16 * 1rem), 3.9vw, calc(24 / 16 * 1rem));
      }

      .cs-card-group {
        width: 100%;
        max-width: 90%;
        margin: 0 auto;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: clamp(calc(32 / 16 * 1rem), 7vw, calc(80 / 16 * 1rem)) 0;
      }

      .cs-item {
        text-align: left;
        list-style: none;
        margin: 0;
        display: flex;
        justify-content: flex-start;
        align-items: flex-start;
        grid-column: span 12;
        gap: clamp(calc(24 / 16 * 1rem), 3.1vw, calc(32 / 16 * 1rem));
        position: relative;
        z-index: 1;
      }

      .cs-wrapper {
        width: calc(64 / 16 * 1rem);
        height: calc(64 / 16 * 1rem);
        display: block;
        flex: none;
        position: relative;
        z-index: 1;
      }

      .cs-border {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;

        &:before {
          content: "";
          opacity: 1;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
        }

        &:after {
          content: "";
          opacity: 1;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
        }
      }

      .cs-border1 {
        /* top left border */
        &:before {
          width: 100%;
          height: 1px;
          background: linear-gradient(
            to right,
            rgba(136, 137, 139, 1) 0%,
            rgba(0, 0, 0, 0) 78%
          );
        }

        &:after {
          width: 1px;
          height: 100%;
          background: linear-gradient(
            to bottom,
            rgba(136, 137, 139, 1) 0%,
            rgba(0, 0, 0, 0) 78%
          );
        }
      }

      .cs-border2 {
        &:before {
          width: 100%;
          height: 1px;
          background: linear-gradient(
            to right,
            rgba(0, 0, 0, 0) 22%,
            rgba(136, 137, 139, 1) 100%
          );
          top: auto;
          bottom: 0;
        }

        &:after {
          width: 1px;
          height: 100%;
          background: linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0) 22%,
            rgba(136, 137, 139, 1) 100%
          );
          left: auto;
          right: 0;
        }
      }

      .cs-icon {
        width: calc(24 / 16 * 1rem);
        height: calc(24 / 16 * 1rem);
        margin: auto;
        display: block;
        position: absolute;
        inset: 0;
        z-index: 2;
      }

      .cs-info {
        font-size: clamp(calc(14 / 16 * 1rem), 1.5vw, calc(16 / 16 * 1rem));
        line-height: 1.5em;
        margin: 0;
        padding: 0;
      }

      .cs-h3 {
        font-size: clamp(calc(20 / 16 * 1rem), 2.5vw, calc(25 / 16 * 1rem));
        font-weight: 500;
        line-height: 1.2em;
        text-align: inherit;
        max-width: 24ch;
        margin: 0 0 clamp(calc(12 / 16 * 1rem), 1.8vw, calc(16 / 16 * 1rem)) 0;
        color: var(--bodyTextColorWhite);
      }

      .cs-text {
        color: var(--bodyTextColorWhite);
        opacity: 0.9;
      }

      .cs-background {
        /* common decorative background image rules defined here */
        /* specific rules defined on .cs-title-bg and .cs-cta below */
        height: 100%;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        overflow: hidden;
        z-index: -1;

        &:before {
          /* common pseudo-element rules defined here */
          /* gradient overlays defined on .cs-title-bg and .cs-cta below */
          content: "";
          width: 100%;
          height: 100%;
          display: block;
          position: absolute;
          bottom: -1px;
          right: 0;
          z-index: -1;
        }

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: relative;
          z-index: -2;
        }
      }

      .cs-title-bg {
        width: 100vw;
        left: 50%;
        transform: translateX(-50%);

        &:before {
          height: 80%;
          background: linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0) 0%,
            rgba(3, 6, 15, 1) 90%,
            rgba(3, 7, 17, 1) 100%
          );
        }
      }

      .cs-cta-bg {
        width: 100vw;
        left: 50%;
        transform: translateX(-50%);

        &:before {
          /* horizontal gradient */
          background: linear-gradient(
            to right,
            rgba(3, 7, 17, 1) 0%,
            rgba(3, 6, 15, 1) 10%,
            rgba(0, 0, 0, 0) 100%
          );
        }
      }

      .cs-graphic {
        width: auto;
        height: calc(513 / 16 * 1rem);
        position: absolute;
        left: calc(50% + 50vw);
        bottom: 36%;
        transform: translate(-100%, 50%);
        display: none;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #why-2425 {
      /* added padding back to section container for a consistent padding bottom */
      padding: var(--sectionPadding);
      padding-top: 0;
      flex-direction: row;
      flex-wrap: wrap;

      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        align-items: stretch;
        gap: calc(64 / 16 * 1rem) 0;
      }

      .cs-content {
        grid-column: span 6;
        justify-content: flex-end;
      }

      .cs-title-group {
        padding-top: clamp(calc(140 / 16 * 1rem), 20vw, calc(240 / 16 * 1rem));
        padding-bottom: calc(60 / 16 * 1rem);
        justify-content: flex-end;
      }

      .cs-topper {
        max-width: none;
        margin: 0;
      }

      .cs-title {
        max-width: none;
        margin: 0;
      }

      .cs-cta {
        text-align: left;
        padding-top: calc(100 / 16 * 1rem);
        padding-left: clamp(calc(32 / 16 * 1rem), 4vw, calc(60 / 16 * 1rem));
        padding-bottom: calc(60 / 16 * 1rem);
        align-items: flex-start;
        order: unset;
      }

      .cs-text-group {
        width: 100%;
        flex-direction: row;
        gap: calc(24 / 16 * 1rem);
        grid-column: span 12;

        .cs-text {
          max-width: none;
        }
      }

      .cs-card-group {
        margin: 0 auto 0 0;
        gap: calc(48 / 16 * 1rem) 0;
        grid-column: span 12;
      }

      .cs-item {
        padding-inline: 0 calc(32 / 16 * 1rem);
        flex-direction: column;
        grid-column: span 6;
      }

      .cs-graphic {
        display: block;
      }

      .cs-title-bg {
        width: 50vw;
        left: auto;
        right: 0;
        transform: none;
      }

      .cs-cta-bg {
        width: 50vw;
        margin: 0;
        left: 0;
        transform: none;
      }
    }
  }

  /* Large Desktop - 1300px */
  @media only screen and (min-width: 81.25rem) {
    #why-2425 {
      .cs-title-group {
        padding-bottom: 0;
        grid-column: span 8;
      }

      .cs-title-bg {
        width: 65vw;
      }

      .cs-cta {
        grid-column: span 4;
      }

      .cs-cta-bg {
        width: 45vw;
      }

      .cs-text-group {
        margin-bottom: calc(64 / 16 * 1rem);
      }

      .cs-card-group {
        max-width: 100%;
      }

      .cs-item {
        grid-column: span 4;
      }
    }
  }
</style>
