<style lang="scss">
  /*-- -------------------------- -->
<---           Footer           -->
<--- -------------------------- -*/

  /* Mobile */
  @media only screen and (min-width: 0rem) {
    #cs-footer-2440 {
      padding: var(--sectionPadding);
      padding-bottom: calc(24 / 16 * 1rem);
      background-color: #111418;
      overflow: hidden;

      .cs-container {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
      }

      .cs-top {
        display: flex;
        flex-direction: column;
        /* 16px - 80px */
        column-gap: clamp(1rem, 6vw, 5rem);
        row-gap: calc(32 / 16 * 1rem);
      }

      .cs-logo-group {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        /* 32px - 72px */
        gap: clamp(2rem, 5vw, 4.5rem);
      }

      .cs-logo {
        max-width: calc(205 / 16 * 1rem);
        height: auto;
        display: block;
      }

      .cs-logo-img {
        width: 100%;
        height: auto;
        display: block;
      }

      .cs-contact-group {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: calc(14 / 16 * 1rem);
      }

      .cs-contact-li {
        display: flex;
        justify-content: flex-start;
        align-items: flex-start;
        gap: calc(12 / 16 * 1rem);
      }

      .cs-contact-icon {
        width: calc(24 / 16 * 1rem);
        height: auto;
        display: block;
      }

      .cs-contact-link {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 400;
        line-height: 1.5em;
        text-decoration: none;
        color: var(--bodyTextColorWhite);
        opacity: 0.8;
      }

      .cs-ul {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: calc(12 / 16 * 1rem);
      }

      .cs-header {
        font-size: calc(20 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        margin: 0 0 calc(12 / 16 * 1rem);
        color: var(--bodyTextColorWhite);
        display: block;

        .cs-link {
          opacity: 1;
        }
      }

      .cs-li {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.5em;
        list-style: none;
        margin: 0;
      }

      .cs-link {
        text-decoration: none;
        color: var(--bodyTextColorWhite);
        opacity: 0.8;
        transition: color 0.3s;

        &:hover {
          color: var(--primary);
        }
      }

      .cs-subscribe-group {
        display: flex;
        flex-direction: column;
        gap: calc(16 / 16 * 1rem);

        .cs-header {
          margin: 0;
        }
      }

      .cs-form {
        width: 100%;
        display: flex;
        align-items: stretch;
        gap: calc(16 / 16 * 1rem);
      }

      .cs-input {
        width: 100%;
        padding: calc(16 / 16 * 1rem);
        background-color: transparent;
        color: var(--bodyTextColorWhite);
        border: none;
        border-bottom: 1px solid #21252e;
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        /* 46px - 56px */
        line-height: clamp(2.875rem, 5.5vw, 3.5rem);
        text-align: center;
        text-decoration: none;
        min-width: calc(150 / 16 * 1rem);
        margin: 0;
        padding: 0 calc(16 / 16 * 1rem);
        background-color: var(--primary);
        color: var(--bodyTextColorWhite);
        display: inline-block;
        position: relative;
        z-index: 1;

        &:before {
          content: "";
          width: 0%;
          height: 100%;
          background: #fff;
          opacity: 1;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
        }

        &:hover {
          &:before {
            width: 100%;
          }
        }
      }

      .cs-button-solid {
        min-width: auto;
        border: none;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .cs-icon {
        width: calc(20 / 16 * 1rem);
        height: auto;
        display: block;
      }

      .cs-bottom {
        /* 48px - 80px */
        margin-top: clamp(3rem, 6vw, 5rem);
        /* 24px - 40px */
        padding-top: clamp(1.5rem, 3vw, 2.5rem);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: calc(12 / 16 * 1rem);
        position: relative;
        z-index: 1;

        &:before {
          content: "";
          width: 100%;
          max-width: calc(1280 / 16 * 1rem);
          height: 1px;
          background: #2d2f2e;
          opacity: 1;
          display: block;
          position: absolute;
          top: 0;
          left: 50%;
          transform: translateX(-50%);
        }
      }

      .cs-flex {
        display: flex;
        flex-flow: wrap row;
        justify-content: center;
        align-items: center;
        column-gap: calc(12 / 16 * 1rem);
        row-gap: calc(4 / 16 * 1rem);
      }

      .cs-divider {
        width: 1px;
        height: calc(13 / 16 * 1rem);
        background-color: var(--bodyTextColorWhite);
        opacity: 0.8;
        display: block;
      }

      .cs-copyright {
        text-decoration: none;
        color: var(--bodyTextColorWhite);
        opacity: 0.8;
        transition: color 0.3s;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #cs-footer-2440 {
      .cs-top {
        flex-direction: row;
        justify-content: flex-end;
        flex-wrap: wrap;
      }

      .cs-logo-group {
        /* 285px - 316px */
        max-width: clamp(17.8125rem, 22vw, 19.75rem);
        margin-right: auto;
      }

      .cs-ul {
        /* Add padding to offset the .cs-ul from the logo, which sits above the rest of the items */
        padding-top: calc(84 / 16 * 1rem);
        flex: none;
      }

      .cs-subscribe-group {
        width: 100%;
      }

      .cs-bottom {
        flex-direction: row;
        justify-content: space-between;
      }
    }
  }

  /* Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #cs-footer-2440 {
      .cs-top {
        flex-wrap: nowrap;
      }

      .cs-ul {
        padding: 0;
      }

      .cs-subscribe-group {
        width: initial;
        /* 281px - 372px */
        max-width: clamp(17.5625rem, 26vw, 23.25rem);
      }
    }
  }
</style>
