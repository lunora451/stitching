<style lang="scss">
  /*-- -------------------------- -->
<---          Footer            -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #cs-footer-1292 {
      padding: var(--sectionPadding);
      padding-bottom: calc(20 / 16 * 1rem);
      box-sizing: border-box;
      overflow: hidden;
      position: relative;
      z-index: 10;

      .cs-container {
        width: 100%;
        margin: auto;
        display: flex;
        justify-content: flex-start;
        align-items: flex-start;
        flex-wrap: wrap;
        column-gap: calc(24 / 16 * 1rem);
        row-gap: calc(36 / 16 * 1rem);
      }

      .cs-logo-group {
        /* takes up all the space, lets the other ul's wrap below it */
        width: 100%;
        position: relative;
      }

      .cs-logo {
        width: calc(197 / 16 * 1rem);
        height: auto;
        display: block;
        /* 20px - 24px */
        margin: 0 0 clamp(1.25rem, 2vw, 1.5rem) 0;
      }

      .cs-logo-img {
        width: 100%;
        height: auto;

        &.dark {
          display: none;
        }
      }

      .cs-text {
        margin-bottom: calc(32 / 16 * 1rem);
      }

      .cs-link {
        font-size: calc(14 / 16 * 1rem);
        line-height: 1.5em;
        text-decoration: none;
        margin: 0;
        color: var(--headerColor);
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: calc(12 / 16 * 1rem);
        transition: color 0.3s;

        &:hover {
          color: var(--primary);
        }
      }

      /* Navigation Links */

      .cs-nav {
        width: 45%;
        max-width: calc(180 / 16 * 1rem);
        padding: 0;
        margin: 0;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        flex-direction: column;
        gap: calc(16 / 16 * 1rem);
      }

      .cs-nav-li {
        list-style: none;
        display: flex;
        justify-content: flex-start;
        align-items: flex-start;
      }

      .cs-header {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.2em;
        font-weight: 700;
        margin-bottom: calc(8 / 16 * 1rem);
        color: var(--headerColor);
        position: relative;
        display: block;
      }

      .cs-nav-link {
        font-size: calc(14 / 16 * 1rem);
        text-decoration: none;
        line-height: 1.5em;
        width: auto;
        color: var(--bodyTextColor);
        position: relative;
        display: inline-block;
        transition: color 0.3s;

        &:before {
          /* underline */
          content: "";
          width: 0%;
          height: calc(2 / 16 * 1rem);
          background: currentColor;
          opacity: 1;
          position: absolute;
          display: block;
          bottom: calc(-2 / 16 * 1rem);
          left: 0;
          transition: width 0.3s;
        }

        &:hover {
          color: var(--primary);
          &:before {
            width: 100%;
          }
        }
      }

      .cs-bottom {
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
        /* 48px - 100px */
        margin-top: clamp(3rem, 9vw, 6.25rem);
        /* 20px - 32px */
        padding: clamp(1.25rem, 3vw, 2rem) 0 0 0;
        box-sizing: border-box;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        column-gap: calc(36 / 16 * 1rem);
        row-gap: calc(12 / 16 * 1rem);
      }

      .cs-copyright,
      .cs-copyright-link {
        font-size: calc(14 / 16 * 1rem);
        line-height: 1.5em;
        color: var(--bodyTextColor);
      }

      .cs-copyright {
        text-align: center;
        width: 100%;
      }

      .cs-copyright-link {
        text-decoration: none;
        transition: color 0.3s;
        &:hover {
          color: var(--secondary);
        }
      }

      .cs-floater {
        width: calc(506 / 16 * 1rem);
        height: calc(506 / 16 * 1rem);
        margin-left: calc(550 / 16 * 1rem);
        border-radius: 50%;
        border: 2px solid var(--primary);
        opacity: 0.1;
        display: none;
        position: absolute;
        left: 50%;
        top: 0;
        z-index: -1;

        &:before {
          content: "";
          width: calc(715 / 16 * 1rem);
          height: calc(715 / 16 * 1rem);
          border: 2px solid var(--primary);
          border-radius: 50%;
          opacity: 0.6;
          position: absolute;
          display: block;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
        }

        &:after {
          content: "";
          width: calc(963 / 16 * 1rem);
          height: calc(963 / 16 * 1rem);
          border: 2px solid var(--primary);
          border-radius: 50%;
          opacity: 0.3;
          position: absolute;
          display: block;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #cs-footer-1292 {
      .cs-container {
        row-gap: 0;
        flex-direction: row;
        flex-wrap: nowrap;
        column-gap: clamp(calc(44 / 16 * 1rem), 6vw, calc(88 / 16 * 1rem));
        row-gap: calc(40 / 16 * 1rem);
      }

      .cs-nav {
        width: auto;
      }

      .cs-bottom {
        flex-wrap: nowrap;
        justify-content: flex-start;
      }

      .cs-copyright {
        text-align: left;
        width: auto;
        margin-right: auto;
      }

      .cs-floater {
        display: block;
      }
    }
  }

  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #cs-footer-1292 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        flex-wrap: nowrap;
        /* align everything to the right */
        justify-content: flex-end;
        column-gap: clamp(2.5rem, 6vw, 5.25rem);
      }

      .cs-logo-group {
        width: 30%;
        max-width: calc(387 / 16 * 1rem);
        /* pushes away from everything to the right */
        margin-right: auto;
      }

      .cs-text {
        width: 100%;
      }

      .cs-graphic {
        display: block;
      }
    }
  }
</style>
