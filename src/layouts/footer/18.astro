      }

      .cs-sitemap {
        gap: calc(12 / 16 * 1rem);
      }

      .cs-li {
        /* 14px - 16px */
        font-size: clamp(0.875rem, 1.5vw, 1rem);
        list-style: none;
        display: flex;
        justify-content: flex-start;
        align-items: flex-start;
        gap: calc(12 / 16 * 1rem);
      }

      .cs-link {
        text-decoration: none;
        color: var(--bodyTextColorWhite);
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: calc(12 / 16 * 1rem);
        transition: color 0.3s;
        &:hover {
          color: var(--secondary);
        }
      }

      .cs-header {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 3vw, 1.5625rem);
