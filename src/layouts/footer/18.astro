            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Footer/fb-blue.svg"
            alt="facebook"
            width="11"
            height="11"
          />
        </a>
        <a class="cs-social-link" aria-label="visit facebook profile" href="">
          <img
            class="cs-social-img"
            aria-hidden="true"
            loading="lazy"
            decoding="async"
            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Footer/insta-blue.svg"
            alt="instagram"
            width="6"
            height="11"
          />
        </a>
        <a class="cs-social-link" aria-label="visit instagram profile" href="">
          <img
            class="cs-social-img"
            aria-hidden="true"
            loading="lazy"
            decoding="async"
            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Footer/twitter-blue.svg"
            alt="twitter"
            width="11"
            height="11"
          />
        </a>
      </div>
    </div>
  </div>
</footer>

<style lang="scss">
  /*-- -------------------------- -->
<---           Footer           -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #cs-footer-487 {
      /* 48px - 64px */
      padding: clamp(3rem, 6vw, 4rem) calc(16 / 16 * 1rem);
      background-color: var(--primary);

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
        max-width: calc(800 / 16 * 1rem);
        margin: auto;
      }

      .cs-top {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: flex-start;
        column-gap: calc(36 / 16 * 1rem);
        /* 40px - 48px */
        row-gap: clamp(2.5rem, 5vw, 3rem);
      }

      .cs-logo-group {
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
      }

      .cs-logo-img {
        width: calc(158 / 16 * 1rem);
        height: auto;
        /* 24px - 32px */
        margin-bottom: clamp(1.5rem, 3vw, 2rem);
