<style lang="scss">
  /*-- -------------------------- -->
<---          Footer            -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #cs-footer-2412 {
      //responsive gradient button color adapts to unique branding color changes
      --gradientmix: color-mix(in lab, var(--primaryLight), black 49%);

      text-align: center;
      padding: var(--sectionPadding);
      padding-bottom: clamp(calc(40 / 16 * 1rem), 6vw, calc(60 / 16 * 1rem));
      color: var(--bodyTextColorWhite);
      background-color: #191005;
      overflow: hidden;
      position: relative;
      z-index: 1;

      &:before {
        content: "";
        width: 100%;
        height: 100%;
        background: url(https://nyc3.digitaloceanspaces.com/csimages2/Images/Patterns/noise100.png)
          repeat 0 0;
        opacity: 0.02;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;
      }

      .cs-container {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
      }

      .cs-text {
        color: inherit;
      }

      .cs-logo {
        width: 45.125%;
        max-width: calc(216 / 16 * 1rem);
        height: auto;
        margin: 0 auto calc(48 / 16 * 1rem);
        display: block;
      }

      .cs-link {
        /* 14px - 16px */
        font-size: clamp(calc(14 / 16 * 1rem), 1.5vw, calc(16 / 16 * 1rem));
        line-height: 1.5em;
        text-decoration: none;
        color: var(--bodyTextColorWhite);
        transition: color 0.3s ease;

        &:hover {
          color: var(--primaryLight);
        }
      }

      /* .cs-quick-links */
      .cs-h2 {
        font-size: calc(25 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.5em;
        margin: 0 0 calc(16 / 16 * 1rem) 0;
        color: var(--bodyTextColorWhite);
        display: block;
        position: relative;
      }

      .cs-ul {
        max-width: none;
        margin: 0;
        margin-bottom: clamp(calc(24 / 16 * 1rem), 8vw, calc(48 / 16 * 1rem));
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        column-gap: clamp(calc(21 / 16 * 1rem), 6.9vw, calc(48 / 16 * 1rem));
        row-gap: calc(4 / 16 * 1rem);
