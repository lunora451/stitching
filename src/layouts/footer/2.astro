    </div>
  </div>
  <div class="cs-credit">
    <span class="cs-ip cs-text"
      >© 2025 Welcome to Poop Patrol LLC. All rights reserved.</span
    >
  </div>
  <svg
    class="cs-curve"
    aria-hidden="true"
    width="1920"
    height="151"
    viewBox="0 0 1920 151"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <filter
        id="filter0_d_1_72-2412"
        x="-4"
        y="0"
        width="1928"
        height="151"
        filterUnits="userSpaceOnUse"
        color-interpolation-filters="sRGB"
      >
        <feFlood flood-opacity="0" result="BackgroundImageFix"></feFlood>
        <feColorMatrix
          in="SourceAlpha"
