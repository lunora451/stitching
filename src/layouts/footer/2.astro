<!-- ============================================ --><!--                   Footer                     --><!-- ============================================ -->
<footer id="cs-footer-2412">
  <div class="cs-container cs-container-top">
    <!-- Logo -->
    <img
      class="cs-logo"
      src="https://nyc3.digitaloceanspaces.com/csimages2/Images/Logos/poo-pat-logomark.svg"
      alt="poop patrol"
      loading="lazy"
      decoding="async"
      width="216"
      height="101"
    />
    <!--Quick Links-->
    <div class="cs-quick-links">
      <h2 class="cs-h2">Quick Links</h2>
      <ul class="cs-ul">
        <li class="cs-li">
          <a class="cs-link" href="/">Home</a>
        </li>
        <li class="cs-li">
          <a class="cs-link" href="">About</a>
        </li>
        <li class="cs-li">
          <a class="cs-link" href="">Services</a>
        </li>
        <li class="cs-li">
          <a class="cs-link" href="">FAQ</a>
        </li>
        <li class="cs-li">
          <a class="cs-link" href="">Contact</a>
        </li>
      </ul>
    </div>
    <div class="cs-wrapper">
      <!--Subscribtion Form-->
      <div class="cs-subscribe">
        <h2 class="cs-header">Subscribe for Seasonal Offers & Pet Care Tips</h2>
        <form class="cs-form" name="Subscription Form" method="post">
          <input
            class="cs-input cs-text"
            type="email"
            id="cs-subscribe-2412"
            name="Subscribe"
            placeholder="Email Address"
          />
          <button class="cs-button-solid cs-submit" type="submit">
            <img
              class="cs-icon"
              src="https://nyc3.digitaloceanspaces.com/csimages2/Images/Icons/paperplane.svg"
              alt="submit my email and subcribe"
              width="40"
              height="40"
              decoding="async"
              loading="lazy"
            />
          </button>
        </form>
      </div>
      <div class="cs-bottom">
        <!--Social-->
        <div class="cs-social">
          <a
            href=""
            class="cs-social-link"
            target="_blank"
            rel="noopener"
            aria-label="visit facebook"
          >
            <img
              class="cs-social-icon"
              src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Icons/face-white1.svg"
              alt="facebook"
              loading="lazy"
              decoding="async"
              width="12"
              height="12"
            />
          </a>
          <a
            href=""
            class="cs-social-link"
            target="_blank"
            rel="noopener"
            aria-label="visit twitter"
          >
            <img
              class="cs-social-icon"
              src="https://nyc3.digitaloceanspaces.com/csimages2/Images/Icons/twitter-x-white.svg"
              alt="twitter"
              loading="lazy"
              decoding="async"
              width="12"
              height="12"
            />
          </a>
          <a
            href=""
            class="cs-social-link"
            target="_blank"
            rel="noopener"
            aria-label="visit instagram"
          >
            <img
              class="cs-social-icon"
              src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Icons/instagram.svg"
              alt="instagram"
              loading="lazy"
              decoding="async"
              width="12"
              height="12"
            />
          </a>
          <a
            href=""
            class="cs-social-link"
            target="_blank"
            rel="noopener"
            aria-label="visit youtube"
          >
            <img
              class="cs-social-icon"
              src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Icons/youtube.svg"
              alt="youtube"
              loading="lazy"
              decoding="async"
              width="12"
              height="12"
            />
          </a>
        </div>
        <!--Legal-->
        <div class="cs-legal">
          <a href="" class="cs-legal-link cs-link">Terms & Conditions</a>
          <span class="cs-divider" aria-hidden="true">|</span>
          <a href="" class="cs-legal-link cs-link">Privacy Policy</a>
        </div>
