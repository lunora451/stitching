        font-weight: 600;
        margin: 0;
        margin-bottom: calc(24 / 16 * 1rem);
      }

      .cs-form {
        margin-bottom: clamp(calc(32 / 16 * 1rem), 11vw, calc(40 / 16 * 1rem));
        display: flex;
        gap: calc(16 / 16 * 1rem);
      }

      .cs-input {
        text-align: left;
        background: none;
        border: none;
        border-bottom: 1px solid #4c4a48;
      }

      .cs-submit {
        width: calc(48 / 16 * 1rem);
        height: calc(48 / 16 * 1rem);
        padding: 0;
        background-color: var(--primaryLight);
        background-image: -moz-linear-gradient(
