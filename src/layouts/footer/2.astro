        width: auto;
      }

      .cs-divider {
        margin: 0 calc(16 / 16 * 1rem);
      }

      .cs-credit {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
        margin-top: clamp(calc(48 / 16 * 1rem), 4vw, calc(100 / 16 * 1rem));
        padding-top: calc(20 / 16 * 1rem);
        border-top: 1px solid #4c4a48;
        display: flex;
        justify-content: center;
        align-items: center;
      }

