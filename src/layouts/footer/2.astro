        <feBlend
          mode="normal"
          in2="BackgroundImageFix"
          result="effect1_dropShadow_1_72"></feBlend>
        <feBlend
          mode="normal"
          in="SourceGraphic"
          in2="effect1_dropShadow_1_72"
          result="shape"></feBlend>
      </filter>
    </defs>
    <g filter="url(#filter0_d_1_72)">
      <path
        d="M1920 0H0V143C111.116 97.6666 456.485 7 951 7C1445.52 7 1803.21 97.6666 1920 143V0Z"
        fill="var(--overlayBG)"></path>
    </g>
