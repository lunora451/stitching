      .cs-logo-group {
        /* takes up all the space, lets the other ul's wrap below it */
        width: 100%;
        position: relative;
      }

      .cs-logo {
        width: calc(210 / 16 * 1rem);
        height: auto;
        margin: 0 0 calc(16 / 16 * 1rem) 0;
        display: block;
      }

      .cs-text {
        max-width: calc(704 / 16 * 1rem);
        /* 24px - 40px */
        margin: 0 0 clamp(1.5rem, 4vw, 2.5rem);
