        text-align: left;
        text-decoration: none;
        color: var(--bodyTextColor);
        display: inline-flex;
        align-items: flex-start;
        gap: calc(8 / 16 * 1rem);
        transition: color 0.3s;

        &:hover {
          color: var(--primaryLight);
        }
      }

      .cs-bottom {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        /* 60px - 80px */
