        justify-content: flex-start;
        align-items: center;
        gap: calc(8 / 16 * 1rem);
        transition: color 0.3s;

        &:hover {
          color: var(--primary);
        }
      }

      .cs-icon {
        width: calc(24 / 16 * 1rem);
        height: auto;
        display: block;
      }

      .cs-social {
        /* 24px - 32px */
        margin-top: clamp(1.5rem, 5vw, 2rem);
        display: flex;
        justify-content: flex-start;
        align-items: stretch;
        gap: calc(8 / 16 * 1rem);
      }

      .cs-social-link {
        width: calc(32 / 16 * 1rem);
        height: calc(32 / 16 * 1rem);
        border-radius: 50%;
        border: 1px solid #d2d8df;
        display: flex;
        justify-content: center;
        align-items: center;
        transition:
          background-color 0.3s,
          border-color 0.3s;

