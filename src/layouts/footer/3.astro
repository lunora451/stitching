        /* 500px -635px */
        width: clamp(31.25rem, 50vw, 39.6875rem);
        height: auto;
        filter: blur(180px);
        opacity: 0.44;
        position: absolute;
        bottom: calc(-20 / 16 * 1rem);
        right: calc(-240 / 16 * 1rem);
        z-index: -2;
      }
