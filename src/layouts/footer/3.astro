        margin-bottom: calc(12 / 16 * 1rem);
        display: flex;
        flex-wrap: wrap;
        gap: calc(16 / 16 * 1rem);

        .cs-link {
          display: flex;
          align-items: center;
          position: relative;
          z-index: 1;

          &:after {
            content: "";
            width: 4px;
            height: 4px;
            margin-left: calc(16 / 16 * 1rem);
            background: #fff;
            border-radius: 50%;
            opacity: 1;
            display: block;
          }

          &:last-of-type {
            &:after {
              display: none;
            }
          }
        }
      }

      .cs-copyright {
        display: flex;
        align-items: center;
        gap: calc(8 / 16 * 1rem);
      }

