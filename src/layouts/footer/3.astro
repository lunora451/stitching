        margin-bottom: calc(16 / 16 * 1rem);
        display: block;

        img {
          width: 100%;
          height: auto;
        }
      }

      .cs-text {
        text-align: inherit;
        /* 32px - 40px */
        margin: 0 0 clamp(2rem, 5vw, 2.5rem);
        color: #e8ebef;
      }

      .cs-contact-info {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        /* 8px - 12px */
        gap: clamp(0.5rem, 1.5vw, 0.75rem);
      }

      .cs-header {
        font-size: calc(20 / 16 * 1rem);
        line-height: 1.2em;
        font-weight: 700;
