        <img
          class="cs-logo-img light"
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          src="https://csimg.nyc3.digitaloceanspaces.com/Footer/logo.svg"
          alt="logo"
          width="240"
          height="32"
        />
        <!-- Lighter Dark Mode Logo, remove if not needed -->
