<style lang="scss">
  /*-- -------------------------- -->
<---           Steps            -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #steps-2013 {
      padding: var(--sectionPadding);
      overflow: hidden;
      position: relative;

      &::before {
        /* backgorund color */
        content: "";
        width: 100%;
        height: 100%;
        background-color: var(--primary);
        opacity: 0.05;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;
      }

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
        max-width: calc(704 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-text {
        max-width: calc(900 / 16 * 1rem);
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        /* 16px - 20px */
        gap: clamp(1rem, 2vw, 1.25rem);
        position: relative;
      }

      .cs-item {
        text-align: center;
        list-style: none;
        width: 100%;
        padding: clamp(1.5rem, 3.1vw, 2rem) clamp(1rem, 2.3vw, 2rem);
        background-color: #fff;
        border-radius: calc(8 / 16 * 1rem);
        border: 1px solid transparent;
        display: flex;
        flex-direction: column;
        align-items: center;
        grid-column: span 12;
        position: relative;
        transition: border 0.3s;

        &:hover {
          border: 1px solid var(--primary);

          .cs-h3 {
            color: var(--primary);
          }
        }
      }

      .cs-icon {
        width: calc(48 / 16 * 1rem);
        height: auto;
        margin-bottom: calc(16 / 16 * 1rem);
        display: block;
      }

      .cs-h3 {
        font-size: calc(20 / 16 * 1rem);
        line-height: 1.2em;
        text-align: inherit;
        margin: 0 0 calc(16 / 16 * 1rem) 0;
        color: var(--headerColor);
        transition: color 0.3s;
      }

      .cs-item-text {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.5em;
        text-align: inherit;
        margin: 0 0 calc(24 / 16 * 1rem) 0;
        color: var(--bodyTextColor);
      }

      .cs-number-wrapper {
        width: calc(48 / 16 * 1rem);
        height: calc(48 / 16 * 1rem);
        margin-top: auto;
        margin-bottom: calc(-24 / 16 * 1rem);
        padding: calc(10 / 16 * 1rem);
        background-color: var(--headerColor);
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1;
      }

      .cs-number {
        font-size: calc(20 / 16 * 1rem);
        font-weight: 700;
        color: #fff;
      }

      .cs-picture {
        width: 100%;
        /* 140px - 180px */
        height: clamp(8.75rem, 18vw, 11.25rem);
        display: block;
        flex: none;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          border-radius: calc(8 / 16 * 1rem);
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #steps-2013 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
      }

      .cs-item {
        grid-column: span 4;
      }
    }
  }
</style>
