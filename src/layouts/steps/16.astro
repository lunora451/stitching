<style lang="scss">
  /*-- -------------------------- -->
<---           Steps            -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #steps-1480 {
      padding: var(--sectionPadding);
      position: relative;
      overflow: hidden;

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
        max-width: calc(704 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-text {
        font-size: var(--bodyFontSize);
        line-height: 1.5em;
        text-align: inherit;
        width: 100%;
        max-width: calc(650 / 16 * 1rem);
        margin: 0;
        color: var(--bodyTextColor);
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: calc(24 / 16 * 1rem);
        position: relative;
      }

      .cs-item {
        text-align: center;
        list-style: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        grid-column: span 12;
        position: relative;
      }

      .cs-picture-group {
        position: relative;
      }

      .cs-picture {
        border: 1px solid #fff;
        display: flex;
        justify-content: center;
        align-items: center;

        img {
          object-fit: cover;
        }
      }

      .cs-shape {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
      }

      .cs-icon-wrapper {
        /* 16px - 20px */
        margin-top: calc(clamp(1rem, 2vw, 1.25rem) * -1);
        margin-bottom: calc(16 / 16 * 1rem);
        padding: calc(12 / 16 * 1rem);
        background-color: var(--primaryLight);
        border: 1px solid var(--primary);
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1;
      }

      .cs-icon {
        width: auto;
        height: calc(16 / 16 * 1rem);
      }

      .cs-h3 {
        font-size: calc(20 / 16 * 1rem);
        line-height: 1.2em;
        text-align: inherit;
        margin: 0 0 calc(8 / 16 * 1rem) 0;
        color: var(--headerColor);
      }

      .cs-item-text {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.5em;
        text-align: inherit;
        max-width: calc(260 / 16 * 1rem);
        margin: 0;
        color: var(--bodyTextColor);
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        /* 46px - 56px */
        line-height: clamp(2.875rem, 5.5vw, 3.5rem);
        text-align: center;
        text-decoration: none;
        min-width: calc(150 / 16 * 1rem);
        margin: 0;
        /* prevents padding from adding to the width */
        box-sizing: border-box;
        padding: 0 calc(24 / 16 * 1rem);
        color: #fff;
        background-color: var(--secondary);
        border: none;
        border-radius: calc(100 / 16 * 1rem);
        display: inline-block;
        position: relative;
        z-index: 1;
        overflow: hidden;

        &:before {
          content: "";
          width: 0%;
          height: 100%;
          background: #000;
          opacity: 1;
          border-radius: calc(100 / 16 * 1rem);
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
        }

        &:hover {
          &:before {
            width: 100%;
          }
        }
      }

      .cs-graphic {
        width: calc(469 / 16 * 1rem);
        height: calc(455 / 16 * 1rem);
        position: absolute;
        top: calc(-241 / 16 * 1rem);
        right: calc(-275 / 16 * 1rem);
        z-index: -1;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #steps-1480 {
      .cs-item {
        grid-column: span 6;

        &:nth-of-type(2) {
          &:after {
            display: none;
          }
        }

        &:nth-of-type(1) {
          &:after {
            transform: rotate(135deg) scaleX(-1);
          }
        }

        &:after {
          margin: 0;
          position: absolute;
          top: 0;
          right: calc(-40 / 16 * 1rem);
          transform: rotate(45deg);
        }
      }
    }
  }

  /* Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #steps-1480 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
      }

      .cs-card-group {
        /* dotted line background */
        &::after {
          content: "";
          width: calc(4000 / 16 * 1rem);
          height: calc(151 / 16 * 1rem);
          background-image: url(https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/day-care-line.svg);
          position: absolute;
          top: calc(50 / 16 * 1rem);
          left: 50%;
          z-index: -1;
          transform: translateX(-50%);
        }
      }

      .cs-item {
        grid-column: span 3;

        &:nth-of-type(2) {
          &:after {
            display: block;
            transform: rotate(45deg);
          }
        }

        &:nth-of-type(3) {
          &:after {
            display: block;
            transform: rotate(135deg) scaleX(-1);
          }
        }

        &:after {
          right: calc(-48 / 16 * 1rem);
        }
      }

      .cs-graphic {
        top: 0;
      }
    }
  }

  /* Large Desktop - 1500px */
  @media only screen and (min-width: 93.75rem) {
    #steps-1480 {
      .cs-graphic {
        width: calc(710 / 16 * 1rem);
        height: calc(690 / 16 * 1rem);
        margin-left: calc(663 / 16 * 1rem);
        left: 50%;
      }
    }
  }
</style>
