  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #steps-2433 {
      padding: var(--sectionPadding);
      background-color: #030711;
      overflow: hidden;
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        max-width: calc(584 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: clamp(calc(48 / 16 * 1rem), 6vw, calc(64 / 16 * 1rem));
        position: relative;
      }

      .cs-content {
        width: 100%;
        display: flex;
        flex-direction: column;
        column-gap: calc(48 / 16 * 1rem);

        .cs-text {
          /* changes to 413px at tablet */
          max-width: 100%;
        }
      }

      .cs-flex {
        width: 100%;
      }

      .cs-topper {
        width: 100%;
        color: var(--secondary);
      }

      .cs-title {
        text-wrap: balance;
        max-width: none;
        color: var(--bodyTextColorWhite);
      }

      .cs-steps {
        width: 100%;
        /* height enables smooth transition between tabs and eliminates content layout shift (CLS) for accordion while oriented vertically • adjust this to accommodate your custom content */
        height: calc(960 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        position: relative;
      }

      .cs-step-toggle {
        /* dimensions of .cs-step-toggle and .cs-tab must be the same at all times */
        width: 100%;
        height: calc(56 / 16 * 1rem);
        margin: 0;
        padding: 0;
        -webkit-appearance: none;
        appearance: none;
        flex-shrink: 0;
        cursor: pointer;
      }

      :checked + .cs-step-panel {
        /* open panel styles */
        min-height: calc(540 / 16 * 1rem);
        flex-basis: 100%; /* or whatever proportion you want the active panel to expand to */
        flex-grow: 1;

        .cs-tab {
          color: var(--primary);
        }

        .cs-item {
          padding-bottom: calc(16 / 16 * 1rem);
          opacity: 1;
          transition-duration: 0.66s;
          transition-timing-function: ease;
          transition-delay: 0.3s;
          pointer-events: auto;

          .cs-text {
            grid-template-rows: 1fr;
            transition-duration: 0.66s;
            transition-timing-function: ease;
            transition-delay: 0.3s;
          }
        }

        .cs-item-icon {
          opacity: 1;
          transition-duration: 1.75s;
          transition-timing-function: ease;
          transition-delay: 0.3s;
        }

        .cs-picture {
          opacity: 1;
          transform: scale(1);
          transition-timing-function: ease;
          transition-duration: 0.66s;
          transition-delay: 0.33s;
        }
      }

      .cs-step-panel {
        min-height: 0;
        height: 0;
        display: flex;
        flex-direction: column;
        flex-basis: 0;
        flex-grow: 0;
        flex-shrink: 1;
        position: relative;
        transition-property: flex-basis, flex-grow, min-height;
        transition-duration: 0.3s;
        transition-timing-function: linear;
      }

      .cs-tab {
        /* dimensions of .cs-step-toggle and .cs-tab must be the same at all times */
        font-size: clamp(calc(20 / 16 * 1rem), 12vw, calc(25 / 26 * 1rem));
        line-height: calc(56 / 16 * 1rem);
        text-align: left;
        width: 100%;
        height: calc(56 / 16 * 1rem);
        padding: 0;
        color: var(--bodyTextColorWhite);
        background: none;
        /* reset border on label element */
        border: none;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        align-items: center;
        position: absolute;
        top: 0;
        left: 0;
        /* position label over toggle element */
        transform: translate(0, -100%);
        transition: color 0.3s ease;
        pointer-events: none;
      }

      .cs-item {
        text-align: left;
        margin: 0 auto auto auto;
        padding: 0;
        opacity: 0;
        display: flex;
        align-items: flex-start;
        flex-direction: column;
        gap: calc(32 / 16 * 1rem);
        z-index: 1;
        transition-property: opacity;
        transition-duration: 0.15s;
        transition-timing-function: linear;
        pointer-events: none;

        .cs-text {
          /* nested in cs-item to only apply within steps widget */
          display: grid;
          grid-template-rows: 0fr;
          overflow: hidden;
          transition-property: grid-template-rows;
          transition-duration: 0.3s;
          transition-timing-function: linear;
        }
      }

      .cs-picture {
        width: 100%;
        height: calc(420 / 16 * 1rem);
        opacity: 0;
        transition:
          transform 0.15s linear,
          opacity 0.15s linear;
        transform-origin: 50% 100%;
        transform: scale(0.51);
        position: relative;
        z-index: 1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: relative;
          z-index: 1;
          top: 0;
          left: 0;
        }
      }

      .cs-item-content {
        display: flex;
        flex-direction: column;
        gap: calc(24 / 16 * 1rem);
      }

      .cs-item-icon {
        width: calc(64 / 16 * 1rem);
        height: calc(64 / 16 * 1rem);
        opacity: 0;
        display: block;
        flex: none;
        position: relative;
        transition: opacity 0.15s linear;
      }

      .cs-icon {
        width: calc(24 / 16 * 1rem);
        height: calc(24 / 16 * 1rem);
        margin: auto;
        display: block;
        position: absolute;
        inset: 0;
        z-index: 2;
      }

      .cs-border {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;

        &:before {
          content: "";
          opacity: 1;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
        }

        &:after {
          content: "";
          opacity: 1;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
        }
      }

      .cs-border1 {
        /* top left border */
        &:before {
          width: 100%;
          height: 1px;
          background: linear-gradient(
            to right,
            rgba(136, 137, 139, 1) 0%,
            rgba(0, 0, 0, 0) 78%
          );
        }

        &:after {
          width: 1px;
          height: 100%;
          background: linear-gradient(
            to bottom,
            rgba(136, 137, 139, 1) 0%,
            rgba(0, 0, 0, 0) 78%
          );
        }
      }

      .cs-border2 {
        &:before {
          width: 100%;
          height: 1px;
          background: linear-gradient(
            to right,
            rgba(0, 0, 0, 0) 22%,
            rgba(136, 137, 139, 1) 100%
          );
          top: auto;
          bottom: 0;
        }

        &:after {
          width: 1px;
          height: 100%;
          background: linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0) 22%,
            rgba(136, 137, 139, 1) 100%
          );
          left: auto;
          right: 0;
        }
      }

      .cs-text {
        max-width: none;
        color: var(--bodyTextColorWhite);
        opacity: 0.9;
      }

      .cs-item-text {
        min-height: 0;
        align-self: center;

        a {
          color: var(--secondary);

          &:hover {
            text-decoration: none;
          }
        }
      }

      .cs-background {
        width: 160%;
        height: 175%;
        opacity: 0.08;
        display: block;
        position: absolute;
        top: 0;
        left: 50%;
        transform: translate(-50%, calc(-50 / 16 * 1rem));
        z-index: -1;
        pointer-events: none;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #steps-2433 {
      /* if your cs-item-text is too tall and makes the panel taller than all the others, measure how tall that panel is and change this variable to that number so they all respond to it. We need a fixed height for the animations to work */
      --panelHeight: calc((420 / 16) * 1rem);

      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
      }

      .cs-content {
        flex-direction: row;
        align-items: flex-end;
        justify-content: space-between;

        .cs-text {
          width: 48%;
          max-width: calc(413 / 16 * 1rem);
        }
      }

      .cs-flex {
        width: 48%;
      }

      .cs-topper {
        flex-shrink: 0;
      }

      .cs-title {
        margin: 0;
      }

      .cs-steps {
        /* reset height • still necessary for dimensions of other elements within accordion */
        height: var(--panelHeight);
        flex-direction: row;
        align-items: flex-end;
      }

      .cs-step-toggle {
        width: clamp(calc(56 / 16 * 1rem), 6.9vw, calc(100 / 16 * 1rem));
        height: 100%;
      }

      :checked + .cs-step-panel {
        /* open panel styles */
        min-height: unset;
        width: 100%;

        .cs-item {
          padding-bottom: 0;

          .cs-text {
            transition-delay: 0.45s;
          }
        }
      }

      .cs-step-panel {
        height: 100%;
        width: 0;
        flex-direction: row;
        transition-property: flex-basis, flex-grow, width;
      }

