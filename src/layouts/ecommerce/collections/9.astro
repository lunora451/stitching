<style lang="scss">
  /*-- -------------------------- -->
<---         Collection         -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #collection-1554 {
      padding: var(--sectionPadding);
      position: relative;
      z-index: 10;
      overflow: hidden;

      .cs-container {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to center if content needs to be centrally aligned */
        text-align: left;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to center to centrally align */
        align-items: flex-start;
      }

      .cs-title {
        max-width: 20ch;
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        /* 16px - 20px */
        gap: clamp(1rem, 2.5vw, 1.25rem);
      }

      .cs-item {
        text-align: left;
        list-style: none;
        width: 100%;
        /* 300px - 420px */
        height: clamp(18.75rem, 30vw, 26.25rem);
        margin: 0;
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
        padding: 0;
        background-color: #000;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: flex-start;
        grid-column: span 12;
        grid-row: span 1;
        position: relative;
        z-index: 1;
        /* clips background image corners */
        overflow: hidden;

        &:hover {
          .cs-item-background {
            img {
              opacity: 0.4;
              transform: scale(1.3);
            }
          }

          .cs-h3 {
            color: var(--primary);
          }

          .cs-wrapper {
            border-color: var(--secondary);
          }

          .cs-icon {
            filter: none;
          }
        }
      }

      .cs-link {
        text-decoration: none;
        /* height & width are 100% to make the link cover the whole of the item, therefore making it hoverable */
        width: 100%;
        height: 100%;
        /* 12px - 24px */
        padding: clamp(0.75rem, 2vw, 1.5rem);
        /* prevents padding from affecting height and width */
        box-sizing: border-box;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: calc(16 / 16 * 1rem);
      }

      .cs-link-flex {
        max-width: calc(280 / 16 * 1rem);
      }

      .cs-h3 {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 2.5vw, 1.5625rem);
        font-weight: bold;
        line-height: 1.2em;
        text-align: inherit;
        margin: 0 0 calc(12 / 16 * 1rem) 0;
        color: var(--bodyTextColorWhite);
        transition: color 0.3s;
      }

      .cs-item-text {
        /* 14px - 16px */
        font-size: clamp(0.875rem, 1.5vw, 1rem);
        line-height: 1.5em;
        margin: 0;
        padding: 0;
        color: var(--bodyTextColorWhite);
      }

      .cs-wrapper {
        /* 32px - 48px */
        width: clamp(2rem, 4vw, 3rem);
        height: clamp(2rem, 4vw, 3rem);
        /* making this element content-box so padding doesn't apply to the height/width dimensions */
        box-sizing: content-box;
        border: 1px solid #fff;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        /* prevents flexbox from squishing it */
        flex: none;
        transition:
          color 0.3s,
          border-color 0.3s;
      }

      .cs-icon {
        width: calc(24 / 16 * 1rem);
        height: auto;
        /* turns it white */
        filter: grayscale(1) brightness(1000%);
      }

      .cs-item-background {
        width: 100%;
        height: 100%;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;

        &:before {
          /* background color overlay */
          content: "";
          width: 100%;
          height: 100%;
          background: #1a1a1a;
          opacity: 0.24;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: 1;
        }

        &:after {
          /* background color overlay */
          content: "";
          width: 100%;
          height: 50%;
          background: -webkit-gradient(
            linear,
            left bottom,
            left top,
            from(#000),
            color-stop(61.37%, rgba(0, 0, 0, 0))
          );
          background: -o-linear-gradient(
            bottom,
            #000 0%,
            rgba(0, 0, 0, 0) 61.37%
          );
          background: linear-gradient(0deg, #000 0%, rgba(0, 0, 0, 0) 61.37%);
          opacity: 1;
          display: block;
          position: absolute;
          bottom: 0;
          left: 0;
          z-index: 2;
        }

        img {
          width: 100%;
          height: 100%;
          /* Makes img tag act as a background image */
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
          transition:
            transform 0.6s,
            opacity 0.3s;
        }
      }

      .cs-background-top {
        width: calc(240 / 16 * 1rem);
        height: calc(250 / 16 * 1rem);
        display: none;
        position: absolute;
        /* 60px - 80px */
        top: calc(clamp(3.75rem, 8vw, 5rem) * -1);
        left: calc(-140 / 16 * 1rem);
      }

      .cs-background-bottom {
        width: calc(240 / 16 * 1rem);
        height: calc(250 / 16 * 1rem);
        position: absolute;
        right: calc(-140 / 16 * 1rem);
        /* 60px - 80px */
        bottom: calc(clamp(3.75rem, 8vw, 5rem) * -1);
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #collection-1554 {
      .cs-content {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        gap: calc(48 / 16 * 1rem);
      }

      .cs-title {
        margin: 0;
      }

      .cs-flex-group {
        width: 50%;
      }

      .cs-item {
        grid-column: span 4;
      }

      .cs-background-top {
        display: block;
      }
    }
  }

  /* Large Desktop - 1300px */
  @media only screen and (min-width: 81.25rem) {
    #collection-1554 {
      .cs-background-top {
        width: calc(509 / 16 * 1rem);
        height: calc(537 / 16 * 1rem);
        margin-left: calc(-1248 / 16 * 1rem);
        position: absolute;
        top: 0;
        left: 50%;
      }

      .cs-background-bottom {
        width: calc(509 / 16 * 1rem);
        height: calc(537 / 16 * 1rem);
        margin-right: calc(-1248 / 16 * 1rem);
        position: absolute;
        right: 50%;
        bottom: 0;
      }
    }
  }
</style>
