<style lang="scss">
  /*-- -------------------------- -->
<---         Collection         -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #collection-1578 {
      padding: var(--sectionPadding);

      .cs-container {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-title {
        margin: 0;
      }

      .cs-topper {
        color: var(--secondary);
      }

      .cs-card-group {
        list-style: none;
        width: 100%;
        /* changes to 1280px on tablet */
        max-width: calc(550 / 16 * 1rem);
        margin: auto;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: clamp(1rem, 3vw, 1.25rem);
      }

      .cs-item {
        max-width: 100%;
        grid-column: span 12;
        position: relative;

        &:hover {
          .cs-background {
            img {
              opacity: 0.5;
              transform: scale(1.4);
            }
          }
        }
      }

      .cs-link {
        text-decoration: none;
        /* changes at tablet */
        height: 60vw;
        max-height: calc(348 / 16 * 1rem);
        padding: calc(40 / 16 * 1rem) calc(24 / 16 * 1rem);
        /* prevents padding from affecting height and width */
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
      }

      .cs-background {
        width: 100%;
        height: 100%;
        background-color: #000;
        overflow: hidden;
        position: absolute;
        top: 0;
        left: 0;
        /* set to -2 so the gradient overlay (z-index: -1) appears in front of the images, but behind the text */
        z-index: -2;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          transition:
            transform 0.6s,
            opacity 0.3s;
        }
      }

      .cs-category {
        font-size: calc(20 / 16 * 1rem);
        font-weight: 700;
        line-height: calc(64 / 16 * 1rem);
        text-align: center;
        text-decoration: none;
        width: 85%;
        /* 12px - 20px top & bottom, 16px - 24px sides*/
        padding: 0 clamp(1rem, 3vw, 1.5rem);
        color: var(--bodyTextColorWhite);
        position: relative;
        transition: color 0.3s;

        &:hover {
          color: var(--headerColor);
          &:before {
            background-color: rgba(255, 255, 255, 1);
          }
        }

        /* blurred background - done as a pseudo element so backdrop-filter won't distort the text */
        &:before {
          content: "";
          width: 100%;
          height: 100%;
          backdrop-filter: blur(8px);
          --webkit-backdrop-filter: blur(8px);
          background-color: rgba(255, 255, 255, 0.2);
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition: background-color 0.3s;
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #collection-1578 {
      .cs-container {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }

      .cs-content {
        width: 30%;
        max-width: calc(305 / 16 * 1rem);
        text-align: left;
        align-items: flex-start;
      }

      .cs-card-group {
        max-width: calc(1280 / 16 * 1rem);
      }

      .cs-item {
        /* 180px - 348px */
        height: clamp(11.75rem, 25vw, 21.75rem);
        grid-column: span 4;
      }
    }
  }
</style>
