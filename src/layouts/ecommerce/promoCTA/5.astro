        line-height: 1.5em;
        max-width: 50ch;
        margin: 0;
        width: 100%;
        color: var(--bodyTextColor);
      }

      .cs-link {
        font-size: calc(16 / 16 * 1rem);
        text-decoration: none;
        text-align: inherit;
        line-height: 1.2em;
        font-weight: 700;
        color: var(--primary);
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        z-index: 1;

        &:hover {
          &:before {
