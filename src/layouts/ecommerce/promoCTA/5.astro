<!-- ============================================ --><!--                 Promotions                   --><!-- ============================================ -->
<section id="promotions-1555">
  <div class="cs-container">
    <div class="cs-promotion">
      <div class="cs-flex">
        <!--Limited Offer-->
        <img
          class="cs-offer"
          aria-hidden="true"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/limited-offer.png"
          decoding="async"
          alt="quote icon"
          width="189"
          height="90"
        />
        <h3 class="cs-h3-offer">The Beginners Guide To Camping</h3>
        <a href="" class="cs-link">Explore Now</a>
      </div>
      <picture class="cs-picture">
        <!--Mobile Image-->
        <source
          media="(max-width: 600px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/MISC/hoodies.png"
        />
        <!--Tablet and above Image-->
        <source
          media="(min-width: 601px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/MISC/hoodies.png"
        />
        <img
          loading="lazy"
          decoding="async"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/MISC/hoodies.png"
          alt="kids"
          width="220"
          height="220"
          aria-hidden="true"
        />
      </picture>
    </div>
    <ul class="cs-card-group">
      <li class="cs-item">
        <div class="cs-icon-wrapper">
          <img
            class="cs-icon"
            loading="lazy"
            decoding="async"
            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/ecomm-truck.svg"
            alt="icon"
            width="48"
            height="48"
          />
        </div>
        <div class="cs-info">
          <h3 class="cs-h3">Free Delivery</h3>
          <p class="cs-item-text">
            Enjoy free delivery on all orders, making shopping seamless and
            convenient.
          </p>
        </div>
      </li>
      <li class="cs-item">
        <div class="cs-icon-wrapper">
          <img
            class="cs-icon"
            loading="lazy"
            decoding="async"
            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/ecomm-headset.svg"
            alt="icon"
            width="48"
            height="48"
          />
        </div>
        <div class="cs-info">
          <h3 class="cs-h3">Online Support</h3>
          <p class="cs-item-text">
            Experience 24/7 online support, ensuring all your concerns are
            addressed promptly.
          </p>
        </div>
      </li>
    </ul>
  </div>
</section>

<style lang="scss">
  /*-- -------------------------- -->
<---        Promotions          -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #promotions-1555 {
      padding: var(--sectionPadding);
      position: relative;
      z-index: 1;
      overflow: hidden;

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
        max-width: calc(900 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 16px - 20px */
        gap: clamp(1rem, 2vw, 1.25rem);
        position: relative;
      }

      .cs-promotion {
        text-align: left;
        list-style: none;
        width: 100%;
        /* 16px - 24px */
        padding: calc(24 / 16 * 1rem) clamp(1rem, 2.4vw, 1.5rem);
