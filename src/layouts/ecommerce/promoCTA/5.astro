        color: var(--headerColor);
        max-width: 17ch;
      }

      .cs-h3-offer {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 2.3vw, 1.5625rem);
        line-height: 1.2em;
        font-weight: 700;
        margin: 0 0 calc(24 / 16 * 1rem) 0;
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
        color: var(--headerColor);
        max-width: 17ch;
      }

