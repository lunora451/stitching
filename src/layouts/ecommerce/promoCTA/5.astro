        flex-direction: row;
        gap: calc(20 / 16 * 1rem);
        width: 66%;
      }

      .cs-item {
        text-align: center;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
      }

      .cs-info {
        align-items: center;
      }
    }
  }
  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #promotions-1555 {
      .cs-item {
        padding: calc(62 / 16 * 1rem) calc(24 / 16 * 1rem);
      }
