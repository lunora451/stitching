        align-items: stretch;
        justify-content: space-between;
        position: relative;
        gap: calc(16 / 16 * 1rem);
        z-index: 1;

        &:before {
          content: "";
          width: 100%;
          height: 100%;
          background: linear-gradient(
            180deg,
            #fdf7eb 0%,
            #fefaee 48.36%,
            #faeddd 100%
          );
          opacity: 1;
          position: absolute;
          display: block;
          top: 0;
          left: 0;
          z-index: -1;
        }
      }

      .cs-flex {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        align-self: center;
      }

      .cs-offer {
        width: 85%;
        max-width: calc(189 / 16 * 1rem);
        height: auto;
        margin: 0 0 calc(16 / 16 * 1rem) 0;
      }

      .cs-picture {
        width: 50%;
        height: auto;
        max-height: calc(300 / 16 * 1rem);
        display: flex;
        justify-content: center;
        align-items: center;
        align-items: center;
        max-width: calc(320 / 16 * 1rem);

        img {
          width: 100%;
          max-width: 100%;
          height: auto;
          max-height: 100%;
          object-fit: contain;
        }
      }

      .cs-card-group {
        margin: 0;
        width: 100%;
        padding: 0;
        display: flex;
        flex-direction: column;
        /* 16px - 20px */
        gap: calc(16 / 16 * 1rem);
        justify-content: stretch;
      }

      .cs-item {
        text-align: left;
        list-style: none;
        height: 100%;
        /* 16px - 24px top & Bottom, changes to 62px at large desktop, left and right changes to 24px */
        padding: clamp(1rem, 2vw, 1.5rem) calc(16 / 16 * 1rem);
        /* prevents padding from affecting height and width */
        box-sizing: border-box;
        background-color: #fff;
        border: 1px solid #e8e8e8;
        /* 40px - 60px */
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        position: relative;
        z-index: 1;
        gap: calc(16 / 16 * 1rem);
      }

      .cs-icon-wrapper {
