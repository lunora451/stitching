        width: clamp(3.75rem, 8vw, 5rem);
        height: clamp(3.75rem, 8vw, 5rem);
        border: 1px solid var(--primary);
        background: #fff;
        box-sizing: border-box;
        border-radius: calc(100 / 16 * 1rem);
        display: flex;
        justify-content: center;
        align-items: center;
        flex-shrink: 0;
        position: relative;
        z-index: 1;
        overflow: hidden;

        &:before {
          content: "";
          width: 100%;
          height: 100%;
          background: var(--primary);
          opacity: 0.1;
          position: absolute;
          display: block;
          top: 0;
          left: 0;
        }
      }

      .cs-icon {
        /* 24px - 36px */
        width: clamp(1.5rem, 3vw, 2.25rem);
        height: auto;
        box-sizing: content-box;
      }

      .cs-info {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }

