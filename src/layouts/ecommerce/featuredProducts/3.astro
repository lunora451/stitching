<style lang="scss">
  /*-- -------------------------- -->
<---        Collection          -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #collection-1570 {
      padding: var(--sectionPadding);

      .cs-container {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
        position: relative;
        z-index: 1;
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        /* breaks up the parent div so the children are no longer bound by it.  Now the children can be children of the cs-container and allow us to arrange their order with the cs-card-group */
        display: contents;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-title {
        margin: 0;
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        /* 46px - 56px */
        line-height: clamp(2.875rem, 5.5vw, 3.5rem);
        text-decoration: none;
        font-weight: 700;
        text-align: center;
        margin: 0;
        color: #fff;
        min-width: calc(150 / 16 * 1rem);
        padding: 0 calc(24 / 16 * 1rem);
        background-color: var(--primary);
        display: inline-block;
        position: relative;
        z-index: 1;
        /* prevents padding from adding to the width */
        box-sizing: border-box;
        order: 3;

        &:before {
          content: "";
          position: absolute;
          height: 100%;
          width: 0%;
          background: #000;
          opacity: 1;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
        }

        &:hover:before {
          width: 100%;
        }
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: grid;
        justify-items: center;
        position: relative;
        grid-template-columns: repeat(auto-fit, minmax(19.0625rem, 1fr));
        /* 16px - 20px */
        column-gap: clamp(1rem, 3vw, 1.25rem);
        /* 16px - 40px */
        row-gap: clamp(1rem, 3vw, 2.5rem);
        transform-style: preserve-3d;
      }

      .cs-item {
        width: 100%;
        max-width: calc(296 / 16 * 1rem);
        padding: calc(16 / 16 * 1rem);
        border: 1px solid #e8e8e8;

        &:hover .cs-picture img {
          transform: scale(1.05);
        }
      }

      .cs-link {
        text-decoration: none;
      }

      .cs-image-group {
        width: auto;
        height: calc(300 / 16 * 1rem);
        margin-bottom: calc(20 / 16 * 1rem);
        position: relative;
      }

      .cs-picture {
        width: 100%;
        height: 100%;
        background-color: #f6f6f6;
        display: block;
        overflow: hidden;

        img {
          width: 100%;
          height: 100%;
          object-fit: contain;
          transition: transform 0.3s;
        }
      }

      .cs-offer {
        font-size: calc(13 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        text-transform: uppercase;
        letter-spacing: 1.3px;
        padding: calc(6 / 16 * 1rem);
        color: #fff;
        background: #ff4747;
        position: absolute;
        top: calc(12 / 16 * 1rem);
        right: calc(12 / 16 * 1rem);
      }

      .cs-tags {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.5em;
        color: #767676;
      }

      .cs-product {
        /* 20px - 24px */
        font-size: clamp(1.25rem, 3vw, 1.5rem);
        font-weight: 700;
        line-height: 1.2em;
        margin: 0;
        color: var(--headerColor);
      }

      .cs-wrapper {
        margin-top: calc(20 / 16 * 1rem);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .cs-info {
        display: flex;
        flex-direction: row;
        align-items: center;
      }

      .cs-price {
        font-size: calc(20 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        color: var(--primary);
      }

      .cs-old-price {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        text-decoration: line-through;
        color: #767676;
      }

      .cs-stars {
        width: calc(92 / 16 * 1rem);
        margin-top: calc(4 / 16 * 1rem);
        display: flex;
      }

      .cs-buy {
        max-height: calc(40 / 16 * 1rem);
        padding: calc(8 / 16 * 1rem);
        background: none;
        border: 1px solid var(--primary);
        border-radius: calc(4 / 16 * 1rem);
        display: flex;
        justify-content: center;
        align-items: center;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #collection-1570 {
      .cs-content {
        display: flex;
        justify-content: space-between;
        flex-direction: row;
        gap: calc(48 / 16 * 1rem);
      }

      .cs-item {
        max-width: none;
      }

      .cs-image-group {
        height: clamp(12rem, 23vw, 20rem);
      }
    }
  }
  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #collection-1570 {
      .cs-card-group {
        grid-template-columns: repeat(4, 1fr);
      }
    }
  }
</style>
