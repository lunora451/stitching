            <!--Mobile Image-->
            <source
              media="(max-width: 600px)"
              srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/ecommerce/shirt5.png"
            />
            <!--Tablet and above Image-->
            <source
              media="(min-width: 601px)"
              srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/ecommerce/shirt5.png"
            />
            <img
              loading="lazy"
              decoding="async"
              src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/ecommerce/shirt5.png"
              alt="hats"
              width="1280"
              height="568"
            />
