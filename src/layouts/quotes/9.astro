<style lang="scss">
  /*-- -------------------------- -->
<---           Quote            -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #quote-1688 {
      padding: var(--sectionPadding);
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        max-width: calc(1720 / 16 * 1rem);
        /* 463px - 700px */
        height: clamp(28.9375rem, 50vw, 43.75rem);
        margin: auto;
        box-sizing: border-box;
        /* 24px - 40px */
        padding: clamp(1.5rem, 3vw, 2.5rem);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        position: relative;
      }

      .cs-content {
        /* set text align to center if content needs to be centrally aligned */
        text-align: left;
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        /* aligns content to the left, set to center to centrally align */
        align-items: flex-start;
        /* 16px - 48px */
        gap: clamp(1rem, 4vw, 3rem);
      }

      .cs-icon {
        /* 80px - 120px */
        width: clamp(5rem, 9vw, 7.5rem);
        /* 66px - 99px */
        height: clamp(4.125rem, 8vw, 6.1875rem);
      }

      .cs-quote {
        /* 16px - 25px */
        font-size: clamp(1rem, 2vw, 1.5625rem);
        font-weight: 700;
        line-height: 1.2em;
        max-width: calc(1248 / 16 * 1rem);
        margin: 0;
        color: #fff;
      }

      .cs-name {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 3.25vw, 1.5625rem);
        font-weight: 700;
        line-height: 1.2em;
        text-align: inherit;
        margin: 0;
        margin-bottom: calc(8 / 16 * 1rem);
        color: var(--primary);
        display: block;
      }

      .cs-job {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.5em;
        text-align: inherit;
        margin: 0;
        color: #f7f7f7;
      }

      .cs-background {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;

        /* darkened overlay */
        &::before {
          content: "";
          width: 100%;
          height: 100%;
          background: linear-gradient(
            0deg,
            rgba(0, 0, 0, 1) 0%,
            rgba(255, 255, 255, 0) 60%
          );
          position: absolute;
          bottom: 0;
          left: 0;
          z-index: 1;
        }

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #quote-1688 {
      .cs-content {
        flex-direction: row;
      }
    }
