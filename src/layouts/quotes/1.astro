<section id="quote-2434">
  <div class="cs-container">
    <div class="cs-content">
      <img
        src="https://nyc3.digitaloceanspaces.com/csimages2/Images/Graphics/quote-outline.svg"
        class="cs-quote"
        alt="icon"
        width="200"
        height="200"
        loading="lazy"
        aria-hidden="true"
        decoding="async"
      />
      <h2 class="cs-title">
        To wear art is to carry spirit. To paint the body is to honor the soul.
      </h2>
      <span class="cs-name">
        Michelle Delio
        <span class="cs-desc">CEO of ArtiStitch</span>
      </span>
    </div>
  </div>
  <!-- You can remove the picture tag and uncomment the video tag to use a video instead of a tag. Compress your video and upload it to a CDN like Digital Oceans Spaces so the video file doesn't cause load time issues.-->
  <picture class="cs-background">
    <source
      media="(max-width: 600px)"
      srcset="https://nyc3.digitaloceanspaces.com/csimages2/Videos/face-paint.jpg"
    />
    <source
      media="(min-width: 601px)"
      srcset="https://nyc3.digitaloceanspaces.com/csimages2/Videos/face-paint.jpg"
    />
    <img
      loading="lazy"
      decoding="async"
      src="https://nyc3.digitaloceanspaces.com/csimages2/Videos/face-paint.jpg"
      alt="face painting"
      width="1920"
      height="768"
      aria-hidden="true"
    />
    <!-- <video loading="lazy" src="https://nyc3.digitaloceanspaces.com/csimages2/Videos/face-paint.mp4" muted autoplay loop></video> -->
  </picture>
  <!-- Graphic -->
  <img
    class="cs-floater"
    src="https://nyc3.digitaloceanspaces.com/csimages2/Icons/tattoo.svg"
    alt="tattoo decal"
    aria-hidden="true"
    decoding="async"
    loading="lazy"
    width="152"
    height="513"
  />
</section>

