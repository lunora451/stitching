<section id="quote-2422">
  <div class="cs-container">
    <figure class="cs-card">
      <blockquote class="cs-blockquote">
        <p class="cs-quote">
          A clean yard isn’t just about appearances; it’s about creating a safe,
          healthy space where pets can play freely and families can relax with
          peace of mind. That’s why we take pride in every cleanup—because happy
          yards make happy homes.
        </p>
      </blockquote>
      <figcaption class="cs-info">
        <span class="cs-name">
          Jordan Lee
          <span class="cs-desc">Founder of Poop Patrol</span>
        </span>
      </figcaption>
      <div class="cs-wrapper">
        <img
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/Quote5.svg"
          alt="icon"
          width="65"
          height="52"
          loading="lazy"
          aria-hidden="true"
          decoding="async"
        />
      </div>
    </figure>
  </div>
  <picture class="cs-background">
    <source
      media="(min-width: 1300px)"
      srcset="https://nyc3.digitaloceanspaces.com/csimages2/Images/People/quotebg-pet-services-1800x1348.jpg"
    />
    <source
      media="(min-width: 768px) and (max-width: 1299px)"
      srcset="https://nyc3.digitaloceanspaces.com/csimages2/Images/People/quotebg-pet-services-1577x1348.jpg"
    />
    <source
      media="(max-width: 767px)"
      srcset="https://nyc3.digitaloceanspaces.com/csimages2/Images/People/quotebg-pet-services-948x948.jpg"
    />
    <img
      loading="lazy"
      decoding="async"
      src="https://nyc3.digitaloceanspaces.com/csimages2/Images/People/quotebg-pet-services-1800x1348.jpg"
      alt=""
      width="1800"
      height="1348"
    />
  </picture>
</section>

<style lang="scss">
  /*-- -------------------------- -->
<!--           Quote            -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #quote-2422 {
      padding: var(--sectionPadding);
      /* padding-top resets at 768px */
      padding-top: calc(480 / 16 * 1rem);
      position: relative;
      overflow: hidden;

      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        margin: 0 auto;
      }

      .cs-card {
        text-align: center;
        width: 100%;
        margin: 0;
        margin-right: auto;
        /* 24px - 40px */
        padding: clamp(calc(16 / 16 * 1rem), 4.8vw, calc(40 / 16 * 1rem));
        padding-top: clamp(calc(80 / 16 * 1rem), 8.8vw, calc(100 / 16 * 1rem));
        background-color: #fff;
        border-radius: calc(16 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: flex-start;
        position: relative;
        z-index: 1;

        &:before {
          /* background color */
          content: "";
          width: 100%;
          height: 100%;
          background-color: var(--primary);
          border-radius: calc(16 / 16 * 1rem);
          opacity: 0.05;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
        }
      }

      .cs-title {
        margin-bottom: calc(48 / 16 * 1rem);
      }

      .cs-blockquote {
        width: 100%;
        margin: 0;
      }

      .cs-quote {
        /* blockquote */
        font-size: calc(20 / 16 * 1rem);
        line-height: 1.5em;
        margin: 0 0 calc(16 / 16 * 1rem);
        color: var(--bodyTextColor);
        z-index: 1;
      }

      .cs-info {
        /* figcaption */
        width: 100%;
        gap: calc(12 / 16 * 1rem);
        position: relative;
      }

      .cs-name {
        font-size: calc(20 / 16 * 1rem);
        line-height: calc(24 / 16 * 1rem);
        font-weight: 700;
        margin: 0;
      }

      .cs-desc {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 400;
        line-height: calc(24 / 16 * 1rem);
        margin-top: 4px;
        color: var(--bodyTextColor);
        display: block;
      }

      // ornamental 'quote' graphic
      .cs-wrapper {
        width: calc(120 / 16 * 1rem);
        height: calc(120 / 16 * 1rem);
        margin: 0 auto;
        background-color: #fff;
        overflow: hidden;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        position: absolute;
        top: calc(-60 / 16 * 1rem);
        right: 0;
        left: 0;
        z-index: -1;

        &:before {
          content: "";
          width: 100%;
          height: 100%;
          background: var(--primary);
          opacity: 0.2;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      // background image
      .cs-background {
        width: 100%;
        height: 100%;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;

        img {
          width: 100%;
          height: 100%;
          /* makes image act as a background image */
          object-fit: cover;
          object-position: center;
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #quote-2422 {
      /* resetting top padding */
      padding-top: clamp(calc(120 / 16 * 1rem), 10vw, calc(180 / 16 * 1rem));

      .cs-card {
        width: 62%;
        max-width: calc(552 / 16 * 1rem);
      }
    }
  }
</style>
