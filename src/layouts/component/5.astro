<style lang="scss">
  /*-- -------------------------- -->
<---           Logos            -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #logos-1430 {
      padding: var(--sectionPadding);
      background-color: #f7f7f7;
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        column-gap: calc(40 / 16 * 1rem);
      }

      .cs-picture {
        /* 120px - 150px */
        width: clamp(7.5rem, 12vw, 9.375rem);
        height: clamp(7.5rem, 12vw, 9.375rem);
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .cs-logo {
        width: 100%;
        height: auto;
        height: auto;
        margin: 0;
        display: block;
        object-fit: contain;
      }

      .cs-background {
        width: 100%;
        height: 100%;
        max-height: calc(650 / 16 * 1rem);
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;

        img {
          width: 100%;
          height: 100%;
          opacity: 0.2;
          object-fit: cover;
          top: 0;
          left: 0;
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #logos-1430 {
      .cs-container {
        justify-content: space-between;
        flex-wrap: nowrap;
      }
    }
  }
</style>
