<style lang="scss">
  /*-- -------------------------- -->
<---          Timeline          -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #timeline-970 {
      padding: var(--sectionPadding);
      background-color: #1a1a1a;
      /* clips the white line through the bullets */
      overflow: hidden;

      .cs-container {
        width: 100%;
        /* changes to 1440px at tablet */
        max-width: calc(550 / 16 * 1em);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-title {
        max-width: 18ch;
        color: var(--bodyTextColorWhite);
      }

      .cs-text {
        max-width: calc(522 / 16 * 1rem);
        color: var(--bodyTextColorWhite);
        opacity: 0.8;
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        /* 40px - 80px */
        gap: clamp(2.5rem, 6vw, 5rem);
        position: relative;
        &:before {
          /* white line through the bullets */
          content: "";
          width: 1px;
          background: #484848;
          opacity: 1;
          display: block;
          position: absolute;
          top: 0;
          /* send it way down to reach the bottom of the section, and have some overlap so if you add content and the ul gets longer, it will still be at the bottom */
          bottom: calc(-300 / 16 * 1rem);
          /* half the width of the bullet */
          left: calc(6 / 16 * 1rem);
        }
      }

      .cs-item {
        list-style: none;
        width: 100%;
        max-width: calc(400 / 16 * 1rem);
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
        padding: 0 0 0 calc(52 / 16 * 1rem);
        position: relative;
        &:before {
          /* bullet circle */
          content: "";
          width: calc(12 / 16 * 1rem);
          height: calc(12 / 16 * 1rem);
          background: var(--primary);
          opacity: 1;
          border-radius: 50%;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      .cs-icon {
        width: calc(60 / 16 * 1rem);
        height: auto;
        /* 32px - 40px */
        margin: 0 0 clamp(2rem, 3vw, 2.5rem);
      }

      .cs-h3 {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 2.5vw, 1.5625rem);
        font-weight: 700;
        line-height: 1.2em;
        /* changes to 100% at tablet */
        width: 80%;
        margin: 0 0 calc(16 / 16 * 1rem) 0;
        color: var(--bodyTextColorWhite);
        position: relative;
      }

      .cs-item-text {
        /* 14px - 16px */
        font-size: clamp(0.875rem, 1.5vw, 1rem);
        line-height: 1.5em;
        margin: 0;
        color: var(--bodyTextColorWhite);
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #timeline-970 {
      .cs-container {
        max-width: calc(1440 / 16 * 1rem);
      }

      .cs-card-group {
        flex-direction: row;

        &:before {
          width: 100%;
          height: 1px;
          top: auto;
          bottom: calc(6 / 16 * 1rem);
          /* these next two properties center the line in the UL */
          left: 50%;
          transform: translateX(-50%);
        }
      }

      .cs-item {
        padding: 0 0 calc(66 / 16 * 1rem) 0;
        z-index: 1;

        &::before {
          top: auto;
          bottom: calc(0 / 16 * 1rem);
        }
      }

      .cs-h3 {
        width: 100%;
      }
    }
  }
</style>
