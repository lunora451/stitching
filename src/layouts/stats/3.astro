<!-- ============================================ --><!--                    Stats                     --><!-- ============================================ -->
<section id="stats-2381">
  <div class="cs-container">
    <div class="cs-content-wrapper">
      <picture class="cs-picture">
        <!--Mobile Image-->
        <source
          media="(max-width: 600px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/people11.jpg"
        />
        <!--Tablet and above Image-->
        <source
          media="(min-width: 601px)"
          srcset="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/people11.jpg"
        />
        <img
          loading="lazy"
          decoding="async"
          src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/People/people11.jpg"
          alt="people"
          width="1058"
          height="773"
        />
      </picture>
      <div class="cs-content">
        <p class="cs-text">
          Discover How InnerPath Wellness Helps You Heal, Grow, and Build a Life
          Aligned with Your Authentic Self and Emotional Well-Being Naturally.
        </p>
        <a href="" class="cs-button-solid">Get A Quote</a>
      </div>
      <ul class="cs-stats-group">
        <li class="cs-stat">
          <span class="cs-number">99%</span>
          <p class="cs-stat-text">
            Experience noticeable progress within the first six weeks of
            therapy.
          </p>
        </li>
        <li class="cs-stat">
          <span class="cs-number">15+</span>
          <p class="cs-stat-text">
            Professional mental health experience backing every therapy approach
            we offer.
          </p>
        </li>
        <li class="cs-stat">
          <span class="cs-number">98%</span>
          <p class="cs-stat-text">
            Clients reported feeling emotionally safer after just three
            sessions.
          </p>
        </li>
        <li class="cs-stat">
          <span class="cs-number">3 Days</span>
          <p class="cs-stat-text">
            Average time it typically takes to schedule your first session.
          </p>
        </li>
      </ul>
      <img
        class="cs-floater"
        loading="lazy"
        decoding="async"
        src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/flower2.svg"
        alt="people"
        width="635"
        height="728"
      />
    </div>
  </div>
</section>

<style lang="scss">
  /*-- -------------------------- -->
<---           Stats            -->
<--- -------------------------- -*/

  /* Mobile */
  @media only screen and (min-width: 0rem) {
    #stats-2381 {
      padding: var(--sectionPadding);
      padding-top: 0;
      overflow: hidden;

      .cs-container {
        width: 100%;
        max-width: calc(1720 / 16 * 1rem);
        margin: auto;
      }

      .cs-content-wrapper {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        /* 48px - 64px */
        gap: clamp(3rem, 7vw, 4rem);
        position: relative;
        z-index: 1;
      }

      .cs-content {
        width: 100%;
        /* changes to 702px at desktop */
        max-width: calc(944 / 16 * 1rem);
        margin: auto;
      }

      .cs-text {
        font-size: calc(25 / 16 * 1rem);
        line-height: 1.2em;
        font-weight: 700;
        max-width: 100%;
        margin: 0 0 calc(32 / 16 * 1rem);
        color: var(--headerColor);
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        /* 46px - 56px */
        line-height: clamp(2.875rem, 5vw, 3.5rem);
        font-weight: 700;
        text-decoration: none;
        text-align: center;
        margin: 0;
        padding: 0 calc(48 / 16 * 1rem);
        overflow: hidden;
        border-radius: calc(100 / 16 * 1rem);
        background-color: var(--primary);
        color: var(--bodyTextColorWhite);
        display: inline-block;
        position: relative;
        z-index: 1;

        &:hover {
          &:before {
            width: 100%;
          }
        }

        &:before {
          content: "";
          width: 0%;
          height: 100%;
          background: #000;
          opacity: 1;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
        }
      }

      .cs-stats-group {
        width: 100%;
        /* changes to 702px at desktop */
        max-width: calc(944 / 16 * 1rem);
        margin: 0 auto;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        /* 16px - 20px */
        gap: clamp(1rem, 2.5vw, 1.25rem);
      }

      .cs-stat {
        list-style: none;
        padding: 0;
        margin: 0;
        grid-column: span 12;
      }

      .cs-number {
        font-size: calc(31 / 16 * 1rem);
        line-height: 1.2em;
        font-weight: 700;
        margin: 0 0 calc(16 / 16 * 1rem);
        /* 24px - 32px */
        padding-bottom: clamp(1.5rem, 3vw, 2rem);
        border-bottom: 1px solid #d2d8df;
        color: var(--primary);
        display: block;
      }

      .cs-stat-text {
        font-size: var(--bodyFontSize);
        line-height: 1.2em;
        margin: 0;
        color: var(--bodyTextColor);
      }

      .cs-picture {
        width: 100vw;
        height: 100vw;
        max-height: calc(400 / 16 * 1rem);
        display: block;
        position: relative;
        left: calc(-16 / 16 * 1rem);
        z-index: 1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      .cs-floater {
        width: calc(635 / 16 * 1rem);
        height: auto;
        opacity: 0.24;
        filter: blur(110px);
        display: block;
        position: absolute;
        left: 50%;
        top: 50%;
        z-index: -1;
        transform: translate(-40%, -50%);
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 600px) {
    #stats-2381 {
      .cs-stat {
        grid-column: span 6;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #stats-2381 {
      .cs-stat {
        grid-column: span 3;
      }

      .cs-picture {
        max-height: calc(660 / 16 * 1rem);
      }
    }
  }

  /* Large Desktop - 1800px */
  @media only screen and (min-width: 1500px) {
    #stats-2381 {
      padding: var(--sectionPadding);
      padding-top: 0;

      .cs-container {
        display: flex;
        justify-content: flex-start;
      }

      .cs-content-wrapper {
        max-width: calc(1280 / 16 * 1rem);
        padding: var(--sectionPadding);
        padding-left: 0;
        padding-right: 0;
        align-items: flex-start;
      }

      .cs-content {
        max-width: calc(702 / 16 * 1rem);
        margin-top: 0;
      }

      .cs-stats-group {
        max-width: calc(702 / 16 * 1rem);
        gap: calc(48 / 16 * 1rem);
      }

      .cs-stat {
        grid-column: span 6;
      }

      .cs-picture {
        height: 100%;
        width: 59vw;
        max-width: calc(1500 / 16 * 1rem);
        max-height: 100%;
        position: absolute;
        top: 0;
        right: auto;
        left: calc(100% + 3.75rem);
      }
    }
  }
</style>
