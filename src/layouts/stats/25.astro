<section id="stats-209">
  <div class="cs-container">
    <div class="cs-content">
      <span class="cs-topper">Why Work with Us</span>
      <h2 class="cs-title">Our Numbers Speak For Themselves</h2>
      <p class="cs-text">
        Facilisis condimentum viverra scelerisque ac morbi sit sed. Turpis
        sagittis in blandit eleifend tortor ullamcorper eu placerat. Et orci
        felis volutpat, etiam vitae egestas volutpat pulvinar.
      </p>
    </div>
    <ul class="cs-card-group">
      <li class="cs-item">
        <span class="cs-number">40+</span>
        <span class="cs-header">Years Experience</span>
      </li>
      <li class="cs-item">
        <span class="cs-number">4</span>
        <span class="cs-header">Experienced Staff</span>
      </li>
      <li class="cs-item">
        <span class="cs-number">100+</span>
        <span class="cs-header">Happy Clients</span>
      </li>
    </ul>
  </div>
  <!--Background Image-->
  <picture class="cs-background">
    <source
      media="(max-width: 600px)"
      srcset="https://csimg.nyc3.digitaloceanspaces.com/Stats/bg-m.jpg"
    />
    <source
      media="(min-width: 601px)"
      srcset="https://csimg.nyc3.digitaloceanspaces.com/Stats/bg.jpg"
    />
    <img
      loading="lazy"
      decoding="async"
      src="https://csimg.nyc3.digitaloceanspaces.com/Stats/bg.jpg"
      alt="brick wall"
      width="1920"
      height="1282"
      aria-hidden="true"
    />
  </picture>
</section>

<style lang="scss">
  /*-- -------------------------- -->
<---           Stats            -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #stats-209 {
      padding: var(--sectionPadding);
      position: relative;
      z-index: 1;

      .cs-container {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-title {
        color: var(--bodyTextColorWhite);
      }

      .cs-text {
        color: var(--bodyTextColorWhite);
        opacity: 0.8;
      }

      .cs-card-group {
        width: 100%;
        /* 500px - 887px */
        max-width: clamp(31.25em, 70vw, 55.4375em);
        margin: 0;
        /* prevents padding from adding to the width of the container */
        box-sizing: border-box;
        padding: 0;
        box-shadow: 0 calc(20 / 16 * 1em) calc(40 / 16 * 1em) 0
          rgba(0, 0, 0, 0.05);
        border-radius: calc(5 / 16 * 1rem);
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        column-gap: calc(28 / 16 * 1em);
        row-gap: calc(28 / 16 * 1em);
      }

      .cs-item {
        text-align: center;
        list-style: none;
        width: 38%;
      }

      .cs-number {
        /* 39px - 61px */
        font-size: clamp(2.4375rem, 4.7vw, 3.8125rem);
        font-weight: 700;
        line-height: 1.2em;
        /* 4px - 8px */
        margin-bottom: clamp(0.25rem, 0.78vw, 0.5rem);
        color: var(--primary);
        display: block;
      }

      .cs-header {
        /* 16px - 25px */
        font-size: clamp(1rem, 2vw, 1.5625rem);
        font-weight: 700;
        line-height: 1.2em;
        color: var(--bodyTextColorWhite);
      }

      .cs-background {
        width: 100%;
        height: 100%;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;

        &:before {
          /* Overlay */
          content: "";
          width: 100%;
          height: 100%;
          background: #000;
          opacity: 0.8;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: 1;
        }

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
        }
      }
    }
  }

  /* Tablet - 720px */
  @media only screen and (min-width: 45rem) {
    #stats-209 {
      .cs-card-group {
        justify-content: space-between;
      }

      .cs-item {
        /* reset width */
        width: 20vw;
        max-width: calc(237 / 16 * 1rem);
      }
    }
  }

  /* Big Desktop Parallax Effect - 1300px */
  @media only screen and (min-width: 81.25rem) {
    #stats-209 {
      .cs-background {
        background: url("https://csimg.nyc3.digitaloceanspaces.com/Stats/bg.jpg");
        background-position: center;
        background-size: cover;
        background-repeat: no-repeat;
        background-attachment: fixed;
        img {
          display: none;
        }
      }
    }
  }
</style>
