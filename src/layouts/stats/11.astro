<style lang="scss">
  /*-- -------------------------- -->
<---           Stats            -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #stats-1659 {
      padding: var(--sectionPadding);
      overflow: hidden;

      .cs-container {
        width: 100%;
        /* changes to 1280px at tablet */
        max-width: calc(550 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
        position: relative;
        z-index: 1;
      }

      .cs-content {
        width: 100%;
        display: flex;
        align-items: flex-end;
        flex-direction: column;
      }

      .cs-flex {
        /* set text align to left if content needs to be left aligned */
        text-align: left;
        width: 100%;
        max-width: calc(570 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: flex-start;
      }

      .cs-text {
        margin-bottom: calc(16 / 16 * 1rem);
        &:last-of-type {
          /* 32px - 64px */
          margin-bottom: clamp(2rem, 5vw, 4rem);
        }
      }

      .cs-stat-group {
        width: 100%;
        max-width: calc(860 / 16 * 1rem);
        /* 24px - 44px top & bottom */
        /* 24px - 40px Left & right */
        padding: clamp(1.5rem, 4vw, 2.75rem) clamp(1.5rem, 4vw, 2.5rem);
        box-sizing: border-box;
        margin: 0;
        background-color: #f7f7f7;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        row-gap: calc(32 / 16 * 1rem);
        column-gap: calc(16 / 16 * 1rem);
        position: relative;
        z-index: 10;
      }

      .cs-stat {
        text-align: left;
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        grid-column: span 6;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
        gap: calc(8 / 16 * 1rem);
      }

      .cs-number {
        /* 39px - 61px */
        font-size: clamp(2.4375rem, 5vw, 3.8125rem);
        line-height: 1.2em;
        font-weight: 900;
        margin: 0;
        color: var(--headerColor);
        display: block;
      }

      .cs-desc {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.2em;
        font-weight: 700;
        margin: 0;
        color: var(--primary);
        display: block;
      }

      .cs-picture {
        width: 100%;
        max-width: calc(630 / 16 * 1rem);
        min-height: calc(400 / 16 * 1rem);
        overflow: hidden;
        display: block;
        position: relative;
        z-index: 1;

        img {
          width: 100%;
          height: 100%;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          object-fit: cover;
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #stats-1659 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        flex-direction: row;
        justify-content: flex-end;
        align-items: stretch;
        position: relative;
      }

      .cs-content {
        /* 40px - 60px */
        padding-bottom: clamp(2.5rem, 6vw, 3.75rem);
      }

      .cs-flex {
        width: 45%;
      }

      .cs-stat-group {
        width: 77vw;
      }

      .cs-stat {
        grid-column: span 3;
      }

      .cs-picture {
        height: 100%;
        width: 48vw;
        position: absolute;
        left: 0;
        top: 0;
      }
    }
  }
</style>
