          text-align: right;
          transform: rotateY(-180deg) translateX(-4rem);
          transform-origin: left;

          .cs-icon-wrapper,
          .cs-wrapper {
            transform: scaleX(-1);
          }

          .cs-date {
            justify-content: flex-end;
          }
        }
      }

