        max-width: calc(584 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6.6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: left;
        width: 100%;
        max-width: calc(522 / 16 * 1rem);
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-title {
        margin: 0;
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
      }

      .cs-item {
        text-align: left;
        list-style: none;
        padding-bottom: calc(40 / 16 * 1rem);
        overflow: hidden;
        display: flex;
        /* 16px - 24px */
        gap: clamp(1rem, 3vw, 1.5rem);

        &:last-of-type {
          padding-bottom: 0;

          .cs-icon-wrapper {
            &:before {
              display: none;
            }
          }
        }
      }

      .cs-icon-wrapper {
        width: calc(64 / 16 * 1rem);
        height: calc(64 / 16 * 1rem);
        background-color: var(--primary);
        display: flex;
        flex: none;
        justify-content: center;
        align-items: center;
        position: relative;
        z-index: 1;

        &:before {
          content: "";
          width: 2px;
          height: 100vh;
          opacity: 1;
          background: repeating-linear-gradient(
            0deg,
            #bababa,
            #bababa 2px,
            transparent 2px,
            transparent 4px
          );
          position: absolute;
          display: block;
          top: 100%;
          left: 50%;
          transform: translateX(-50%);
        }
      }

      .cs-date {
        font-size: calc(16 / 16 * 1rem);
        text-align: inherit;
        line-height: 1.5em;
        margin: 0 0 calc(12 / 16 * 1rem);
        color: var(--secondary);
        display: flex;
        align-items: center;
        gap: calc(12 / 16 * 1rem);
      }

      .cs-dot {
        width: calc(8 / 16 * 1rem);
        height: calc(8 / 16 * 1rem);
        border-radius: 50%;
        background-color: var(--secondary);
      }

      .cs-h3 {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 3vw, 1.5625rem);
        line-height: 1.2em;
        font-weight: 700;
        margin: 0 0 calc(8 / 16 * 1rem);
        color: var(--headerColor);
      }

      .cs-item-text {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.5em;
        margin: 0;
        color: var(--bodyTextColor);
      }

      .cs-floater {
