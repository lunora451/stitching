<style lang="scss">
  /*-- -------------------------- -->
<---          Services          -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #services-1733 {
      padding: var(--sectionPadding);
      background-color: #1d1c1c;
      position: relative;

      .cs-container {
        width: 100%;
        /* changes to 1280px at tablet */
        max-width: calc(584 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-title {
        max-width: 12ch;
        color: var(--bodyTextColorWhite);
      }

      .cs-text {
        color: var(--bodyTextColorWhite);
        opacity: 0.8;
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        /* 16px - 20px */
        column-gap: clamp(1rem, 2vw, 1.25rem);
        row-gap: calc(32 / 16 * 1rem);
      }

      .cs-item {
        list-style: none;
        width: 100%;
        grid-column: span 12;

        &:hover {
          .cs-picture {
            img {
              opacity: 0.3;
              transform: scale(1.2);
            }
          }

          .cs-h3 {
            color: var(--primary);
          }
        }
      }

      .cs-link {
        text-decoration: none;
        width: 100%;
        height: 100%;
        /* we use flexbox here to grow the link to fit the whole item, making it clickable everywhere, no matter the size */
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        /* 12px - 20px */
        gap: clamp(0.75rem, 1.6vw, 1.25rem);
        position: relative;
        z-index: 1;
      }

      .cs-picture {
        width: 100%;
        /* 300px - 380px */
        height: clamp(12.5rem, 33vw, 26.25rem);
        background-color: #000;
        display: block;
        position: relative;
        z-index: -1;
        overflow: hidden;

        img {
          width: 100%;
          height: 100%;
          /* Makes img tag act as a background image */
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition:
            transform ease-in-out 0.5s,
            opacity 0.3s;
        }
      }

      .cs-flex {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-start;
      }

      .cs-h3 {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 1.8vw, 1.5625rem);
        text-transform: uppercase;
        font-weight: 900;
        line-height: 1.2em;
        text-align: inherit;
        margin: 0;
        color: var(--bodyTextColorWhite);
        transition: color 0.3s;
      }

      .cs-arrow {
        width: calc(24 / 16 * 1rem);
        height: auto;
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #services-1733 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
      }

      .cs-content {
        text-align: left;
        flex-direction: row;
        justify-content: space-between;
      }

      .cs-title {
        margin: 0;
      }

      .cs-text {
        width: 50%;
      }

      .cs-item {
        grid-column: span 3;
      }
    }
  }
</style>
