<style lang="scss">
  /*-- -------------------------- -->
<---         Services           -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #services-2414 {
      padding: var(--sectionPadding);

      .cs-container {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
        position: relative;
        z-index: 1;
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        max-width: calc(630 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
        gap: calc(32 / 16 * 1rem);
      }

      .cs-title {
        max-width: 25ch;
      }

      .cs-text {
        margin-bottom: calc(16 / 16 * 1rem);

        &:last-of-type {
          margin-bottom: calc(32 / 16 * 1rem);
        }
      }

      .cs-button-solid {
        //responsive gradient button color adapts to unique branding color changes
        --gradientmix: color-mix(in lab, var(--primary), black 49%);

        font-size: calc(16 / 16 * 1rem);
        line-height: clamp(calc(46 / 16 * 1rem), 5.5vw, calc(56 / 16 * 1rem));
        text-decoration: none;
        font-weight: 700;
        text-align: center;
        color: #fff;
        white-space: nowrap;
        margin: 0;
        min-width: calc(150 / 16 * 1rem);
        padding: 0 calc(28 / 16 * 1rem);
        background-color: var(--primary);
        background-image: -moz-linear-gradient(
          top,
          rgba(0, 0, 0, 0) 0%,
          var(--gradientmix) 99%
        );
        background-image: -webkit-linear-gradient(
          top,
          rgba(0, 0, 0, 0) 0%,
          var(--gradientmix) 99%
        );
        background-image: linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0) 0%,
          var(--gradientmix) 99%
        );
        border-radius: calc(100 / 16 * 1rem);
        overflow: hidden;
        display: inline-block;
        position: relative;
        z-index: 1;

        &:before {
          content: "";
          width: 0%;
          height: 100%;
          border-radius: calc(4 / 16 * 1rem);
          background: var(--secondary);
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
          opacity: 1;
        }

        &:hover {
          &:before {
            width: 100%;
          }
        }
      }

      .cs-card-group {
        margin: 0;
        padding: 0;
        width: 100%;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        /* 16px - 20px */
        gap: clamp(1rem, 2.4vw, 1.25rem);
      }

      .cs-item {
        width: 100%;
        text-align: left;
        list-style: none;
        margin: 0;
        /* 12px - 20px */
        padding: clamp(0.75rem, 1vw, 1.25rem);
        border-radius: calc(12 / 16 * 1rem);
        background-color: #fff;
        overflow: hidden;
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
        grid-column: span 12;
        grid-row: span 1;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
        position: relative;
        z-index: 1;

        &:before {
          content: "";
          width: 100%;
          height: 100%;
          background: var(--primary);
          opacity: 0.05;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
        }
      }

      .cs-picture {
        width: 100%;
        height: 45vw;
        max-height: calc(350 / 16 * 1rem);
        /* 12px - 16px */
        margin-bottom: clamp(0.75rem, 2vw, 1rem);
        border-radius: calc(8 / 16 * 1rem);
        overflow: hidden;
        display: block;
        position: relative;
        z-index: 1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      .cs-h3 {
        /* 16px - 20px */
        font-size: clamp(1rem, 3vw, 1.25rem);
        line-height: 1.2em;
        font-weight: bold;
        text-align: inherit;
        margin: 0;
        color: var(--headerColor);
      }

      .cs-image-group {
        width: 100%;
        max-width: calc(704 / 16 * 1rem);
        height: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: calc(42 / 16 * 1rem);
        position: relative;
        z-index: 1;
      }

      .cs-map {
        width: 89%;
        height: 79vw;
        max-height: calc(400 / 16 * 1rem);
        overflow: hidden;
        display: block;
        position: relative;
        z-index: 1;

        &:before {
          content: "";
          background: radial-gradient(
            ellipse at center,
            rgba(255, 255, 255, 0) 33%,
            rgba(255, 255, 255, 0.03) 34%,
            rgba(255, 255, 255, 0.57) 54%,
            rgba(255, 255, 255, 1) 70%,
            rgba(255, 255, 255, 1) 88%
          );
          pointer-events: none;
          opacity: 1;
          display: block;
          position: absolute;
          top: -1px;
          left: -1px;
          right: -1px;
          bottom: -1px;
          z-index: 2;
        }

        img,
        iframe {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
        }
      }

      .cs-arrow {
        width: calc(36 / 16 * 1rem);
        height: auto;
        margin-right: calc(20 / 16 * 1rem);
        display: block;
        position: absolute;
        bottom: calc(75 / 16 * 1rem);
        right: 50%;
        z-index: 3;
        transform: rotate(-137deg);
      }

      .cs-box {
        text-align: center;
        width: 40vw;
        max-width: calc(177 / 16 * 1rem);
        margin-right: calc(250 / 16 * 1rem);
        /* 12px - 16px top & bottom */
        /* 12px - 24px left & right */
        padding: clamp(0.75rem, 3vw, 1rem) clamp(0.75rem, 3vw, 1.5rem);
        box-sizing: border-box;
        background-color: #fff;
        border-radius: calc(16 / 16 * 1rem);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
        z-index: 1;

        &:before {
          /* background color */
          content: "";
          width: 100%;
          height: 100%;
          background: var(--primary);
          border-radius: calc(16 / 16 * 1rem);
          opacity: 0.1;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
        }

        &:after {
          /* border color */
          content: "";
          width: 100%;
          height: 100%;
          border: 4px solid var(--primary);
          border-radius: calc(16 / 16 * 1rem);
          opacity: 0.2;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
        }
      }

      .cs-box-text {
        /* 12px - 16px */
        font-size: clamp(0.75rem, 3vw, 1rem);
        line-height: 1.2em;
        font-weight: 700;
        width: 100%;
        margin: 0;
        color: var(--headerColor);
        display: block;
      }
    }
  }

  /* Tablet - 700px */
  @media only screen and (min-width: 43.75rem) {
    #services-2414 {
      .cs-item {
        grid-column: span 6;
      }

      .cs-box {
        margin-right: calc(350 / 16 * 1rem);
      }

      .cs-picture {
        height: auto;
        min-height: calc(212 / 16 * 1rem);
        max-height: 100%;
      }

      .cs-arrow {
        margin-right: calc(60 / 16 * 1rem);
        bottom: calc(100 / 16 * 1rem);
      }
    }
  }

  /* Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #services-2414 {
      .cs-container {
        align-items: flex-end;
      }

      .cs-content {
        text-align: left;
        width: 54vw;
        box-sizing: border-box;
        align-items: flex-start;
      }

      .cs-flex {
        padding-bottom: 0;
      }

      .cs-card-group {
        /* 200px - 325px */
        padding-left: clamp(12.5rem, 20vw + 1rem, 20.3125rem);
      }

      .cs-item {
        grid-column: span 3;
      }

      .cs-picture {
        max-height: calc(200 / 16 * 1rem);
      }

      .cs-image-group {
        width: 41vw;
        max-width: calc(522 / 16 * 1rem);
        height: auto;
        position: absolute;
        left: 0;
        top: 0;
        bottom: calc(-20 / 16 * 1rem);
      }

      .cs-map {
        width: 100%;
        height: auto;
        max-height: 100%;
        position: absolute;
        top: 0;
        bottom: calc(132 / 16 * 1rem);
      }

      .cs-box {
        margin: 0;
        position: absolute;
        left: 0;
        bottom: 0;
      }
    }
  }

  /* Large Desktop - 1300px */
  @media only screen and (min-width: 81.25rem) {
    #services-2414 {
      .cs-map {
        bottom: calc(70 / 16 * 1rem);
      }

      .cs-arrow {
        margin-right: calc(30 / 16 * 1rem);
        bottom: calc(70 / 16 * 1rem);
      }
    }
  }
</style>
