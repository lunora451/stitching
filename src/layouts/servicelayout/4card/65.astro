<style lang="scss">
  /*-- -------------------------- -->
<---         Services           -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #services-13 {
      padding: var(--sectionPadding);

      .cs-container {
        width: 100%;
        /* changes to 1280px at tablet */
        max-width: calc(550 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-title {
        margin: 0;
        max-width: 20ch;
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: flex;
        justify-content: space-between;
        align-items: stretch;
        flex-wrap: wrap;
        row-gap: calc(16 / 16 * 1rem);
      }

      .cs-item {
        list-style: none;
        margin: 0;
        width: 48%;
        /* 28px - 40px */
        padding-bottom: clamp(1.75rem, 4.2vw, 2.5rem);
        background: #fff;
        box-shadow: 0px 0px calc(8 / 16 * 1em) rgba(26, 26, 26, 0.15);
      }

      .cs-picture {
        display: block;
        position: relative;
        width: 100%;
        height: calc(232 / 16 * 1rem);
        /* 28px - 40px */
        margin-bottom: clamp(1.75rem, 4.2vw, 2.5rem);

        img {
          position: absolute;
          top: 0;
          left: 0;
          height: 100%;
          width: 100%;
          /* Turns image into background image */
          object-fit: cover;
        }
      }

      .cs-icon {
        width: calc(60 / 16 * 1rem);
        height: auto;
        margin: auto;
        margin-bottom: calc(16 / 16 * 1rem);
        display: block;
      }

      .cs-h3 {
        /* 14px - 20px */
        font-size: clamp(0.875rem, 2vw, 1.25rem);
        line-height: 1.2em;
        font-weight: 700;
        margin: 0;
        margin: auto;
        color: var(--headerColor);
        display: block;
        text-align: center;
      }

      .cs-bottom-group {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }

      .cs-left-group {
        /* breaks open the container, letting the children be part of the .cs-bottom-group flexbox */
        display: contents;
      }

      .cs-lg-span {
        text-align: left;
        /* 20px - 25px */
        font-size: clamp(1.25rem, 3vw, 1.5625rem);
        font-weight: 700;
        line-height: 1.2em;
        margin-bottom: calc(20 / 16 * 1rem);
        color: var(--primary);
        display: block;
      }

      .cs-lg-link {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        text-decoration: none;
        color: var(--headerColor);
        position: relative;
        display: inline-block;
        /* Sends it to the bottom of the flexbox */
        order: 3;

        &:before {
          content: "";
          position: absolute;
          display: block;
          height: calc(3 / 16 * 1rem);
          width: 100%;
          background: var(--primary);
          opacity: 1;
          bottom: calc(-6 / 16 * 1rem);
          left: 0;
        }
      }

      .cs-bottom-ul {
        width: 100%;
        margin: 0;
        margin-bottom: calc(28 / 16 * 1rem);
        padding: 0;
        padding-left: calc(16 / 16 * 1rem);
        columns: 2;
        column-gap: calc(40 / 16 * 1rem);
      }

      .cs-li {
        text-align: left;
        font-size: calc(13 / 16 * 1rem);
        line-height: 1.5em;
        list-style: none;
        max-width: calc(150 / 16 * 1rem);
        margin-bottom: calc(8 / 16 * 1rem);
        display: block;
        color: var(--bodyTextColor);
        position: relative;

        &:before {
          /* List Bullet */
          content: "";
          position: absolute;
          display: block;
          height: calc(4 / 16 * 1rem);
          width: calc(4 / 16 * 1rem);
          border-radius: 50%;
          background: #1a1a1a;
          opacity: 1;
          top: calc(10 / 16 * 1rem);
          left: calc(-15 / 16 * 1rem);
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #services-13 {
      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
      }

      .cs-card-group {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: calc(20 / 16 * 1rem);
      }

      .cs-item {
        margin: 0;
        &:last-of-type {
          margin: 0;
        }
      }

      .cs-bottom-group {
        margin: auto;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-start;
        max-width: calc(690 / 16 * 1rem);
      }

      .cs-left-group {
        text-align: left;
        min-width: calc(224 / 16 * 1rem);
        margin-right: calc(40 / 16 * 1rem);
        display: inline-block;
      }

      .cs-lg-span {
        text-align: left;
      }

      .cs-block {
        /* forces the second line */
        display: block;
      }

      .cs-bottom-ul {
        width: auto;
        max-width: calc(776 / 16 * 1rem);
        display: inline-block;
      }

      .cs-li {
        text-align: left;
        width: calc(130 / 16 * 1rem);
      }
    }
  }

  /* Small Desktop - 1024px - Contains Hover States */
  @media only screen and (min-width: 64rem) {
    #services-13 {
      .cs-card-group {
        justify-content: space-between;
        flex-wrap: nowrap;
        gap: calc(20 / 16 * 1rem);
      }

      .cs-item {
        max-width: calc(305 / 16 * 1rem);
        transition: transform 0.3s;
        &:hover {
          transform: translateY(calc(-20 / 16 * 1rem));
          .cs-picture {
            &:before {
              opacity: 0.7;
            }

            img {
              transform: scale(1.1);
            }
          }
        }
      }

      .cs-picture {
        /* 320px - 420px */
        height: clamp(20rem, 33vw, 26.25rem);
        /* Prevents image from overflowing on hover */
        overflow: hidden;

        &:before {
          content: "";
          position: absolute;
          display: block;
          height: 100%;
          width: 100%;
          background: var(--primary);
          opacity: 0;
          top: 0;
          left: 0;
          transition: opacity 0.4s;
          z-index: 10;
        }

        img {
          transition: transform 0.7s;
        }
      }

      .cs-bottom-group {
        max-width: calc(1104 / 16 * 1rem);
        align-items: flex-end;
      }

      .cs-lg-span {
        font-size: calc(20 / 16 * 1rem);
      }

      .cs-lg-link {
        font-size: calc(15 / 16 * 1rem);
      }

      .cs-bottom-ul {
        width: calc(776 / 16 * 1rem);
        margin: 0;
        columns: 3;
        column-gap: calc(90 / 16 * 1rem);
      }

      .cs-li {
        font-size: calc(15 / 16 * 1rem);
        width: calc(160 / 16 * 1rem);
      }
    }
  }
</style>
