<style lang="scss">
  /*-- -------------------------- -->
<---          Services          -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #services-1729 {
      padding: var(--sectionPadding);
      /* removing the side paddings to allow the cards to fit the whole page width */
      padding-right: 0;
      padding-left: 0;
      position: relative;

      .cs-container {
        width: 100%;
        max-width: calc(2500 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: left;
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        box-sizing: border-box;
        /* 16px - 40px */
        padding: 0 clamp(1rem, 3.8vw, 2.5rem);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        /* centers content horizontally, set to flex-start to left align */
        align-items: flex-start;
        /* 16px - 32px */
        gap: clamp(1rem, 4vw, 2rem);
      }

      .cs-title {
        max-width: 15ch;
        margin: 0;
      }

      .cs-text {
        max-width: calc(632 / 16 * 1rem);
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: grid;
      }

      .cs-item {
        width: 100%;
        color: #fff;
        display: flex;
        flex-direction: column;

        &:nth-of-type(1),
        &:nth-of-type(4) {
          background-color: #1a1a1a;
        }

        &:nth-of-type(2),
        &:nth-of-type(3) {
          background-color: var(--primary);
        }
      }

      .cs-picture {
        width: 100%;
        max-height: calc(340 / 16 * 1rem);
        display: block;
        overflow: hidden;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          display: block;
        }
      }

      .cs-details {
        margin: 0 auto;
        /* 68px - 144px top & bottom, 24px - 32px sides*/
        padding: clamp(4.25rem, 10vw, 9rem) clamp(1.5rem, 2vw, 2rem);
        /* prevents padding from affecting height and width */
        box-sizing: border-box;
      }

      .cs-tag {
        /* 13px - 16px */
        font-size: clamp(0.8125rem, 2vw, 1rem);
        font-weight: 700;
        line-height: 1.2em;
        text-transform: uppercase;
        margin: 0 0 calc(4 / 16 * 1rem);
        color: #fff;
        display: block;
      }

      .cs-h3 {
        /* 25px - 31px */
        font-size: clamp(1.5625rem, 3vw, 1.9375rem);
        font-weight: 700;
        line-height: 1.2em;
        margin: 0 0 calc(16 / 16 * 1rem);
        color: #fff;
      }

      .cs-item-text {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 400;
        line-height: 1.5em;
        margin: 0;
        color: #f7f7f7;
      }

      .cs-link {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        text-decoration: none;
        width: 100%;
        margin: calc(24 / 16 * 1rem) 0 0;
        color: #fff;
        display: flex;
        gap: calc(4 / 16 * 1rem);

        &:hover {
          img {
            transform: translateX(0.25rem);
          }
        }

        img {
          transition: transform 0.3s;
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 37.5rem) {
    #services-1729 {
      .cs-content {
        flex-direction: row;
        align-items: flex-end;
      }

      .cs-item {
        flex-direction: row;
        align-items: center;

        &:nth-of-type(1),
        &:nth-of-type(3) {
          .cs-details {
            order: 1;
          }

          .cs-picture {
            order: 2;
          }
        }
      }

      .cs-details {
        width: 50%;
      }

      .cs-picture {
        width: 50%;
      }

      .cs-picture {
        height: 100%;
        max-height: none;
      }
    }
  }

  /* Large Desktop - 1300px */
  @media only screen and (min-width: 64rem) {
    #services-1729 {
      .cs-card-group {
        grid-template-columns: repeat(2, 1fr);
      }

      .cs-item {
        &:nth-of-type(1),
        &:nth-of-type(2) {
          .cs-details {
            order: 1;
          }

          .cs-picture {
            order: 2;
          }
        }

        &:nth-of-type(3) {
          .cs-details {
            order: 2;
          }

          .cs-picture {
            order: 1;
          }
        }
      }
    }
  }
</style>
