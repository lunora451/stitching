        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: left;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: flex-start;
      }

      .cs-title {
        max-width: 18ch;
      }

      .cs-text {
        max-width: calc(540 / 16 * 1rem);
      }

      .cs-card-group {
        width: 100%;
        /* changes to 100% at tablet */
        max-width: calc(500 / 16 * 1rem);
        margin: 0;
        padding: 0;
        border: 1px solid #a0a3bd;
        display: flex;
        flex-direction: column;
      }

      .cs-item {
        width: 100%;
        margin: auto;
        list-style: none;
        background-color: #fff;
        border-bottom: 1px solid #a0a3bd;
        transition: background-color 0.3s;

        &:hover {
          background-color: var(--primary);

          .cs-icon {
            /* turns it white */
            filter: grayscale(1) brightness(1000%);
          }

          .cs-h3 {
            color: #fff;
          }
        }
      }

      .cs-link {
        text-decoration: none;
        width: 100%;
        height: 100%;
        padding-top: calc(56 / 16 * 1rem);
        padding-bottom: calc(52 / 16 * 1rem);
        display: flex;
        justify-content: flex-start;
        align-items: center;
        flex-direction: column;
        /* Prevents padding from affecting height */
        box-sizing: border-box;
      }

      .cs-icon {
        margin-bottom: calc(18 / 16 * 1rem);
      }

      .cs-hover {
        display: none;
      }

      .cs-h3 {
        font-size: calc(20 / 16 * 1rem);
        line-height: 1.2em;
        font-weight: 400;
        text-align: center;
        margin: 0;
        color: var(--headerColor);
        transition: color 0.3s;
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        /* 46px - 56px */
        line-height: clamp(2.875em, 5.5vw, 3.5em);
        text-decoration: none;
        font-weight: 700;
        text-align: center;
        margin: auto;
        color: #fff;
        min-width: calc(150 / 16 * 1rem);
        padding: 0 calc(24 / 16 * 1rem);
        background-color: var(--primary);
        border-radius: calc(4 / 16 * 1rem);
        display: inline-block;
        position: relative;
        z-index: 1;
        /* prevents padding from adding to the width */
        box-sizing: border-box;

        &:before {
          content: "";
          position: absolute;
          height: 100%;
          width: 0%;
          background: #000;
          opacity: 1;
          top: 0;
          left: 0;
          z-index: -1;
          border-radius: calc(4 / 16 * 1rem);
          transition: width 0.3s;
        }

        &:hover {
          &:before {
            width: 100%;
          }
        }
      }
    }
  }

  /* In Between - 500px */
  @media only screen and (min-width: 31.25rem) {
