  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #services-28 {
      /* Centers the button */
      text-align: center;
      padding: var(--sectionPadding);

      .cs-container {
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        margin: auto;
        display: flex;
