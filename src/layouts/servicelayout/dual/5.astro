  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #services-1841 {
      padding: var(--sectionPadding);

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
        max-width: calc(550 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        max-width: calc(542 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
      }

      .cs-title {
        /* 28px - 44px */
        margin: 0 0 clamp(1.75rem, 6vw, 2.75rem);
      }

      .cs-ul {
        list-style: none;
        width: 100%;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }

      .cs-li {
        width: 100%;
        border-bottom: 1px solid #e8e8e8;
      }

      .cs-link {
        text-decoration: none;
        padding: calc(20 / 16 * 1rem) 0;
        box-sizing: border-box;
        display: flex;
        justify-content: space-between;
        align-items: center;

        &:hover {
          .cs-h3 {
            color: var(--primary);
          }

          .cs-icon {
            transform: scale(1.2);
          }
        }
      }

      .cs-h3 {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 2vw, 1.5625rem);
        font-weight: 700;
        line-height: 1.2em;
        text-transform: uppercase;
        margin: 0;
        color: var(--bodyTextColor);
        transition: color 0.3s;
      }

      .cs-icon {
        width: calc(32 / 16 * 1rem);
        height: auto;
        display: block;
        transition: transform 0.3s;
        transform-origin: bottom left;
      }

      .cs-image-group {
        /* scales the whole group based on the view width size and stop when that vales equals .8rem, resets at tablet */
        font-size: min(2.235vw, 0.8em);
        width: calc(630 / 16 * 1em);
        height: calc(613 / 16 * 1em);
        display: block;
        position: relative;
        z-index: 1;
      }

      .cs-picture {
        position: absolute;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      .cs-picture1 {
        width: calc(413 / 16 * 1em);
        height: calc(540 / 16 * 1em);
        top: 0;
        left: 0;
      }

      .cs-picture2 {
        width: calc(305 / 16 * 1em);
        height: calc(365 / 16 * 1em);
        right: 0;
        bottom: 0;
        z-index: 10;
      }

      .cs-floater {
        /* 62px - 120px */
        width: clamp(3.875rem, 14vw, 7.5rem);
        height: clamp(3.875rem, 14vw, 7.5rem);
        background-color: #1a1a1a;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        position: absolute;
        top: 34%;
        left: 57%;
        z-index: 10;
        transform: translate(-50%);
      }

      .cs-floater-icon {
        /* 32px - 60px */
        width: clamp(2rem, 4.6vw, 3.75rem);
        height: auto;
        display: block;
      }
    }
  }

