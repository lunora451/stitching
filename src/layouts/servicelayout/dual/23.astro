<style lang="scss">
  /*-- -------------------------- -->
<---         Services           -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #services-676 {
      padding: var(--sectionPadding);

      .cs-container {
        width: 100%;
        /* changes to 1440px at desktop */
        max-width: calc(992 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        /* 48px - 64px */
        gap: clamp(3rem, 8vw, 6.25rem);
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: left;
        width: 100%;
        max-width: calc(487 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: flex-start;
      }

      .cs-color {
        color: var(--primary);
      }
      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        /* 46px - 56px */
        line-height: clamp(2.875em, 5.5vw, 3.5em);
        text-decoration: none;
        font-weight: 700;
        text-align: center;
        margin: 0;
        color: #fff;
        min-width: calc(150 / 16 * 1rem);
        padding: 0 calc(24 / 16 * 1rem);
        background-color: var(--primary);
        border-radius: calc(4 / 16 * 1rem);
        display: inline-block;
        position: relative;
        z-index: 1;
        /* prevents padding from adding to the width */
        box-sizing: border-box;

        &:before {
          content: "";
          position: absolute;
          height: 100%;
          width: 0%;
          background: #000;
          opacity: 1;
          top: 0;
          left: 0;
          z-index: -1;
          border-radius: calc(4 / 16 * 1rem);
          transition: width 0.3s;
        }

        &:hover {
          &:before {
            width: 100%;
          }
        }
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
      }

      .cs-item {
        list-style: none;
        /* 40px - 64px */
        padding: clamp(2.5rem, 6.3vw, 4rem);
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
        background-color: #eff1f0;
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        z-index: 1;
        transition: filter 0.3s;

        &:hover {
          filter: brightness(70%);
        }

        &:nth-of-type(even) {
          background-color: var(--primary);
          .cs-link,
          .cs-h2 {
            color: #f7f7f7;
          }

          .cs-waves {
            display: none;
          }
        }
      }

      .cs-picture {
        width: calc(100 / 16 * 1rem);
        height: calc(100 / 16 * 1rem);
        margin: 0 0 calc(20 / 16 * 1rem) 0;
        background-color: #fdfaf8;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .cs-icon {
        width: calc(52 / 16 * 1rem);
        height: auto;
        display: block;
      }

      .cs-h2 {
        font-size: calc(25 / 16 * 1rem);
        font-weight: 700;
        text-align: center;
        line-height: 1.2em;
        /* 20px - 32px */
        margin: 0 0 clamp(1.25rem, 3vw, 2rem);
        color: var(--headerColor);
        display: block;
      }

      .cs-link {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.2em;
        font-weight: 700;
        text-decoration: none;
        margin: 0;
        color: var(--primary);
        display: inline-block;
        position: relative;
        &:before {
          /* underline */
          content: "";
          width: 100%;
          height: 1px;
          background: currentColor;
          opacity: 1;
          position: absolute;
          display: block;
          bottom: -1px;
          left: 0;
        }
      }

      .cs-waves {
        width: 100%;
        height: 100%;
        opacity: 0.5;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        /* prevents the mouse from interacting with it */
        pointer-events: none;
        /* makes it act like a background images */
        object-fit: cover;
        z-index: -1;
      }
    }
  }

  /* Tablet - 650px */
  @media only screen and (min-width: 40.625rem) {
    #services-676 {
      .cs-card-group {
        flex-direction: row;
        flex-wrap: wrap;
      }

      .cs-item {
        width: 50%;

        &:nth-of-type(3) {
          order: 4;
        }
      }
    }
  }

  /* Large Desktop 1300px */
  @media only screen and (min-width: 81.25rem) {
    #services-676 {
      .cs-container {
        max-width: calc(1440 / 16 * 1rem);
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }

      .cs-card-group {
        /* sends it to the left in the first position */
        order: -1;
      }
    }
  }
</style>
