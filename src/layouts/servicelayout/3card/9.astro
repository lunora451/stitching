  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #services-1849 {
      padding: var(--sectionPadding);
      overflow: hidden;
      position: relative;

      &:before {
        content: "";
        width: 100%;
        height: 100%;
        background: #f6eddf;
        opacity: 0.9;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
      }

      .cs-container {
        width: 100%;
        max-width: calc(704 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
        position: relative;
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
        z-index: 1;
      }

      .cs-title {
        max-width: none;
      }

      .cs-card-group {
        width: 100%;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        row-gap: calc(16 / 16 * 1rem);
      }

      .cs-item {
        list-style: none;
        width: 100%;
        /* 264px - 350px, changes to a different clamp on tablet */
        padding-top: clamp(16.5rem, 75vw, 21.875rem);
        display: flex;
        flex-direction: column;
        grid-column: span 12;
        position: relative;
        z-index: 1;

        &:hover {
          cursor: pointer;
          .cs-picture {
            img {
              transform: scale(1.1);
            }
          }
        }
      }

      .cs-picture {
        width: 90vw;
        max-width: calc(413 / 16 * 1rem);
        height: 90vw;
        max-height: calc(413 / 16 * 1rem);
        box-sizing: border-box;
        background-color: #dab692;
        /* clips img tag from overflowing it on hover */
        overflow: hidden;
        border: 4px solid #dab692;
        border-radius: 50%;
        display: block;
        position: absolute;
        top: 0;
        left: 50%;
        z-index: -1;
        transform: translateX(-50%);

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
          transition: transform 0.7s;
        }
      }

      .cs-text-box {
        text-align: center;
        /* 16px - 24px */
        padding: clamp(1rem, 3.5vw, 1.5rem);
        background-color: #faf6f2;
        border-radius: calc(24 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: calc(16 / 16 * 1rem);
        z-index: 1;
        align-self: stretch;
      }

      .cs-h3 {
        font-size: calc(20 / 16 * 1rem);
        font-weight: 700;
        line-height: 120%;
        width: 100%;
        margin: 0;
        color: var(--headerColor);
      }

      .cs-item-text {
        /* 14px - 16px */
        font-size: clamp(0.875rem, 1.5vw, 1rem);
        line-height: 1.5em;
        width: 100%;
        margin: 0;
        color: var(--bodyTextColor);
      }

      .cs-background {
        width: 100%;
        height: 100%;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          /* makes the top of the image start at the top of the parent */
          object-position: top;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
        }
      }

      .cs-graphic1 {
        /* 200px - 548px */
        width: clamp(12.5rem, 30vw, 34.25rem);
