<style lang="scss">
  /*-- -------------------------- -->
<---          Services          -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #services-2051 {
      padding: var(--sectionPadding);
      background-color: #f3fcfb;
      overflow: hidden;
      position: relative;
      z-index: 1;

      &::before {
        /* black background, removed at tablet */
        content: "";
        width: 100%;
        background-color: #1a1a1a;
        /* prevents the mouse from interacting with it */
        pointer-events: none;
        position: absolute;
        top: 0;
        bottom: calc(580 / 16 * 1rem);
        left: 0;
        z-index: -1;
      }

      .cs-container {
        width: 100%;
        /* changes to 1280px at desktop */
        max-width: calc(584 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-wrapper {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
        position: relative;
        z-index: 1;
      }

      .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: left;
        width: 100%;
        max-width: calc(630 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: flex-start;
      }

      .cs-topper {
        color: var(--secondary);
      }

      .cs-title {
        /* 23 characters wide including spaces */
        max-width: 26ch;
        color: var(--bodyTextColorWhite);
      }

      .cs-text {
        margin-bottom: calc(12 / 16 * 1rem);
        color: var(--bodyTextColorWhite);

        &:last-of-type {
          margin-bottom: 0;
        }
      }

      .cs-button-solid {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        line-height: calc(56 / 16 * 1rem);
        text-decoration: none;
        margin: calc(32 / 16 * 1rem) 0 0;
        padding: 0 calc(48 / 16 * 1rem);
        background-color: var(--primary);
        overflow: hidden;
        color: #fff;
        border-radius: calc(8 / 16 * 1rem);
        display: inline-block;
        position: relative;
        z-index: 1;
        transition: color 0.3s;

        &:before {
          content: "";
          width: 0;
          height: 100%;
          background: #1a1a1a;
          opacity: 1;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          transition: width 0.3s;
        }

        &:hover {
          color: var(--primary);

          &:before {
            width: 100%;
          }
        }
      }

      .cs-picture-group {
        width: 100%;
        min-height: calc(520 / 16 * 1rem);
        display: flex;
        position: relative;
        z-index: 1;
      }

      .cs-picture {
        width: 100%;
        min-height: calc(362 / 16 * 1rem);
        /* clips img tag corners */
        overflow: hidden;
        border-radius: calc(8 / 16 * 1rem);
        display: block;
        position: relative;

        z-index: 1;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          display: block;
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      .cs-box {
        text-align: left;
        width: 88%;
        max-width: calc(305 / 16 * 1rem);
        /* prevents padding from affecting height and width */
        box-sizing: border-box;
        padding: calc(32 / 16 * 1rem);
        border-radius: calc(8 / 16 * 1rem);
        background-color: #fff;
        position: absolute;
        /* 16px - 40px */
        bottom: clamp(1rem, 4vw, 2.5rem);
        /* 16px - 40px */
        left: clamp(1rem, 4vw, 2.5rem);
        z-index: 1;

        &:before {
          /* background color */
          content: "";
          width: 100%;
          height: 100%;
          background-color: var(--primary);
          opacity: 0.05;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
        }
      }

      .cs-box-icon {
        width: calc(60 / 16 * 1rem);
        height: auto;
        margin: 0 0 calc(16 / 16 * 1rem);
        display: block;
      }

      .cs-box-number {
        font-size: calc(31 / 16 * 1rem);
        font-weight: 900;
        line-height: 1.2em;
        margin: 0 0 calc(12 / 16 * 1rem);
        color: var(--headerColor);
        display: block;
      }

      .cs-box-desc {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.5em;
        color: var(--bodyTextColor);
        display: block;
      }

      .cs-stat-group {
        display: flex;
        flex-direction: column;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
        position: relative;
        z-index: 10;
      }

      .cs-stats {
        width: 100%;
        max-width: calc(630 / 16 * 1rem);
        margin: 0;
        padding: 0;
        display: flex;
        /* 16px - 24px */
        gap: clamp(1rem, 2.5vw, 1.5rem);
      }

      .cs-li {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: calc(16 / 16 * 1rem);
      }

      .cs-icon {
        /* 64px - 80px */
        width: clamp(4rem, 8vw, 5rem);
        height: auto;
        display: block;
        flex: none;
      }

      .cs-stat {
        /* 31px - 39px */
        font-size: clamp(1.9375rem, 3vw, 2.4375rem);
        font-weight: 900;
        line-height: 1.2em;
        margin: 0 0 calc(4 / 16 * 1rem);
        color: var(--bodyTextColorWhite);
        display: block;
      }

      .cs-stat-text {
        /* 14px - 16px */
        font-size: clamp(0.875rem, 1.8vw, 1rem);
        line-height: 1.5em;
        text-align: left;
        margin: 0;
        color: var(--bodyTextColorWhite);
        opacity: 0.8;
      }

      .cs-card-group {
        width: 100%;
        margin: 0 auto;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        /* 16px - 20px */
        gap: clamp(1rem, 2vw, 1.25rem);
      }

      .cs-item {
        text-align: left;
        list-style: none;
        width: 100%;
        margin: 0 auto;
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
        /* 16px - 32px */
        padding: clamp(1rem, 4.5vw, 2rem);
        background-color: #fff;
        border-radius: calc(8 / 16 * 1rem);
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        grid-column: span 12;
        grid-row: span 1;
        gap: calc(32 / 16 * 1rem);
        position: relative;
        z-index: 1;
        border: 1px solid transparent;
        transition: border-color 0.3s;

        &:hover {
          border-color: var(--primary);
        }
      }

      .cs-flex {
        display: flex;
        flex-direction: column;
      }

      .cs-h3 {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 2.5vw, 1.5625rem);
        font-weight: 700;
        line-height: 1.2em;
        text-align: inherit;
        margin: 0 0 calc(16 / 16 * 1rem) 0;
        color: var(--headerColor);
        transition: color 0.3s;
      }

      .cs-item-text {
        /* 14px - 16px */
        font-size: clamp(0.875rem, 1.5vw, 1rem);
        line-height: 1.5em;
        max-width: calc(450 / 16 * 1rem);
        margin: 0;
        margin-bottom: calc(24 / 16 * 1rem);
        padding: 0;
        color: var(--bodyTextColor);
      }

      .cs-link {
        font-size: calc(16 / 16 * 1rem);
        font-weight: 700;
        line-height: 1.2em;
        text-align: inherit;
        text-decoration: none;
        max-width: fit-content;
        margin-top: auto;
        color: var(--primary);
        border-bottom: 1px solid var(--primary);
        display: flex;
        justify-content: flex-start;
        align-items: center;
      }

      .cs-item-picture {
        margin: 0;
        padding: calc(58 / 16 * 1rem) 0 0 calc(115 / 16 * 1rem);
        border-radius: calc(8 / 16 * 1rem);
        overflow: hidden;
        display: flex;
        justify-content: flex-end;
        align-items: flex-end;
        position: relative;

        &:before {
          /* background color */
          content: "";
          width: 100%;
          height: 100%;
          background-color: var(--primary);
          opacity: 0.05;
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
        }

        img {
          width: 100%;
          height: auto;
          display: block;
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #services-2051 {
      &:before {
        /* 100px - 200px */
        top: clamp(6.25rem, 15vw, 12.5rem);
        bottom: calc(200 / 16 * 1rem);
      }

      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
        align-items: flex-start;
      }

      .cs-content {
        width: 50%;
        /* 140px - 200px top */
        /* 48px - 64px right */
        /* 20px - 80px bottom*/
        padding: clamp(8.75rem, 20vw, 12.5rem) clamp(3rem, 6vw, 4rem)
          clamp(1.25rem, 6vw, 5rem) 0;
      }

      .cs-wrapper {
        flex-direction: row;
        justify-content: flex-start;
      }

      .cs-picture-group {
        width: 50vw;
        position: absolute;
        top: 0;
        left: 50%;
        bottom: 0;
      }

      .cs-picture {
        border-radius: calc(8 / 16 * 1rem) 0 0 calc(8 / 16 * 1rem);
      }

      .cs-stat-group {
        flex-direction: row;
      }

      .cs-item {
        flex-direction: row;
        justify-content: space-between;
        align-items: stretch;
        grid-column: span 6;
      }

      .cs-item-picture {
        width: 50%;
        max-width: calc(185 / 16 * 1rem);
        height: auto;
        padding: calc(61 / 16 * 1rem) 0 0 calc(4 / 16 * 1rem);
        flex: none;
      }
    }
  }

  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #services-2051 {
      .cs-picture-group {
        margin-left: calc(40 / 16 * 1rem);
      }

      .cs-li {
        flex-direction: row;
        align-items: center;
      }
    }
  }
</style>
