<style lang="scss">
  /*-- -------------------------- -->
<---          Services          -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #services-2331 {
      padding: var(--sectionPadding);
      position: relative;
      z-index: 1;

      &:before {
        content: "";
        width: 100%;
        height: 40%;
        background: #f3f3f3;
        opacity: 1;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;
      }

      .cs-container {
        width: 100%;
        /* changes to 1280px at tablet */
        max-width: calc(550 / 16 * 1rem);
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* 48px - 64px */
        gap: clamp(3rem, 6vw, 4rem);
      }

      .cs-stat-group {
        width: 100%;
        max-width: calc(1040 / 16 * 1rem);
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: calc(20 / 16 * 1rem);
      }

      .cs-stat {
        list-style: none;
        display: flex;
        align-items: center;
        /* 8px - 20px */
        gap: clamp(0.5rem, 2vw, 1.25rem);
        grid-column: span 6;
      }

      .cs-number {
        /* 31px - 61px */
        font-size: clamp(1.9375rem, 4vw, 3.8125rem);
        line-height: 1.2em;
        font-weight: 700;
        margin: 0;
        color: var(--primary);
      }

      .cs-desc {
        font-size: clamp(1rem, 2vw, 1.25rem);
        line-height: 1.2em;
        font-weight: bold;
        margin: 0;
        color: var(--headerColor);
      }

      .cs-card-group {
        margin: 0;
        padding: 0;
        width: 100%;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: clamp(0.5rem, 2vw, 1.25rem);
      }

      .cs-item {
        /* place this in a variable to reuse for the s-icon-wrapper placement */
        --itemPadding: clamp(1rem, 3.5vw, 3rem);
        width: 100%;
        text-align: left;
        list-style: none;
        margin: 0;
        /* 16px - 48px */
        padding: var(--itemPadding);
        background-color: #fff;
        border: 1px solid #e7e7e8;
        /* prevents padding and border from affecting height and width */
        box-sizing: border-box;
        grid-column: span 12;
        grid-row: span 1;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        position: relative;
        z-index: 1;

        &:hover {
          .cs-h3,
          .cs-link,
          .cs-item-text {
            color: var(--bodyTextColorWhite);
          }

          .cs-item-text {
            opacity: 0.9;
          }

          .cs-icon-wrapper {
            border-radius: 50%;
            transform: rotate(90deg);
          }

          .cs-icon {
            transform: rotate(-90deg);
          }

          .cs-arrow {
            filter: grayscale(1) brightness(10000%);
          }

          .cs-picture {
            opacity: 1;
          }
        }
      }

      .cs-icon-wrapper {
        /* 48px - 100px */
        width: clamp(3rem, 7vw, 6.25rem);
        height: clamp(3rem, 7vw, 6.25rem);
        margin: 0;
        background-color: #1a1a1a;
        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
        position: absolute;
        bottom: var(--itemPadding);
        right: var(--itemPadding);
        z-index: 1;
        transition:
          transform 0.5s,
          border-radius 0.5s;
      }

      .cs-icon {
        /* 24px - 48px */
        width: clamp(1.5rem, 4vw, 3rem);
        height: auto;
        transition: transform 0.5s;
      }

      .cs-h3 {
        /* 20px - 25px */
        font-size: clamp(1.25rem, 2.5vw, 1.5625rem);
        line-height: 1.2em;
        font-weight: bold;
        text-align: inherit;
        margin: 0 0 calc(12 / 16 * 1rem) 0;
        color: var(--headerColor);
        display: flex;
        align-items: center;
        gap: calc(16 / 16 * 1rem);
        position: relative;
        z-index: 1;

        &:before {
          content: "";
          width: calc(8 / 16 * 1rem);
          height: calc(8 / 16 * 1rem);
          background: var(--primary);
          opacity: 1;
          display: block;
        }
      }

      .cs-item-text {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.5em;
        max-width: calc(300 / 16 * 1rem);
        /* 56px - 108px */
        margin: 0 0 clamp(3.5rem, 8vw, 6.75rem) 0;
        padding: 0;
        color: var(--bodyTextColor);
      }

      .cs-link {
        text-decoration: none;
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.2em;
        text-transform: uppercase;
        font-weight: bold;
        margin: 0;
        padding: 0 0 calc(6 / 16 * 1rem) 0;
        color: var(--headerColor);
        display: inline-flex;
        justify-content: space-between;
        gap: calc(12 / 16 * 1rem);
        position: relative;
        transition: color 0.3s;

        &:hover {
          .cs-arrow {
            transform: rotate(45deg);
          }
        }

        &:before {
          /* underline */
          content: "";
          width: 100%;
          height: 1px;
          background: currentColor;
          opacity: 1;
          position: absolute;
          display: block;
          bottom: calc(0 / 16 * 1rem);
          left: 0;
        }
      }

      .cs-arrow {
        width: calc(20 / 16 * 1rem);
        height: auto;
        display: block;
        transition: transform 0.3s;
      }

      .cs-picture {
        width: 100%;
        height: 100%;
        opacity: 0;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;
        transition: opacity 0.3s;

        &:before {
          /* background color overlay */
          content: "";
          position: absolute;
          display: block;
          height: 100%;
          width: 100%;
          background: #1a1a1a;
          opacity: 0.84;
          top: 0;
          left: 0;
          z-index: 1;
        }

        img {
          position: absolute;
          top: 0;
          left: 0;
          height: 100%;
          width: 100%;
          /* Makes img tag act as a background image */
          object-fit: cover;
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #services-2331 {
      &:before {
        height: 30vw;
        max-height: calc(416 / 16 * 1rem);
      }

      .cs-container {
        max-width: calc(1280 / 16 * 1rem);
      }

      .cs-stat {
        grid-column: span 3;
      }

      .cs-item {
        grid-column: span 4;
        justify-content: flex-start;
      }

      .cs-link {
        margin-top: auto;
      }
    }
  }

  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #services-2331 {
      .cs-item {
        grid-column: span 4;
      }

      .cs-accent {
        /* 435px - 526px */
        height: clamp(27.1875rem, 41vw, 32.875rem);
      }
    }
  }
</style>
