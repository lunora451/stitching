<style lang="scss">
  .c-dunno {
    width: 100%;
    overflow-x: hidden;

    .c-menu {
      position: fixed;
      top: 0;
      left: 0;
      background-color: #d6a99d;
      padding: 0.9rem;
      display: flex;
      gap: 0.3rem;
      z-index: 999999;
      flex-direction: column;
      transform: translateX(0);
      transition: transform 0.4s;

      &.hide {
        transform: translateX(-100%);
      }

      .select-group {
        display: flex;
        align-items: center;
        gap: 0.5rem;

        .order-input {
          width: 50px;
          padding: 0;
          border: 1px solid #ccc;
          border-radius: 4px;
          text-align: center;
          font-size: 0.9rem;
        }
      }

      .hider {
        position: absolute;
        transform: translate(0, -50%);
        top: 50%;
        left: 100%;
        font-size: 1.5rem;
        padding-inline: 0.3rem;
        border-top-right-radius: 0.3rem;
        border-bottom-right-radius: 0.3rem;
        background: #d6a99d;
        &:hover {
          cursor: pointer;
        }
      }
    }

    .c-content {
      display: flex;
      flex-direction: column;
      padding-left: 0;
      width: 100%;
      overflow-x: hidden;

      .component-wrapper {
        width: 100%;
        overflow-x: hidden;

        // Force all child elements to respect container width
        > * {
          max-width: 100%;
          box-sizing: border-box;
        }
      }
    }
  }

  // Global overflow fix for all elements in template builder
  * {
    box-sizing: border-box;
  }

  select {
    padding: 0;
  }
</style>

<script>
  const tickerMenu = document.querySelector(".hider");
  const menu = document.querySelector(".c-menu");

  tickerMenu.addEventListener("click", () => {
    menu.classList.toggle("hide");
  });

  // Handle order changes
  const orderInputs = document.querySelectorAll(".order-input");

  orderInputs.forEach((input) => {
    input.addEventListener("change", (e) => {
      const targetId = e.target.getAttribute("data-target");
      const newOrder = e.target.value;
      const targetElement = document.getElementById(targetId);

      if (targetElement) {
        targetElement.style.order = newOrder;
      }
    });

    input.addEventListener("input", (e) => {
      const targetId = e.target.getAttribute("data-target");
      const newOrder = e.target.value;
      const targetElement = document.getElementById(targetId);

      if (targetElement && newOrder) {
        targetElement.style.order = newOrder;
      }
    });
  });

  // Handle preview generation
  const previewButton = document.getElementById("generate-preview");

  previewButton.addEventListener("click", () => {
    const selectedComponents = [];

    // Get all select elements and their corresponding order inputs
    const selectGroups = document.querySelectorAll(".select-group");

    selectGroups.forEach((group) => {
      const select = group.querySelector("select");
      const orderInput = group.querySelector(".order-input");

      if (select && orderInput) {
        console.log(`Checking select: ${select.name}, value: ${select.value}`);

        if (select.value && select.value !== "none") {
          const componentType = select.name;
          const componentValue = select.value;
          const componentOrder = parseInt(orderInput.value);
          const targetId = orderInput.getAttribute("data-target");

          console.log(
            `Adding component: ${componentType}, value: ${componentValue}, order: ${componentOrder}`
          );

          selectedComponents.push({
            type: componentType,
            value: componentValue,
            order: componentOrder,
            targetId: targetId,
          });
        }
      }
    });

    console.log("Selected components:", selectedComponents);

    // Check if any components are selected
    if (selectedComponents.length === 0) {
      alert(
        "Veuillez sélectionner au moins un composant avant de générer la prévisualisation."
      );
      return;
    }

    // Sort components by order
    selectedComponents.sort((a, b) => a.order - b.order);

    // Submit data via POST form to editor page
    const hiddenInput = document.getElementById(
      "components-data-input"
    ) as HTMLInputElement;
    const form = document.getElementById("editor-form") as HTMLFormElement;

    hiddenInput.value = JSON.stringify(selectedComponents);
    form.submit();
  });
</script>
