---
import Layout from "../../layouts/Layout.astro";
import ECommerce from "../../layouts/show/ECommerce.astro";
import Navigation from "../../layouts/show/Navigation.astro";
import Hero from "../../layouts/show/Hero.astro";
import Service from "../../layouts/show/Services.astro";
import Sidebyside from "../../layouts/show/Sidebyside.astro";
import Team from "../../layouts/show/Team.astro";
import Gallery from "../../layouts/show/Gallery.astro";
import Steps from "../../layouts/show/Steps.astro";
import Stats from "../../layouts/show/Stats.astro";
import Pricing from "../../layouts/show/Pricing.astro";
import Faq from "../../layouts/show/faq.astro";
import Whychooseus from "../../layouts/show/Whychooseus.astro";
import Quotes from "../../layouts/show/quotes.astro";
import Component from "../../layouts/show/component.astro";
import Reviews from "../../layouts/show/Reviews.astro";
import Contactform from "../../layouts/show/Contactform.astro";
import Events from "../../layouts/show/Events.astro";
import Blog from "../../layouts/show/blog.astro";
import CTA from "../../layouts/show/CTA.astro";
import Footer from "../../layouts/show/Footer.astro";
import InteriorPage from "../../layouts/show/InteriorPage.astro";

const { type } = Astro.params;

const components = {
  "commerceCollection": ECommerce,
  "navigation": Navigation,
  "hero": Hero,
  "service": Service,
  "sidebyside": Sidebyside,
  "team": Team,
  "gallery": Gallery,
  "steps": Steps,
  "stats": Stats,
  "pricing": Pricing,
  "faq": Faq,
  "chooseus": Whychooseus,
  "quotes": Quotes,
  "component": Component,
  "reviews": Reviews,
  "contact": Contactform,
  "events": Events,
  "blog": Blog,
  "cta": CTA,
  "footer": Footer,
  "interiorpage": InteriorPage
};

const ComponentToRender = components[type];

export function getStaticPaths() {
  return [
    { params: { type: "commerceCollection" } },
    { params: { type: "navigation" } },
    { params: { type: "hero" } },
    { params: { type: "service" } },
    { params: { type: "sidebyside" } },
    { params: { type: "team" } },
    { params: { type: "gallery" } },
    { params: { type: "steps" } },
    { params: { type: "stats" } },
    { params: { type: "pricing" } },
    { params: { type: "faq" } },
    { params: { type: "chooseus" } },
    { params: { type: "quotes" } },
    { params: { type: "component" } },
    { params: { type: "reviews" } },
    { params: { type: "contact" } },
    { params: { type: "events" } },
    { params: { type: "blog" } },
    { params: { type: "cta" } },
    { params: { type: "footer" } },
    { params: { type: "interiorpage" } }
  ];
}
---

{ComponentToRender && <ComponentToRender />}