---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="hero-container">
    <a href="/templateBuilder" class="hero-button">Template Builder</a>
  </div>
</Layout>

<style is:inline>
  .hero-container {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    min-height: 100vh !important;
    padding: 2rem !important;
  }

  .hero-button {
    background: #eecb2f !important;
    color: #1a1a1a !important;
    padding: 1.25rem 2.5rem !important;
    border-radius: 8px !important;
    text-decoration: none !important;
    font-family: "Oswald-700", Arial, sans-serif !important;
    font-size: 1.5rem !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.5px !important;
    transition: all 0.3s ease !important;
    box-shadow: 0 4px 15px rgba(238, 203, 47, 0.3) !important;
    display: inline-block !important;
  }

  .hero-button:hover {
    background: #ffe81a !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 25px rgba(238, 203, 47, 0.4) !important;
  }

  .hero-button:active {
    transform: translateY(0) !important;
  }

  [data-theme="dark"] .hero-button {
    background: #fff !important;
    color: #030f18 !important;
    box-shadow: 0 4px 15px rgba(255, 255, 255, 0.1) !important;
  }

  [data-theme="dark"] .hero-button:hover {
    box-shadow: 0 8px 25px rgba(255, 255, 255, 0.2) !important;
  }
</style>
