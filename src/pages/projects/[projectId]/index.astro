---
import Layout from '../../../layouts/Layout.astro';
import ThemeEditor from '../../../components/editor/ThemeEditor.astro';
import { env } from 'cloudflare:workers';
import { DB } from '../../../lib/db';

export const prerender = false;

const { projectId } = Astro.params;
const db = new DB(env.DB);
const project = await db.getProject(projectId!);
if (!project) return Astro.redirect('/projects');
const pages = await db.listPages(project.id);
---
<Layout>
  <main style="max-width: 1100px; margin: 2rem auto; padding: 1rem;">
    <p><a href="/projects">← Tous les projets</a></p>
    <h1>{project.name}</h1>

    <h2>Thème</h2>
    <ThemeEditor project={project} />

    <div style="margin-top:1rem; display:flex; gap:0.5rem;">
      <a href={`/api/projects/${project.id}/export-md`}><button>Exporter (Markdown)</button></a>
      <button id="export-zip-btn">Exporter (ZIP HTML)</button>
    </div>

    <h2 style="margin-top:2rem;">Pages</h2>
    <p><a href={`/projects/${project.id}/pages/new`}><button>+ Nouvelle page</button></a></p>

    {pages.length === 0 && <p>Aucune page.</p>}
    <ul style="list-style:none; padding:0;">
      {pages.map((p) => (
        <li style="border:1px solid #ddd; padding:1rem; margin:0.5rem 0; display:flex; justify-content:space-between; align-items:center;">
          <span><strong>{p.name}</strong> <code>/{p.slug}</code></span>
          <span>
            <a href={`/projects/${project.id}/pages/${p.id}/edit`}><button>Éditer</button></a>
            <button data-action="rename" data-id={p.id}>Renommer</button>
            <button data-action="delete" data-id={p.id}>Supprimer</button>
          </span>
        </li>
      ))}
    </ul>
  </main>

  <script>
    document.getElementById('export-zip-btn')?.addEventListener('click', async () => {
      const { default: JSZip } = await import('jszip');
      const projectId = location.pathname.split('/')[2];
      const projectRes = await fetch(`/api/projects/${projectId}`).then((r) => r.json()) as { name: string };
      const pagesRes = await fetch(`/api/projects/${projectId}/pages`).then((r) => r.json()) as Array<{ id: string; slug: string }>;
      const zip = new JSZip();
      const slugIndex = new Map(pagesRes.map((p) => [p.id, p.slug]));

      async function renderPageOffline(projId: string, pgId: string): Promise<string> {
        return new Promise((resolve, reject) => {
          const iframe = document.createElement('iframe');
          iframe.style.cssText = 'position:fixed; left:-9999px; width:1280px; height:800px; visibility:hidden;';
          iframe.src = `/projects/${projId}/pages/${pgId}/render`;
          iframe.addEventListener('load', () => {
            const wait = setInterval(() => {
              if ((iframe.contentDocument?.documentElement as any)?.dataset?.ready === '1') {
                clearInterval(wait);
                const html = '<!doctype html>\n' + iframe.contentDocument!.documentElement.outerHTML;
                document.body.removeChild(iframe);
                resolve(html);
              }
            }, 100);
            setTimeout(() => { clearInterval(wait); reject(new Error('render timeout: ' + pgId)); }, 10000);
          });
          document.body.appendChild(iframe);
        });
      }

      for (const p of pagesRes) {
        let html: string;
        try { html = await renderPageOffline(projectId, p.id); } catch (e) { console.error(e); continue; }
        const filename = p.slug === pagesRes[0].slug ? 'index.html' : `${p.slug}.html`;
        const rewritten = html.replace(/\/projects\/[a-f0-9-]+\/pages\/([a-f0-9-]+)\/edit/g, (_, id) => `${slugIndex.get(id) ?? id}.html`);
        zip.file(filename, rewritten);
      }

      const imageUrls = new Set<string>();
      for (const p of pagesRes) {
        try {
          const fullPage = await fetch(`/api/projects/${projectId}/pages/${p.id}`).then((r) => r.json()) as { page: any; sections: Array<{ content: { imageOverrides?: Record<string,string> } }> };
          for (const s of fullPage.sections) {
            for (const url of Object.values(s.content.imageOverrides ?? {})) imageUrls.add(url);
          }
        } catch {}
      }

      for (const url of imageUrls) {
        try {
          const blob = await fetch(url).then((r) => r.blob());
          const localPath = `assets/images/${url.split('/').pop()}`;
          zip.file(localPath, blob);
          const names = Object.keys(zip.files).filter((n) => n.endsWith('.html'));
          for (const name of names) {
            const f = await zip.file(name)!.async('string');
            zip.file(name, f.replaceAll(url, localPath));
          }
        } catch {}
      }

      // --- bundle Astro build assets (CSS/JS/fonts) referenced via absolute /_astro/ paths ---
      const ASTRO_RE = /\/_astro\/[A-Za-z0-9_.\-]+/g;
      const astroAssets = new Map<string, { text?: string; blob?: Blob }>();
      async function fetchAstro(path: string): Promise<void> {
        if (astroAssets.has(path)) return;
        astroAssets.set(path, {}); // reserve to break cycles
        try {
          const r = await fetch(path);
          const isText = path.endsWith('.css') || path.endsWith('.js');
          if (isText) {
            const text = await r.text();
            astroAssets.set(path, { text });
            for (const m of text.matchAll(ASTRO_RE)) await fetchAstro(m[0]);
          } else {
            astroAssets.set(path, { blob: await r.blob() });
          }
        } catch (e) { console.error('asset fetch failed', path, e); }
      }

      const htmlNames = Object.keys(zip.files).filter((n) => n.endsWith('.html'));
      const seedPaths = new Set<string>();
      for (const name of htmlNames) {
        const f = await zip.file(name)!.async('string');
        for (const m of f.matchAll(ASTRO_RE)) seedPaths.add(m[0]);
      }
      for (const p of seedPaths) await fetchAstro(p);

      // write assets; css/js live inside _astro/, so their internal /_astro/ refs become sibling-relative
      for (const [path, val] of astroAssets) {
        const zipPath = path.slice(1); // "/_astro/x" -> "_astro/x"
        if (val.text !== undefined) zip.file(zipPath, val.text.replaceAll('/_astro/', ''));
        else if (val.blob) zip.file(zipPath, val.blob);
      }
      // html lives at zip root, so /_astro/ -> _astro/
      for (const name of htmlNames) {
        const f = await zip.file(name)!.async('string');
        zip.file(name, f.replaceAll('/_astro/', '_astro/'));
      }

      const blob = await zip.generateAsync({ type: 'blob' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `${projectRes.name.replace(/[^a-z0-9-]+/gi, '_')}.zip`;
      a.click();
    });
  </script>

  <script>
    const projectId = location.pathname.split('/')[2];
    document.querySelectorAll('button[data-action="delete"]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('Supprimer cette page ?')) return;
        const id = (btn as HTMLElement).dataset.id;
        await fetch(`/api/projects/${projectId}/pages/${id}`, { method: 'DELETE' });
        location.reload();
      });
    });
    document.querySelectorAll('button[data-action="rename"]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.id;
        const name = prompt('Nouveau nom ?');
        if (!name) return;
        await fetch(`/api/projects/${projectId}/pages/${id}`, { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ name }) });
        location.reload();
      });
    });
  </script>
</Layout>
