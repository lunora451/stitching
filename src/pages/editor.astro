  const BUTTON_PRESET_TEMPLATES: Record<string, (text: string) => string> = {
    "cs-preset-1": (t) => `<span class="cs-button-text">${escapeHtml(t)}</span>`,
    "cs-preset-2": (t) => `${escapeHtml(t)}<div class="cs-wrapper">${ARROW_SVG_DARK}</div>`,
    "cs-preset-3": (t) => `${escapeHtml(t)}${DOUBLE_ARROW_SVG}`,
    "cs-preset-4": (t) => `${escapeHtml(t)}<div class="cs-wrapper">${ARROW_SVG_DARK}</div>`,
    "cs-preset-5": (t) => `${escapeHtml(t)}<div class="cs-wrapper">${ARROW_SVG_LIGHT}</div>`,
    "cs-preset-6": (t) => escapeHtml(t),
    "cs-preset-7": (t) => `${escapeHtml(t)}${ARROW_SVG_DARK}`,
    "cs-preset-8": (t) => escapeHtml(t),
    "cs-preset-9": (t) => escapeHtml(t),
    "cs-preset-10": (t) => escapeHtml(t),
  };

  let textMode = false;
  let imageMode = false;
  let colorMode = false;
  let fontMode = false;
  let buttonMode = false;

  function $(id: string) {
    return document.getElementById(id);
  }

  function rgbToHex(rgb: string): string {
    if (!rgb) return "#000000";
    if (rgb.startsWith("#")) return rgb;
    const m = rgb.match(/\d+/g);
    if (!m || m.length < 3) return "#000000";
    const toHex = (n: string) => parseInt(n, 10).toString(16).padStart(2, "0");
    return `#${toHex(m[0])}${toHex(m[1])}${toHex(m[2])}`;
  }

  function readSelection(): Selection {
    return [...document.querySelectorAll<HTMLElement>(".editable-component")].map(
      (w) => ({
        type: w.dataset.componentType || "",
        value: w.dataset.variantValue || "",
        order: parseInt(w.style.order || "0", 10),
        targetId: "",
      })
    );
  }

  function selectionToUrl(selection: Selection): string {
    const params = new URLSearchParams();
    const order: string[] = [];
    [...selection]
      .sort((a, b) => a.order - b.order)
      .forEach((s, idx) => {
        const key = TYPE_TO_KEY[s.type];
        if (!key) return;
        params.set(key, s.value);
        order[idx] = key;
      });
    params.set("order", order.filter(Boolean).join(","));
    return `/editor?${params.toString()}`;
  }

  function readTemplates(): Record<string, TemplateData> {
    try {
      const raw = localStorage.getItem(STORAGE_TEMPLATES);
      return raw ? JSON.parse(raw) : {};
    } catch {
      return {};
    }
  }

  function writeTemplates(t: Record<string, TemplateData>) {
    localStorage.setItem(STORAGE_TEMPLATES, JSON.stringify(t));
  }

  function markEditable() {
    const wrappers = document.querySelectorAll<HTMLElement>(
      ".editable-component"
    );
    wrappers.forEach((wrapper) => {
      const type = wrapper.dataset.componentType || "";
      const variant = wrapper.dataset.variantValue || "x";
      const active = wrapper.querySelector<HTMLElement>(".active");
      if (!active) return;

      let tIdx = 0;
      active
        .querySelectorAll<HTMLElement>("h1, h2, h3, h4, h5, h6, p, span, a, button, li")
        .forEach((el) => {
          if (el.getAttribute("data-editable") === "false") return;
          const hasElementChildren = Array.from(el.children).some(
            (c) => !["IMG", "BR", "SVG", "I"].includes(c.tagName)
          );
          if (hasElementChildren) return;
          const hasDirectText = Array.from(el.childNodes).some(
            (n) => n.nodeType === Node.TEXT_NODE && (n.textContent || "").trim() !== ""
          );
          if (!hasDirectText) return;
          el.setAttribute("data-editable", "true");
          if (!el.dataset.editId) {
            el.dataset.editId = `${type}-${variant}-text-${tIdx}`;
            if (!el.dataset.originalText) {
              el.dataset.originalText = el.textContent || "";
            }
          }
          tIdx++;
        });

      let iIdx = 0;
      active.querySelectorAll<HTMLImageElement>("img").forEach((img) => {
        if (!img.dataset.editId) {
          img.dataset.editId = `${type}-${variant}-img-${iIdx}`;
          if (!img.dataset.originalSrc) {
            img.dataset.originalSrc = img.src;
          }
        }
        iIdx++;
      });

      let bIdx = 0;
      active
        .querySelectorAll<HTMLElement>("button, a")
        .forEach((el) => {
          const cls = el.className || "";
          if (typeof cls !== "string") return;
          if (!/\b(button|btn)\b/i.test(cls)) return;
          if (!el.dataset.btnEditId) {
            el.dataset.btnEditId = `${type}-${variant}-btn-${bIdx}`;
            el.dataset.originalClass = cls;
          }
          bIdx++;
        });
    });
  }

  function setTextMode(on: boolean) {
    textMode = on;
    $("toggle-text-edit")?.classList.toggle("active", on);
    document
      .querySelectorAll<HTMLElement>(".editable-component")
      .forEach((c) => c.classList.toggle("text-edit-mode", on));
    document
      .querySelectorAll<HTMLElement>('[data-editable="true"]')
      .forEach((el) => {
        el.contentEditable = on ? "true" : "false";
      });
    document
      .querySelectorAll<HTMLAnchorElement>("#editor-content a")
      .forEach((a) => {
        if (on) {
          if (a.dataset.origHref === undefined) {
            a.dataset.origHref = a.getAttribute("href") ?? "";
          }
          a.removeAttribute("href");
        } else if (a.dataset.origHref !== undefined) {
          const orig = a.dataset.origHref;
          if (orig) a.setAttribute("href", orig);
          delete a.dataset.origHref;
        }
      });
    if (on) {
      setImageMode(false);
      setColorMode(false);
      setFontMode(false);
      setButtonMode(false);
    }
  }

  function setImageMode(on: boolean) {
    imageMode = on;
    $("toggle-image-edit")?.classList.toggle("active", on);
    document
      .querySelectorAll<HTMLElement>(".editable-component")
      .forEach((c) => c.classList.toggle("image-edit-mode", on));
    if (on) {
      setTextMode(false);
      setColorMode(false);
      setFontMode(false);
      setButtonMode(false);
      mountImagePills();
    } else {
      unmountImagePills();
    }
  }

  function applyImageSrc(img: HTMLImageElement, src: string) {
    img.src = src;
    img.removeAttribute("srcset");
    const picture = img.closest("picture");
    if (picture) {
      picture
        .querySelectorAll<HTMLSourceElement>("source")
        .forEach((s) => {
          s.srcset = src;
        });
    }
  }

  let pillResizeHandler: (() => void) | null = null;

  function repositionPills() {
    document
      .querySelectorAll<HTMLElement>(".image-edit-pill")
      .forEach((pill) => {
        const editId = pill.dataset.forImg;
        if (!editId) return;
        const img = document.querySelector<HTMLImageElement>(
          `img[data-edit-id="${editId}"]`
        );
        if (!img) {
          pill.remove();
          return;
        }
        const r = img.getBoundingClientRect();
        pill.style.position = "fixed";
        pill.style.left = `${r.left + r.width / 2}px`;
        pill.style.top = `${r.top + r.height / 2}px`;
      });
  }

  function mountImagePills() {
    unmountImagePills();
    document
      .querySelectorAll<HTMLImageElement>("img[data-edit-id]")
      .forEach((img) => {
        const wrapper = img.closest<HTMLElement>(".editable-component");
        if (!wrapper || wrapper.style.display === "none") return;
        const pill = document.createElement("button");
        pill.type = "button";
        pill.className = "image-edit-pill";
        pill.dataset.forImg = img.dataset.editId!;
        pill.textContent = "📷 Change image";
        pill.style.cssText = [
          "position:fixed",
          "z-index:2147483647",
          "display:inline-flex",
          "align-items:center",
          "gap:0.3rem",
          "padding:0.45rem 0.85rem",
          "background:#1d11b9",
          "color:#fff",
          "font-family:Arial,sans-serif",
          "font-size:0.8rem",
          "font-weight:700",
          "border:2px solid #fff",
          "border-radius:999px",
          "cursor:pointer",
          "box-shadow:0 4px 14px rgba(0,0,0,0.5)",
          "pointer-events:auto",
          "transform:translate(-50%,-50%)",
          "white-space:nowrap",
          "line-height:1",
        ].join(";");
        pill.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          openFilePickerFor(img);
        });
        document.body.appendChild(pill);
      });
    repositionPills();
    pillResizeHandler = () => repositionPills();
    window.addEventListener("scroll", pillResizeHandler, true);
    window.addEventListener("resize", pillResizeHandler);
  }

  function unmountImagePills() {
    document
      .querySelectorAll<HTMLElement>(".image-edit-pill")
      .forEach((p) => p.remove());
    if (pillResizeHandler) {
      window.removeEventListener("scroll", pillResizeHandler, true);
      window.removeEventListener("resize", pillResizeHandler);
      pillResizeHandler = null;
    }
  }

  let buttonPillResizeHandler: (() => void) | null = null;

  function repositionButtonPills() {
    document
      .querySelectorAll<HTMLElement>(".button-edit-pill")
      .forEach((pill) => {
        const editId = pill.dataset.forBtn;
        if (!editId) return;
        const btn = document.querySelector<HTMLElement>(
          `[data-btn-edit-id="${editId}"]`
        );
        if (!btn) {
          pill.remove();
          return;
        }
        const r = btn.getBoundingClientRect();
        pill.style.left = `${r.left + r.width / 2}px`;
        pill.style.top = `${r.top + r.height / 2}px`;
      });
  }

  function mountButtonPills() {
    unmountButtonPills();
    document
      .querySelectorAll<HTMLElement>("[data-btn-edit-id]")
      .forEach((btn) => {
        const wrapper = btn.closest<HTMLElement>(".editable-component");
        if (!wrapper || wrapper.style.display === "none") return;
        const pill = document.createElement("button");
        pill.type = "button";
        pill.className = "button-edit-pill";
        pill.dataset.forBtn = btn.dataset.btnEditId!;
        pill.textContent = "🎨 Style";
        pill.style.cssText = [
          "position:fixed",
          "z-index:2147483647",
          "display:inline-flex",
          "align-items:center",
          "gap:0.3rem",
          "padding:0.4rem 0.8rem",
          "background:#c10e0a",
          "color:#fff",
          "font-family:Arial,sans-serif",
          "font-size:0.75rem",
          "font-weight:700",
          "border:2px solid #fff",
          "border-radius:999px",
          "cursor:pointer",
          "box-shadow:0 4px 14px rgba(0,0,0,0.5)",
          "pointer-events:auto",
          "transform:translate(-50%,-50%)",
          "white-space:nowrap",
          "line-height:1",
        ].join(";");
        pill.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const live = document.querySelector<HTMLElement>(
            `[data-btn-edit-id="${pill.dataset.forBtn}"]`
          );
          if (!live) return;
          showButtonPresetPopup(live, e.clientX, e.clientY);
        });
        document.body.appendChild(pill);
      });
    repositionButtonPills();
    buttonPillResizeHandler = () => repositionButtonPills();
    window.addEventListener("scroll", buttonPillResizeHandler, true);
    window.addEventListener("resize", buttonPillResizeHandler);
  }

  function unmountButtonPills() {
    document
      .querySelectorAll<HTMLElement>(".button-edit-pill")
      .forEach((p) => p.remove());
    if (buttonPillResizeHandler) {
      window.removeEventListener("scroll", buttonPillResizeHandler, true);
      window.removeEventListener("resize", buttonPillResizeHandler);
      buttonPillResizeHandler = null;
    }
  }

  let buttonPresetTarget: HTMLElement | null = null;

  function showButtonPresetPopup(btn: HTMLElement, x: number, y: number) {
    const popup = $("button-preset-popup");
    if (!popup) return;
    buttonPresetTarget = btn;
    popup.hidden = false;
    const pw = popup.offsetWidth || 400;
    const ph = popup.offsetHeight || 300;
    popup.style.left = `${Math.min(x, window.innerWidth - pw - 10)}px`;
    popup.style.top = `${Math.min(y, window.innerHeight - ph - 10)}px`;
  }

  function hideButtonPresetPopup() {
    const popup = $("button-preset-popup");
    if (popup) popup.hidden = true;
    buttonPresetTarget = null;
  }

  function applyButtonPreset(btn: HTMLElement, presetKey: string | null) {
    if (!presetKey || !BUTTON_PRESET_TEMPLATES[presetKey]) return;
    const editId = btn.dataset.btnEditId;
    const text = (btn.textContent || "").trim() || "Button";
    const inner = BUTTON_PRESET_TEMPLATES[presetKey](text);

    const replacement = document.createElement("button");
    replacement.type = "button";
    replacement.className = presetKey;
    if (editId) replacement.dataset.btnEditId = editId;
    replacement.innerHTML = inner;

    btn.replaceWith(replacement);

    if (buttonMode) {
      setTimeout(repositionButtonPills, 0);
    }
  }

  function populateButtonPresetGrid() {
    const grid = $("button-preset-grid");
    if (!grid) return;
    grid.innerHTML = "";
    BUTTON_PRESETS.forEach((p) => {
      const card = document.createElement("div");
      card.className = "preset-card";
      card.innerHTML = `
        <a href="javascript:void(0)" class="${p.key}" style="pointer-events:none;">Sample</a>
        <span class="preset-label">${p.label}</span>
      `;
      card.addEventListener("click", () => {
        if (buttonPresetTarget) {
          applyButtonPreset(buttonPresetTarget, p.key);
        }
        hideButtonPresetPopup();
      });
      grid.appendChild(card);
    });
  }

  function populateFontPanel() {
    document
      .querySelectorAll<HTMLSelectElement>(".font-select")
      .forEach((select) => {
        select.innerHTML = FONT_OPTIONS.map(
          (f) => `<option value='${f.stack}'>${f.label}</option>`
        ).join("");
        const varName = select.dataset.fontVar;
        if (!varName) return;
        select.addEventListener("change", () => {
          document.documentElement.style.setProperty(varName, select.value);
        });
      });
  }

  const CHECKERBOARD = "repeating-linear-gradient(45deg,#ddd 0,#ddd 4px,#fff 4px,#fff 8px)";

  function updateDropdownTrigger(
    axis: "color" | "backgroundColor",
    value: string,
    pickerColor?: string
  ) {
    const id = axis === "color" ? "local-color-text-dropdown" : "local-color-bg-dropdown";
    const container = $(id);
    if (!container) return;
    const swatch = container.querySelector<HTMLElement>(".cd-trigger .cd-swatch");
    const label  = container.querySelector<HTMLElement>(".cd-trigger .cd-label");
    if (!swatch || !label) return;
    if (!value) {
      swatch.style.background = CHECKERBOARD;
      label.textContent = "— inherit —";
    } else if (value === "custom") {
      swatch.style.background = pickerColor ?? CHECKERBOARD;
      label.textContent = "Custom…";
    } else {
      swatch.style.background = value;
      const optLabel = container.querySelector<HTMLElement>(`.cd-option[data-value="${CSS.escape(value.slice(4, -1))}"] .cd-label, .cd-option[data-value="${value}"] .cd-label`);
      label.textContent = optLabel?.textContent ?? value;
    }
  }

  function selectDropdownOption(
    containerId: string,
    value: string,
    axis: "color" | "backgroundColor",
    pickerColor?: string
  ) {
    const container = $(containerId);
    const picker = document.querySelector<HTMLInputElement>(`.custom-picker[data-axis="${axis}"]`);
    if (!container) return;

    container.querySelectorAll<HTMLButtonElement>(".cd-option").forEach((btn) => {
      btn.classList.toggle("selected", btn.dataset.value === value);
    });

    if (picker) {
      picker.hidden = value !== "custom";
      if (value === "custom" && pickerColor) picker.value = pickerColor;
    }

    updateDropdownTrigger(axis, value, pickerColor ?? picker?.value);

    if (value === "custom") return;
    if (!localColorTarget) return;
    localColorTarget.style[axis] = value;
  }

  function populateColorDropdowns() {
    const defs: Array<{ id: string; axis: "color" | "backgroundColor" }> = [
      { id: "local-color-text-dropdown", axis: "color" },
      { id: "local-color-bg-dropdown",   axis: "backgroundColor" },
    ];

    defs.forEach(({ id, axis }) => {
      const container = $(id);
      if (!container) return;
      container.innerHTML = "";

      const trigger = document.createElement("button");
      trigger.type = "button";
      trigger.className = "cd-trigger";
      trigger.innerHTML = `<span class="cd-label">— inherit —</span><span class="cd-swatch" style="background:${CHECKERBOARD}"></span><span class="cd-arrow">▾</span>`;

      const list = document.createElement("div");
      list.className = "cd-list";
      list.hidden = true;

      const options: Array<{ value: string; label: string; bg: string }> = [
        { value: "", label: "— inherit —", bg: CHECKERBOARD },
        ...ROOT_COLOR_VARS.map((cv) => ({
          value: `var(${cv.name})`,
          label: `${cv.name}  ${cv.defaultHex}`,
          bg: `var(${cv.name})`,
        })),
        { value: "custom", label: "Custom…", bg: CHECKERBOARD },
      ];

      options.forEach((opt) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "cd-option";
        btn.dataset.value = opt.value;
        btn.innerHTML = `<span class="cd-label">${opt.label}</span><span class="cd-swatch" style="background:${opt.bg}"></span>`;
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          selectDropdownOption(id, opt.value, axis);
          list.hidden = true;
        });
        list.appendChild(btn);
      });

      trigger.addEventListener("click", (e) => {
        e.stopPropagation();
        list.hidden = !list.hidden;
      });

      container.appendChild(trigger);
      container.appendChild(list);
    });
  }

  function openFilePickerFor(img: HTMLImageElement) {
    const input = document.createElement("input");
    input.type = "file";
    input.accept = "image/*";
    input.onchange = () => {
      const file = input.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (ev) => {
        const result = ev.target?.result;
        if (typeof result === "string") {
          applyImageSrc(img, result);
          repositionPills();
        }
      };
      reader.readAsDataURL(file);
    };
    input.click();
  }

  function setColorMode(on: boolean) {
    colorMode = on;
    $("toggle-color-edit")?.classList.toggle("active", on);
    const panel = $("color-panel");
    if (panel) panel.hidden = !on;
    document
      .querySelectorAll<HTMLElement>(".editable-component")
      .forEach((c) => c.classList.toggle("color-edit-mode", on));
    if (!on) {
      hideLocalColorPopup();
    }
    if (on) {
      setTextMode(false);
      setImageMode(false);
      setFontMode(false);
      setButtonMode(false);
    }
  }

  function setFontMode(on: boolean) {
    fontMode = on;
    $("toggle-font-edit")?.classList.toggle("active", on);
    const panel = $("font-panel");
    if (panel) panel.hidden = !on;
    if (on) {
      setTextMode(false);
      setImageMode(false);
      setColorMode(false);
      setButtonMode(false);
    }
  }

  function setButtonMode(on: boolean) {
    buttonMode = on;
    $("toggle-button-edit")?.classList.toggle("active", on);
    if (on) {
      setTextMode(false);
      setImageMode(false);
      setColorMode(false);
      setFontMode(false);
      mountButtonPills();
    } else {
      unmountButtonPills();
      hideButtonPresetPopup();
    }
  }

  let localColorTarget: HTMLElement | null = null;

  function syncColorDropdown(containerId: string, axis: "color" | "backgroundColor", target: HTMLElement) {
    const container = $(containerId);
    if (!container) return;
    const val = target.style[axis];
    let matchValue = "";
    let pickerColor: string | undefined;

    if (!val) {
      matchValue = "";
    } else if (val.startsWith("var(")) {
      const btn = container.querySelector<HTMLButtonElement>(`.cd-option[data-value="${val}"]`);
      matchValue = btn ? val : "custom";
      if (!btn) pickerColor = rgbToHex(getComputedStyle(target)[axis]);
    } else {
      matchValue = "custom";
      pickerColor = rgbToHex(val);
    }

    selectDropdownOption(containerId, matchValue, axis, pickerColor);
  }

  function showLocalColorPopup(target: HTMLElement, x: number, y: number) {
    const popup = $("local-color-popup");
    if (!popup) return;
    localColorTarget = target;

    if (!target.dataset.colorOverrideId) {
      const wrapper = target.closest<HTMLElement>(".editable-component");
      const type = wrapper?.dataset.componentType || "x";
      const variant = wrapper?.dataset.variantValue || "x";
      target.dataset.colorOverrideId = `${type}-${variant}-color-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`;
    }

    syncColorDropdown("local-color-text-dropdown", "color", target);
    syncColorDropdown("local-color-bg-dropdown", "backgroundColor", target);

    popup.hidden = false;
    const pw = popup.offsetWidth || 200;
    popup.style.left = `${Math.min(x, window.innerWidth - pw - 10)}px`;
    popup.style.top = `${y}px`;
  }

  function hideLocalColorPopup() {
    const popup = $("local-color-popup");
    if (popup) popup.hidden = true;
    localColorTarget = null;
  }

  function handleColorClick(e: MouseEvent) {
    if (!colorMode) return;
    const t = e.target as HTMLElement;
    if (!t || t.closest(".editor-toolbar") || t.closest(".color-panel") || t.closest(".local-color-popup")) {
      return;
    }
    e.preventDefault();
    e.stopPropagation();
    showLocalColorPopup(t, e.clientX + 8, e.clientY + 8);
  }

  function wireColorPickers() {
    document
      .querySelectorAll<HTMLInputElement>(".color-panel input[type='color']")
      .forEach((input) => {
        input.addEventListener("input", () => {
          const cssVar = input.dataset.cssVar;
          if (!cssVar) return;
          document.documentElement.style.setProperty(cssVar, input.value);
        });
      });

    const textInput = $("local-color-text") as HTMLInputElement | null;
    const bgInput = $("local-color-bg") as HTMLInputElement | null;
    textInput?.addEventListener("input", () => {
      if (localColorTarget) localColorTarget.style.color = textInput.value;
      updateDropdownTrigger("color", "custom", textInput.value);
    });
    bgInput?.addEventListener("input", () => {
      if (localColorTarget)
        localColorTarget.style.backgroundColor = bgInput.value;
      updateDropdownTrigger("backgroundColor", "custom", bgInput.value);
    });

    $("local-color-clear")?.addEventListener("click", () => {
      if (!localColorTarget) return;
      localColorTarget.style.color = "";
      localColorTarget.style.backgroundColor = "";
      delete localColorTarget.dataset.colorOverrideId;
      hideLocalColorPopup();
    });
    $("local-color-close")?.addEventListener("click", hideLocalColorPopup);
  }

  function collectTextOverrides(): Record<string, string> {
    const out: Record<string, string> = {};
    document
      .querySelectorAll<HTMLElement>("[data-edit-id]")
      .forEach((el) => {
        if (el.tagName === "IMG") return;
        const id = el.dataset.editId!;
        const cur = el.textContent || "";
        const orig = el.dataset.originalText || "";
        if (cur !== orig) out[id] = cur;
      });
    return out;
  }

  function collectImageOverrides(): Record<string, string> {
    const out: Record<string, string> = {};
    document
      .querySelectorAll<HTMLImageElement>("img[data-edit-id]")
      .forEach((img) => {
        const id = img.dataset.editId!;
        const cur = img.src;
        const orig = img.dataset.originalSrc || "";
        if (cur !== orig) out[id] = cur;
      });
    return out;
  }

  function collectRootColors(): Record<string, string> {
    const out: Record<string, string> = {};
    const inline = document.documentElement.style;
    ROOT_COLOR_VARS.forEach(({ name }) => {
      const val = inline.getPropertyValue(name).trim();
      if (val) out[name] = val;
    });
    return out;
  }

  function collectRootFonts(): Record<string, string> {
    const out: Record<string, string> = {};
    const inline = document.documentElement.style;
    ROOT_FONT_VARS.forEach((v) => {
      const val = inline.getPropertyValue(v).trim();
      if (val) out[v] = val;
    });
    return out;
  }

  function collectButtonOverrides(): Record<string, string> {
    const out: Record<string, string> = {};
    document
      .querySelectorAll<HTMLElement>("[data-btn-edit-id]")
      .forEach((btn) => {
        const id = btn.dataset.btnEditId!;
        const preset = (btn.className || "")
          .split(/\s+/)
          .find((c) => c.startsWith("cs-preset-"));
        if (preset) out[id] = preset;
      });
    return out;
  }

  function collectLocalColors(): Record<
    string,
    { color?: string; backgroundColor?: string }
  > {
    const out: Record<string, { color?: string; backgroundColor?: string }> =
      {};
    document
      .querySelectorAll<HTMLElement>("[data-color-override-id]")
      .forEach((el) => {
        const id = el.dataset.colorOverrideId!;
        const entry: { color?: string; backgroundColor?: string } = {};
        if (el.style.color) entry.color = el.style.color;
        if (el.style.backgroundColor)
          entry.backgroundColor = el.style.backgroundColor;
        if (Object.keys(entry).length > 0) out[id] = entry;
      });
    return out;
  }

  function refreshLoadList() {
    const select = $("load-template") as HTMLSelectElement | null;
    if (!select) return;
    const templates = readTemplates();
    const names = Object.keys(templates).sort();
    select.innerHTML =
      '<option value="">— Load template —</option>' +
      names
        .map((n) => `<option value="${n}">${n}</option>`)
        .join("");
  }

  function saveTemplate() {
    const nameInput = $("template-name") as HTMLInputElement | null;
    const name = nameInput?.value.trim() || "";
    if (!name) {
      alert("Donnez un nom au template avant de sauvegarder.");
      nameInput?.focus();
      return;
    }
    const selection = readSelection();
    if (selection.length === 0) {
      alert("Aucune sélection courante.");
      return;
    }
    const templates = readTemplates();
    templates[name] = {
      createdAt: new Date().toISOString(),
      selection,
      textOverrides: collectTextOverrides(),
      imageOverrides: collectImageOverrides(),
      rootColors: collectRootColors(),
      localColors: collectLocalColors(),
      rootFonts: collectRootFonts(),
      buttonOverrides: collectButtonOverrides(),
    };
    writeTemplates(templates);
    refreshLoadList();
    alert(`Template "${name}" enregistré.`);
  }

  function applyOverrides(t: TemplateData) {
    Object.entries(t.rootColors).forEach(([k, v]) => {
      document.documentElement.style.setProperty(k, v);
    });
    document
      .querySelectorAll<HTMLInputElement>(".color-panel input[type='color']")
      .forEach((input) => {
        const v = input.dataset.cssVar;
        if (v && t.rootColors[v]) input.value = t.rootColors[v];
      });

    Object.entries(t.textOverrides).forEach(([id, text]) => {
      const el = document.querySelector<HTMLElement>(
        `[data-edit-id="${id}"]`
      );
      if (el) el.textContent = text;
    });

    Object.entries(t.imageOverrides).forEach(([id, src]) => {
      const el = document.querySelector<HTMLImageElement>(
        `img[data-edit-id="${id}"]`
      );
      if (el) applyImageSrc(el, src);
    });

    Object.entries(t.localColors).forEach(([id, styles]) => {
      const el = document.querySelector<HTMLElement>(
        `[data-color-override-id="${id}"]`
      );
      if (el) {
        if (styles.color) el.style.color = styles.color;
        if (styles.backgroundColor) el.style.backgroundColor = styles.backgroundColor;
      }
    });

    const fonts = t.rootFonts || {};
    Object.entries(fonts).forEach(([k, v]) => {
      document.documentElement.style.setProperty(k, v);
    });
    document
      .querySelectorAll<HTMLSelectElement>(".font-select")
      .forEach((select) => {
        const v = select.dataset.fontVar;
        if (v && fonts[v]) select.value = fonts[v];
      });

    const buttonOv = t.buttonOverrides || {};
    Object.entries(buttonOv).forEach(([id, presetKey]) => {
      const el = document.querySelector<HTMLElement>(
        `[data-btn-edit-id="${id}"]`
      );
      if (el) applyButtonPreset(el, presetKey);
    });
  }

  function loadTemplate(name: string) {
    const templates = readTemplates();
    const t = templates[name];
    if (!t) {
      alert(`Template "${name}" introuvable.`);
      return;
    }
    sessionStorage.setItem("lunora.pendingTemplate", name);
    window.location.href = selectionToUrl(t.selection);
  }

  function deleteTemplate() {
    const select = $("load-template") as HTMLSelectElement | null;
    const name = select?.value;
    if (!name) {
      alert("Choisissez un template dans la liste.");
      return;
    }
    if (!confirm(`Supprimer le template "${name}" ?`)) return;
    const templates = readTemplates();
    delete templates[name];
    writeTemplates(templates);
    refreshLoadList();
  }

  document.addEventListener("DOMContentLoaded", () => {
    markEditable();
    wireColorPickers();
    populateColorDropdowns();
    populateFontPanel();
    populateButtonPresetGrid();
    refreshLoadList();

    const pending = sessionStorage.getItem("lunora.pendingTemplate");
    if (pending) {
      sessionStorage.removeItem("lunora.pendingTemplate");
      const templates = readTemplates();
      const t = templates[pending];
      if (t) {
        applyOverrides(t);
        const nameInput = $("template-name") as HTMLInputElement | null;
        if (nameInput) nameInput.value = pending;
      }
    }

    $("toggle-text-edit")?.addEventListener("click", () =>
      setTextMode(!textMode)
    );
    $("toggle-image-edit")?.addEventListener("click", () =>
      setImageMode(!imageMode)
    );
    $("toggle-color-edit")?.addEventListener("click", () =>
      setColorMode(!colorMode)
    );
    $("toggle-font-edit")?.addEventListener("click", () =>
      setFontMode(!fontMode)
    );
    $("toggle-button-edit")?.addEventListener("click", () =>
      setButtonMode(!buttonMode)
    );

    $("button-preset-close")?.addEventListener("click", hideButtonPresetPopup);
    $("button-preset-reset")?.addEventListener("click", () => {
      if (buttonPresetTarget) applyButtonPreset(buttonPresetTarget, null);
      hideButtonPresetPopup();
    });

    $("save-template")?.addEventListener("click", saveTemplate);
    $("delete-template")?.addEventListener("click", deleteTemplate);

    $("load-template")?.addEventListener("change", (e) => {
      const sel = e.target as HTMLSelectElement;
      if (sel.value) loadTemplate(sel.value);
    });

    document
      .getElementById("editor-content")
      ?.addEventListener("click", handleColorClick, true);

    document.addEventListener("click", () => {
      document.querySelectorAll<HTMLElement>(".cd-list").forEach((l) => (l.hidden = true));
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        if (!$("local-color-popup")?.hidden) hideLocalColorPopup();
        if (!$("button-preset-popup")?.hidden) hideButtonPresetPopup();
      }
    });

    const editorContent = document.getElementById("editor-content");
    if (editorContent) {
      editorContent.addEventListener("click", (e) => {
        if (textMode) return;
        const link = (e.target as HTMLElement).closest("a");
        if (link) e.preventDefault();
      }, true);
    }
  });
</script>
